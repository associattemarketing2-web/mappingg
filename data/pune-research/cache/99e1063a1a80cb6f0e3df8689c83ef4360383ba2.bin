<script>
  function onSubmit(token) {
    
  }

  function validate(event) {
   // event.preventDefault();
   var ftEmail =document.getElementById('ftemail');
   var ftFname =document.getElementById('ftname');
   var ftMobile = document.getElementById('ftmobile');
    if (ftEmail!='' && ftFname!=''  && ftMobile!='') {
