		<div class="embed_container" style="position: static; z-index: 1;"><style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    img {
        max-width: 100%;
    }

    /* Overlay */
    .popup-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .75);
        backdrop-filter: blur(8px);
        z-index: 9999999;
        align-items: center;
        justify-content: center;
        padding: 10px;
    }

    .popup-overlay.active {
        display: flex;
    }

    /* Modal */
    .popup-overlay .popup-content {
        position: relative;
        width: min(900px, 95vw);
        max-height: 98vh;
        overflow-y: auto;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, .25);
        animation: popupShow .4s ease;
    }

    @keyframes popupShow {
        from {
            opacity: 0;
            transform: translateY(30px) scale(.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Close Button */
    .popup-overlay .popup-header {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 100;
    }

    .popup-overlay .close-btn {
        width: 30px;
        height: 30px;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, .95);
        backdrop-filter: blur(10px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, .15);
        font-size: 14px;
        cursor: pointer;
        transition: .3s;
        color: #333;
        font-weight: bold;
    }

    .popup-overlay .close-btn:hover {
        transform: rotate(90deg);
    }

    .popup-overlay .close-btn:focus-visible,
    .popup-overlay .nav-btn:focus-visible,
    .popup-overlay .read-more-btn:focus-visible,
    .popup-overlay .dot-indicator:focus-visible,
    .popup-overlay .play-pause-btn:focus-visible {
        outline: 3px solid #5b1a14;
        outline-offset: 2px;
    }

    /* Image */
    .popup-overlay .popup-image {
        width: 100%;
        max-height: 94vh;
        object-fit: contain;
        display: block;
        background: #f8f9fa;
        position: relative;
    }

    /* Content */
    .popup-overlay .popup-body {
        padding: 5px 10px;
        text-align: center;
        position: absolute;
        bottom: 10px;
        background: #69676726;
        width: 390px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin: 0 auto;
        left: 27%;
    }

    /* Expired Notice */
    .popup-overlay .expired-notice {
        background: #fff3cd;
        color: #856404;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: .9rem;
    }

    /* Button */
    .popup-overlay .read-more-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 6px 16px;
        border-radius: 50px;
        background: linear-gradient(135deg, #9f4f48, #5b1a14);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        transition: .3s;
        font-size: 12px;
    }

    .popup-overlay .read-more-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(91, 26, 20, .25);
    }

    .popup-overlay .read-more-btn.hidden {
        display: none;
    }

    /* Play / Pause Button */
    .popup-overlay .play-pause-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, .9);
        box-shadow: 0 2px 8px rgba(0, 0, 0, .15);
        cursor: pointer;
        font-size: 14px;
        color: #5b1a14;
        transition: .3s;
        flex-shrink: 0;
    }

    .popup-overlay .play-pause-btn:hover {
        transform: scale(1.15);
        box-shadow: 0 4px 12px rgba(0, 0, 0, .25);
    }

    /* Screen-reader-only utility */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* Counter */
    .popup-overlay .slider-indicator {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;

    }

    .popup-overlay #popupCounter {
        font-weight: 600;
        color: #242424;
    }

    /* Dots */
    .popup-overlay #dotsContainer {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .popup-overlay .dot-indicator {
        width: 10px;
        height: 10px;
        border-radius: 50px;
        background: #d1d5db;
        cursor: pointer;
        transition: .3s;
    }

    .popup-overlay .dot-indicator.active {
        width: 30px;
        background: #9f4f48;
    }

    /* Navigation Arrows */
    .popup-overlay .nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 30px;
        height: 30px;
        border: none;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 5px 15px rgba(0, 0, 0, .15);
        cursor: pointer;
        z-index: 90;
        font-size: 16px;
        transition: .3s;
    }

    .popup-overlay .nav-btn:hover {
        transform: translateY(-50%) scale(1.1);
    }

    .popup-overlay .prev-btn {
        left: 15px;
    }

    .popup-overlay .next-btn {
        right: 15px;
    }

    /* Scrollbar */
    .popup-content::-webkit-scrollbar {
        width: 8px;
    }

    .popup-content::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 10px;
    }

    /* Mobile */
    @media(max-width:768px) {

        .popup-overlay {
            padding: 10px;
        }

        .popup-overlay .popup-content {
            width: 95vw;
            max-height: 92vh;
            border-radius: 18px;
        }

        .popup-overlay .popup-image {
            max-height: 95vh;
        }

        .popup-overlay .popup-body {
           padding: 4px;
        width: 410px;
        left: 75px;
        margin: 0 auto;
        }

        .popup-overlay .close-btn {
            width: 30px;
            height: 30px;
            font-size: 13px;
        }

        .popup-overlay .nav-btn {
            width: 30px;
            height: 30px;
            font-size: 13px;
        }

        .popup-overlay .read-more-btn {
            width: 45%;
            padding: 5px;
        }

        .popup-overlay .slider-indicator {

            gap: 7px;
        }
    }
</style>

<!-- Popup -->
<div class="popup-overlay" id="popupOverlay" aria-hidden="true">

    <div class="popup-content" tabindex="-1" role="dialog" aria-modal="true" aria-label="Promotional popup">

        <!-- Screen-reader announcements -->
        <div id="popupAnnouncer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

        <!-- Close -->
        <div class="popup-header">
            <button class="close-btn" onclick="closePopup()" aria-label="Close popup">✕</button>
        </div>

        <!-- Prev -->
        <button class="nav-btn prev-btn" onclick="prevPopup()" aria-label="Previous slide">❮</button>

        <!-- Next -->
        <button class="nav-btn next-btn" onclick="nextPopup()" aria-label="Next slide">❯</button>

        <!-- Image -->
        <img id="popupImage" class="popup-image" src="" alt="" role="img">

        <!-- Body -->
        <div class="popup-body">

            <div id="expiredNotice" class="expired-notice" style="display:none;" role="alert">
                ✓ This offer has expired
            </div>

            <a id="readMoreBtn" class="read-more-btn" href="" target="_blank" aria-label="Read more about this offer (opens in new tab)">
                Click Here To Read →
            </a>

            <button id="playPauseBtn" class="play-pause-btn" onclick="togglePlayPause()" aria-label="Pause slideshow">
                ❚❚
            </button>

            <div class="slider-indicator">

                <span id="popupCounter" aria-live="polite"></span>

                <div id="dotsContainer" role="tablist" aria-label="Slide navigation"></div>

            </div>

        </div>

    </div>

</div>

<script>
    // Sample Popup Data
    const popupData = [
        
        
        
        
         {
            id: 11,
            image:
                "https://jsblpune.bank.in/images/WebSiteImg_Janata Bank Safe Deposit Locker Notice.png",
            link: "https://jsblpune.bank.in/encyc/2026/10/19/Janata-Bank-Safe-Deposit-Locker-Notice_202610191047028877.pdf",
            expiryDate: "2026-11-1",
            active: true,
        },
        
        
        
        
        
         {
            id: 1,
            image:
                "https://jsblpune.bank.in/images/WebSiteImg_key-recruitment-crit.jpg",
            link: "",
            expiryDate: "2026-09-18",
            active: true,
        },
        
         {
            id: 1,
            image:
                "https://jsblpune.bank.in/images/WebSiteImg_indapur-tender-related.jpg",
            link:
                "https://jsblpune.bank.in//Encyc/2026/9/17/indapur-branch-shifting-tender-notice.html",
            expiryDate: "2026-09-30",
            active: true,
        },
        
        
         {
            id: 9,
            image:
                "https://jsblpune.bank.in/images/WebSiteImg_jsbad.jpg",
            link:
                "",
            expiryDate: "2026-09-16",
            active: true,
        },
        
        
        
        
        
        
        
   
        
        {
            id: 9,
            image:
                "https://jsblpune.bank.in/images/WebSiteImg_jsbhindi11.jpg",
            link:
                "https://jsblpune.bank.in/Encyc/2026/5/29/Dedicated-Helpline-Final-Branch-hindi_202605291456474071.pdf",
            expiryDate: "2026-09-30",
            active: true,
        },
        {
            id: 7,
            image:
                "https://jsblpune.bank.in/images/WebSiteImg_jsbenglish1.jpg",
            link:
                "https://jsblpune.bank.in/Encyc/2026/5/29/Dedicated-Helpline-Final-Branch-english_202605291457012358.pdf",
            expiryDate: "2026-09-30",
            active: true,
        },




    ];

    let currentPopupIndex = 0;
    let popupTimer;
    let lastFocusedElement = null;
    let isPlaying = true;

    const AUTO_SLIDE_INTERVAL = 10000;

    const popupOverlay = document.getElementById("popupOverlay");
    const popupContent = document.querySelector(".popup-content");
    const closeButton = document.querySelector(".close-btn");

    // =========================
    // INITIALIZE
    // =========================
    function initPopup() {
        filterActivePopups();

        if (popupData.length > 0) {
            showPopup(0);
            createDotIndicators();
            startAutoSlide();
        }
    }

    // =========================
    // FILTER EXPIRED
    // =========================
    function filterActivePopups() {
        const today = new Date().toISOString().split("T")[0];

        popupData.forEach((popup) => {
            if (popup.expiryDate < today) {
                popup.active = false;
            }
        });
    }

    function getActivePopups() {
        return popupData.filter((p) => p.active);
    }

    // =========================
    // SHOW POPUP
    // =========================
    function showPopup(index) {
        const activePopups = getActivePopups();

        if (activePopups.length === 0) return;

        currentPopupIndex = index % activePopups.length;

        const popup = activePopups[currentPopupIndex];

        // Store previous focus
        lastFocusedElement = document.activeElement;

        document.getElementById("popupImage").src = popup.image;
        document.getElementById("popupImage").alt = "Slide " + (currentPopupIndex + 1) + " of " + activePopups.length;

        // Read More Button
        const readMoreBtn = document.getElementById("readMoreBtn");

        if (popup.link && popup.link.trim() !== "") {
            readMoreBtn.href = popup.link;
            readMoreBtn.classList.remove("hidden");
        } else {
            readMoreBtn.classList.add("hidden");
        }

        // Expiry Notice
        const today = new Date().toISOString().split("T")[0];
        const expiredNotice = document.getElementById("expiredNotice");

        if (popup.expiryDate < today) {
            expiredNotice.style.display = "block";
        } else {
            expiredNotice.style.display = "none";
        }

        // Counter
        document.getElementById(
            "popupCounter"
        ).textContent = `${currentPopupIndex + 1} / ${activePopups.length}`;

        updateDotIndicators();

        // Show Modal
        popupOverlay.classList.add("active");

        // Accessibility
        popupOverlay.setAttribute("aria-hidden", "false");
        popupContent.setAttribute("role", "dialog");
        popupContent.setAttribute("aria-modal", "true");
        popupContent.setAttribute("aria-label", "Slide " + (currentPopupIndex + 1) + " of " + activePopups.length);

        // Announce slide change to screen readers
        announceToScreenReader("Showing slide " + (currentPopupIndex + 1) + " of " + activePopups.length);

        // Move focus inside popup
        setTimeout(() => {
            closeButton.focus();
        }, 100);
    }

    // =========================
    // CREATE DOTS
    // =========================
    function createDotIndicators() {
        const activePopups = getActivePopups();
        const dotsContainer = document.getElementById("dotsContainer");

        dotsContainer.innerHTML = "";

        activePopups.forEach((_, index) => {
            const dot = document.createElement("span");

            dot.className = "dot-indicator";
            dot.setAttribute("role", "tab");
            dot.setAttribute("tabindex", "0");
            dot.setAttribute("aria-label", "Go to slide " + (index + 1));
            dot.setAttribute("aria-selected", "false");

            dot.onclick = () => {
                clearInterval(popupTimer);
                showPopup(index);
                startAutoSlide();
            };

            dot.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    dot.click();
                }
            });

            dotsContainer.appendChild(dot);
        });
    }

    // =========================
    // UPDATE DOTS
    // =========================
    function updateDotIndicators() {
        const dots = document.querySelectorAll(".dot-indicator");

        dots.forEach((dot, index) => {
            dot.classList.remove("active");
            dot.setAttribute("aria-selected", "false");
            dot.setAttribute("tabindex", "-1");

            if (index === currentPopupIndex) {
                dot.classList.add("active");
                dot.setAttribute("aria-selected", "true");
                dot.setAttribute("tabindex", "0");
            }
        });
    }

    // =========================
    // AUTO SLIDE
    // =========================
    function startAutoSlide() {
        clearInterval(popupTimer);

        if (!isPlaying) return;

        popupTimer = setInterval(() => {
            const activePopups = getActivePopups();

            showPopup((currentPopupIndex + 1) % activePopups.length);
        }, AUTO_SLIDE_INTERVAL);
    }

    // =========================
    // PLAY / PAUSE TOGGLE
    // =========================
    function togglePlayPause() {
        const btn = document.getElementById("playPauseBtn");

        isPlaying = !isPlaying;

        if (isPlaying) {
            btn.innerHTML = "&#10074;&#10074;";
            btn.setAttribute("aria-label", "Pause slideshow");
            announceToScreenReader("Slideshow resumed");
            startAutoSlide();
        } else {
            btn.innerHTML = "&#9654;";
            btn.setAttribute("aria-label", "Play slideshow");
            announceToScreenReader("Slideshow paused");
            clearInterval(popupTimer);
        }
    }

    // =========================
    // SCREEN READER ANNOUNCEMENT
    // =========================
    function announceToScreenReader(message) {
        const announcer = document.getElementById("popupAnnouncer");

        if (announcer) {
            // Clear then set to trigger re-announcement
            announcer.textContent = "";
            setTimeout(() => {
                announcer.textContent = message;
            }, 50);
        }
    }

    // =========================
    // CLOSE POPUP
    // =========================
    function closePopup() {
        popupOverlay.classList.remove("active");

        popupOverlay.setAttribute("aria-hidden", "true");

        clearInterval(popupTimer);

        // Restore focus
        if (lastFocusedElement) {
            lastFocusedElement.focus();
        }
    }

    // =========================
    // CLICK OUTSIDE CLOSE
    // =========================
    popupOverlay.addEventListener("click", function (e) {
        if (e.target === this) {
            closePopup();
        }
    });

    // =========================
    // ACCESSIBILITY
    // =========================

    document.addEventListener("keydown", function (e) {
        if (!popupOverlay.classList.contains("active")) return;

        // ESC CLOSE
        if (e.key === "Escape") {
            closePopup();
            return;
        }

        // LEFT ARROW — previous slide
        if (e.key === "ArrowLeft") {
            e.preventDefault();
            prevPopup();
            return;
        }

        // RIGHT ARROW — next slide
        if (e.key === "ArrowRight") {
            e.preventDefault();
            nextPopup();
            return;
        }

        // SPACE — toggle play/pause (only when not on an interactive element that uses Space)
        if (e.key === " ") {
            const activeEl = document.activeElement;
            const isOnInteractive = activeEl && (
                activeEl.tagName === "INPUT" ||
                activeEl.tagName === "TEXTAREA" ||
                activeEl.tagName === "SELECT" ||
                activeEl.getAttribute("role") === "tab"
            );
            if (!isOnInteractive) {
                e.preventDefault();
                togglePlayPause();
                return;
            }
        }

        // FOCUS TRAP
        if (e.key === "Tab") {
            const focusableElements = popupOverlay.querySelectorAll(
                'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
            );

            const firstElement = focusableElements[0];
            const lastElement =
                focusableElements[focusableElements.length - 1];

            // SHIFT + TAB
            if (e.shiftKey) {
                if (document.activeElement === firstElement) {
                    e.preventDefault();
                    lastElement.focus();
                }
            }
            // TAB
            else {
                if (document.activeElement === lastElement) {
                    e.preventDefault();
                    firstElement.focus();
                }
            }
        }
    });
    function nextPopup() {
        clearInterval(popupTimer);

        const activePopups = getActivePopups();

        showPopup(
            (currentPopupIndex + 1) %
            activePopups.length
        );

        startAutoSlide();
    }

    function prevPopup() {
        clearInterval(popupTimer);

        const activePopups = getActivePopups();

        showPopup(
            (currentPopupIndex - 1 + activePopups.length) %
            activePopups.length
        );

        startAutoSlide();
    }

    // =========================
    // INIT
    // =========================
    window.addEventListener("load", initPopup);
</script></div>
	</div>	
   </div>
                                    </div>
                                 
	
