            <link href="https://api.mapbox.com/mapbox-gl-js/v3.8.0/mapbox-gl.css" rel="stylesheet">
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.8.0/mapbox-gl.js"></script>

    <script>
        var map_indexes = [];

        var action = "";
        var data = {};
        data["page_no"] = '1';

        $(document).ready(function () {
            // Initial filter
            filterData();
            action = "inactive";
        });


        function filterData(){
            var selectedCity = $(".city-filter.active").data("city");
            var selectedYear = $(".year-filter").val();
            var hasResults = false;

            selectedYear = selectedYear == 'year' ? '' : selectedYear;
            map_indexes = [];
            data["page_no"] = $("#page_no").val();
            data['city'] = selectedCity;
            data['year'] = selectedYear;

            $.ajax({
                type: "POST",
                dataType:"json",
                url: "https://www.supremeuniversal.com/legacy/data",
                global: false,
                data:{
                    'page_no': data['page_no'],
                    'city': data['city'],
                    'year': data['year'],
                    'last_page': '0'
                },
                headers: {
                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content') // Include CSRF token
                },
                success: function(result) {
                    if(result["status"] == true){

                        if(result["data"]){
                            if(result["page_no"] == 2){
                                $("#data-container").html(result["data"]);
                                //load map data
                                loadLocations(result['globalLocations']);
                            }else{
                                $("#data-container").append(result["data"]);
                            }
                        }else{
                            $("#data-container").html(result['message']);
                        }

                        $("#total_count").val(result["total_count"]);

                    }else{
                        $("#data-container").html(result['message']);
                    }

                    refreshSmoother();

                    $("#page_no").val(result["page_no"]);
                    if(result["show_more"] == 0){
                        action = 'active';
                        $("#load-more").hide();
                    }
                    if(result["show_more"] == 1){
                        action = 'inactive';
                        $("#load-more").show();
                    }
                },
                error: function() {
                    $("#data-container").html("Failed to load the data");
                }
            });

        }

        $("#load-more").click(function() {
            filterData();
        });

        // Handle city button click
        $(".city-filter").click(function () {
            $(".city-filter").removeClass("active");
            $(this).addClass("active");
            $("#page_no").val(1);
            $(".year-filter").val("");
            filterData();

            var city_name = $(".city-filter.active").data("city");

            //Set the year filter
            var yearsByCity = {"Mumbai":["2025","2024","2023","2020","2018","2017","2016","2014","2010","2009","2008","2007","2006","2005","2003-2004","2002","1999-2001","1998","1997","1996","1995","1993-1994","1988-1992","1987","1985-1986","1984"],"Pune":["2025","2023","2016","2015","2013","2012","2008"]};
            
            
            var $yearSelect = $(".year-filter");

            // Clear existing options and set default
            $yearSelect.empty();
            $yearSelect.append('<option value="year">Year</option>');

            // Populate options for selected city
            if (yearsByCity[city_name]) {
                yearsByCity[city_name].forEach(function (year) {
                    $yearSelect.append('<option value="' + year + '">' + year + '</option>');
                });
            }
        });

        // Handle year dropdown change
        $(".year-filter").change(function () {
            $("#page_no").val(1);
            filterData();
        });


        // const globalLocations = [];
        
        let map = null;
        let activeMarkers = [];

        mapboxgl.accessToken = "pk.eyJ1Ijoic3dldGFoZXB0YSIsImEiOiJjbXQ5cWttaXkwYXYyMnpzYjdzcmNmMDBvIn0.u8Utcm2UG_mzM6QDtwbsNw";

        map = new mapboxgl.Map({
            container: "map", // The HTML container ID
            style: "mapbox://styles/mapbox/dark-v11", // Mapbox style
            center: [0, 0], // Initial center of the map
            zoom: 2, // Initial zoom level
        });

        function loadLocations(globalLocations){
            // Remove existing markers, if any
            activeMarkers.forEach((marker) => marker.remove());
            activeMarkers = [];

            if (globalLocations.length > 0) {
                const bounds = new mapboxgl.LngLatBounds();
                globalLocations.forEach((location) => {
                    const newMarker = new mapboxgl.Marker({
                            color: "red"
                        })
                        .setLngLat(location.coordinates)
                        .addTo(map);

                    activeMarkers.push(newMarker);
                    bounds.extend(location.coordinates);

                    map.fitBounds(bounds, {
                        padding: {
                            top: 50,
                            bottom: 50,
                            left: 50,
                            right: 50
                        },
                        maxZoom: 12,
                    });
                });
            }

        }

    </script>

