    <script>
        document.addEventListener("DOMContentLoaded", function () {


            const currentPageId = window.PROJECT_ID || "22926";

            const maxSubmissionAllowed = 6;
            const blockDuration = 24 * 60 * 60 * 1000; // 24 hours

            function getStorageKey(formId) {
                return "cf7_submit_limit_project_" + currentPageId + "_form_" + formId;
            }

            function getSubmissionData(storageKey) {
                const data = localStorage.getItem(storageKey);

                if (!data) {
                    return {
                        count: 0,
                        firstSubmitTime: null
                    };
                }

                try {
                    return JSON.parse(data);
                } catch (e) {
                    localStorage.removeItem(storageKey);
                    return {
                        count: 0,
                        firstSubmitTime: null
                    };
                }
            }

            function saveSubmissionData(storageKey, data) {
                localStorage.setItem(storageKey, JSON.stringify(data));
            }

            function getRemainingTime(firstSubmitTime) {
                const now = new Date().getTime();
                const timePassed = now - firstSubmitTime;
                return blockDuration - timePassed;
            }

            function formatRemainingTime(ms) {
                const totalMinutes = Math.ceil(ms / (1000 * 60));
                const hours = Math.floor(totalMinutes / 60);
                const minutes = totalMinutes % 60;

                if (hours > 0) {
                    return hours + " hour(s) " + minutes + " minute(s)";
                }

                return minutes + " minute(s)";
            }

            function blockForm(formWrapper, remainingTime) {
                if (!formWrapper) return;

                const form = formWrapper.querySelector("form");

                if (form) {
                    form.style.display = "none";
                }

                if (!formWrapper.querySelector(".cf7-submit-limit-message")) {
                    const message = document.createElement("div");
                    message.className = "cf7-submit-limit-message";
                    message.innerHTML =
                        "You have already submitted this form 6 times on this page. Please try again after " +
                        formatRemainingTime(remainingTime) +
                        ".";

                    formWrapper.appendChild(message);
                }
            }

            function allowForm(formWrapper) {
                if (!formWrapper) return;

                const form = formWrapper.querySelector("form");

                if (form) {
                    form.style.display = "";
                }

                const message = formWrapper.querySelector(".cf7-submit-limit-message");

                if (message) {
                    message.remove();
                }
            }

            function checkFormLimit(formWrapper) {
                const formIdInput = formWrapper.querySelector('input[name="_wpcf7"]');

                if (!formIdInput) return;

                const formId = formIdInput.value;
                const storageKey = getStorageKey(formId);

                const submissionData = getSubmissionData(storageKey);

                if (!submissionData.firstSubmitTime) {
                    allowForm(formWrapper);
                    return;
                }

                const remainingTime = getRemainingTime(submissionData.firstSubmitTime);

                if (remainingTime <= 0) {
                    localStorage.removeItem(storageKey);
                    allowForm(formWrapper);
                    return;
                }

                if (submissionData.count >= maxSubmissionAllowed) {
                    blockForm(formWrapper, remainingTime);
                } else {
                    allowForm(formWrapper);
                }
            }

            // Check all CF7 forms on page load
            document.querySelectorAll(".wpcf7").forEach(function (formWrapper) {
                checkFormLimit(formWrapper);
            });

            // After successful CF7 submission
            document.addEventListener("wpcf7mailsent", function (event) {

                const formId = event.detail.contactFormId;
                const storageKey = getStorageKey(formId);

                let submissionData = getSubmissionData(storageKey);
                const now = new Date().getTime();

                // Start 24-hour window from first successful submission
                if (!submissionData.firstSubmitTime) {
                    submissionData.firstSubmitTime = now;
                }

                submissionData.count = parseInt(submissionData.count || 0) + 1;

                saveSubmissionData(storageKey, submissionData);

                const remainingTime = getRemainingTime(submissionData.firstSubmitTime);

                // If the same CF7 form appears more than once, update all same form instances
                document.querySelectorAll(".wpcf7").forEach(function (formWrapper) {

                    const formIdInput = formWrapper.querySelector('input[name="_wpcf7"]');

                    if (!formIdInput) return;

                    if (String(formIdInput.value) === String(formId)) {
                        if (submissionData.count >= maxSubmissionAllowed && remainingTime > 0) {
                            blockForm(formWrapper, remainingTime);
                        }
                    }

                });

            }, false);

        });
    </script>
