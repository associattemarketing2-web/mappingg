6d40":"blog-builder","474ee948-702b-4c0f-970e-b5319eff6d8b":"blog-builder","ada94d8c-4889-444e-b773-f1a875693fdb":"blog-builder","bd5dc6d6-7a0d-48d5-99da-457340ce6f2d":"blog-builder","edee3dc6-161e-4650-9f9f-c6093b4f88c4":"blog-builder","30856e5a-ad99-4f4f-a362-5697f8ef5d7f":"blog-builder","7d10ae29-fb0a-4361-8bc0-c3b8a3b96e34":"blog-builder","2aaff717-a69c-4967-b59c-d181bf02ec8d":"blog-builder","66b4159e-4d31-44b8-a769-82de85b8017c":"blog-builder","f6db360b-5c5c-4ceb-aa5c-e422562bb535":"blog-builder","cfe0d874-88a8-4466-ba78-1e3050ea6640":"blog-builder","0a58971f-220d-4849-9107-3b67bee7d8af":"blog-builder","2e0ac7c1-e22c-4c8a-a67f-9c56fa3128ba":"blog-builder","50886b2a-2f47-42d4-a203-f8d783c4d87b":"blog-builder","e4dc216a-a280-4031-8356-cc251eefe1c9":"blog-builder"}},{"appId":"1484cb44-49cd-5b39-9681-75188ab429de","isWixTPA":true,"monitoringComponent":{"monitoring":{"type":"PANORAMA","panoramaOptions":{"project":{"groupId":"com.wixpress","artifactId":"site-search-builder","fingerprint":"54c27bc95c64b4cd10c8c9c684b2f008546faa5186ba7413bf89fb79"}}}},"panoramaConfigByArtifactId":{"site-search-builder":{"type":"PANORAMA","panoramaOptions":{"project":{"groupId":"com.wixpress","artifactId":"site-search-builder","fingerprint":"54c27bc95c64b4cd10c8c9c684b2f008546faa5186ba7413bf89fb79"}}}},"externalIdByComponentId":{"8244af1e-c249-4dd6-9308-e59e9d03556d":"site-search-builder","b2afa946-9e97-4922-ad55-0f69e9ca482d":"search-results-builder"}}]},"assetsLoader":{"isStylableComponentInStructure":true,"hasBuilderComponents":false},"businessLoggerService":{},"businessLogger":{"isBuilderComponentModel":false},"codeEmbed":{"htmlEmbeds":[{"id":"2d6d7308-7bb1-478f-9947-2618523feaf8","embedType":"custom","position":"head","loadOnce":true,"content":{"type":"custom","html":"<!-- Google Tag Manager -->\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https:\/\/www.googletagmanager.com\/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-K5RVRQJQ');<\/script>\n<!-- End Google Tag Manager -->","category":{"enumClass":"com.wixpress.live.site.data.types.CustomContentCategory","value":"ESSENTIAL"}},"domain":"mittalbrothers.com","name":"Google Tag"},{"id":"c728b7c4-2293-42b4-b455-d026c23e9329","embedType":"custom","position":"head","loadOnce":false,"content":{"type":"custom","html":"<script async src=\"https:\/\/www.googletagmanager.com\/gtag\/js?id=G-V6F2E9RXML\"><\/script>\n<script>\n    !function(w, a) {\n        let isInitializing = true;\n        const eventBuffer = [];\n        w.dataLayer = w.dataLayer || [];\n\n        function gtag(){\n            if (isInitializing) {\n                eventBuffer.push(arguments);\n            } else {\n                dataLayer.push(arguments);\n            }\n        }\n\n        function config() {\n                gtag('config', 'G-V6F2E9RXML', { send_page_view: false });\n        }\n\n        w.document.addEventListener(\"consentPolicyChanged\", ({ detail }) => {\n            setConsent('update', detail.policy);\n        });\n\n\n        w.document.addEventListener(\"consentPolicyInitialized\", ({ detail }) => {\n            const config = w.wixTagManager?.getConfig();\n            if (isInitializing && config && Object.keys(config).length) {\n                onDoneInitilizing();\n            }\n        });\n\n        w.addEventListener(\"TagManagerConfigSet\", ({ detail }) => {\n            if (isInitializing && w.consentPolicyManager?.initRan) {\n                onDoneInitilizing();\n            }\n        });\n\n        function onDoneInitilizing() {\n            isInitializing = false;\n            setConsent('default', evaluateConsentPolicy());\n            gtag('js', new Date());\n            gtag('set', 'developer_id.dYzMzMD', true);\n            config();\n            eventBuffer.forEach(args => gtag(...args));\n        }\n\n        function evaluateConsentPolicy() {\n            const { gdprEnforcedGeo } = w.wixTagManager.getConfig();\n            const { policy, defaultPolicy } = w.consentPolicyManager.getCurrentConsentPolicy();\n            return defaultPolicy && gdprEnforcedGeo\n                ? { ...policy, advertising: false, analytics: false }\n                : policy\n        }\n\n        function setConsent(action, { advertising, analytics, functional, waitForUpdate }) {\n            gtag('consent', action, {\n                'ad_storage': advertising ? 'granted' : 'denied',\n                'ad_user_data': advertising ? 'granted' : 'denied',\n                'ad_personalization': advertising ? 'granted' : 'denied',\n                'analytics_storage': analytics ? 'granted' : 'denied',\n                'functionality_storage': functional ? 'granted' : 'denied',\n                'personalization_storage': 'granted',\n                'security_storage': 'granted',\n                ...waitForUpdate ? { 'wait_for_update': waitForUpdate } : {}\n            });\n        }\n\n        w[a] = (w[a] && w[a].filter(c => c.name !== 'googleAnalyticsConsentMode')) || [];\n        w[a].push({\n            name: 'googleAnalyticsConsentMode',\n            report: gtag,\n            config: {\n                trackingId: 'G-V6F2E9RXML'\n            }\n        });\n    }(window,\"promoteAnalyticsChannels\")\n<\/script>\n"},"domain":"mittalbrothers.com","name":"Google Tag (Advanced Consent Mode)"},{"id":"235d769d-ca63-489a-98b3-c0ed076ffbec","embedType":"custom","position":"head","loadOnce":true,"content":{"type":"custom","html":"```html\n<script src=\"https:\/\/cdn.jsdelivr.net\/gh\/Coalitionify\/acolead-client-lib\/dist\/acolead.iife.js\" defer><\/script>\n\n<script>\n(function () {\n\"use strict\";\n\nif (window.__ACO_V5__) return;\nwindow.__ACO_V5__ = true;\n\nconst ACOLEAD_ID = \"1f03e0b6-0964-6ab0-be2e-73e4fd51e784\";\n\nlet savedLead = null;\nlet lastSent = 0;\nlet lastButton = null;\nlet lastCapture = 0;\nlet sending = false;\n\n\n\/* =========================\n   HELPERS\n========================= *\/\n\nfunction clean(v) {\n  return (v || \"\").toString().trim();\n}\n\nfunction visible(el) {\n  if (!el) return false;\n  try {\n    const r = el.getBoundingClientRect();\n    const s = getComputedStyle(el);\n    return r.width > 0 &&\n           r.height > 0 &&\n           s.display !== \"none\" &&\n           s.visibility !== \"hidden\";\n  } catch(e) {\n    return true;\n  }\n}\n\n\n\/* =========================\n   PROJECT FROM URL\n========================= *\/\n\nfunction urlProject() {\n  const p = location.pathname.toLowerCase();\n\n  if (p.includes(\"skyhigh-tower\") ||\n      p.includes(\"sky-high-tower\") ||\n      p.includes(\"sky-high-towers\") ||\n      p.includes(\"skyhightowers\"))\n    return \"Sky High Towers\";\n\n  if (p.includes(\"arcvista\"))\n    return \"ArcVista\";\n\n  if (p.includes(\"akshardham\"))\n    return \"Akshardham\";\n\n  if (p.includes(\"bhandup\"))\n    return \"Bhandup - PAP\";\n\n  if (p.includes(\"oneplace-baner\"))\n    return \"One Place Baner\";\n\n  if (p.includes(\"oneplace-fc-road\") ||\n      p.includes(\"one-place-fc-road\"))\n    return \"One Place FC Road\";\n\n  if (p.includes(\"oneplace-wanowrie\"))\n    return \"One Place Wanowrie\";\n\n  if (p.includes(\"oneplace-wakad\"))\n    return \"One Place Wakad\";\n\n  return \"\";\n}\n\n\n\/* =========================\n   FORM ROOT\n========================= *\/\n\nfunction formRoot(btn) {\n  let p = btn;\n\n  for (let i = 0; i < 15 && p; i++, p = p.parentElement) {\n    try {\n      const fields = [...p.querySelectorAll(\"input,textarea\")]\n        .filter(visible);\n\n      const drops = [...p.querySelectorAll(\n        '[data-hook=\"dropdown-base-text\"],[role=\"combobox\"],select'\n      )].filter(visible);\n\n      if (fields.length >= 2 || drops.length)\n        return p;\n    } catch(e) {}\n  }\n\n  return document;\n}\n\n\n\/* =========================\n   PROJECT\n========================= *\/\n\nfunction project(root) {\n  const drops = [...root.querySelectorAll(\n    '[data-hook=\"dropdown-base-text\"],[role=\"combobox\"],select'\n  )].filter(visible);\n\n  for (const d of drops) {\n    const v = clean(\n      d.value ||\n      d.innerText ||\n      d.textContent ||\n      d.getAttribute(\"aria-label\")\n    );\n\n    if (v && ![\n      \"choose one\",\n      \"choose project\",\n      \"select one\",\n      \"select project\",\n      \"please select\",\n      \"please choose\",\n      \"select\",\n      \"choose\"\n    ].includes(v.toLowerCase())) {\n      console.log(\"[ACOLEAD] PROJECT DROPDOWN:\",v);\n      return v;\n    }\n  }\n\n  const u = urlProject();\n\n  if (u)\n    console.log(\"[ACOLEAD] PROJECT URL:\",u);\n\n  return u;\n}\n\n\n\/* =========================\n   FIELD\n========================= *\/\n\nfunction field(root,type) {\n  const fields = [...root.querySelectorAll(\"input,textarea\")]\n    .filter(visible);\n\n  const found = fields.filter(el => {\n    const t = clean(el.type).toLowerCase();\n    const n = clean(el.name).toLowerCase();\n    const p = clean(el.placeholder).toLowerCase();\n    const a = clean(el.getAttribute(\"aria-label\")).toLowerCase();\n\n    if (type === \"email\")\n      return t === \"email\" ||\n             n.includes(\"email\") ||\n             p.includes(\"email\") ||\n             a.includes(\"email\");\n\n    if (type === \"phone\")\n      return t === \"tel\" ||\n             n.includes(\"phone\") ||\n             n.includes(\"mobile\") ||\n             n.includes(\"contact\") ||\n             p.includes(\"phone\") ||\n             p.includes(\"mobile\") ||\n             a.includes(\"phone\") ||\n             a.includes(\"mobile\");\n\n    return n.includes(\"name\") ||\n           n.includes(\"first\") ||\n           p.includes(\"name\") ||\n           a.includes(\"name\");\n  });\n\n  const filled = found.filter(x => clean(x.value));\n\n  return filled.length\n    ? clean(filled[filled.length - 1].value)\n    : \"\";\n}\n\n\n\/* =========================\n   PHONE\n========================= *\/\n\nfunction phone(v) {\n  v = clean(v).replace(\/[^\\d+]\/g,\"\");\n\n  if (v.startsWith(\"+91\")) return v;\n\n  if (v.startsWith(\"0091\"))\n    return \"+\" + v.substring(2);\n\n  if (\/^\\d{10}$\/.test(v))\n    return \"+91\" + v;\n\n  return v;\n}\n\n\n\/* =========================\n   CAPTURE LEAD\n========================= *\/\n\nfunction capture(btn) {\n  const root = formRoot(btn);\n\n  const lead = {\n    name: field(root,\"name\"),\n    mobileNumber: phone(field(root,\"phone\")),\n    requirement: project(root),\n    email: field(root,\"email\"),\n    company: \"\",\n    type: \"ENQUIRY\"\n  };\n\n  console.log(\"[ACOLEAD] CAPTURED:\",lead);\n\n  if (\n    lead.name ||\n    lead.mobileNumber ||\n    lead.email\n  ) {\n    savedLead = lead;\n  }\n\n  return lead;\n}\n\n\n\/* =========================\n   SUBMIT BUTTON DETECTION\n========================= *\/\n\nfunction submitButton(path) {\n\n  for (const el of path || []) {\n\n    if (!el || el.nodeType !== 1) continue;\n\n    const hook = clean(\n      el.getAttribute(\"data-hook\")\n    ).toLowerCase();\n\n    const type = clean(\n      el.getAttribute(\"type\")\n    ).toLowerCase();\n\n    const role = clean(\n      el.getAttribute(\"role\")\n    ).toLowerCase();\n\n    const text = clean(\n      el.innerText || el.textContent\n    ).toLowerCase();\n\n    const aria = clean(\n      el.getAttribute(\"aria-label\")\n    ).toLowerCase();\n\n    if (hook === \"submit-button\" ||\n        type === \"submit\")\n      return el;\n\n    if (\n      role === \"button\" &&\n      (\n        text.includes(\"submit\") ||\n        text.includes(\"send\") ||\n        text.includes(\"request\") ||\n        text.includes(\"demo\") ||\n        text.includes(\"enquire\") ||\n        text.includes(\"inquire\") ||\n        text.includes(\"contact\")\n      )\n    )\n      return el;\n\n    if (\n      (\n        el.tagName === \"BUTTON\" ||\n        el.tagName === \"A\"\n      ) &&\n      (\n        text.includes(\"submit\") ||\n        text.includes(\"send\") ||\n        text.includes(\"request a demo\") ||\n        text.includes(\"request demo\") ||\n        text.includes(\"get started\") ||\n        text.includes(\"enquire\") ||\n        text.includes(\"inquire\") ||\n        text.includes(\"contact us\")\n      )\n    )\n      return el;\n\n    if (\n      aria.includes(\"submit\") ||\n      aria.includes(\"send\") ||\n      aria.includes(\"request\")\n    )\n      return el;\n  }\n\n  return null;\n}\n\n\n\/* =========================\n   SAVE FROM EVENT\n========================= *\/\n\nfunction handle(event) {\n  try {\n    const path = event.composedPath\n      ? event.composedPath()\n      : [];\n\n    const btn = submitButton(path);\n\n    if (!btn) return;\n\n    const now = Date.now();\n\n    if (\n      btn === lastButton &&\n      now - lastCapture < 1000\n    ) return;\n\n    lastButton = btn;\n    lastCapture = now;\n\n    console.log(\n      \"[ACOLEAD] SUBMIT DETECTED:\",\n      event.type\n    );\n\n    capture(btn);\n\n  } catch(e) {\n    console.error(\"[ACOLEAD] DETECTION ERROR:\",e);\n  }\n}\n\n\n\/* =========================\n   SEND TO CRM\n========================= *\/\n\nfunction send() {\n\n  if (sending) return;\n\n  if (!savedLead) {\n    console.log(\"[ACOLEAD] NO LEAD\");\n    return;\n  }\n\n  const lead = savedLead;\n\n  if (\n    !lead.name &&\n    !lead.mobileNumber &&\n    !lead.email\n  ) {\n    console.error(\"[ACOLEAD] EMPTY LEAD\");\n    return;\n  }\n\n  if (!lead.requirement) {\n    console.error(\"[ACOLEAD] PROJECT NOT FOUND\");\n    return;\n  }\n\n  if (Date.now() - lastSent < 2000)\n    return;\n\n  if (\n    !window.AcoLead ||\n    typeof window.AcoLead.submitEnquiry !== \"function\"\n  ) {\n    console.log(\"[ACOLEAD] LIBRARY LOADING...\");\n\n    setTimeout(send,500);\n    return;\n  }\n\n  try {\n\n    sending = true;\n    lastSent = Date.now();\n\n    console.log(\n      \"[ACOLEAD] SENDING TO CRM:\",\n      lead\n    );\n\n    window.AcoLead.submitEnquiry(\n      ACOLEAD_ID,\n      lead.name,\n      lead.mobileNumber,\n      lead.requirement,\n      lead.email,\n      lead.company\n    );\n\n    console.log(\n      \"[ACOLEAD] SENT SUCCESSFULLY\"\n    );\n\n    savedLead = null;\n    lastButton = null;\n\n    setTimeout(() => {\n      sending = false;\n    },2500);\n\n  } catch(e) {\n\n    sending = false;\n\n    console.error(\n      \"[ACOLEAD] SEND ERROR:\",\n      e\n    );\n  }\n}\n\n\n\/* =========================\n   POINTER\n========================= *\/\n\ndocument.addEventListener(\n  \"pointerdown\",\n  handle,\n  true\n);\n\n\n\/* =========================\n   TOUCH\n========================= *\/\n\ndocument.addEventListener(\n  \"touchstart\",\n  handle,\n  true\n);\n\n\n\/* =========================\n   CLICK\n========================= *\/\n\ndocument.addEventListener(\n  \"click\",\n  function(event) {\n\n    handle(event);\n\n    setTimeout(\n      send,\n      50\n    );\n\n  },\n  true\n);\n\n\n\/* =========================\n   FORM SUBMIT\n========================= *\/\n\ndocument.addEventListener(\n  \"submit\",\n  function(event) {\n\n    try {\n\n      console.log(\n        \"[ACOLEAD] FORM SUBMIT EVENT\"\n      );\n\n      const form = event.target;\n\n      let btn =\n        event.submitter ||\n        form.querySelector(\n          '[data-hook=\"submit-button\"],button[type=\"submit\"],input[type=\"submit\"],button'\n        ) ||\n        form;\n\n      capture(btn);\n\n      setTimeout(\n        send,\n        50\n      );\n\n    } catch(e) {\n\n      console.error(\n        \"[ACOLEAD] FORM ERROR:\",\n        e\n      );\n\n    }\n\n  },\n  true\n);\n\n\n\/* =========================\n   READY\n========================= *\/\n\nconsole.log(\n  \"[ACOLEAD] READY:\",\n  location.href\n);\n\n})();\n<\/script>\n```","category":{"enumClass":"com.wixpress.live.site.data.types.CustomContentCategory","value":"ESSENTIAL"}},"domain":"","name":"Custom"},{"id":"07cecba5-5019-490a-839d-2e86d6ec0c55","embedType":"custom","position":"bodyStart","loadOnce":true,"content":{"type":"custom","html":"<!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https:\/\/www.googletagmanager.com\/ns.html?id=GTM-K5RVRQJQ\"\nheight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"><\/iframe><\/noscript>\n<!-- End Google Tag Manager (noscript) -->","category":{"enumClass":"com.wixpress.live.site.data.types.CustomContentCategory","value":"ESSENTIAL"}},"domain":"mittalbrothers.com","name":"Google Tag"}],"shouldLoadRequireJS":true},"componentsRegistry":{"librariesTopology":[{"artifactId":"editor-elements","namespace":"wixui","url":"https:\/\/static.parastorage.com\/services\/editor-elements\/1.15595.0"},{"artifactId":"editor-elements","namespace":"dsgnsys","url":"https:\/\/static.parastorage.com\/services\/editor-elements\/1.15595.0"}]},"consentPolicy":{"isWixSite":false,"isBuilderComponentModel":false},"cyclicTabbing":{"isBuilderComponentModel":false},"dataWixCodeSdk":{"environment":"LIVE","cloudDataUrlWithExternalBase":"https:\/\/www.mittalbrothers.com\/_api\/cloud-data"},"editorWixCodeSdk":{"isBuilderComponentModel":false},"elementorySupportWixCodeSdk":{"baseUrl":"https:\/\/www.mittalbrothers.com\/_api\/wix-code-public-dispatcher-ng\/siteview","relativePath":"\/\/_api\/wix-code-public-dispatcher-ng\/siteview","viewMode":"site","siteRevision":1517},"environmentWixCodeSdk":{},"environment":{"editorType":"","domain":"mittalbrothers.com","previewMode":false,"isBuilderComponentModel":false},"fedopsWixCodeSdk":{"isWixSite":false,"shouldReportFedops":false},"lightbox":{"prefixToRouterFetchData":{},"pageIdToPrefix":{},"isBuilderComponentModel":false},"locationWixCodeSdk":{"routersConfigMap":{},"urlMappings":null},"mpaNavigation":{"forceMpaNavigation":false,"isRunning