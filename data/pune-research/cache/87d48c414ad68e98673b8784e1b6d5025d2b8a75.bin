_2026.jpeg"},{"id":800,"Title":"Moneycontrol","url":"https://www.moneycontrol.com/news/business/markets/puravankara-shares-rise-3-5-as-company-secures-rs-2-600-crore-redevelopment-project-in-mumbai-s-goregaon-west-14032200.html"}]}}]},"__N_SSP":true},"page":"/","query":{},"buildId":"y55JGKsP_bLiLytFnaMCK","isFallback":false,"dynamicIds":[98515,27200,4278,89922,11915,62865,89014,40824],"gssp":true,"scriptLoader":[]}</script><script src="/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js" data-cf-settings="159c462ea6594df0a0c729b7-|49" defer></script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092" integrity="sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==" data-cf-beacon='{"version":"2024.11.0","token":"0def3336a86a4d74b2cb3789a0e12f1b","spa":2}' crossorigin="anonymous"></script>
