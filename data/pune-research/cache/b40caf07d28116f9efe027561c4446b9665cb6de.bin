    @media (max-width: 767px) {
        #contact-page #buying #form-block {
            margin-right: 0;
            margin-left: 0;
        }

        #contact-page #buying #form-block>.col,
        #contact-page #buying #form-block>[class*=col-] {
            padding-right: 0;
            padding-left: 0;
        }
    }
</style>
