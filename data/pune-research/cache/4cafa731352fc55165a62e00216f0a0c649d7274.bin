                            <br><br>
                            <label for="newsletter-off" class="fs-15 mb-20px"><input class="w-auto me-10px position-relative top-1px p-0" type="checkbox" id="newsletter-off" name="newsletter-off" required>I authorize Gagan Developers and it’s representatives to Call, SMS, RCS,  Email or WhatsApp me about it’s products and offers. This consent overrides any registration for NDC/NDNC.</label>


                            <button type="submit" class="btn btn-base-color btn-medium btn-round-edge btn-box-shadow">Send Message</button>
                        </form>

                        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

                        <script>
                            $(document).ready(function() {
                                function submitEnquiryForm(formId) {
                                    $(formId).submit(function(event) {
                                        event.preventDefault(); // Prevent default form submission

                                        $.ajax({
                                            url: "gagan-klara-submit_form.php",
                                            type: "POST",
                                            data: $(this).serialize(),
                                            dataType: "json",
                                            success: function(response) {
                                                console.log(response); // Check response in browser console
                                                if (response.status === "success") {
                                                    window.location.href = "thank-you.php"; // Redirect if successful
                                                } else {
                                                    alert("Error : " + response.message);
                                                }
                                            },
                                            error: function(xhr, status, error) {
                                                console.log("XHR Response: ", xhr.responseText); // Log full response
                                                alert("Failed to connect to the server.");
                                            }
                                        });
                                    });
                                }

                                // Apply function to both forms
                                submitEnquiryForm("#enquiry-form"); // Bottom form
                                submitEnquiryForm("#popup-enquiry-form"); // Pop-up form

                            });
                        </script>

                        <!-- end contact form -->
                    </div>
                </div>
            </div>
        </div>
