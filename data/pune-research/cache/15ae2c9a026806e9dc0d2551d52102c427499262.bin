<script>
    $(".videotab img, #videotab .item img, a[href='#co_video'], #cv .carousel-item img, #team .item img, .al img").click(function() {
        var a = $(this).attr('data-src');
        var b = $(this).next("h6").text();
        var c = $(this).next("p").text();
        //alert(c);
        $("#v_section").modal();

        $("#v_section .modal-body").html("<iframe id='popup-youtube-player' width='100%' height='450' src='https://www.youtube.com/embed/" + a + "?enablejsapi=1&version=3' frameborder='0' allowfullscreen></iframe>");
        if (b) {
            $("#v_section .modal-title").text(b);
        } else if (c) {
            $("#v_section .modal-title").text(c);
        } else {
            $("#v_section .modal-title").text('Corporate Video');
        }


    });

    function jump() {
        $("#v_section .modal-body").html("");
    }
</script>

