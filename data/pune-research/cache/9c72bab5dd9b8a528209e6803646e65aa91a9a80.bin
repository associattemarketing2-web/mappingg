<div id="shopify-section-sections--22552458887417__new_announcementbar_Fq4WMP" class="shopify-section shopify-section-group-header-group metal-price-bar-section"><style data-shopify>:root {
--metal-price-bar-height: 3.5rem;
}

.metal-price-bar {
display: block;
transition: background-color 0.3s ease;
}

.metal-price-bar--bg-image {
background-size: cover;
background-position: center center;
background-repeat: no-repeat;
background-color:#0C3761;
}

.metal-price-bar__inner {
display: grid;
grid-template-columns: 1fr auto 1fr;
grid-template-areas: "prices announcement links";
align-items: center;
gap: 1.6rem;
font-size: 1.3rem;
min-height: var(--metal-price-bar-height);
box-sizing: border-box;
}

.metal-price-bar__prices {
grid-area: prices;
justify-self: start;
display: flex;
align-items: center;
gap: 0.8rem;
min-width: 0;
color: inherit;
text-decoration: none;
}

.metal-price-bar__fade {
position: relative;
display: block;
height: 2rem;
overflow: hidden;
min-width: 15rem;
}

.metal-price-bar__price {
position: absolute;
top: 50%;
left: 0;
display: flex;
align-items: center;
gap: 0.6rem;
opacity: 0;
transition: opacity 0.6s ease
, transform 0.6s ease;
white-space: nowrap;
}

.metal-price-bar__price.is-active {
opacity: 1;
transform: translateY(-50%);
}

.metal-price-bar__label {
color: #C9A84C;
font-family: var(--font-family-body);
font-size: 10px;
font-style: normal;
font-weight: 400;
line-height: normal;
}

.metal-price-bar__value,
.metal-price-bar__unit {
color: #E8D5BC;
leading-trim: both;
text-edge: cap;
font-family: var(--font-family-body);
font-size: 10px;
font-style: normal;
font-weight: 400;
line-height: normal;
}

.metal-price-bar__live {
display: inline-flex;
align-items: center;
gap: 0.6rem;
white-space: nowrap;
color: #F5F1EB;
font-family: "Helvetica Neue";
font-size: 12px;
font-style: normal;
font-weight: 400;
line-height: normal;
letter-spacing: 0.48px;
}

.metal-price-bar__live-dot {
width: 0.7rem;
height: 0.7rem;
border-radius: 50%;
background: #2ecc71;
animation: metalPriceLivePulse 1.6s ease-in-out infinite;
}

@keyframes metalPriceLivePulse {
0,
100% {
opacity: 1;
box-shadow: 0 0 0 0 rgba(46, 204, 113, 0.6);
}
50% {
opacity: 0.6;
box-shadow: 0 0 0 0.4rem rgba(46, 204, 113, 0);
}
}

.metal-price-bar__marquee {
display: none;
overflow: hidden;
width: 100%;
}

.metal-price-bar__marquee-track {
display: flex;
width: max-content;
animation: metalPriceMarquee var(--marquee-duration, 25s) linear infinite;
}

.metal-price-bar__marquee-group {
display: flex;
align-items: center;
flex-shrink: 0;
padding-right: 2rem;
}

.metal-price-bar__marquee-item {
white-space: nowrap;
font-weight: 600;
display: flex;
gap: 1.2rem;
}
.metal-price-bar__marquee-item span:first-child {
color: #FECD5B;
font-family: "Helvetica Neue";
font-size: 10px;
font-style: normal;
font-weight: 400;
line-height: normal;
letter-spacing: 0.4px;
display: flex;
align-items: center;
}
.metal-price-bar__marquee-item span:last-child {
color: #CDB89B;
font-family: "Helvetica Neue";
font-size: 10px;
font-style: normal;
font-weight: 400;
line-height: normal;
letter-spacing: 0.4px;
}

.metal-price-bar__marquee-sep {
margin: 0 1rem;
opacity: 0.6;
}

.metal-price-bar__marquee-item--live {
display: inline-flex;
align-items: center;
gap: 0.5rem;
margin-left: 1rem;
color: #FCF2F2;
font-family: "Helvetica Neue";
font-size: 10px;
font-style: normal;
font-weight: 400;
line-height: normal;
letter-spacing: 0.4px;
}

@keyframes metalPriceMarquee {
from {
transform: translateX(0);
}
to {
transform: translateX(-50%);
}
}

.metal-price-bar__announcement {
grid-area: announcement;
justify-self: center;
position: relative;
min-height: 2rem;
min-width: 30rem;
overflow: hidden;
text-align: center;
}

.metal-price-bar__announcement-item {
position: absolute;
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
opacity: 0;
transition: opacity 0.6s ease;
white-space: nowrap;
color: #F5F4F4;
font-family: var(--font-family-body);
font-size: 10px;
font-style: normal;
font-weight: 400;
line-height: normal;
}

.metal-price-bar__announcement-item.is-active {
opacity: 1;
}

.metal-price-bar__announcement-link {
color: inherit;
text-decoration: none;
}

.metal-price-bar__links {
grid-area: links;
justify-self: end;
display: flex;
align-items: center;
gap: 0.8rem;
margin: 0;
padding: 0;
list-style: none;
white-space: nowrap;
}

.metal-price-bar__links-item:not(:last-child)::after {
content: '|';
margin-left: 0.8rem;
opacity: 0.5;
}

.metal-price-bar__links-link {
color: #F5F4F4;
font-family: var(--font-family-body);
font-size: 10px;
font-style: normal;
font-weight: 400;
line-height: normal;
text-decoration:none;
}

.metal-price-bar__links-item--has-popover {
position: relative;
}

.metal-rates-popover {
display: none;
position: absolute;
top: calc(100% + 1.2rem);
left:1rem;
right: 0;
z-index: 20;
width: 28rem;
max-width: 90vw;
padding: 2rem;
border-radius: 1.2rem;
background: #fff;
box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.18);
color: #1A120B;
text-align: left;
white-space: normal;
}

.metal-price-bar__links-item--has-popover:hover .metal-rates-popover,
.metal-price-bar__links-item--has-popover:focus-within .metal-rates-popover {
display: block;
}

.metal-rates-popover__heading {
margin: 0 0 1.2rem;
font-family: var(--font-family-heading);
font-size: 1.8rem;
font-weight: 600;
text-align: center;
}

.metal-rates-popover__list {
margin: 0;
}

.metal-rates-popover__row {
display: flex;
align-items: center;
justify-content: space-between;
padding: 1rem 0;
border-bottom: 0.1rem solid rgba(26, 18, 11, 0.08);
}

.metal-rates-popover__row:last-child {
border-bottom: none;
}

.metal-rates-popover__label,
.metal-rates-popover__value {
margin: 0;
font-family: var(--font-family-body);
font-size: 1.4rem;
}

.metal-rates-popover__value {
font-weight: 600;
}

.metal-rates-popover__disclaimer,
.metal-rates-popover__updated {
margin: 0.4rem 0 0;
text-align: center;
font-size: 1.1rem;
color: rgba(26, 18, 11, 0.6);
}

.metal-rates-popover__disclaimer {
margin-top: 1.6rem;
font-weight: 600;
}

@media screen and (max-width: 749px) {
:root {
--metal-price-bar-height: 3.5rem;
}

.metal-price-bar__fade,
.metal-price-bar__live {
display: none;
}

.metal-price-bar__marquee {
display: none;
flex: 1;
min-width: 0;
}
.metal-price-bar__inner {
padding: 0.4rem 0;
display: block;
min-height: unset;
}

.metal-price-bar__links {
display: none;
}
.metal-price-bar__announcement-item {
font-size: 12px;
}
}

@media (prefers-reduced-motion: reduce) {
.metal-price-bar__marquee-track {
animation: none;
}

.metal-price-bar__announcement-item {
transition: none;
}

.metal-price-bar__price {
transition: opacity 0.3s ease;
transform: none;
}
