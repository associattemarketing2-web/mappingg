                            <div class="c-about-us-profile-card__items__item open-about-modal col-md-4 col-sm-12 mr-0" data-full-designation="Director" data-designation="committee---stakeholders-relationship" data-profileSrc="https://cdn.bajajauto.com/-/media/assets/bajajauto/about-us/bajaj-team/board-of-directors/new/desktop/niraj-r.jpg" data-bs-toggle="modal">

