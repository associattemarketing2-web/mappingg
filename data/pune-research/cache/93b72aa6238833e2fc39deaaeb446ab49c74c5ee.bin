<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script type="text/javascript">
$("#submit1").click(function(){
	var name3=$("#name3").val();
	var email3=$("#email3").val();
	var phone3=$("#phone3").val();
	var project3=$("#project3").val();
	var message3=$("#message3").val();
   //var g_recaptcha=$("#g-recaptcha-response").val();
   let g_recaptcha = grecaptcha.getResponse(contact_r);

    
	if(!name3)
	{
		$("#error1").html('Enter your name');
		return false;
	}
	if(!email3)
	{
		$("#error1").html('Enter your email');
		return false;
	}
	if(!phone3)
	{
		$("#error1").html('Enter your phone');
		return false;
	}
	if(!project3)
	{
		$("#error1").html('Please select project that you are interested in');
		return false;
	}
	if(!message3)
	{
		$("#error1").html('Enter your message');
		return false;
	}
	$("#submit1").html('<i class="fa fa-spinner fa-pulse fa-fw"></i> Loading..');

    $.ajax({
    type: "POST",
    url: "https://naiknavare.com/sendmail",
    data:$("#contactform").serialize(),
    success: function(response){
    	console.log(response);
    	
    	if (response.status == 1) {
             //alert("Your data has been sent successfully");
             $("#contactform").trigger("reset");
             $("#error1").html("");
             window.location.href='https://naiknavare.com/thanku_page';
             
           }else if (response.status == 0) {
            alert("Something went wrong..! please check");
            $("#submit1").html('Submit');
         }else{
         	$("#submit1").html('Submit');
         	alert(response);
         }
      }
    });    
});
</script>


