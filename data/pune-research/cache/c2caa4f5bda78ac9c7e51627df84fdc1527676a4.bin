                  <script>
$(function() {
	$(".homsldr").cycle({fx:"scrollHorz",log:"false",timeout:3000,speed:2000,easing:"easeOutQuart",swipe:true,slides:">div",pager:"#banpgr"}).on('cycle-before', function (event, opts) {$('#frmevid iframe').attr('src', '').hide();
               $('#frmevid .closevid').fadeOut(200);$('.vidbg').hide();
             $('#frmevid .playvdo').show(); }).on('cycle-after', function (event, opts) {});
	$('a.playpause').click(function (e) {e.preventDefault();var slideshow=$(".homsldr");slideshow.is(".cycle-paused")?(slideshow.cycle("resume"),$(this).removeClass("paused")):(slideshow.cycle("pause"),$(this).addClass("paused"));
	});
    
    $('.playvdo').on('click', function (e) {
       e.preventDefault();
       $('iframe', $(this).parent()).attr('src', $('iframe', $(this).parent()).attr('data-src')).height($(this).parent().height()).show();

       $('.playvdo', $(this).parent()).fadeOut(800);
       $('.closevid', $(this).parent()).fadeIn(800);
        $('.vidbg').show();

   });
   // video close triggers //
   $('.closevid').on('click', function (e) {
       e.preventDefault();
       $('iframe', $(this).parent()).attr('src', '').hide();
       $('.playvdo', $(this).parent()).fadeIn(800);
       $('.closevid', $(this).parent()).fadeOut(200);
       $('.vidbg').hide();
       $('.homsldr').cycle('resume'); 
       $('.playpause').removeClass('paused');
   });
    
    $('.playvdo').on('click', function (e) {
         e.preventDefault();
       $('.homsldr').cycle('pause');
       $('.playpause').addClass('paused');
      });
    
    
        


});
