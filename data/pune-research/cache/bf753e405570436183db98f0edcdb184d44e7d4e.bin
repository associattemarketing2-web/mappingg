					</div>
				</div>
				<div class="col-12 col-sm-6">
					<div class="form-group">
						<label for="city">City *</label>
						<input type="text" class="form-control required" placeholder="Enter City" name="city" id="enquiryCity">
						<div class="error-msg" id="errenquiryCity"></div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-12 col-sm-6">
					<div class="form-group">
						<label for="pincode">Pincode *</label>
						<input type="text" name="enquirypincode" id="enquirypincode" class="form-control required" placeholder="Pincode">
						<div class="error-msg" id="errenquiryPincode"></div>
					</div>
				</div>
				<div class="col-12 col-sm-6">
