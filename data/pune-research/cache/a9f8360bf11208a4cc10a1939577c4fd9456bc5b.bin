ription\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3kEdevECN4ky6OwQO3YZyL/efc32dfb200ea89f09f41cadfa0f87b7/Partners-Page.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Strategic collaborations power better outcomes. Together with our partners, we help clients unlock efficiency, scale smarter, and stay ahead.\"},{\"label\":\"Awards and Recognition\",\"href\":\"/about-us/awards-and-recognitions\",\"image\":{\"title\":\"awards\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/71VBhym1sHq41bLUmdBt8L/b5636afc612528acd68d27a002a3bb4a/awards.png\",\"mediaType\":\"image/png\"},\"infoText\":\"From innovation to excellence, see how our work has been recognized by global analysts, partners, and industry leaders.\"},{\"label\":\"Sustainability\",\"href\":\"/about-us/sustainability\",\"image\":{\"title\":\"Sustainability\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/7y7u2xENlB7RMbX1WHgkkb/d76d98ed17c0912c6af08d5b54d6963e/Sustainability.png\",\"mediaType\":\"image/png\"},\"infoText\":\"From design to delivery, we're committed to solutions that care for the business, communities, and the environment.\"},{\"label\":\"CSR\",\"href\":\"/about-us/corporate-social-responsibility\",\"image\":{\"title\":\"CSR-1\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3XY1xKIbmanqwVmkqu9gwZ/1bd50b123f9ceaaba25a34379b7e31bb/CSR-1.jpg\",\"mediaType\":\"image/jpeg\"},\"infoText\":\"We use the power of technology, compassion, and community to build more inclusive, equitable, and empowered futures. \"}]},{\"label\":\"What We Do\",\"identifier\":\"Footer\",\"submenu\":[{\"label\":\"Application Services\",\"href\":\"/tech-services/enterprise-applications\",\"image\":{\"title\":\"Overview of enterprise application services for Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/7D6lrGrPUZEf4i3lZdo446/174e76a8c146f3594cd5409d067aa55c/Services_0005s_0005_ApplicationService.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Manage, modernize, and scale apps with services that enhance performance, usability, and integration across the enterprise.\"},{\"label\":\"Artificial Intelligence\",\"href\":\"/tech-services/artificial-intelligence\",\"image\":{\"title\":\"Professional demonstrating augmented reality and AI technology\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3iFjYbI4glxbFMHd58IaWh/4a1c0854e6fe9e5d3cc6a70ea4392512/Services_0005s_0000_AI.png\",\"mediaType\":\"image/png\"},\"infoText\":\"By turning data into actionable insights, our Al solutions unlock growth, boost efficiency, and power intelligent decision-making.\"},{\"label\":\"Cloud, Infrastructure, and Security\",\"href\":\"/tech-services/cloud-infrastructure-and-security\",\"image\":{\"title\":\"Abstract representation of AI-native cloud infrastructure and security\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/1K4eTzxHE6dg6kicalU2LL/37880bf2bd87fdeef2cc8848f4c21993/Mobile_Banner_CIS_page.jpg\",\"mediaType\":\"image/jpeg\"},\"infoText\":\"Transform operations with intelligent cloud, robust infrastructure, and secure-by-design solutions that build trust and scale value.\"},{\"label\":\"Data Engineering and Analytics\",\"href\":\"/tech-services/data-analytics-and-ai\",\"image\":{\"title\":\"Abstract representation of data analytics services for enterprise\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/wPONFxrJCu1UregHQbxLa/50cf4073c33fe759c6e3eeeaebcdea10/Services_0005s_0003_Data-and-analysis.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Drive smarter decisions with modern data practices - governance, AI, and products that turn insight into impact.\"},{\"label\":\"Marketing and Engagement\",\"href\":\"/tech-services/marketing-and-engagement\",\"image\":{\"title\":\"Marketing and engagement services overview\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/2j0vDwJelfU1g76dzldlbJ/6df01f14d794e558d07fbc46458269ef/Services_0005s_0002_Marketing-and-Engagement.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Blend strategy, storytelling, and design to connect with audiences in meaningful, timely, and measurable ways.\"},{\"label\":\"Product and Platforms\",\"href\":\"/tech-services/product-and-platforms\",\"image\":{\"title\":\"Digital products and platforms interface with scalable enterprise solutions\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3l0yNMrpX5hm1WXqEfRSs8/0e99012a88c56534ec39f4090a1c3a76/Services_0005s_0001_Product-and-platform.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Accelerate growth with next-gen engineering that transforms products, platforms, and possibilities across the lifecycle.\"}]},{\"label\":\"Industries We Empower\",\"identifier\":\"Footer\",\"submenu\":[{\"label\":\"Banking and Financial Services\",\"href\":\"/industries/banking-and-financial-services\",\"image\":{\"title\":\"Person using a smartwatch while interacting with a digital kiosk in a tech service context\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/gNmX1FtIqTEbT0jkGfLuY/18307f6639de6b6ab1e2cd1287096b4c/Industries_0004s_0005_BFS.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Powering secure, personalized experiences that make banking faster, smarter, and more connected.\",\"subMenuItems\":[{\"label\":\"Cards and Payments\",\"buttonUrl\":\"/industries/banking-and-financial-services/cards-and-payments\"},{\"label\":\"Lending\",\"buttonUrl\":\"/industries/banking-and-financial-services/lending\"}]},{\"label\":\"Consumer Services\",\"href\":\"/industries/consumer-services\",\"image\":{\"title\":\"Person shopping with multiple colorful bags and checking a phone in a festive setting.\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/54inF5fqyEnkpQ4mD2QTkQ/dcb4a3bff0bc44beb514b0ceda664f58/Industries_0004s_0003_Consumer-Services.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Building brand loyalty through immersive, personalized, and tech-forward consumer experiences.\"},{\"label\":\"Healthcare and Life Sciences\",\"href\":\"/industries/healthcare-and-life-sciences\",\"image\":{\"title\":\"Professional in a lab coat using a tablet in a laboratory setting with colorful glassware.\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3oi0GGxqRnMnW5pSxYPmSf/ab476b29abc1ca5e30c9e576c1b4f148/Industries_0004s_0004_HLS.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Enabling better care with data-led, intelligent solutions that improve outcomes and accelerate innovation.\"},{\"label\":\"Insurance\",\"href\":\"/industries/insurance-technology-solutions\",\"image\":{\"title\":\"Insurance technology solutions driving digital transformation at Zensar\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/fzkMmaz4IsPDZrQ4hnLag/2dd7dae10372a04fac11116c1d36517c/mobile-Insurance.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Modernizing insurance with cloud, AI, and customer-first strategies that drive trust and efficiency.\",\"subMenuItems\":[{\"label\":\" Guidewire Services\",\"buttonUrl\":\"/industries/insurance-technology-solutions/insurance-guidewire-services\"}]},{\"label\":\"Manufacturing\",\"href\":\"/industries/manufacturing-technology-solutions\",\"image\":{\"title\":\"Automated assembly of a circuit board using precision tools in a tech service environment.\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/XahCV1kYQq7VXmlmjPyhR/8c0d91f5eb179706db4a3acf35487467/Industries_0004s_0002_Manufacturing.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Smarter factories, faster innovation - leveraging AI, IoT, and cloud to transform how manufacturing works.\"},{\"label\":\"Hi Tech\",\"href\":\"/industries/hi-tech\",\"image\":{\"title\":\"Digital screens displaying various concepts related to AI and digital transformation\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/5z7pJc67UNBfoaZZPCQ78m/f5bc4bae277b83b7776af149d19aacdf/Industries_0004s_0001_TMT.jpg\",\"mediaType\":\"image/jpeg\"},\"infoText\":\"Enabling Intelligent Hi Tech Organizations with Agile, AI-Driven Solutions.\"},{\"label\":\"Public Sector\",\"href\":\"/industries/public-sector\",\"image\":{\"title\":\"thumb-banner\",\"description\":\"\",\"url\":\"//imag