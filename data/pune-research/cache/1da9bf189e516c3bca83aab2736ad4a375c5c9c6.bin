<script>
    $(".form-group.custom-range-slider").each(function() {
        var $wrapper = $(this);
        var $range = $wrapper.find(".properties-range-slider");
        var $from = $wrapper.find(".from");
        var $to = $wrapper.find(".to");

        var min = +$range.data("min");
        var max = +$range.data("max");
        var from = +$from.val() || min;
        var to = +$to.val() || max;

        // Function to update input values
        var updateValues = function() {
            $from.val(from);
            $to.val(to);
        };

        // Initialize ionRangeSlider
        $range.ionRangeSlider({
            skin: "round",
            type: "double",
            min: min,
            max: max,
            from: from,
            to: to,
            grid: false,
            onChange: function(data) {
                from = data.from;
                to = data.to;
                updateValues();
            }
        });

        // Get slider instance
        var rangeInstance = $range.data("ionRangeSlider");

        // Update slider from inputs
        var updateRange = function() {
            rangeInstance.update({
                from: from,
                to: to
            });
        };

        $from.on("input", function() {
            from = +$(this).val();
            if (from < min) from = min;
            if (from > to) from = to;
            updateValues();
            updateRange();
        });

        $to.on("input", function() {
            to = +$(this).val();
            if (to > max) to = max;
            if (to < from) to = from;
            updateValues();
            updateRange();
        });
    });
</script>
<script>
    function allowOnlyLetters(selector) {
        const elements = document.querySelectorAll(selector);
        elements.forEach(function(el) {
            el.addEventListener('input', function() {
                this.value = this.value.replace(/[^A-Za-z\s]/g, '');
            });
        });
    }

    // Call the function for inputs with class 'only-letters'
    allowOnlyLetters('.only-letters');
</script>

<script>
    /** Sanitize Text Start */

    $(document).on("input paste keyup", ".only-letters", function() {
        const sanitizedValue = sanitizeInput($(this).val());
        $(this).val(sanitizedValue);
    });


    function sanitizeInput(input) {
        function escapeRegExp(str) {
            return str.replace(/[.*+?^=!:${}()|[\]\\]/g, '\\$&');
        }

        const dangerousCommands = [
            'rm', 'shutdown', 'reboot', 'mkfs', 'dd', 'wget', 'curl',
            '.sh', '.exe', '.bat', '.cmd', '.js', '.vbs', '.php', '.pl', '.asp', '.jsp', '.cgi',
            '|', ';', '&', '||', '`', '>', '<', '$', '(', ')', '{', '}'
        ];

        const sqlInjectionPatterns = [
            /\b(SELECT|INSERT|UPDATE|DELETE|DROP|UNION|ALTER|CREATE|TRUNCATE|GRANT|REVOKE|JOIN|HAVING|WHERE|LIKE|EXISTS)\b/gi,
            /--/g,
            /\bOR\b.*\b1=1\b/gi,
            /\bAND\b.*\b1=1\b/gi,
            /' OR '.*'='.*'/g,
            /' AND '.*'='.*'/g,
            /'\s+OR\s+\d+=\d+/g,
            /\bEXEC\b/gi,
            /\bXP_CMDSHELL\b/gi,
        ];

        const scriptRegex = /<script.*?>.*?<\/script>/gi;
        const extensionRegex = /\.(exe|sh|bat|cmd|js|vbs|php|pl|asp|jsp|cgi)$/gi;

        dangerousCommands.forEach(cmd => {
            const escapedCmd = escapeRegExp(cmd);
            const regex = new RegExp(`\\b${escapedCmd}\\b`, 'gi');
            input = input.replace(regex, '');
        });

        input = input.replace(scriptRegex, '').replace(extensionRegex, '');

        sqlInjectionPatterns.forEach(pattern => {
            input = input.replace(pattern, '');
        });

        input = input.replace(/[^a-zA-Z0-9\s\(\)'",\-_.@+/]/g, '');
        return input;
    }
    /** Sanitize Text End */
</script>
<script>
  // awards slider
  setTimeout(() => {
  new Splide('#awards-slider', {
    gap: '40px',
    type: 'splide',
    perPage: 3,
    perMove: 1,
    pagination: false,
    breakpoints: {
      1024: {
        perPage: 2,
      },
      575: {
        perPage: 1,
      },
    },
  }).mount();
}, 2000);

</script>
</body>

</html>