                <div class='right-section'>
                                <div class="w-650">
                <div class="c-about-us-profile-card">
                    <div class="c-about-us-profile-card__heading">
                        <div class="c-about-us-profile-card__heading__title">
                            <h1 class="header-aboutus">Bajaj Team</h1>
                        </div>
                            <div class="c-about-us-profile-card__heading__filter">
                                <select class="about-us-filter">
                                            <option value="board-of-directors" data-role=True>Board of Directors</option>
                                            <option value="management-team" data-role=False>Management Team</option>
