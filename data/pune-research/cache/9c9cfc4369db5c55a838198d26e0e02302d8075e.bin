    <script>
        (function () {
            function initComingSoonPopup() {
                var overlay = document.getElementById('coming-soon-popup-overlay');
                if (!overlay) return;
                var steps = overlay.querySelectorAll('.coming-soon-popup-step');
                var current = 0;

                function next() {
                    steps[current].hidden = true;
                    current++;
                    if (current < steps.length) {
                        steps[current].hidden = false;
                    } else {
                        overlay.classList.remove('show');
                    }
                }

                setTimeout(function () {
                    overlay.classList.add('show');
                }, 1200);

                overlay.querySelectorAll('.coming-soon-popup-close').forEach(function (btn) {
                    btn.addEventListener('click', next);
                });

                overlay.addEventListener('click', function (e) {
                    if (e.target === overlay) next();
                });
            }
    
            if (document.readyState === 'complete') {
                initComingSoonPopup();
            } else {
                window.addEventListener('load', initComingSoonPopup);
            }
        })();
    </script>
    
