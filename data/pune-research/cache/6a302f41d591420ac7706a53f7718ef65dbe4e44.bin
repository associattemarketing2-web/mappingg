    <style>
@keyframes countUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes shimmer{0%{background-position:200% center}100%{background-position:-200% center}}
.ce-wrap{
  background:
    linear-gradient(180deg, rgba(10,10,10,0.55), rgba(10,10,10,0.72)),
    url('data:image/jpeg;base64,') center/cover no-repeat;
  border-radius:16px;padding:0;overflow:hidden;border:1px solid rgba(255,255,255,0.15);
}
.ce-top{padding:20px 32px 0;text-align:center;}
.ce-top-label{font-size:11px;letter-spacing:0.18em;color:#E8D8A8;text-transform:uppercase;font-weight:500;}
.ce-grid{display:grid;grid-template-columns:repeat(4,1fr);}
.ce-card{text-align:center;padding:2rem 1rem 2.2rem;animation:countUp 0.7s cubic-bezier(.22,.68,0,1.2) forwards;opacity:0;position:relative;}
.ce-card:not(:last-child)::after{content:'';position:absolute;right:0;top:25%;height:50%;width:1px;background:rgba(255,255,255,0.25);}
.ce-num{font-size:clamp(28px,5vw,48px);font-weight:600;line-height:1;display:inline-block;background:linear-gradient(135deg,#F0D98C 0%,#FFEAA8 40%,#E8C766 60%,#C9A84C 100%);background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:shimmer 4s linear infinite;}
.ce-suf{font-size:clamp(14px,2.5vw,26px);font-weight:600;background:linear-gradient(135deg,#F0D98C,#E8C766);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.ce-label{font-size:11px;color:rgba(255,255,255,0.75);margin-top:10px;letter-spacing:0.1em;text-transform:uppercase;}
.ce-line{height:1px;background:linear-gradient(to right,transparent,#C9A84C,transparent);margin:0 32px;}
.ce-footer{text-align:center;padding:12px;font-size:11px;letter-spacing:0.12em;background:linear-gradient(135deg,#F0D98C,#E8C766);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;font-weight:500;}
@media(max-width:768px){
  .ce-grid{grid-template-columns:repeat(2,1fr);}
  .ce-card:nth-child(2)::after{display:none;}
  .ce-card:nth-child(4)::after{display:none;}
  .ce-card:nth-child(1),
  .ce-card:nth-child(2){border-bottom:1px solid rgba(255,255,255,0.2);}
  .ce-card:nth-child(1)::after{display:block;}
  .ce-card:nth-child(3)::after{display:block;}
}
@media(max-width:400px){
  .ce-top-label{font-size:9px;letter-spacing:0.1em;}
  .ce-label{font-size:9px;}
  .ce-card{padding:1.4rem 0.5rem 1.6rem;}
}
</style>

<div class="ce-wrap" itemscope itemtype="https://schema.org/Organization">
  <meta itemprop="name" content="Ceratec Group" />
  <meta itemprop="foundingDate" content="1999" />
  <div class="ce-top"><div class="ce-top-label">Ceratec Group — numbers that speak</div></div>
  <div class="ce-line" style="margin-top:16px;"></div>
  <div class="ce-grid">

    <div class="ce-card" style="animation-delay:0s" itemprop="description" content="26+ years of legacy">
      <div><span class="ce-num" id="c1">26</span><span class="ce-suf">+</span></div>
      <div class="ce-label">Years of legacy</div>
    </div>

    <div class="ce-card" style="animation-delay:.15s">
      <div><span class="ce-num" id="c2">5,000</span><span class="ce-suf">+</span></div>
      <div class="ce-label">Happy families</div>
    </div>

    <div class="ce-card" style="animation-delay:.3s">
      <div><span class="ce-num" id="c3">12</span><span class="ce-suf">+</span></div>
      <div class="ce-label">Projects completed</div>
    </div>

    <div class="ce-card" style="animation-delay:.45s">
      <div><span class="ce-num" id="c4">2.26</span><span class="ce-suf">M sq.ft</span></div>
      <div class="ce-label">Area delivered</div>
    </div>

  </div>
  <div class="ce-line"></div>
  <div class="ce-footer">EXCEEDING EXPECTATIONS — ALWAYS</div>
</div>

<script>
function animateCounter(id, target, duration, decimal) {
  const el = document.getElementById(id);
  const start = performance.now();
  function update(now) {
    const progress = Math.min((now - start) / duration, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    const val = eased * target;
    el.textContent = decimal ? val.toFixed(2) : Math.round(val).toLocaleString('en-IN');
    if (progress < 1) requestAnimationFrame(update);
    else el.textContent = decimal ? target.toFixed(2) : target.toLocaleString('en-IN');
  }
  requestAnimationFrame(update);
}

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      setTimeout(() => animateCounter('c1', 26,   1500, false), 0);
      setTimeout(() => animateCounter('c2', 5000, 2000, false), 150);
      setTimeout(() => animateCounter('c3', 12,   1500, false), 300);
      setTimeout(() => animateCounter('c4', 2.26, 2000, true),  450);
      observer.disconnect();
    }
  });
}, { threshold: 0.3 });

observer.observe(document.querySelector('.ce-wrap'));
</script>
  
  



