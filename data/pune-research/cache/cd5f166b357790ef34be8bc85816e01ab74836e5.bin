<!-- staggering script execution to avoid blocking of the main thread -->

    <script>
    (function() {
        if (typeof jQuery === 'undefined') return;

        var queue = [];
        var processed = false;
        var _originalReady = jQuery.fn.ready;

        function processQueue() {
            if (processed) return;
            processed = true;
            queue.forEach(function(fn, index) {
                setTimeout(function() {
                    try {
                        fn.call(document, jQuery);
                    } catch(e) {
                        console.error('Error in staggered jQuery ready callback:', e);
                    }
                }, index * 20); // 20ms gap between each component 
            });
        }

        // Override $.ready to queue all callbacks
        jQuery.fn.ready = function(fn) {
            if (typeof fn !== 'function') return _originalReady.call(this, fn);
            
            // If the queue has already processed (like scripts loading dynamically 
            // after DOMContentLoaded) execute immediately using native jQuery ready
            if (processed) {
                return _originalReady.call(this, fn);
            }
            
            queue.push(fn);
            return this;
        };

        // Process only if DOM is loaded
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', processQueue);
        } else {
            setTimeout(processQueue, 0);
        }
    })();
    </script>

    
    
    

    

    
    

    
