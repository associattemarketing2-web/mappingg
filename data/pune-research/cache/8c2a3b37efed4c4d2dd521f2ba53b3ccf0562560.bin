        <script type="text/javascript">
        jQuery(document).ready(function($) {
    $('.vc_tta-tabs-list li a').on('click', function(event) {
      event.preventDefault(); // Prevents default anchor scroll
    });

    // Stop jumping by adjusting how tabs are triggered
    $('.vc_tta-tabs-list li a').on('click', function() {
      var tab_id = $(this).attr('href');
      $(tab_id).show().siblings('.vc_tta-panel').hide();
      $(this).parent().addClass('vc_active').siblings().removeClass('vc_active');
    });
  });    </script>
