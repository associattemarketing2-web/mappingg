e\":\"Zensar Technologies\",\"url\":\"https://www.zensar.com/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://images.ctfassets.net/bjl3f17nyta4/6IUeLrHvOQVPUxczuwnpG6/0b21114df102b72adf6e79d941c05e3b/zensar-logo-white.svg\"}},{\"@type\":\"CollectionPage\",\"@id\":\"https://www.zensar.com/about-us/leadership#collectionpage\",\"url\":\"https://www.zensar.com/about-us/leadership\",\"name\":\"Zensar Leadership Team and Board of Directors\",\"description\":\"Meet Zensar Technologies’ Board of Directors and leadership team driving strategy, growth, and digital transformation across global markets.\",\"inLanguage\":\"en-US\",\"image\":{\"@type\":\"ImageObject\",\"@id\":\"https://www.zensar.com/about-us/leadership#primaryimage\",\"url\":\"https://images.ctfassets.net/bjl3f17nyta4/7E9bw8VPgGeH181dtqwkk7/9107372f659b11f5e787d4f92fde1120/mobile-banner.png?fm=webp\u0026q=85\",\"contentUrl\":\"https://images.ctfassets.net/bjl3f17nyta4/7E9bw8VPgGeH181dtqwkk7/9107372f659b11f5e787d4f92fde1120/mobile-banner.png?fm=webp\u0026q=85\",\"name\":\"Zensar Leadership Team Banner\",\"description\":\"Banner image representing Zensar Technologies leadership team and board of directors.\",\"encodingFormat\":\"image/webp\"},\"mainEntity\":{\"@type\":\"ItemList\",\"@id\":\"https://www.zensar.com/about-us/leadership#itemlist\",\"numberOfItems\":17,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/hv-goenka#person\",\"name\":\"H. V. Goenka\",\"url\":\"https://www.zensar.com/about-us/leadership/hv-goenka\",\"jobTitle\":\"Chairman, Non-Executive Director\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/anant-goenka#person\",\"name\":\"Anant Goenka\",\"url\":\"https://www.zensar.com/about-us/leadership/anant-goenka\",\"jobTitle\":\"Vice Chairman, Non-Executive Director\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":3,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/manish-tandon#person\",\"name\":\"Manish Tandon\",\"url\":\"https://www.zensar.com/about-us/leadership/manish-tandon\",\"jobTitle\":\"Chief Executive Officer and Managing Director\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":4,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/ketan-dalal#person\",\"name\":\"Ketan Dalal\",\"url\":\"https://www.zensar.com/about-us/leadership/ketan-dalal\",\"jobTitle\":\"Independent, Non-Executive Director\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":5,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/ben-druskin#person\",\"name\":\"Ben Druskin\",\"url\":\"https://www.zensar.com/about-us/leadership/ben-druskin\",\"jobTitle\":\"Independent, Non-Executive Director\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":6,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/radha-rajappa#person\",\"name\":\"Radha Rajappa\",\"url\":\"https://www.zensar.com/about-us/leadership/radha-rajappa\",\"jobTitle\":\"Independent, Non-Executive Director\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":7,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/u-b-pravin-rao#person\",\"name\":\"U. B. Pravin Rao\",\"url\":\"https://www.zensar.com/about-us/leadership/u-b-pravin-rao\",\"jobTitle\":\"Independent, Non-Executive Director\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":8,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/vijayasimha-alilughatta#person\",\"name\":\"Vijayasimha (Vijay) Alilughatta\",\"url\":\"https://www.zensar.com/about-us/leadership/vijayasimha-alilughatta\",\"jobTitle\":\"Chief Operating Officer\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":9,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/vivek-ranjan#person\",\"name\":\"Vivek Ranjan\",\"url\":\"https://www.zensar.com/about-us/leadership/vivek-ranjan\",\"jobTitle\":\"Chief Human Resources Officer\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":10,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/pulkit-bhandari#person\",\"name\":\"Pulkit Bhandari\",\"url\":\"https://www.zensar.com/about-us/leadership/pulkit-bhandari\",\"jobTitle\":\"Chief Financial Officer\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":11,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/parag-jain#person\",\"name\":\"Parag Jain\",\"url\":\"https://www.zensar.com/about-us/leadership/parag-jain\",\"jobTitle\":\"Executive Vice President and Head - Manufacturing and Consumer Services, and Growth Office\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":12,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/nachiketa-mitra#person\",\"name\":\"Nachiketa (Nachi) Mitra\",\"url\":\"https://www.zensar.com/about-us/leadership/nachiketa-mitra\",\"jobTitle\":\"Executive Vice President and Head - Banking and Financial Services\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":13,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/harish-lala#person\",\"name\":\"Harish Lala\",\"url\":\"https://www.zensar.com/about-us/leadership/harish-lala\",\"jobTitle\":\"Executive Vice President and Head - Telecommunication, Media, and Technology\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":14,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/chaitanya-rajebahadur#person\",\"name\":\"Chaitanya (Chai) Rajebahadur\",\"url\":\"https://www.zensar.com/about-us/leadership/chaitanya-rajebahadur\",\"jobTitle\":\"EVP and Global Leader - Digital Engineering, Consulting, Martech, AI, and Creative Studios\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":15,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/pratik-maroo#person\",\"name\":\"Pratik Maroo\",\"url\":\"https://www.zensar.com/about-us/leadership/pratik-maroo\",\"jobTitle\":\"Senior Vice President and Head - Healthcare and Life Sciences\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":16,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/kaushik-chatterjee#person\",\"name\":\"Kaushik Chatterjee\",\"url\":\"https://www.zensar.com/about-us/leadership/kaushik-chatterjee\",\"jobTitle\":\"Senior Vice President and Head - Africa\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}},{\"@type\":\"ListItem\",\"position\":17,\"item\":{\"@type\":\"Person\",\"@id\":\"https://www.zensar.com/about-us/leadership/anshul-srivastav#person\",\"name\":\"Anshul Srivastav\",\"url\":\"https://www.zensar.com/about-us/leadership/anshul-srivastav\",\"jobTitle\":\"Senior Vice President and Head - UK and Europe\",\"worksFor\":{\"@id\":\"https://www.zensar.com/#organization\"}}}]},\"publisher\":{\"@id\":\"https://www.zensar.com/#organization\"}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.zensar.com/about-us/leadership#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@id\":\"https://www.zensar.com/\",\"name\":\"Home\"}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@id\":\"https://www.zensar.com/about-us\",\"name\":\"About Us\"}},{\"@type\":\"ListItem\",\"position\":3,\"item\":{\"@id\":\"https://www.zensar.com/about-us/leadership\",\"name\":\"Leadership\"}}]}]}7:[\"$\",\"main\",null,{\"id\":\"main\",\"children\":[[\"$\",\"$L31\",null,{\"items\":{\"slug\":\"/about-us/leadership\",\"title\":\"Leadership\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$32\"}}],\"$L33\",\"$undefined\"]}]\n10:null\n14:[[\"$\",\"title\",\"0\",{\"children\":\"Zensar Leadership Team and Board of Directors\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Meet Zensar Technologies’ Board of Directors and leadership team driving strategy, growth, and digital transformation across global markets.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"zensar technologies leadership team, zensar board of directors, zensar management team, h v goenka zensar, manish tandon ceo zensar, zensar executives, technology leadership india, it services leadership\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://www.zensar.com/about-us/leadership\"}],[\"$\",\"meta\",\"4\",{\"name\":\"google-site-verification\",\"content\":\"V0U_UHHI5w5UTjHRyDrjiZdLNivAjGbODGNZ4L4IXEQ\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Zensar Leadership Team and Board of Directors\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Meet Zensar Technologies’ Board of Directors and leadership team driving strategy, growth, and digital transformation across global markets.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:url\",\"content\":\"https://www.zensar.com/about-us/leadership\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image\",\"content\":\"https://images.ctfassets.net/bjl3f17nyta4/5HIShYcat23218CxKhk3hC/cb42673411172856355637e1a82f6120/DEsktopBanner.png\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:title\",\"content\":\"Zensar Leadership Team and Board of Directors\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:description\",\"content\":\"Meet Zensar Technologies’ Board of Directors and leadership team driving strategy, growth, and digital transformation across global markets.\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:image\",\"content\":\"https://images.ctfassets.net/bjl3f17nyta4/5HIShYcat23218CxKhk3hC/cb42673411172856355637e1a82f6120/DEsktopBanner.png\"}]]\n"])</script><script nonce="0nQtGDl9xrQ6Qgj2Y4fziA==">self.__next_f.push([1,"34:T65a,With over 20 years of experience, Anant Goenka is the Vice Chairman of CEAT Limited, one of India’s largest tyre manufacturers, and the Vice Chairman of Zensar Technologies, a leading technology solutions company. He also holds the position of Vice President at the Federation of Indian Chambers of Commerce and Industry (FICCI) and is the former Chairman of the Automotive Tyre Manufacturers’ Association (ATMA). During his tenure as Managing Director and CEO of CEAT from 2012 to 2023, Anant led the company through transformative growth, increasing its market capitalization 25-fold. Under his visionary leadership, CEAT became the first tyre company globally to win the prestigious Deming Grand Prize in 2023 and earned the World Economic Forum’s Lighthouse Certification. Anant’s strategic acumen earned him accolades such as Forbes’ “Next Generation Business Leader of the Year” in 2017, and a spot in Economic Times- Spencer Stuart’s “India’s 40 Under 40 Business Leaders.” He also received the “Kabiller Science of Empathy Prize” from the Kellogg School of Management. Anant’s career also includes notable stints at KEC International and Hindustan Unilever. As an advocate for purpose-driven organizations, Anant has steered the sustainability charter across the RPG Group. His experience, expertise, and deep understanding of climate-related issues are visible through the Group’s commitments on decarbonization and stewardship toward a greener planet. Anant holds an MBA from the Kellogg School of Management and a B.Sc. in Economics from the Wharton School, University of Pennsylvania.35:T562,Ms. Radha is an entrepreneurial business leader with over three decades in executive leadership roles in the technology industry. She has successfully incubated, scaled, and passionately led various businesses in digital transformation and IT products and services. She is an ardent believer of building and nurturing high performance teams and is excited about carving business opportunities with leading edge digital, AI, and cloud technologies. Radha loves cultivating and mentoring startups. She is Executive Chairperson of a new-age industrial IOT startup - Flutura Decision Sciences and Analytics, guiding a talented team to scale the firm to its true potential. She also serves as an External Advisor to Bain and Company and consults with firms in the private equity and technology space on strategy, market acceleration, value creation, and digital transformation. Radha was a member of the India leadership team at Microsoft driving transformation for customers to the cloud and digital world. She served 16 years as a key member of the Executive Leadership team at Mindtree and established Mindtree as a significant partner for global clients in the digital space. She has also served in IBM India in various capacities. Radha holds a degree in Electronics and Communications Engineering and a Management Degree from the Indian Institute of Management (IIM) Bangalore.36:T5fa,U. B. Pravin Rao served as the Chief Operating Officer of Infosys Ltd. and a Whole-time Director of the Board of Infosys Ltd. from 2014 to 2021. Pravin began his career as a Software Engineer Trainee in August 1986 and super-annuated in December 2021. Pravin has over 35 years of industry experience. He has held a number of senior leadership roles at Infosys, including Interim Chief Executive Officer and Managing Director, Head of Infrastructure Management Services, Delivery Head for Europe, and Head of Retail, Consumer Packaged Goods, Logistics, and Life Sciences. As the Chief Operating Officer, U. B. Pravin Rao had overall strategic and operational responsibility for the entire portfolio of the Company’s offerings. He oversaw the key functions of global delivery, HR, and business enablement. Pravin was the Chairperson of Infosys BPM, a subsidiary of the company, from October 2014 to July 2017. As a member of the Board of Infosys Ltd., he was a member of the Stakeholder Relationship Committee and the Corporate Social Responsibility Committee of the Board. Pravin holds a degree in Electrical Engineering from Bangalore University, India. He was a member of the National Council of the Confederation of Indian Industry (CII) from 2015 to 2021. He also serves on the Executive Council of National Association of Software and Service Companies (NASSCOM) since 2015 and was the Chairman of NASSCOM in FY21. He currently serves on the Boards of Axis Finance Limited and Indegene Pvt. Ltd. as an Independent Director. 37:T428,Vijayasimha Alilughatta (Vijay) is the Chief Operating Officer at Zensar and is based out of Bangalore. Over his 27+ years of association with the IT industry, Vijay has focused on client delight, execution excellence, building world-class teams, and delivering industry-leading profitable growth. Before joining Zensar, Vijay worked at Wipro Limited as the COO for the largest global business line comprising over 100K employees. He was instrumental in establishing the overall operating model for this unit and enabling the group to consistently deliver double-digit growth. Before this, he was the Global Delivery Head of the $2.5 billion BFSI unit, pivotal in establishing trust-based partnerships with marquee clients in the BFSI sector. Preceding this, Vijay worked at Infosys for 18 years and held several roles across delivery, practice, pre-sales, and sales. He has successfully scaled many Fortune 500 client accounts into large, fruitful partnerships. Vijay has a Bachelor’s Degree in Computer Science and Engineering from Bangalore University, India.38:T55c,With over 26 years of experience leading HR for diverse workforces, Vivek has been instrumental in driving business growth and fostering a thriving workplace culture. His extensive global expertise and demonstrated success in scaling businesses underscore his role as Chief Human Resources Officer (CHRO) at Zensar. Before joining Zensar, Vivek served as the Head of HR at Ericsson India Global Services, overseeing HR for 22,000 employees in the information and communications technology sector. He laid the foundation for a “great place-to-work” culture, elevating Ericsson India to a top-ranking company in the GPTW survey. Prior to Ericsson, Vivek spent 12 years in the UK, driving the establishment and growth of European operations for multinational IT firms, including HCL, iGATE, Mastek, and NIIT. Vivek holds a Post-Graduate Diploma in HR from XLRI, Jamshedpur, and is a Chartered Member of CIPD (MCIPD), UK. He has completed Executive Education Programs from The Wharton School, Questrom School of Business, Boston, and the Indian School of Business (ISB). Vivek is also a certified Change Management Leader (Prosci) and has been actively engaged in GPTW circles, having served as a member of the Best Places to Work Executive Committee. Beyond his professional achievements, he is passionate about sports and regularly plays tennis, badminton, and cricket. 39:T4f5,Pulkit Bhandari is the Chief Financial Officer at Zensar. Pulkit brings over two decades of experience in start-ups, corporates, and investment banking and advisory across sectors and products. He has well-rounded expertise in finance (business and controllership), mergers and acquisitions, corporate strategy, capital raising, ESG, and investor relations. Before joining Zensar, Pulkit was CFO at Zetwerk Manufacturing, a large tech-based managed marketplace for contract manufacturing in India with a revenue of $2 billion. He led a team of 150+ finance professionals there, across controllership, business finance, FP\u0026A, treasury, taxation, and internal audit. Previously, he was associated with the RPG Group from 2014 to 2023 as Head of Group Corporate Finance, closely partnering with all the operating companies. He also had a successful stint as an investment banker with Deutsche Bank and ICICI for over a decade. His transaction experience includes 100+ deals totaling to more than $15 billion. A chartered accountant, Pulkit was an Economic Times 40 Under Forty winner, listed among India Inc.’s top business leaders. He is passionate about sports and has successfully completed several triathlons, including a 70.3 Ironman, sea swims, and full marathons.3a:T75e,Parag Jain is a seasoned industry leader with over 25 plus years of experience in incubating and scaling businesses and driving complex transformation programs in the IT services industry. He has been a strategic advisor for major global corporations across the banking, communications, media and entertainment, retail, cpg, and consumer tech industries. Parag is a recognized industry thought leader and advisor to major Fortune 500 companies and CXOs in harnessing technology to drive transformation while establishing strategic partnerships with technology service providers. As Executive Vice President and Global Head of the Retail and Consumer Services (RCS) vertical at Zensar, Parag is responsible for strengthening and expanding Zensar’s global RCS footprint. In addition, as Chief Growth, Marketing, Brand and Communications Officer, Parag is responsible for managing Zensar’s growth channels, including growth office, marketing, brand and public relations, pre sales and sales enablement functions. Parag comes to Zensar from Infosys, where he was responsible for net new sales and business development for the consumer, retail, and logistics (CRL) sector globally. He was also responsible for analysis, advisory relations, and marketing for the CRL sector, besides supporting many corporate-level initiatives on sales transformation, strategic partnerships, and margin improvement. Prior to Infosys, Parag spent 17 years at TCS, where he led the growth and scaling of the media and entertainment, CPG, and distribution businesses. He also led multiple large complex IT transformation programs for TCS. An engineering major from IIT Roorkee, Parag has completed an Advanced Management Program at the University of Michigan, Ross School of Business, and a Financial Leadership Program from Stanford, Graduate School of Business. Parag lives with his family in New Jersey. 3b:T424,Nachiketa Mitra (Nachi) is a global BFSI executive with over 25 years of business experience in financial services, management consulting, and technology services. He has successfully scaled multiple client relationships across leading multinational organizations by developing new offerings and building high-performance teams in the financial services domain. As Executive Vice President and Global Head of the BFSI vertical at Zensar, Nachi is responsible for strengthening and expanding Zensar’s global BFSI footprint. Prior to joining Zensar, Nachi was VP and SBU Head of Banking and Financial Services, NY Metro Portfolio at Cognizant. Nachi played multiple roles in Cognizant over his 18-year stint, building the payments practice from the ground up to its current industry-leading position. He also led the manufacturing and logistics domain in North America, growing it by more than 40 percent. Nachi is based out of Princeton, NJ. As an active member of the New York Kali Temple, Nachi enjoys serving as a volunteer at the temple in his spare time.3c:T504,Pratik Maroo is the Head of Healthcare and Life Sciences at Zensar. He has 25+ years of industry expertise, 16 of which have been dedicated to healthcare and life sciences. A digital transformation visionary, Pratik is known for successfully managing P\u0026L, building new capabilities, and sustaining long-term growth across key global markets. Prior to Zensar, Pratik worked at Indegene, a digital-first life sciences commercialization company. As Vice President, he spearheaded product strategy and was responsible for managing IP portfolio, establishing CIO offerings, building product roadmaps, and identifying new areas for nonlinear growth. Earlier, as Strategic Business Unit Head of Cognizant’s life sciences practice, he managed a $250 million P\u0026L, orchestrated key acquisitions, and served as Chief Digital Officer, Life Sciences. With a rich background at Sapient and Computer Science Corporation (now DxC), Pratik is a trailblazer in digital transformation and business growth. He has completed his Bachelor’s Degree in Electronics and Telecommunication from SGSITS Indore and is an MBA alumnus of IIM Bangalore. With a keen interest in macroeconomics and geopolitics, Pratik is an avid reader and finds joy in hiking and bringing his passion for coaching soccer to life.33:[\"$\",\"$L30\",null,{\"pageName\":\"Leader\",\"pageTitle\":\"Zensar Leadership Team and Board of Directors\",\"description\":\"Meet Zensar Technologies’ Board of Directors and leadership team driving strategy, growth, and digital transformation across global markets.\",\"section\":[{\"sectionName\":\"Leader Banner\",\"componentType\":\"MainBannerVariant\",\"image\":{\"title\":\"Zensar leadership team collaborating during a strategic business discussion\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/5HIShYcat23218CxKhk3hC/cb42673411172856355637e1a82f6120/DEsktopBanner.png\",\"mediaType\":\"image/png\"},\"mobileImage\":{\"title\":\"Zensar leadership team collaborating during a strategic business discussion\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/7E9bw8VPgGeH181dtqwkk7/9107372f659b11f5e787d4f92fde1120/mobile-banner.png\",\"mediaType\":\"image/png\"},\"header\":{\"title\":\"Leading With Purpose, Together\",\"color\":\"black\",\"level\":\"h1\"},\"description\":\"Get to know the leaders who are guiding our growth, strategy, purpose, and journey forward.\",\"descriptionTextColor\":\"black\",\"slug\":\"leader-banner\"},{\"sectionName\":\"Board of Directors\",\"componentType\":\"ThreeColumn\",\"padding\":true,\"header\":{\"title\":\"Board of Directors\",\"color\":\"black\",\"level\":\"h2\",\"headerStyle\":\"heading-style-level-2\"},\"cardType\":\"LeaderCard\",\"sectionItems\":[{\"name\":\"H. V. Goenka\",\"title\":{\"title\":\"H. V. Goenka\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"H. V. Goenka, Chairman and Non-Executive Director at Zensar's Board of Directors\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/10NhKsPGTPp7kb2oOQMGWs/341f7971c0bd420041789f2dab904b0f/hvgoenka-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Chairman, Non-Executive Director\",\"socialIconUrl\":\" https://www.linkedin.com/in/harsh-goenka-7706a014/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Mr. Harsh V. Goenka is Chairman of RPG Enterprises, one of the largest industrial groups in India, active in key business segments such as tyres, infrastructure, information technology and other diversified segments having an annual turnover of about USD 4 billion. Born in 1957, Mr. Goenka is a graduate in Economics and MBA from the International Institute of Management Development (IMD), Lausanne, Switzerland and is now on the Foundation Board of IMD, Lausanne. Mr. Goenka, a past President of the Indian Merchants’ Chamber, is also a member of the Executive Committee of FICCI and a Trustee on the Board of the Breach Candy Hospital Trust. Mr. Goenka has been the Chairman of the Board of the Company since 2001. \",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"h-v-goenka\",\"metaTitle\":\"H. V. Goenka, Chairman and Non-Executive Director, Zensar\",\"metaDescription\":\"Harsh V. Goenka, Chairman of RPG Enterprises and Zensar, leads a $4B group across tyres, IT, and infrastructure with strong governance and strategy.\",\"metaKeywords\":\"harsh v goenka, h v goenka chairman rpg enterprises, zensar chairman, non executive director zensar, rpg group india, imd lausanne, ficci member, indian business leader\"},{\"name\":\"Anant Goenka\",\"title\":{\"title\":\"Anant Goenka\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Anant Goenka, Chairman and Non-Executive Director at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3C5ftDUpcnqvCyw4nl4ayX/b16177f96ad27e8ce31d3f6200f5bd0e/Anant-Goenka-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Vice Chairman, Non-Executive Director\",\"socialIconUrl\":\"https://www.linkedin.com/in/anant-goenka-712a652/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"$34\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"anant-goenka\",\"metaTitle\":\"Anant Goenka, Vice Chairman and Non-Executive Director, Zensar\",\"metaDescription\":\"Anant Goenka, Vice Chairman at Zensar and CEAT, led CEAT’s 25x growth as MD and CEO and drives innovation, sustainability, and enterprise leadership.\",\"metaKeywords\":\"anant goenka, vice chairman zensar technologies, vice chairman ceat limited, non executive director zensar, rpg group leadership, deming prize ceat, forbes business leader\"},{\"name\":\"Manish Tandon \",\"title\":{\"title\":\"Manish Tandon\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5-bold\"},\"image\":{\"title\":\"Manish Tandon, Vice Chairman and Non-Executive Director at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/2SXQV5oo60HNIAeTjfSSq3/df6f55b3580a95e66e766746805d36e3/Manish-tandon-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Chief Executive Officer and Managing Director\",\"socialIconUrl\":\"https://www.linkedin.com/in/manish-tandon-347481/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Manish Tandon is the Chief Executive Officer and Managing Director at Zensar. He has over 27 years of experience and a proven track record of driving industry-leading revenue, profit, and growth. Prior to Zensar, Manish was the CEO of CSS Corp, a technology services company based in the US. Manish was instrumental in enabling the company's turnaround and consistent growth trajectory. This was preceded by a 20-year tenure at Infosys Limited, where he led a $2+ billion global healthcare, financial, insurance, life sciences, and technology business. He was also on the Board of Infosys Lodestone and Infosys Public Services. Manish has been an advisor to several leading US-based private equity firms. He was recognized as Executive of the Year - Computer Services - Gold Stevie® at the 17th Annual International Business Awards and CEO of the Year at the CMO Asia Awards 2019. An IIT and IIM alumnus, Manish is well-recognized in the industry as a thought leader and highly accomplished public speaker.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"manish-tandon\",\"metaTitle\":\"Manish Tandon, CEO and Managing Director, Zensar\",\"metaDescription\":\"Manish Tandon, CEO and Managing Director of Zensar Technologies, brings 27+ years of experience driving global growth and digital transformation.\",\"metaKeywords\":\"manish tandon, ceo zensar technologies, managing director zensar, zensar ceo, digital transformation leader, it services leadership\"},{\"name\":\"Ketan Dalal\",\"title\":{\"title\":\"Ketan Dalal\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Ketan Dalal, Chief Executive Officer and Managing Director at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/2f2L6JfKy8kWPv3LVC5ZAA/bbbbd4b7865a3115e9387e9a155bae22/Ketan-Dalal-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Independent, Non-Executive Director\",\"socialIconUrl\":\"https://www.linkedin.com/in/ketan-dalal-4003a116/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Ketan \",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\"Dalal is\",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\" a Fellow Member of the Institute of Chartered Accountants of India, having qualified in 1981. He has extensive experience of about 40 years in investment structuring, including mergers and acquisitions. He is also a Director in HDFC Life Insurance and Eternis Fine Chemicals Limited. He has been a member of several SEBI committees, including SEBI’s High-Powered Advisory Committee (HPAC) on consent orders and compounding. He was a member of the committee constituted by IFSCA to examine the feasibility of \",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\"variable\",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\" capital company in IFSCs. He is a member of the Managing Committee of IMC. International Tax Review, a leading global magazine on international tax has listed him among India’s leading tax advisers.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"ketan-dalal\",\"metaTitle\":\"Ketan Dalal, Independent Non-Executive Director, Zensar\",\"metaDescription\":\"Ketan Dalal, Independent Director at Zensar, brings 40+ years in MandA, tax advisory, and investment structuring expertise across global enterprises.\",\"metaKeywords\":\"ketan dalal, independent director zensar technologies, fellow icai, tax advisory india, manda investment structuring, corporate governance india, zensar board\"},{\"name\":\"Ben Druskin\",\"title\":{\"title\":\"Ben Druskin\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Ben Druskin, Independent Non-Executive Director at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/sFfgrDLQAIwZj4BjejSBn/de27bddb8251fb02c8c30b406008c007/Ben-Druskin-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Independent, Non-Executive Director\",\"socialIconUrl\":\"https://www.linkedin.com/in/ben-druskin-554284254/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Ben Druskin retired from Citigroup. He has an experience of around 30 years. He was the Managing Director and Chairman of Global TMT Banking. He previously was Co-Head Global TMT Banking and prior to that he ran the Global Services and East Coast Technology Investment Banking Groups. He founded the Global Services Group in 1997. Having been part of the Citigroup since 1993, he has been a member of the Technology Banking Group since 1996.\",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\" Ben has completed and led hundreds of equities, M\u0026A, and fixed income transactions since joining Citigroup. \",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"ben-druskin\",\"metaTitle\":\"Ben Druskin, Independent Non-Executive Director, Zensar\",\"metaDescription\":\"Ben Druskin, Independent Director at Zensar, is a former Citigroup MD with 30+ years in global TMT banking, MandA, and capital markets expertise.\",\"metaKeywords\":\"ben druskin, independent director zensar technologies, citigroup md tmt banking, global investment banking, manda expertise, corporate governance\"},{\"name\":\"Radha Rajappa\",\"title\":{\"title\":\"Radha Rajappa\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Radha Rajappa, Independent Non-Executive Director at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/43TWXYWTBqrvfE1lVpwgrE/8e0fb5982c47985f652eb38853067103/Radha-rajappa-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Independent, Non-Executive Director\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"$35\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"radha-rajappa\",\"metaTitle\":\"Radha Rajappa, Independent Non-Executive Director, Zensar\",\"metaDescription\":\"Radha Rajappa, Independent Director at Zensar, brings 30+ years of leadership across Microsoft, IBM, Mindtree, and digital transformation.\",\"metaKeywords\":\"radha rajappa, independent director zensar technologies, microsoft india leadership, mindtree executive, digital transformation leader, iot advisor\"},{\"name\":\"U. B. Pravin Rao\",\"title\":{\"title\":\"U. B. Pravin Rao\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"U. B. Pravin Rao, Independent Non-Executive Director at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/6sRl4pE1HlxyyRWOX7By9i/efa7ccd3f160d4ae98b44406f66be3e1/U-B-Rao-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Independent, Non-Executive Director\",\"socialIconUrl\":\"https://www.linkedin.com/in/ubpravin\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"$36\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"u-b-pravin-rao\",\"metaTitle\":\"U. B. Pravin Rao, Independent Non-Executive Director, Zensar\",\"metaDescription\":\"U. B. Pravin Rao, Independent Director at Zensar, is former Infosys COO and NASSCOM Chairman with 35+ years in global IT leadership.\",\"metaKeywords\":\"u b pravin rao, independent director zensar technologies, infosys coo, nasscom chairman, it leadership india, corporate governance\"}],\"slug\":\"board-of-directors\",\"horizontalPadding\":true,\"verticalPadding\":true},{\"sectionName\":\"Our Leadership\",\"componentType\":\"ThreeColumn\",\"padding\":true,\"header\":{\"title\":\"Our leadership\",\"color\":\"black\",\"level\":\"h2\"},\"cardType\":\"LeaderCard\",\"sectionItems\":[{\"name\":\"Manish Tandon \",\"title\":{\"title\":\"Manish Tandon\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5-bold\"},\"image\":{\"title\":\"Manish Tandon, Vice Chairman and Non-Executive Director at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/2SXQV5oo60HNIAeTjfSSq3/df6f55b3580a95e66e766746805d36e3/Manish-tandon-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Chief Executive Officer and Managing Director\",\"socialIconUrl\":\"https://www.linkedin.com/in/manish-tandon-347481/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Manish Tandon is the Chief Executive Officer and Managing Director at Zensar. He has over 27 years of experience and a proven track record of driving industry-leading revenue, profit, and growth. Prior to Zensar, Manish was the CEO of CSS Corp, a technology services company based in the US. Manish was instrumental in enabling the company's turnaround and consistent growth trajectory. This was preceded by a 20-year tenure at Infosys Limited, where he led a $2+ billion global healthcare, financial, insurance, life sciences, and technology business. He was also on the Board of Infosys Lodestone and Infosys Public Services. Manish has been an advisor to several leading US-based private equity firms. He was recognized as Executive of the Year - Computer Services - Gold Stevie® at the 17th Annual International Business Awards and CEO of the Year at the CMO Asia Awards 2019. An IIT and IIM alumnus, Manish is well-recognized in the industry as a thought leader and highly accomplished public speaker.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"manish-tandon\",\"metaTitle\":\"Manish Tandon, CEO and Managing Director, Zensar\",\"metaDescription\":\"Manish Tandon, CEO and Managing Director of Zensar Technologies, brings 27+ years of experience driving global growth and digital transformation.\",\"metaKeywords\":\"manish tandon, ceo zensar technologies, managing director zensar, zensar ceo, digital transformation leader, it services leadership\"},{\"name\":\"Vijayasimha (Vijay) Alilughatta \",\"title\":{\"title\":\"Vijayasimha (Vijay) Alilughatta \",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Vijayasimha Alilughatta, Chief Executive Officer and Managing Director at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/475FZBhdLfpjclXgdufwJp/83a43d09fddeb00934ff3b53350a1c85/Vijayasimha-Alilughatta-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Chief Operating Officer\",\"socialIconUrl\":\"https://www.linkedin.com/in/vijayasimha-a-j-95a51a/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"$37\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"vijayasimha-alilughatta\",\"metaTitle\":\"Vijayasimha Alilughatta, Chief Operating Officer, Zensar\",\"metaDescription\":\"Vijay Alilughatta, COO at Zensar, brings 27+ years in IT with leadership roles at Wipro and Infosys across delivery, operations, and global growth.\",\"metaKeywords\":\"vijay alilughatta, zensar coo, chief operating officer zensar, wipro coo, infosys leadership, delivery excellence, global operations\"},{\"name\":\"Vivek Ranjan\",\"title\":{\"title\":\"Vivek Ranjan\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Vivek Ranjan, Chief Operating Officer at Zensar, posed for a professional portrait.\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/53oRRw0F2kwPkAkAXf8wU2/78ced684f8f31d178437a305519234f1/Vivek-Ranjan-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Chief Human Resources Officer\",\"socialIconUrl\":\"https://www.linkedin.com/in/vivek-ranjan-771878/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"$38\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"vivek-ranjan\",\"metaTitle\":\"Vivek Ranjan, Chief Human Resources Officer, Zensar\",\"metaDescription\":\"Vivek Ranjan, CHRO at Zensar, brings 26+ years in HR leadership, including Ericsson India, driving talent strategy and organizational culture.\",\"metaKeywords\":\"vivek ranjan, chro zensar technologies, hr leadership zensar, ericsson india hr head, talent strategy, organizational culture, people leadership\"},{\"name\":\"Pulkit Bhandari\",\"title\":{\"title\":\"Pulkit Bhandari\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5-bold\"},\"image\":{\"title\":\"Pulkit Bhandari, Chief Human Resources Officer at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/5E6pPYmI5MURExBSsGel9R/5a8941b15efb0aa921ad02d0527ca8bd/Pulkit-Bhandari-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Chief Financial Officer\",\"socialIconUrl\":\"https://www.linkedin.com/in/pulkit-bhandari-86650b37/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"$39\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"pulkit-bhandari\",\"metaTitle\":\"Pulkit Bhandari, Chief Financial Officer, Zensar\",\"metaDescription\":\"Pulkit Bhandari, CFO at Zensar, is a Chartered Accountant with $15B+ deal experience across Deutsche Bank, ICICI, RPG Group, and Zetwerk.\",\"metaKeywords\":\"pulkit bhandari, cfo zensar technologies, chief financial officer zensar, deutsche bank investment banking, icici investment banking, et 40 under 40\"},{\"name\":\"Parag Jain\",\"title\":{\"title\":\"Parag Jain\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Parag Jain, Chief Financial Officer at Zensar, in a professional setting.\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/7prxTLMVduf9edMfJNj7Dz/5622e4e22996b10aeff87fa3038da82b/Parag-Jain-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Executive Vice President and Global  Head - Retail and Consumer Services, Growth Office, Marketing, and Brand and Comms\",\"socialIconUrl\":\"https://www.linkedin.com/in/paragj123/\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"$3a\",\"marks\":[],\"data\":{}}]}]},\"slug\":\"parag-jain\",\"metaTitle\":\"Parag Jain, EVP and Head, MCS and Growth Office, Zensar\",\"metaDescription\":\"Parag Jain, EVP and head at Zensar, leads Manufacturing and Consumer Services and growth initiatives with 25+ years across Infosys, TCS, and global enterprises.\",\"metaKeywords\":\"parag jain, evp zensar technologies, manufacturing consumer services zensar, chief growth officer zensar, infosys leadership, tcs experience\"},{\"name\":\"Nachiketa (Nachi) Mitra \",\"title\":{\"title\":\"Nachiketa (Nachi) Mitra\",\"color\":\"black\",\"level\":\"h3\"},\"image\":{\"title\":\"Nachiketa Mitra, Executive Vice President and Head - Banking and Financial Services at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/6bGPGCvuz3aQRMUypg1QjU/992963c0608cb3e683da2661e82be0cc/Nachiketa-Mitra-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Executive Vice President and Head - Banking and Financial Services \",\"socialIconUrl\":\"https://www.linkedin.com/in/nachiketamitra/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"$3b\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"nachiketa-mitra\",\"metaTitle\":\"Nachiketa Mitra, EVP and Head, BFSI, Zensar\",\"metaDescription\":\"Nachiketa Mitra, EVP and BFSI Head at Zensar, brings 25+ years in financial services and built Cognizant’s global payments practice.\",\"metaKeywords\":\"nachiketa mitra, evp bfsi zensar technologies, head banking financial services zensar, cognizant payments leader, financial services technology\"},{\"name\":\"Harish Lala\",\"title\":{\"title\":\"Harish Lala\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Harish Lala, Executive Vice President and Head of Banking and Financial Services at Zensar\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/b2GXyuFUVRK15CubPQr5Z/456168e46ccc29e230fda53d70d514ef/_0008_Harish-Lala.png\",\"mediaType\":\"image/png\"},\"designation\":\"Executive Vice President and Head - Telecom and Public Services\",\"socialIconUrl\":\"https://www.linkedin.com/in/harish-lala-09442b12/\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Harish Lala is currently based in Johannesburg, South Africa. Zensar Technologies is a global business and software services company with a strong presence in Africa and the Middle East. Harish was involved in setting up Zensar’s Africa operations, with its starting base in South Africa, and has since been working with many blue chip companies across banking, insurance, retail, and mining across Africa by helping them implement transformational business solutions using technology as an enabler. He is also involved in expanding Zensar’s operations from South Africa to Southern and East Africa while taking over the Middle East charter a couple of years back. He holds a Master’s Degree in Business Administration and a Bachelor’s Degree in Engineering.\",\"marks\":[],\"data\":{}}]}]},\"slug\":\"harish-lala\",\"metaTitle\":\"Harish Lala, EVP and Head, TMT, Zensar\",\"metaDescription\":\"Harish Lala, EVP and Head of TMT at Zensar, built Africa operations and drives growth across telecom, media, and technology sectors globally.\",\"metaKeywords\":\"harish lala, evp tmt zensar technologies, telecom media technology head, zensar africa operations, digital transformation telecom\"},{\"name\":\"Chaitanya (Chai) Rajebahadur\",\"title\":{\"title\":\"Chaitanya (Chai) Rajebahadur\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Chaitanya Rajebahadur, Executive Vice President and Head of Telecommunication, Media, and Technology\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/7cPEtPo2SFH5zvzfstgtRu/7a2df63919a3367a380988fc2d626c63/Chaitanya-Rajebahadur-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"EVP and Global Leader - Digital Engineering, Consulting, Martech, AI, and Creative Studios\",\"socialIconUrl\":\"https://www.linkedin.com/in/chaitanya-chai-rajebahadur-212b74/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Chaitanya (Chai) leads Zensar’s global Digital Engineering, Consulting, Martech, AI, and Creative Studios practice, overseeing a team of 2,500 specialists across design, strategy, marketing, creativity, and engineering. His focus is on helping enterprises deliver connected outcomes - smarter products, modern platforms, and customer engagement that drives growth. With over three decades of leadership experience across financial services, manufacturing, retail, and telecom, Chai has successfully driven transformation across markets in the US, the Middle East, Europe, India, Singapore, and Australia. He spent 10 years heading Zensar’s European business, establishing a strong regional presence. Prior to Zensar, he led key verticals at iGATE for nine years. Beyond business, Chai serves on the board of a UK-based non-profit dedicated to children’s education, poverty alleviation, and youth empowerment.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"chaitanya-rajebahadur\",\"metaTitle\":\"Chaitanya Rajebahadur, EVP and Global Leader, Zensar\",\"metaDescription\":\"Chaitanya Rajebahadur, EVP at Zensar, leads Digital Engineering, AI, and Martech with 30+ years across global markets and transformation programs.\",\"metaKeywords\":\"chaitanya rajebahadur, evp zensar technologies, digital engineering ai leader, martech zensar, transformation consulting\"},{\"name\":\"Brahma Pandey\",\"title\":{\"title\":\"Brahma Pandey\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5-bold\"},\"image\":{\"title\":\"Bramha-Pandey\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/4hmMcZeLxhN5sBHvDi0hc1/cfb27ad39709b8f8ed3206886de41945/Bramha-Pandey.png\",\"mediaType\":\"image/png\"},\"designation\":\"Senior Vice President and Head - High Tech and Manufacturing\",\"socialIcon\":{\"title\":\"LinkedIn\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/6OZfbgpAIVcafBXxMb5Gfr/80565c71823c146462495e92674db2c0/linkedin.svg\",\"mediaType\":\"image/svg+xml\"},\"socialIconDarkMode\":{\"title\":\"LinkedIn\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3Gj73jEnFyvffhK95Izoop/d3df5242e8989c5814f6c82dce24bb26/linkedin-w-02.svg\",\"mediaType\":\"image/svg+xml\"},\"socialIconUrl\":\"https://www.linkedin.com/in/brahma-pandey/\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Brahma Pandey is a seasoned business leader with nearly 29 years of experience driving growth, sales transformation, and client expansion across the manufacturing and hi-tech sectors. He has built and scaled strategic client relationships across industries, including industrials, automotive, aerospace and defense, semiconductors, and the broader software value chain. \",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"As Senior Vice President and Global Head of Hi-tech and Manufacturing at Zensar, Brahma is responsible for leading the growth and go-to-market strategies for these verticals while serving as a member of the Executive Committee. He is focused on accelerating business expansion, strengthening client partnerships, and driving the next phase of growth for Zensar’s HTM business. \",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Prior to joining Zensar, Brahma spent nearly 26 years at Infosys, most recently leading the Sales function for the manufacturing and hi-tech industries. In this role, he was responsible for acquiring new clients and expanding existing accounts across multiple industry segments. During his career, he also worked with Dell Technologies, where he led new account acquisition across the US Southeast region, serving clients across diverse industry verticals. \",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Brahma holds an MBA from Duke University’s Fuqua School of Business and a Bachelor’s Degree in Engineering from IIT (BHU). Based in Dallas, Texas, he lives with his wife, Meenu, and their two children, Rohan and Arya. Outside of work, Brahma enjoys travelling, exploring different cultures, and playing golf. He is also a passionate dog lover.\",\"marks\":[],\"data\":{}}]}]},\"slug\":\"brahma-pandey\"},{\"name\":\"Pratik Maroo\",\"title\":{\"title\":\"Pratik Maroo\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Pratik Maroo, EVP and Global Leader - Digital Engineering at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/5TUpIrMMnTMLtiV4V3jVpp/f6eda5be123cbe740bfe64254191b0cc/Pratik-Maroo-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Senior Vice President and Head - Healthcare and Life Sciences\",\"socialIconUrl\":\"https://www.linkedin.com/in/pratikmaroo/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"$3c\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"pratik-maroo\",\"metaTitle\":\"Pratik Maroo, Senior Vice President and Head, HLS, Zensar\",\"metaDescription\":\"Pratik Maroo, SVP and Head of HLS at Zensar, brings experience from Cognizant and Indegene, leading healthcare transformation and innovation.\",\"metaKeywords\":\"pratik maroo, svp healthcare zensar technologies, life sciences head zensar, cognizant healthcare leader, digital health transformation\"},{\"name\":\"Kaushik Chatterjee\",\"title\":{\"title\":\"Kaushik Chatterjee\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Kaushik Chatterjee, Senior Vice President and Head of Healthcare and Life Sciences at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/SrN2tPmfqa3kbgi2vfImt/99484a2f8acdb9789dedf5918c5aa129/Kaushik-Chatterjee-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Senior Vice President and Head - Africa\",\"socialIconUrl\":\"https://www.linkedin.com/in/kaushik-chatterjee-0443b94/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Kaushik Chatterjee is Senior Vice President and Head of Africa at Zensar Technologies. Prior to assuming this role in April 2025, Kaushik headed global delivery for the BFSI and Healthcare and Life Sciences verticals at Zensar. Kaushik brings over 26 years of rich experience in IT services across business, applications, and infrastructure. He has held leadership roles in P\u0026L management, business development, global delivery, consulting, and practice development. He has strong domain expertise across the BFSI, Life Sciences, and Healthcare verticals. He has held leadership roles in organizations such as Cognizant and Citibank and has significant expertise in incubating competencies and growing them to scale. Kaushik holds a BTech in Electronics and Electrical Engineering and an MBA (PGDM) from IIM Calcutta.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"kaushik-chatterjee\",\"metaTitle\":\"Kaushik Chatterjee, SVP and Head - Africa, Zensar\",\"metaDescription\":\"Kaushik Chatterjee is SVP and Head of Africa at Zensar Technologies, driving regional business growth with extensive IT services and BFSI domain expertise.\",\"metaKeywords\":\"kaushik chatterjee, svp africa zensar technologies, head africa zensar, cognizant leader, citibank technology, bfsi healthcare delivery\"},{\"name\":\"Anshul Srivastav\",\"title\":{\"title\":\"Anshul Srivastav\",\"color\":\"black\",\"level\":\"h3\",\"headerStyle\":\"heading-style-level-5\"},\"image\":{\"title\":\"Anshul Srivastav, Senior Vice President and Head of Africa at Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/40kQj3ltnB2JUBSkB0o8BU/745a96d9bd4d68916f14bd73dd67dc35/Anshul-Srivastav-transparent.png\",\"mediaType\":\"image/png\"},\"designation\":\"Senior Vice President and Head - UK and Europe\",\"socialIconUrl\":\"https://www.linkedin.com/in/anshulsrivastav/\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Anshul Srivastav is the Senior Vice President and Head of UK and Europe at Zensar. He is a seasoned leader with extensive experience in business development, client engagement, and competency development. Before his current role, Anshul served as the Regional Head of Sales for UK and Europe, where he successfully led key accounts and business growth efforts across Banking, Financial Services, Insurance, Technology, Media, Consumer Services, and Public Services verticals. Before joining Zensar, he spent nearly 12 years with Infosys in various leadership roles. Anshul’s leadership has driven transformative solutions tailored to evolving market needs. He has had a tremendous impact in his leadership roles across sales, domain consulting, and technology transformation. His expertise is leveraging technology to optimize business performance, foster client success, and shape future-ready enterprises. Anshul holds a BTech in Electronics and Communication and an MBA from IIM Ahmedabad.  \",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"slug\":\"anshul-srivastav\",\"metaTitle\":\"Anshul Srivastav, SVP and Head, UK and Europe, Zensar\",\"metaDescription\":\"Anshul Srivastav, SVP and Head of UK and Europe at Zensar, drives BFSI, TMT, and consumer services growth with prior leadership at Infosys.\",\"metaKeywords\":\"anshul srivastav, svp uk europe zensar technologies, head uk europe zensar, infosys leadership, bfsi technology europe\"}],\"slug\":\"our-leadership\",\"horizontalPadding\":true,\"verticalPadding\":true}],\"slug\":\"leadership\",\"pageUrl\":\"/about-us/leadership\",\"metaKeywords\":\"zensar technologies leadership team, zensar board of directors, zensar management team, h v goenka zensar, manish tandon ceo zensar, zensar executives, technology leadership india, it services leadership\",\"pageSchema\":{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://www.zensar.com/#organization\",\"name\":\"Zensar Technologies\",\"url\":\"https://www.zensar.com/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://images.ctfassets.net/bjl3f17nyta4/6IUeLrHvOQVPUxczuwnpG6/0b21114df102b72adf6e79d941c05e3b/zensar-logo-white.svg\"}},{\"@type\":\"CollectionPage\",\"@id\":\"https://www.zensar.com/about-us/leadership#collectionpage\",\"url\":\"https://www.zensar.com/about-us/leadership\",\"name\":\"Zensar Leadership Team and Board of Directors\",\"description\":\"Meet Zensar Technologies’ Board of Directors and leadership team driving strategy, growth, and digital tran