				<div class="elementor-widget-container">
															<img fetchpriority="high" fetchpriority="high" decoding="async" width="585" height="610" src="https://sukhwani.in/wp-content/uploads/2024/01/About-sukhwani-585X610_1.jpg" class="attachment-large size-large wp-image-4065" alt="" srcset="https://sukhwani.in/wp-content/uploads/2024/01/About-sukhwani-585X610_1.jpg 585w, https://sukhwani.in/wp-content/uploads/2024/01/About-sukhwani-585X610_1-288x300.jpg 288w, https://sukhwani.in/wp-content/uploads/2024/01/About-sukhwani-585X610_1-471x491.jpg 471w" sizes="(max-width: 585px) 100vw, 585px" />															</div>
