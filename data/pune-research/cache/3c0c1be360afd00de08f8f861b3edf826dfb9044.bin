<style>
  .premium-contact-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px 20px;
    display: flex;
    gap: 60px;
    width: 100%;
    min-height: 100vh; 
    justify-content: center;
  }

  /* Shopify Color Scheme Classes */
  .color-;
  .color-;
  .bg-;
  .bg-;

  .left-column {
    flex: 0 0 50%;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .form-column {
    flex: 0 0 50%;
    display: flex;
    flex-direction: column;
  }

  .left-column-image-container {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
    
    order: 2;
    
  }

  .left-column-image {
    border-radius: 12px;
    
    width: 75%;
    
    height: auto;
    object-fit: cover;
  }

  .left-column-content {
    
    order: 1;
    
  }

  /* Text size classes */
  .left-column-heading {
    
    font-size: 2rem;
    
    margin-bottom: 20px;
  }

  .left-column-text {
    
    font-size: 1rem;
    
    line-height: 1.6;
    margin-bottom: 30px;
  }

  .content-block {
    display: flex;
    align-items: center;
    margin-bottom: 25px;
    gap: 15px;
  }

  .block-icon {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .block-icon.block-1 {
    
    width: 48px;
    height: 48px;
    
  }

  .block-icon.block-2 {
    
    width: 48px;
    height: 48px;
    
  }

  .block-icon.block-3 {
    
    width: 48px;
    height: 48px;
    
  }

  .block-icon.block-4 {
    
    width: 48px;
    height: 48px;
    
  }

  .block-icon.block-5 {
    
    width: 48px;
    height: 48px;
    
  }

  .block-icon.block-6 {
    
    width: 32px;
    height: 32px;
    
  }

   .block-content h3 {
    margin: 0 0 8px 0;
    /* font-size: 1.1rem; */
  }

  .form-container {
    position: relative;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    overflow: hidden; /* This prevents scrollbars on the container */
  }

  .form-container iframe {
    border: none;
    width: 100%;
    height: 750px; /* Use the setting for initial height */
    display: block;
    overflow: hidden; /* Hide any internal scrollbars */
  }

  /* Responsive adjustments */
  @media (max-width: 749px) {

    .ring-sperate-for-mobilehide{
      display:none;
    }
    .form-container iframe {
      height: 750px; /* Fixed height for mobile that works well */
    }
  }
  .loading-spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
  }

  .form-header {
    padding: 40px 40px 20px;
  }

  @media (max-width: 749px) {
    .premium-contact-section {
      flex-direction: column;
      padding: 40px 20px;
      gap: 40px;
      min-height: auto;
    }

    .left-column {
      flex: 1 1 100%;
      padding: 20px;
      width: 100%;
      order: 2;
    }

    .form-column {
      flex: 1 1 100%;
      width: 100%;
      order: 1;
    }

    .left-column-image {
      
      width: 80%;
      
    }

    .form-container {
      height: 750px; /* Fixed height for mobile that works well */
    }
  }

