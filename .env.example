# ---------------------------------------------------------------------------
# Mappingg environment variables. Copy to .env.local and fill in real values.
# NEVER commit .env.local. All of these are SERVER-ONLY except NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Pooled Prisma Postgres connection string. TLS is required by the provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# --- Auth / sessions (required) --------------------------------------------
# Secret used to sign the mg_session JWT (HS256). Generate a long random value,
# e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Public site URL (required in production) ------------------------------
# Absolute origin, used for canonical URLs, sitemap, OpenGraph, OAuth callbacks.
NEXT_PUBLIC_SITE_URL="https://www.mappingg.com"

# --- Google Maps JS API key (admin team-editor / 3D map only) --------------
# The PUBLIC map is Leaflet and needs no key. This key is only used by the
# admin editor. Restrict it by HTTP referrer in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# --- Google OAuth (optional — only if/when Google Login is enabled) --------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
# These are read SERVER-SIDE only. Do NOT prefix the secret with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
