  <script type="text/javascript">
    $(document).ready(function () {
      $(".error_container i").click(function () {
        $(".error_container").fadeOut();
      });
    });

    function val_form(x) {
      const scriptURL =
        "https://script.google.com/macros/s/AKfycbyGNNusPydbjDa0hELF9eXX39wBhEhvMfTFwcg_dU30AKnY3MzmwaNb/exec";
      $(x).addClass("load").text("");
      $(".error_container").fadeOut();

      var name = $("#name").val();
      var number = $("#number").val();
      var email = $("#email").val();
      var city = $("#city").val();
      var purpose = $("#purpose").val();
      var amount = $("#loanAmount").val();
      var date = `27-Oct-2026`;
	  

      if (name == "") {
        $(".error_container p").text("Please enter your Name");
        $(".error_container").fadeIn();
        $('.form button[type="button"]')
          .removeClass("load")
          .text("submit details");
        return;
      }
      if (number == "") {
        $(".error_container p").text("Please enter your Mobile Number");
        $(".error_container").fadeIn();
        $('.form button[type="button"]')
          .removeClass("load")
          .text("submit details");
        return;
      }
      if (email == "") {
        $(".error_container p").text("Please enter your Email Address");
        $(".error_container").fadeIn();
        $('.form button[type="button"]')
          .removeClass("load")
          .text("submit details");
        return;
      }
      if (city == "") {
        $(".error_container p").text("Please enter your City");
        $(".error_container").fadeIn();
        $('.form button[type="button"]')
          .removeClass("load")
          .text("submit details");
        return;
      }

      const formData = new FormData();
      formData.append("name", name);
      formData.append("number", number);
      formData.append("email", email);
      formData.append("city", city);
      formData.append("purpose", purpose);
      formData.append("amount", amount);
      formData.append("date", date);

      fetch(scriptURL, { method: "POST", body: formData })
        .then((response) => {
          $('.form button[type="button"]')
            .removeClass("load")
            .text("submit details");

          if (response.status != 200) {
            $(".error_container p").text(data);
            $(".error_container").fadeIn();
          } else {
            $(".error_container").fadeOut();
            $(".form .wrapper").hide();
            $(".success_container").fadeIn();
          }
          //   console.log("Success!", response);
        })
        .catch((error) => console.error("Error!", error.message));

      //   $.post(
      //     "validate.php",
      //     {
      //       cid: cid,
      //       branch: branch,
      //       city: city,
      //       message: message,
      //       staff: staff,
      //     },
      //     function (data) {
      //       $('.form button[type="button"]')
      //         .removeClass("load")
      //         .text("submit details");
      //       if (data != "success") {
      //         $(".error_container p").text(data);
      //         $(".error_container").fadeIn();
      //       } else {
      //         $(".error_container").fadeOut();
      //         $(".form .wrapper").hide();
      //         $(".success_container").fadeIn();
      //       }
      //     }
      //   );
    }
  </script>

