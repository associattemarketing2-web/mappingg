<script>
    let body = document.querySelector("html"),
        toggle = document.querySelector("#menu-trigger");

    function sidebarmenuclose() {
        document.querySelector("html").classList.remove("insomenu-active")
    }
    toggle.addEventListener("click", (() => {
        body.classList.toggle("insomenu-active")
    }));
    var scrollToTopBtn = document.querySelector(".scroll-to-top"),
        rootElement = document.documentElement;

    function handleScroll() {
        var e = rootElement.scrollHeight - rootElement.clientHeight;
        rootElement.scrollTop / e > .01 ? scrollToTopBtn.classList.add("showBtn") : scrollToTopBtn.classList.remove("showBtn")
    }

    function scrollToTop() {
        rootElement.scrollTo({
            top: 0,
            behavior: "smooth"
        })
    }

    function closeModel(e) {
        var o = document.querySelector("html");
        document.querySelector("#" + e).classList.remove("is-active"), o.classList.remove("is-active")
    }

    function openModel(e) {
        var o = document.querySelector("html");
        document.querySelector("#" + e).classList.add("is-active"), o.classList.add("is-active")
    }

    function toggleModel(e) {
        var o = document.querySelector("html");
        document.querySelector("#" + e).classList.toggle("is-active"), o.classList.toggle("is-active")
    }
    scrollToTopBtn.addEventListener("click", scrollToTop), document.addEventListener("scroll", handleScroll);
    var lastScrollTop = 0,
        lastScrollBottom = 0;

    function menuclose() {
        $(".header-dropdown").removeClass("menu-active"), $("html").removeClass("html-menu-active")
    }
    window.addEventListener("scroll", (function() {
        var e = window.pageYOffset || document.documentElement.scrollTop;
        e > 140 || e > 140 ? document.getElementById("header").classList.add("sticky") : document.getElementById("header").classList.remove("sticky"), lastScrollTop = e <= 0 ? 0 : e
    }), !1), $(document).ready((function() {
        setTimeout((() => {
            $("[data-fancybox]").fancybox({
                iframe: {
                    css: {
                        width: "100%",
                        height: "100%"
                    }
                },
                buttons: ["zoom", "share", "slideShow", "fullScreen", "download", "thumbs", "close"]
            })
        }), 2e3)
    })), $(document).ready((function() {
        $(".footer-hidden-content .arrow-toggle").on("click", (function() {
            ! function(e) {
                const o = e.hasClass("open"),
                    t = e[0].scrollHeight,
                    n = e.closest(".footer-hidden-content");
                o ? (e.css("height", t + "px"), requestAnimationFrame((() => {
                    e.css("height", "0px"), e.removeClass("open"), n.removeClass("is-active")
                }))) : (e.addClass("open"), e.css("height", t + "px"), n.addClass("is-active"), $("html, body").animate({
                    scrollTop: n.offset().top
                }, 500))
            }($(this).closest(".footer-hidden-content").find(".footer-toggle-content"))
        }))
    })), $(document).ready((function() {
        $(".header-dropdown").on("mouseenter", (function() {
            const e = $(this);
            $(".header-dropdown").not(e).removeClass("menu-active"), e.addClass("menu-active"), $(".header-dropdown.menu-active").length > 0 && $("html").addClass("html-menu-active")
        })), $(".header-dropdown").on("mouseleave", (function() {
