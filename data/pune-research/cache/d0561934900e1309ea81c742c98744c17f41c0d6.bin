:transparent" srcSet="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fabout%2Fclients%2Fnvidia-493911736.webp&amp;w=256&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fabout%2Fclients%2Fnvidia-493911736.webp&amp;w=640&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fabout%2Fclients%2Fnvidia-493911736.webp&amp;w=640&amp;q=75"/></div></div></div></div></div><div class="w-1/2 mx-auto"><div class="h-0.5 bg-gold-beige/20"><div class="h-full bg-gold-beige transition-[width] duration-200 ease-out" style="width:2%"></div></div></div></div></div></section></div><section class="bg-white py-14 md:py-20"><div class="max-w-[1400px] mx-auto px-6 md:px-12"><h2 class="text-center text-2xl md:text-[28px] tracking-[0.04em] font-display-semi text-black-chocolate uppercase">ALLIANCES THAT SHAPE OUR WORK</h2><div class="mt-10 flex flex-wrap items-center justify-center gap-6 md:gap-12 mb-10"><button type="button" class="text-sm md:text-base font-medium tracking-wider transition-colors pb-1 uppercase text-[#B09E81] border-b-2 border-[#B09E81]">INSTITUTIONAL PARTNERS</button><button type="button" class="text-sm md:text-base font-medium tracking-wider transition-colors pb-1 uppercase text-[#B09E81]/60 hover:text-[#B09E81]">HOSPITALITY BRAND PARTNERS</button><button type="button" class="text-sm md:text-base font-medium tracking-wider transition-colors pb-1 uppercase text-[#B09E81]/60 hover:text-[#B09E81]">BRAND ASSOCIATION</button></div><div class="relative mt-8 md:mt-12"><div class="absolute -top-12 right-0 z-20 md:flex items-center gap-3 hidden"><button aria-label="Previous" disabled="" class="grid place-items-center text-[#B09E81] transition-opacity opacity-40 cursor-not-allowed"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="18" fill="#9E8C70" class="bi bi-arrow-left" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"></path></svg></button><button aria-label="Next" disabled="" class="grid place-items-center text-[#B09E81] transition-opacity opacity-40 cursor-not-allowed"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="18" fill="#9E8C70" class="bi bi-arrow-left" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"></path></svg></button></div><div class="embla-projects overflow-hidden"><div class="embla-projects__container flex gap-6"><div class="embla-projects__slide basis-[85%] md:basis-[calc(33.333%-1rem)] shrink-0 grow-0 min-w-0"><div class="border border-black/10 p-8 h-full flex flex-col justify-between"><div><h3 class="text-2xl font-display-semi text-black-chocolate mb-5">Blackstone</h3><p class="text-black/80 text-sm leading-relaxed">Blackstone is one of the world&#x27;s leading investment firms that seek to create positive economic impact and long-term value for its investors, the companies it invests in, and the communities in which it works. Blackstone&#x27;s global business platform encompasses private equity and real estate funds, hedge fund solutions, and credit funds.</p></div><div class="mt-8"><a target="_blank" class="text-[#B09E81] text-sm underline underline-offset-4 hover:text-[#8C7A5B] transition-colors" href="https://www.blackstone.com/">Read More</a></div></div></div><div class="embla-projects__slide basis-[85%] md:basis-[calc(33.333%-1rem)] shrink-0 grow-0 min-w-0"><div class="border border-black/10 p-8 h-full flex flex-col justify-between"><div><h3 class="text-2xl font-display-semi text-black-chocolate mb-5">GIC, Singapore</h3><p class="text-black/80 text-sm leading-relaxed">Established in 1981 to manage Singapore&#x27;s foreign reserves, GIC strives to achieve good long-term real returns on assets under our management to preserve and enhance the value of Singapore&#x27;s reserves. They have investments in over 40 countries and are headquartered in Singapore, with 10 offices in key financial cities worldwide.</p></div><div class="mt-8"><a target="_blank" class="text-[#B09E81] text-sm underline underline-offset-4 hover:text-[#8C7A5B] transition-colors" href="https://www.gic.com.sg/">Read More</a></div></div></div><div class="embla-projects__slide basis-[85%] md:basis-[calc(33.333%-1rem)] shrink-0 grow-0 min-w-0"><div class="border border-black/10 p-8 h-full flex flex-col justify-between"><div><h3 class="text-2xl font-display-semi text-black-chocolate mb-5">Morgan Stanley</h3><p class="text-black/80 text-sm leading-relaxed">Morgan Stanley mobilizes capital to help governments, corporations, institutions and individuals around the world achieve their financial goals. A consistent industry leader throughout decades in modern finance, Morgan Stanley continues to break new ground in advising, serving and providing new opportunities for its clients.</p></div><div class="mt-8"><a target="_blank" class="text-[#B09E81] text-sm underline underline-offset-4 hover:text-[#8C7A5B] transition-colors" href="https://www.morganstanley.com/">Read More</a></div></div></div><div class="embla-projects__slide basis-[85%] md:basis-[calc(33.333%-1rem)] shrink-0 grow-0 min-w-0"><div class="border border-black/10 p-8 h-full flex flex-col justify-between"><div><h3 class="text-2xl font-display-semi text-black-chocolate mb-5">Meryll Lynch</h3><p class="text-black/80 text-sm leading-relaxed">Merrill Lynch is an American investment management and wealth management division of Bank of America. Along with BofA Securities, the investment banking arm, both firms engage in prime brokerage and broker-dealer activities. The firm is headquartered in New York City</p></div><div class="mt-8"><a target="_blank" class="text-[#B09E81] text-sm underline underline-offset-4 hover:text-[#8C7A5B] transition-colors" href="https://www.ml.com/">Read More</a></div></div></div><div class="embla-projects__slide basis-[85%] md:basis-[calc(33.333%-1rem)] shrink-0 grow-0 min-w-0"><div class="border border-black/10 p-8 h-full flex flex-col justify-between"><div><h3 class="text-2xl font-display-semi text-black-chocolate mb-5">Xander</h3><p class="text-black/80 text-sm leading-relaxed">The Xander Group Inc. is a private equity firm based out of London, the United Kingdom with offices in Singapore and India. It is focused on long-term, value investing, primarily in companies that operate in the infrastructure, hospitality, retail, and real estate markets.</p></div><div class="mt-8"><a target="_blank" class="text-[#B09E81] text-sm underline underline-offset-4 hover:text-[#8C7A5B] transition-colors" href="http://www.xandergroup.com/">Read More</a></div></div></div><div class="embla-projects__slide basis-[85%] md:basis-[calc(33.333%-1rem)] shrink-0 grow-0 min-w-0"><div class="border border-black/10 p-8 h-full flex flex-col justify-between"><div><h3 class="text-2xl font-display-semi text-black-chocolate mb-5">Ireo</h3><p class="text-black/80 text-sm leading-relaxed">Ireo is a leading property developer in India. Since establishing its presence in 2004, it has assembled one of the largest property portfolios in India, with a focus on the Delhi NCR (including Gurgaon), Punjab, Tamil Nadu and Goa regions. The Ireo portfolio is owned by affiliated investment funds that are backed by global blue-chip investors and financial institutions.</p></div><div class="mt-8"><a target="_blank" class="text-[#B09E81] text-sm underline underline-offset-4 hover:text-[#8C7A5B] transition-colors" href="https://www.ireoworld.com/">Read More</a></div></div></div><div class="embla-projects__slide basis-[85%] md:basis-[calc(33.333%-1rem)] shrink-0 grow-0 min-w-0"><div class="border border-black/10 p-8 h-full flex flex-col justify-between"><div><h3 class="text-2xl font-display-semi text-black-chocolate mb-5">Apollo Global Management</h3><p class="text-black/80 text-sm leading-relaxed">Apollo is a high-growth, global alternative asset manager. In their asset management business, they seek to provide our clients excess return at every point along the risk-reward spectrum from investment grade to private equity with a focus on three investing strategies: yield, hybrid, and equity.</p></div><div class="mt-8"><a target="_blank" class="text-[#B09E81] text-sm underline underline-offset-4 hover:text-[#8C7A5B] transition-colors" href="https://www.apollo.com/">Read More</a></div></div></div><div class="embla-projects__slide basis-[85%] md:basis-[calc(33.333%-1rem)] shrink-0 grow-0 min-w-0"><div class="border border-black/10 p-8 h-full flex flex-col justify-between"><div><h3 class="text-2xl font-display-semi text-black-chocolate mb-5">Lumina CloudInfra</h3><p class="text-black/80 text-sm leading-relaxed">Lumina CloudInfra builds high-quality, secure cloud infrastructure in India and the world. With over 175 years of collective industry experience, Lumina’s leadership is among the most reputed in the business. The team is well-versed in developing, leasing and operating data center infrastructure.</p></div><div class="mt-8"><a target="_blank" class="text-[#B09E81] text-sm underline underline-offset-4 hover:text-[#8C7A5B] transition-colors" href="https://www.luminadc.com/">Read More</a></div></div></div><div class="embla-projects__slide basis-[85%] md:basis-[calc(33.333%-1rem)] shrink-0 grow-0 min-w-0"><div class="border border-black/10 p-8 h-full flex flex-col justify-between"><div><h3 class="text-2xl font-display-semi text-black-chocolate mb-5">ALTA CAPITAL</h3><p class="text-black/80 text-sm leading-relaxed">Alta Capital is an investment &amp; asset management firm established in 2021, headquartered in Mumbai, India. They seek to invest in real estate assets and early-stage proptech companies across the capital stack with significant underlying growth potential.</p></div><div class="mt-8"><a target="_blank" class="text-[#B09E81] text-sm underline underline-offset-4 hover:text-[#8C7A5B] transition-colors" href="https://altacaps.com/">Read More</a></div></div></div></div></div></div></div></section><footer class="w-full transition-colors bg-[#FFFAF7] text-black-chocolate"><div class="justify-center sm:justify-between items-center px-6 py-14 grid grid-cols-2 sm:flex flex-wrap gap-10 max-w-3xl mx-auto"></div><div class="transition-colors bg-[#F9F0E9]"><div class="px-4 md:px-12 py-12 grid grid-cols-1 md:grid-cols-[0.8fr_0.8fr_0.8fr_1fr_2fr] gap-10"><div><div class="text-sm font-display-semi tracking-[0.2em] mb-4 transition-colors text-black">VERTICALS</div><ul class="space-y-3 text-sm transition-colors text-black-chocolate"></ul></div><div><div class="text-sm font-display-semi tracking-[0.2em] mb-4 transition-colors text-black">COUNTRIES</div><ul class="space-y-3 text-sm transition-colors text-black-chocolate"></ul></div><div><div class="text-sm font-display-semi tracking-[0.2em] mb-4 transition-colors text-black">QUICK LINKS</div><ul class="space-y-3 text-sm transition-colors text-black-chocolate"><li><a class="hover:text-gold-beige" href="/about">About Us</a></li><li><a class="hover:text-gold-beige" href="/services">Services</a></li><li><a class="hover:text-gold-beige" href="/testimonials">Testimonials</a></li><li><a class="hover:text-gold-beige" href="/media">Media</a></li><li><a class="hover:text-gold-beige" href="/blog">Blogs</a></li><li><a class="hover:text-gold-beige" href="/contact-us">Contact Us</a></li></ul></div><div><div class="text-sm font-display-semi tracking-[0.2em] mb-4 transition-colors text-black">USEFUL LINKS</div><ul class="space-y-3 text-sm transition-colors text-black-chocolate"><li><a class="hover:text-gold-beige" target="_blank" href="https://www.panchshilprivilege.com/">Panchshil Privilege</a></li><li><a class="hover:text-gold-beige" target="_self" href="/meet-the-city">Meet The City</a></li><li><a class="hover:text-gold-beige" target="_self" href="/prec">PREC</a></li><li><a class="hover:text-gold-beige" target="_self" href="/clients">Clients</a></li><li><a class="hover:text-gold-beige" target="_self" href="/awards-and-recognitions">Awards</a></li><li><a class="hover:text-gold-beige" target="_self" href="/esg">ESG</a></li></ul></div><div><div class="text-sm font-display-semi tracking-[0.2em] mb-4 transition-colors text-black">STAY IN THE KNOW</div><form class="space-y-1"><div class="flex items-center gap-3  pb-2"><input type="email" placeholder="Email Address" required="" class="bg-transparent outline-none text-sm flex-1 border-b transition-colors placeholder-black/50 border-gold-beige text-black-chocolate" name="subscriber_email_id"/><button type="submit" class="text-sm underline cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed transition-colors text-gold-beige">Submit</button></div><p class="text-[11px] leading-relaxed tracking-wider transition-colors text-black-chocolate/70">By signing up I want to hear about new updates and masterpieces and agree with the<!-- --> <a class="underline" target="_blank" href="/privacy-policy">data protection policy</a> <!-- -->of panchshil</p></form></div></div></div><div class="transition-colors bg-[#35393B] text-white"><div class=" mx-auto px-6 py-4 flex items-center justify-between gap-6"><div class="text-[12px] font-display-semi">PANCHSHIL © <!-- -->2026<!-- --> - Designed &amp; Developed by<!-- --> <a href="https://www.theneontree.in/" target="_blank">The Neon Tree</a></div><div class="hidden md:flex items-center gap-6 text-[12px] transition-colors opacity-90"><a class="hover:text-gold-beige" href="/terms-and-conditions"> <!-- -->Term Of Use</a><a class="hover:text-gold-beige" href="/privacy-policy">Privacy</a><a class="hover:text-gold-beige" href="/disclaimer">Disclaimer</a></div><div class="flex items-center gap-3"><a target="_blank" rel="noopener noreferrer" aria-label="Facebook" href="https://www.facebook.com/panchshilrealty/"><div class=""><img alt="Facebook" loading="lazy