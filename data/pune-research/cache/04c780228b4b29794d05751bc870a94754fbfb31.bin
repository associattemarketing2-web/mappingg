<!-- ACCORDION DROPDOWN HEADER MENU START-->
<script>
  $(function() {
    var Accordion = function(el, multiple) {
        this.el = el || {};
        this.multiple = multiple || false;

         
        var links = this.el.find('.dropdown-menu__link');
         
        links.on('click', {el: this.el, multiple: this.multiple}, this.dropdown)
    }

    Accordion.prototype.dropdown = function(e) {
        var $el = e.data.el;
            $this = $(this),
            $next = $this.next();

        $next.slideToggle();
        $this.parent().toggleClass('isOpen');

        if (!e.data.multiple) {
            $el.find('.dropdown-menu__submenu').not($next).slideUp().parent().removeClass('isOpen');
        };
    }   

    var accordion = new Accordion($('.dropdown-accordion'), false);
});
</script> 
<!-- ACCORDION DROPDOWN HEADER MENU END-->

