	<div id="AGoG-ZyZE-mbQg-UBhT" class="Special-Embed-Code ">
		<div class="embed_container" style="position: static; z-index: 1;"><script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;800&amp;display=swap" rel="stylesheet">


<script type="text/javascript">
    function conv_number(expr, decplaces) {
        var str = "" + Math.round(eval(expr) * Math.pow(10, decplaces));
        while (str.length <= decplaces) {
            str = "0" + str;
        }

        var decpoint = str.length - decplaces;
        return (str.substring(0, decpoint) + "." + str.substring(decpoint, str.length));
    }
    function pv(rate, nper, pmt, fv) {
        rate = parseFloat(rate);
        nper = parseFloat(nper);
        pmt = parseFloat(pmt);
        fv = parseFloat(fv);
        if (nper == 0) {
            alert("Why do you want to test me with zeros?");
            return (0);
        }
        if (rate == 0) { // Interest rate is 0
            pv_value = -(fv + (pmt * nper));
        } else {
            x = Math.pow(1 + rate, -nper);
            y = Math.pow(1 + rate, nper);
            pv_value = - (x * (fv * rate - pmt + y * pmt)) / rate;
        }
        pv_value = conv_number(pv_value, 2);
        return (pv_value);
    }

    function calculateEMI() {
        var principal = $('#emi_amount').val();
        var interest = parseFloat($('#emi_rate').val()) / 100 / 12;
        var payments = parseInt($('#emi_months').val());
        var y = parseFloat(Math.pow(1 + interest, payments));
        var emi = parseFloat((principal * y * interest) / (y - 1));

        var final_emi = Math.round(emi);
        var final_amt = Math.round(parseFloat(emi) * parseFloat(payments));
        var final_int = Math.round(parseFloat(final_amt) - parseFloat(principal));

        $('#emi_monthly').html('₹ ' + final_emi);
        $('#emi_total_interest').html('₹ ' + final_int);
        $('#emi_total_amount').html('₹ ' + final_amt);
    }

    function calculateGold() {
        var gold = parseFloat($('#gold_in_grams').val());
        var cost = parseFloat($('#gold_cost').val());
        var total = Math.round(gold * cost);

        $('#gold_total').html('₹ ' + total);
    }

    function calculateEligibility() {
        var gross = parseInt($('#elig_gross_salary').val());
        var net = parseInt($('#elig_net_salary').val());
        var int = parseFloat($('#elig_rate').val());
        var month = parseInt($('#elig_months').val());
        var allowed = parseInt(gross * 70 / 100);
        var monthly = parseInt(allowed - (gross - net));

        var total = pv(int / 1200, month, -monthly, 0);
        // var y 		= parseFloat(Math.pow(1+ int, month));
        // var emi  	= parseFloat((principal*y*interest)/(y-1));


        $('#elig_allowed').html('₹ ' + allowed);
        $('#elig_monthly').html('₹ ' + monthly);
        $('#elig_total').html('₹ ' + total);
    }

    (function () {
        var a = setInterval(function () {
            if (typeof window.jQuery === 'undefined') {
                return;
            }
            clearInterval(a);

            console.log('jQuery is loaded'); // call your function with jQuery instead of this

            $('#QAcC-cGBp-UZXv-UUqo > a:nth-child(2) ').click(function () {
                $('.custom_calculator_container').fadeIn();
                return false;
            });


        }, 500);
    })();
</script>

<style type="text/css">
    .Special-Emi-Calculator-1-v1 .overlay {
        display: none !important;
        opacity: 0 !important;
    }

    .Special-Emi-Calculator-1-v1 .grid {
        display: none !important;
        opacity: 0 !important;
    }

    .custom_calculator_container {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.9);
        overflow: auto;
        z-index: 99999;
        font-family: Montserrat;
    }

    .custom_calculator_container .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-areas:
            'eligibility eligibility'
            'emi gold';
        grid-gap: 10px;
        padding: 20px;
        padding-top: 20px;
        max-width: 800px;
        margin: auto;
    }

    .custom_calculator_container .grid>div {
        background-color: white;
    }

    .custom_calculator_container .grid>div h1 {
        /*background-color: #424242;*/
        color: #424242;
        text-align: center;
        margin: 0px;
        padding: 10px;
        font-size: 14px;
        font-weight: bold;
    }

    .custom_calculator_container .grid>div:nth-child(1) {
        grid-area: emi;
    }

    .custom_calculator_container .grid>div:nth-child(2) {
        grid-area: gold;
    }

    .custom_calculator_container .grid>div:nth-child(3) {
        grid-area: eligibility;
    }

    .custom_calculator_container .grid .col2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .custom_calculator_container .inputs_container {
        padding: 20px;
        text-align: center;
        background-color: white !important;
    }

    .custom_calculator_container .inputs_container label {
        display: block;
        width: 100%;
        margin-top: 20px;
    }

    .custom_calculator_container .inputs_container span {
        font-weight: 400;
    }

    .custom_calculator_container .inputs_container input {
        display: block;
        width: 100%;
        border: none;
        border-bottom: 1px solid #ccc;
        outline: none;
        text-align: center;
        font-weight: 600;
        background: transparent;
    }

    .custom_calculator_container .details_container {
        padding: 20px;
        text-align: center;
        color: white;
        background-color: #941116 !important;
    }

    .custom_calculator_container .details_container h2 {
        font-size: 15px;
        margin-bottom: 5px;
    }

    .custom_calculator_container .details_container p {
        font-weight: bold;
        font-size: 20px;
    }

    .custom_calculator_container .close {
        position: fixed;
        top: 10px;
        right: 30px;
        font-size: 30px;
        color: white;
        opacity: 1;
        z-index: 100;
    }

    @media screen and (max-width: 600px) {
        .custom_calculator_container .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-areas:
                'eligibility eligibility'
                'emi emi'
                'gold gold';
        }

        .custom_calculator_container .grid .col2 {
            /*grid-template-columns: 1fr;*/
        }
    }

    .custom_calculator_container .disclaimer {
        max-width: 750px;
        margin: auto;
        color: white;
        margin-bottom: 40px;
    }
    .head-emicalc {
        color: #424242;
    text-align: center;
    margin: 0px;
    padding: 10px;
    font-size: 14px;
    font-weight: bold;
    }


</style>

