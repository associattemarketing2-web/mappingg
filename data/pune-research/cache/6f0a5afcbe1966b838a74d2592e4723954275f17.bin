<div class="aem-Grid aem-Grid--12 aem-Grid--default--12 ">
    
    <div class="related-content-container container responsivegrid aem-GridColumn aem-GridColumn--default--12">

    <div class="cmp-related-container 
                theme-glass 
                cards-total-3
                hero-image-middle
                pretitle-generic
                sec-hide-desc-false
                sec-hide-date-false
                sec-hide-author-false">
         
        
            <div class="related-content-card">
    
    
    <div class="cmp-related-card cmp-related-card--primary bright-blue-purple">
        <div class="cmp-related-card__content">            
            
            <div class="cmp-related-card__header">
                <span class="cmp-related-card__pretitle pt-dynamic">Blog</span>
                <span class="cmp-related-card__pretitle pt-generic">Blog</span>
                
                <div class="cmp-related-card__title">
                    <a href="/blog/introducing-druva-azure-gov" class="cmp-related-card__link-overlay">Introducing Druva for Azure Government: Cross-Cloud Cyber Resilience for Mission-Critical Workloads</a>
                </div>
