            url: "https://naiknavare.com/send_complain",
            data: {
                'name4': name4,
                'email4': email4,
                'phone4': phone4,
                'city4': city4,
                'flat4': flat4,
                'property4': property4,
                'response4': response4,
                'g_recaptcha': g_recaptcha
            },
            success: function(response) {
                console.log(response);
                if (response.status == true) {
                    alert("Your Enquiry has been sent successfully ..!");
                    $("#customer_complain").modal(close);
                    $("#complainform").trigger("reset");
                    $("#error4").html("");
                    $("#complain").html('Submit');
                    $('#complain').prop('disabled', false);
                    $('#customer_complain').modal('hide');
                } else if (response.status == false) {
                    alert("Something went wrong, Please try again ..!");
                    $("#complainform").trigger("reset");
                    $("#complain").html('Submit');
                    $('#complain').prop('disabled', false);

                } else {
                    alert(response);
                }
            }
        });
    });
</script>

<script>
    $(".videotab img, #videotab .item img, a[href='#co_video'], #cv .carousel-item img, #team .item img, .al img").click(function() {
        var a = $(this).attr('data-src');
        var b = $(this).next("h6").text();
        var c = $(this).next("p").text();
        //alert(c);
        $("#v_section").modal();

        $("#v_section .modal-body").html("<iframe id='popup-youtube-player' width='100%' height='450' src='https://www.youtube.com/embed/" + a + "?enablejsapi=1&version=3' frameborder='0' allowfullscreen></iframe>");
        if (b) {
            $("#v_section .modal-title").text(b);
        } else if (c) {
            $("#v_section .modal-title").text(c);
        } else {
            $("#v_section .modal-title").text('Corporate Video');
        }


    });

    function jump() {
        $("#v_section .modal-body").html("");
    }
</script>

