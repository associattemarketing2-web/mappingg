<script>
    function showData() {
        const button = document.getElementById('toggleButton');
        const content = document.getElementById('dataContent');
        if (content) {
            content.style.display = 'block'; 
        }
    
        if (button) {
            button.style.display = 'none';
        }
    }
    const modalSubscribe = document.getElementById('modal-subscribe');
    
    // Listen for clicks outside the modal
    modalSubscribe.addEventListener('click', (event) => {
        const modalDialog = modalSubscribe.querySelector('.modal-dialog');
        if (!modalDialog.contains(event.target)) {
            const modalInstance = bootstrap.Modal.getInstance(modalSubscribe);
            modalInstance.hide(); // Close the modal
        }
    });
</script>
<style>
#toggleContent {
    transition: all 0.3s ease;
}
</style>
<!-- SCROLL TO TOP BTN START -->
<script>
// Get the button
let mybutton = document.getElementById("scrollToTop");

// When the user scrolls down 20px from the top of the document, show the button
window.onscroll = function() {
    scrollFunction()
};

function scrollFunction() {
    if (document.body.scrollTop > 600 || document.documentElement.scrollTop > 600) {
        mybutton.style.display = "block";
    } else {
        mybutton.style.display = "none";
    }
}

// When the user clicks on the button, scroll to the top of the document
function topFunction() {
    document.body.scrollTop = 0;
    document.documentElement.scrollTop = 0;
}
</script>
