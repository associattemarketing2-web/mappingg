<div class="awards-list">
<div class="cmp-awards-list" data-awards="/content/dam/druvaincprogram/content-fragments/awards" data-resource-path="/content/druvaincprogram/us/en/why-druva/about/awards-and-accolades/jcr:content/root/container/container/container_2061411862/container/awards_list">
  <div class="cmp-awards-list__filter"></div>
  <div class="cmp-awards-list__container"></div>
</div>
<script id="awards-list-filter-tmpl" type="text/x-handlebars-template">
  <p class="cmp-awards-list__filter__label cmp-card-list__filter__label">Filter<span class="druva-hide-mobile"> by</span></p>
  {{#each this}}
    {{#if this.filters}}
      {{> awardsFilterPartial}}
    {{/if}}
  {{/each}}
</script>
<script id="awards-list-filter-partial" type="text/x-handlebars-template">
  {{#if pill}}
    <div class="cmp-card-list__filter__pill {{@key}}">
      <ul>
        <li>
            <label>
              <input type="checkbox" name="{{@key}}" value="" checked/>
              <span>All</span>
            </label>
          </li>
        {{#each filters}}
          <li class="{{toLowercase this}}">
            <label>
              <input type="checkbox" name="{{@../key}}" value="{{this}}" />
              <span>{{this}}</span>
            </label>
          </li>
        {{/each}}
      </ul>
    </div>
  {{else}}
  <div class="cmp-card-list__filter__dropdown {{@key}}">
    <p class="cmp-card-list__filter__dropdown__title">{{title}}</p>
    <ul>
      {{#each filters}}
        <li>
          <label>
            <input type="checkbox" value="{{this}}" />
            <span>{{this}}</span>
          </label>
        </li>
      {{/each}}
    </ul>
  </div>
  {{/if}}
</script>
<script id="awards-list-card-tmpl" type="text/x-handlebars-template">
  {{#each cards}}
    <div class="cmp-awards-list__card {{toLowercase this.category}}">
      <p class="cmp-awards-list__card--eyebrow">{{this.category}}</p>
      <a class="cmp-awards-list__card--image" href="{{this.url}}" {{#if is-external}}target="_blank"{{/if}}><img src="{{this.thumbnail}}" /></a>
      <div class="cmp-awards-list__card--title"><a href="{{this.url}}" {{#if is-external}}target="_blank"{{/if}}>{{this.title}}</a></div>
    </div>
  {{/each}}
</script>

<script id="pagination-pages-tmpl" type="text/x-handlebars-template">
  {{#each pages}}
    {{#if @first}}
      <a class="cmp-pagination__page prev {{#if this.active}}disabled{{/if}}" href="#" data-page="prev" aria-label="Previous page"></a>
      <a class="cmp-pagination__page first {{#if this.active}}active{{/if}}" href="#" data-page="{{@index}}">{{this.number}}</a>
      {{#if ../showDots}}<span class="cmp-pagination__page-dots first {{#if this.active}}hidden{{/if}}">…</span>{{/if}}
    {{else if @last}}
      {{#if ../showDots}}<span class="cmp-pagination__page-dots last {{#if this.active}}hidden{{/if}}">…</span>{{/if}}
      <a class="cmp-pagination__page last {{#if this.active}}active{{/if}}" href="#" data-page="{{@index}}">{{this.number}}</a>
      <a class="cmp-pagination__page next {{#if this.active}}disabled{{/if}}" href="#" data-page="next" aria-label="Next page"></a>
    {{else}}
      <a class="cmp-pagination__page middle {{#if this.active}}active{{/if}}{{#if this.hidden}}hidden{{/if}}" href="#" data-page="{{@index}}">{{this.number}}</a>
    {{/if}}
  {{/each}}
</script>


</div>

        
    </div>

</div>

        
    </div>

</section>
