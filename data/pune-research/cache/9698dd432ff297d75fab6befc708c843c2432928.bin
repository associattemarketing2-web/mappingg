            filtersRadioButton.forEach((eachValue) => {
                eachValue.addEventListener("click", function (e) {
                    currentValue = e.target.value;
                });
            });

            applyBtn.addEventListener('click', function (e) {
                switch (currentValue) {
                    case 'Mumbai':
