            <script>
        $(document).on('click', '.btn_filter', function(){
            var location_id = $(this).attr('data-location');

            if(location_id == 'location1'){
                $("#location1").show();
                $("#location2").hide();

                $("#mumbaiShowBtn").addClass('active');
                $("#puneShowBtn").removeClass('active');
            }else{
                $("#location2").show();
                $("#location1").hide();

                $("#mumbaiShowBtn").removeClass('active');
                $("#puneShowBtn").addClass('active');
            }
        });
    </script>

                    <script>
                let check = localStorage.getItem("disclaimerShown");
                if (!check) {
                    setTimeout(() => {
                        $('.disclaimerModal').modal('show');
                    }, 1500);
                }

                $(".disclaimerModal .lineBtn").click(function (e) {
                    e.preventDefault();
                    $('.disclaimerModal').modal('hide');
                    localStorage.setItem("disclaimerShown", "true");
                });
                
            </script>
            
