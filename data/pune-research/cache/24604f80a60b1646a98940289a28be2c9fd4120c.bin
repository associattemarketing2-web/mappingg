                        }

                        //check if any hidden item left
                        var hidden_item = false;
                        $('#EALY-AYUt-GKez-YEJh .Img-Title-Intro-UI-1-v1').each(function(){ 
                             if($(this).css('display') == 'none'){
                                hidden_item = true;
                                return false;
                             }
                        });
                        if(hidden_item == false){
                            $('#EALY-AYUt-GKez-YEJh .Img-Title-Intro-UI-1-v1_load_more').hide();
                        }else{
                            $('#EALY-AYUt-GKez-YEJh .Img-Title-Intro-UI-1-v1_load_more').removeClass('Img-Title-Intro-UI-1-v1_load_more_active').text('load more');
                        }
                    },1000);
                });
            }
        }
    });

</script>
