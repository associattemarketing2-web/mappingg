            <input type="hidden" name="consent" id="consentHidden" value="0">
            <!-- Checkbox input to send "1" when checked -->
            <input 
                name="consent" 
                required 
                type="checkbox" 
                class="form-check-input" 
                id="consent" 
                value="1" 
                
            >
