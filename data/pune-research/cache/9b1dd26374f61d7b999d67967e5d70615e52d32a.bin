		<script>
			// Quick fix: Remove country lists from hidden forms on page load
			// This runs AFTER all.min.js has initialized everything
			$(window).on('load', function(){
					// Override intlTelNumber validator to allow all starting digits
			if ($.validator && $.validator.methods) {
				$.validator.methods.intlTelNumber = function(value, element) {
					return this.optional(element) || $.trim(value).replace(/\D/g, '').length >= 7;
				};
			}
			// Remove country lists from hidden modal forms
			$('#header_enquire .country-list, #schedule_visit .country-list, #down_broch .country-list').remove();
			
			// Re-init when modal opens
			function reInitTel(formId, inputName) {
				var $input = $(formId + ' :input[name=' + inputName + ']');
				if ($input.length && !$input.closest('.intl-tel-input').find('.country-list').length) {
				$input.intlTelInput('destroy');
				$input.intlTelInput({
					geoIpLookup: function(){},
					initialCountry: "in",
					nationalMode: false,
					autoHideDialCode: false,
					separateDialCode: true,
					utilsScript: "/assets/dist/vendor/utils.js"
				});
				}
			}
			
			$(document).on('click', '.eqfrm', function(){ reInitTel('#header_enquire', 'phone'); });
			$('#schedule_visit').on('show', function(){ reInitTel('#schedule_visit', 'psv_phone'); });
			$('#down_broch').on('show', function(){ reInitTel('#down_broch', 'db_phone'); });
			});
		</script>

	</body>

