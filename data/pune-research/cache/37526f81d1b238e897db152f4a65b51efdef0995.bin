  <style>

.hero-main-ctn * {
  margin: 0;
//  padding: 0;
//  box-sizing: border-box;
}

.hero-main-ctn {
  display: flex;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  flex-direction: column;
  color: #fff;
  align-items: center;
  min-height: 750px;
  overflow: hidden;
}

.hero-background {
  position: absolute;
  top: 0;
  width: 1200px;
  height: 470px;
  border: none;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.hero-content-ctn {
  display: flex;
  flex-direction: column;
  gap: 25px;
  text-align: center;
  z-index: 2;
  width: 100%;
  padding: 55px 30px 10px;
  align-items: center;
}

.hero-title {
  font-size: 75px !important;
  line-height: 1 !important;
  font-weight: 300 !important;
  max-width: 800px;
}

.hero-subtitle {
  font-size: 22px !important;
  font-weight: 300 !important;
  max-width: 800px;
}

.hero-content-button-ctn {
  display: flex;
  gap: 20px;
  justify-content: center;
  pointer-events: auto;
}

.hero-content-ctn .cmp-teaser__action-container.center-buttons .button-1.button.cmp-button__size-large.cmp-button__font-bold.cmp-button__bg-orange.cmp-button__text-white.cmp-button__orange-border.cmp-button__hover-bg-transparent.cmp-button__hover-text-orange .cmp-button{
  border-color: #fff;
  border: 1.5px solid #fff;
}

.hero-button:hover {
  background-color: #ff9900;
  color: #000;
  border-color: #ff9900;
}

.hero-button.secondary {
  background-color: #ff9900;;
  color: #000;
}

.hero-button.secondary:hover {
  background-color: #e47800;
}

.pillar-tiles-ctn {
  position: absolute;
  height: 100%;
  width: 100%;
  display: flex;
  bottom: 0;
  gap: 10px;
}

.pillar-tile {
  position: relative;
  width: 25%;
  height: 100%;
  background: linear-gradient(157deg, rgba(0, 8, 51, 0.00) 15%, rgba(0, 13, 161, 0.5) 100%);
  display: flex;
  gap: 15px;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  z-index: 0;
  border-radius: 0 0 50px 50px;
  text-align: center;
  padding: 40px 0;
  backdrop-filter: blur(10px);
  text-decoration: none;
  color: #fff;
}

.pillar-tile::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 0 0 50px 50px;
  padding: 1.5px;
  background: linear-gradient(
    135deg, 
    rgba(255, 255, 255, 0) 0%, 
    rgba(255, 255, 255, 0) 70%, 
    rgba(255, 255, 255, 0.4) 100%
  );
  -webkit-mask: 
    linear-gradient(#fff 0 0) content-box, 
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
          mask-composite: exclude;
}

.pillar-tile:hover {
  background: linear-gradient(200deg, rgba(0, 8, 51, 0.00) 20%, rgba(40, 165, 249, 0.8) 100%);
  cursor: pointer;
}

.pillar-icon {
  width: 100px;
  height: 100px;
  transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1);
  transform: translateY(50px);
}

.pillar-tile-title {
  font-size: 24px !important;
  font-weight: 300;
  transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1);
  transform: translateY(50px);
}

.pillar-tile-desc {
  font-size: 16px !important;
  font-weight: 300;
  max-width: 210px;
  opacity: 0;
  transform: translateY(15px);
  pointer-events: none;
  transition: opacity 0.8s ease, transform 1.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.pillar-tile:hover .pillar-icon, .pillar-tile:hover .pillar-tile-title {
  transform: translateY(0);
}

.pillar-tile:hover .pillar-tile-desc {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 1025px) {
  .pillar-tile-title {
    font-size: 20px !important;
  }
}

@media (max-width: 845px) {
  .hero-main-ctn {
    min-height: 700px;
  }
  .hero-background {
    top: -30px;
  }
  .hero-content-ctn {
    padding-top: 40px;
  }
  .hero-title {
    font-size: 60px !important;
    max-width: 640px;
  }
  .hero-subtitle {
    font-size: 18px !important;
    max-width: 620px;
  }
  .pillar-tile-desc {
    font-size: 14px !important;
    max-width: 180px;
  }
}

@media (max-width: 768px) {
  .hero-main-ctn {
    min-height: 600px;
  }
  .hero-background {
    top: -75px;
  }
  .hero-content-ctn {
    gap: 15px;
  }
  .hero-title {
    font-size: 45px !important;
  }
  .hero-button {
    font-size: 16px;
    padding: 10px;
    min-width: 180px;
  }
  .pillar-tiles-ctn {
    gap: 5px;
  }
  .pillar-tile {
    border-radius: 0 0 30px 30px;
  }
  .pillar-tile::after {
    border-radius: 0 0 30px 30px;
  }
  .pillar-icon {
    width: 80px;
    height: 80px;
  }
  .pillar-tile-title {
    font-size: 16px !important;
    padding: 0 5px;
  }
  .pillar-tile-desc {
    display: none;
  }
  .pillar-icon, .pillar-tile-title {
    transform: translateY(0);
  }
  .pillar-tile:hover .pillar-icon, .pillar-tile:hover .pillar-tile-title {
    transform: translateY(0);
  }
}

</style>

