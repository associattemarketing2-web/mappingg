	<style>
		.committees .uk-accordion-title {
			border: none;
		}

		.investor_bg_image {
			background: url('/site/templates/assets/images/investor_new_bg.jpg');
			background-size: cover;
			background-position: bottom;
			background-repeat: no-repeat;
			width: 100%;
			height: 30vh;
		}

		.investor_bg_overlay {
			width: 100%;
			height: inherit;
			background-color: #0079b6bd;
		}

		.investor_headline {
			display: flex;
			align-items: center;
			justify-content: center;
			height: inherit;
		}

		.investor_headline h1 {
			font-size: 48px !important;
		}

		.investor_horizontal_menu {
			bottom: 28px;
		}

		.investor_horizontal_menu ul {
			background: #e3f6ff;
			padding-left: 0;
			padding: 12px 16px;
			border-radius: 50px;
		}

		.investor_horizontal_menu ul li {
			margin: 2px 15px;
		}

		.investor_horizontal_menu ul li a {
			color: #000;
			font-weight: bold;
		}

		.investor_horizontal_menu ul li a:hover {
			color: #008fd1;
		}

		@media screen and (max-width: 769px) {
			.investor_bg_image {
				height: 20vh;
			}

			.investor_horizontal_menu {
				display: none;
			}
		}
	</style>
