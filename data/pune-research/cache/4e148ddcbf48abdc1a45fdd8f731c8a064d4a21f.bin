-center gap-3 h-[380px]"><div class="relative lg:h-[22.083vw] lg:w-[14.792vw] w-[200px] h-[350px] overflow-hidden"><img alt="Trust by Design" loading="lazy" decoding="async" data-nimg="fill" class="object-cover clip-image" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fwc1_e52441ad5a.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fwc1_e52441ad5a.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fwc1_e52441ad5a.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fwc1_e52441ad5a.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fwc1_e52441ad5a.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fwc1_e52441ad5a.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fwc1_e52441ad5a.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fwc1_e52441ad5a.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fwc1_e52441ad5a.png&amp;w=3840&amp;q=75"/></div><h3 class="lg:text-[1.302vw] text-[20px] font-[500] text-[#7B766C]">Trust by Design</h3><div class="lg:text-[0.833vw] text-[16px] text-[#5F5F5F]"><p style="text-align:center;">Four decades of trust, transparency, and timely delivery - the cornerstone of Pristine Properties legacy.</p></div><div class="bg-white rounded-t-[999px] rounded-b-[10px] lg:h-[24.5vw] h-[380px] w-full absolute bottom-0 -z-10"></div></div></div><div class="swiper-slide"><div class="relative py-[2vw] text-center flex flex-col items-center gap-3 h-[380px]"><div class="relative lg:h-[22.083vw] lg:w-[14.792vw] w-[200px] h-[350px] overflow-hidden"><img alt="Timeless Architecture" loading="lazy" decoding="async" data-nimg="fill" class="object-cover clip-image" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_17_4cfbff3fd7.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_17_4cfbff3fd7.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_17_4cfbff3fd7.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_17_4cfbff3fd7.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_17_4cfbff3fd7.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_17_4cfbff3fd7.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_17_4cfbff3fd7.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_17_4cfbff3fd7.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_17_4cfbff3fd7.png&amp;w=3840&amp;q=75"/></div><h3 class="lg:text-[1.302vw] text-[20px] font-[500] text-[#7B766C]">Timeless Architecture</h3><div class="lg:text-[0.833vw] text-[16px] text-[#5F5F5F]"><p style="text-align:center;"><span style="background-color:transparent;">Thoughtful planning, global aesthetics, and biophilic design - creating homes that breathe and belong.</span></p></div><div class="bg-white rounded-t-[999px] rounded-b-[10px] lg:h-[24.5vw] h-[380px] w-full absolute bottom-0 -z-10"></div></div></div><div class="swiper-slide"><div class="relative py-[2vw] text-center flex flex-col items-center gap-3 h-[380px]"><div class="relative lg:h-[22.083vw] lg:w-[14.792vw] w-[200px] h-[350px] overflow-hidden"><img alt="Engineering Excellence" loading="lazy" decoding="async" data-nimg="fill" class="object-cover clip-image" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_16_1_8c770a03f6.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_16_1_8c770a03f6.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_16_1_8c770a03f6.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_16_1_8c770a03f6.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_16_1_8c770a03f6.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_16_1_8c770a03f6.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_16_1_8c770a03f6.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_16_1_8c770a03f6.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fbackend.pristinepune.com%2Fuploads%2Fimage_16_1_8c770a03f6.png&amp;w=3840&amp;q=75"/></div><h3 class="lg:text-[1.302vw] text-[20px] font-[500] text-[#7B766C]">Engineering Excellence</h3><div class="lg:text-[0.833vw] text-[16px] text-[#5F5F5F]"><p style="text-align:center;"><span style="background-color:transparent;">Behind every landmark lies our quiet obsession with detail - the kind that endures over generations.</span></p></div><div class="bg-white rounded-t-[999px] rounded-b-[10px] lg:h-[24.5vw] h-[380px] w-full absolute bottom-0 -z-10"></div></div></div><div class="swiper-slide"><div class="relative py-[2vw] text-center flex flex-col items-center gap-3 h-[380px]"><div class="relative lg:h-[22.083vw] lg:w-[14.792vw] w-[200px] h-[350px] overflow-hidden"><img alt="People First" loadi