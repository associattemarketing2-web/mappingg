<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
	<div class="modal-dialog enq-dia">
		<div class="modal-content enq-con">
			<div class="modal-header enq-he">
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">x</button>
				<h4 class="modal-title enq-tl">Enquire Now!</h4>
			</div>
			<div class="modal-body enq-bdy">
				<form action="#" name="Enquerinow" id="Enquerinow" method="post" class="wpcf7-form"
					novalidate="novalidate">
					<div class="form-group">
						<label>Name</label>
						<span id="fname-info" class="info"></span>
						<input type="text" name="Name" value="" size="40" autocomplete="off" id="fname"
							class="form-control enq-frm">
					</div>
					<div class="form-group">
						<label>Email</label>
						<span id="Email-info" class="info"></span>
						<input type="text" name="Email" autocomplete="off" id="Email" value=""
							class="form-control enq-frm">
					</div>
					<div class="form-group">
						<label>Phone</label>
						<span id="Phone-info" class="info"></span>
						<input type="text" name="phone" id="Phone" autocomplete="off" value="" size="40" maxlength="10"
							minlength="10" class="form-control enq-frm">
					</div>
					<div class="form-group">
						<label>Message</label>
						<span id="Message-info" class="info"></span>
						<textarea class="form-control frm-txt" name="Message" autocomplete="off" id="Message" cols="40"
							rows="10"></textarea>
					</div>
					<div class="form-group">
						<input type="hidden" name="utm_source" value="">
						<input type="hidden" name="utm_medium" value="">
						<input type="hidden" name="utm_campaign" value="">
						<input type="hidden" name="utm_term" value="">
						<input type="hidden" name="utm_content" value="">
						<input type="hidden" name="website" value="magarpatta">
						<input type="submit" name="submit" class="sub_btn">
					</div>
					<div id="mail-status"></div>
			</div>
			</form>
		</div><!-- /.modal-content -->
	</div><!-- /.modal-dialog -->
</div><!-- /.modal -->
<!-- Modal HTML -->
<div id="myVideoModal" class="modal fade">
	<div class="modal-dialog modal-md">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
				<!--<h4 class="modal-title">YouTube Video</h4>-->
			</div>
			<div class="modal-body">
				<a href="http://magarpattacitygroup.com/" target="_blank">
					<img src="https://magarpattacity.com/wp-content/uploads/2025/12/mcg-foundationday27_popup.webp" alt="Foundation Day 27"
						class="img-responsive">
					<!-- 						<img src="https://nandedcitypune.com/wp-content/uploads/2024/01/Website-pop-up-size-1000-x-700.jpg" class="img-responsive" > -->
				</a>
				<!--<iframe id="cartoonVideo" width="560" height="315" src="//www.youtube.com/embed/eg7IiLGGxHo?autoplay=1" frameborder="0" allowfullscreen></iframe>-->
			</div>
		</div>
	</div>
</div>
<script type="text/javascript">
	$(window).on('load', function () {
		$('#myVideoModal').modal('show');
	});
	//  $("#myVideoModal").on('hidden.bs.modal', function (e) {
	//     // Invoke your server side code here.
	// });
	// $("#myVideoModal").modal("hide");
	/* Get iframe src attribute value i.e. YouTube video url
and store it in a variable */
	var url = $("#cartoonVideo").attr('src');
	/* Remove iframe src attribute on page load to
	prevent autoplay in background */
	$("#cartoonVideo").attr('src', '');
	/* Assign the initially stored url back to the iframe src
	attribute when modal is displayed */
	$("#myVideoModal").on('shown.bs.modal', function () {
		$("#cartoonVideo").attr('src', url);
	});
	/* Assign empty url value to the iframe src attribute when
	modal hide, which stop the video playing */
	$("#myVideoModal").on('hide.bs.modal', function () {
		$("#cartoonVideo").attr('src', '');
	});
</script>
<script>
	$(document).ready(function (e) {
		$("#Enquerinow").on('submit', (function (e) {
			e.preventDefault();
			var valid;
			valid = validateContact();
			if (valid) {
				var form = $('#Enquerinow')[0];
				$.ajax({
					url: "https://magarpattacity.com/webenqiries/enquirydata.php",
					type: "POST",
					data: new FormData(form),
					contentType: false,
					cache: false,
					processData: false,
					success: function (data) {
						if (data == '1') {
							$("#mail-status").html('Emailid already exists');
						}
						else {
							$("#mail-status").html('');
							window.location.href = "https://magarpattacity.com/thank-you/";
						}
					},
					error: function () { }
				});
			}
		}));
		function validateContact() {
			var valid = true;
			$(".demoInputBox").css('background-color', '');
			$(".info").html('');
			if (!$("#fname").val()) {
				$("#fname-info").html("<i class='fa fa-exclamation-circle'></i> Required");
				$("#fname").css('background-color', '#FFFFDF');
				valid = false;
			}
			if (!$("#Phone").val()) {
				$("#Phone-info").html("<i class='fa fa-exclamation-circle'></i> Required");
				$("#Phone").css('background-color', '#FFFFDF');
				valid = false;
			}
			if (!$("#Phone").val().match(/^\d{10}$/)) {
				$("#Phone-info").html("<i class='fa fa-exclamation-circle'></i> Invalid");
				$("#Phone").css('background-color', '#FFFFDF');
				valid = false;
			}
			if (!$("#Email").val()) {
				$("#EmailEmail-info").html("<i class='fa fa-exclamation-circle'></i> Required");
				$("#Email").css('background-color', '#FFFFDF');
				valid = false;
			}
			if (!$("#Email").val().match(/^\s*(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))\s*$/)) {
				$("#Email-info").html("<i class='fa fa-exclamation-circle'></i> Invalid");
				$("#Email").css('background-color', '#FFFFDF');
				valid = false;
			}
			if (!$("textarea#Message").val()) {
				$("#Message-info").html("<i class='fa fa-exclamation-circle'></i> Required");
				$("#Message").css('background-color', '#FFFFDF');
				valid = false;
			}
			if (!valid) {
				$("#allrroer-info").html("<i class='fa fa-exclamation-circle'></i> One or more fields have an error. Please check and try again.");
			}
			return valid;
		}
	});


	function tabJump(tabId, showId) {

    // alert(tabId);
    // alert($('ul li[id="' + tabId + '"]'));
    // alert($('li').attr('aria-labelledby'));
	$("#tabs ul li").removeClass("ui-state-active");
    // Adding the active class to the selected tab
    $("#tabs ul li[id='" + tabId + "']").addClass("ui-state-active");
    // Removing the active class from previously active tabs
    // $("#menu_wrapper>ul>li.active").removeClass("ui-state-active");
	$(".ui-tabs-panel").hide();
    // You might want to toggle visibility here if that's the intent
    $("#" + showId).show(); // Or add an actual class if needed
}

$(document).ready(function () {
    // Event handler for clicking on tabs
    $("#tabs .ui-tabs-nav li a").on("click", function (event) {
        event.preventDefault();
        // Remove active class from all tabs and panels
        $("#tabs ul li").removeClass("ui-state-active");
        $("#tabs ul li a").removeClass("active");
        $(".ui-tabs-panel").hide();

        // Add active class to the clicked tab and show the corresponding panel
        $(this).parent().addClass("ui-state-active");
        $(this).addClass("active");
        $($(this).attr("href")).show();
    });

    // Event handler for clicking on the mega menu items
    $('#mega-menu-item-29 .mega-menu-link').on("click", function (event) {
        event.preventDefault();
        // Remove active class from all tabs and panels
        $("#tabs ul li").removeClass("ui-state-active");
        $("#tabs ul li a").removeClass("active");
        $(".ui-tabs-panel").hide();

        // Get the href attribute value and show the corresponding panel
        var id = $(this).attr("href");
        $("#tabs ul li a[href='" + id + "']").parent().addClass("ui-state-active");
        $("#tabs ul li a[href='" + id + "']").addClass("active");

        $(id).show();
    });
});




</script>
</body>

</html>