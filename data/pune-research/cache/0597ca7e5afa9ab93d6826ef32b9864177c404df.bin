		<div class="error">
			<span class="property_enquiry_full_name_err"></span>
		</div>
	</div>
	<div class="mb-3">
		<input type="email" class="form-control property_enquiry_email_id" placeholder="Email" name="property_enquiry_email_id" >
		<div class="error">
			<span class="property_enquiry_email_id_err"></span>
		</div>
	</div>
	<div class="mb-3">
		<input type="text" class="form-control property_enquiry_phone_number" placeholder="Mobile" name="property_enquiry_phone_number" inputmode="numeric" >
		<div class="error">
			<span class="property_enquiry_phone_number_err"></span>
		</div>
	</div>
	
	<div class="mb-3">
		<select class="form-select property_ids" name="property_ids" title="Property">
			<option value="">Select Property</option>
            
            <option value="68ee13ea57785ba78517f919" >Mantra Mistara</option>
            
