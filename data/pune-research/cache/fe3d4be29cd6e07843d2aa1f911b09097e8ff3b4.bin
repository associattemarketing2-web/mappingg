					<span class='e-n-accordion-item-title-header'><div class="e-n-accordion-item-title-text"> Timely Completion </div></span>
							<span class='e-n-accordion-item-title-icon'>
			<span class='e-opened' ><i aria-hidden="true" class="fas fa-minus"></i></span>
