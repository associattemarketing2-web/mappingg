      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who is Ceratec Group?",
          "acceptedAnswer": { "@type": "Answer", "text": "Ceratec Group is a Pune-based real estate developer with over 26 years of experience, delivering 12+ residential and commercial projects to more than 5,000 families across Balewadi, Hinjewadi and Ravet." }
        },
        {
          "@type": "Question",
          "name": "What projects does Ceratec Group offer?",
          "acceptedAnswer": { "@type": "Answer", "text": "Ceratec Group currently offers three flagship projects: Presidential Tower (2-3 BHK + Row Houses in Ravet), Westwinds (2-5.5 BHK Airy Homes and Duplexes in Hinjewadi), and Tower 108 (Grade A commercial offices and showrooms in Balewadi)." }
        },
        {
          "@type": "Question",
          "name": "Where is Ceratec Group's Presidential Tower located?",
          "acceptedAnswer": { "@type": "Answer", "text": "Presidential Tower is located in Ravet, Pimpri-Chinchwad, Pune (Maharashtra 412101). It is 2 km from the Pune-Mumbai Expressway and 3.3 km from Dehu Road Railway Station." }
        },
        {
          "@type": "Question",
          "name": "Where is Ceratec Westwinds located and is it near Hinjewadi IT Park?",
          "acceptedAnswer": { "@type": "Answer", "text": "Westwinds is located at Maan Road, Hinjewadi Phase 1, Pune (Maharashtra 411057). It is 3.2 km from Hinjewadi IT Park, 4 km from Wipro, and approximately 2.3 km from the proposed Metro station." }
        },
        {
          "@type": "Question",
          "name": "What is Tower 108 in Balewadi?",
          "acceptedAnswer": { "@type": "Answer", "text": "Tower 108 is a Grade A commercial tower by Ceratec Group in Balewadi, Pune. It is 108 metres tall with 26 floors, offering 450+ office spaces ranging from 516 to 1470 sq ft, 4 grand showrooms, 17,000 sq ft of recreational space, and 7 floors of dedicated parking. It is located 150 metres from a Metro station and 400 metres from the Pune-Bangalore Expressway." }
        },
        {
          "@type": "Question",
          "name": "How can I contact Ceratec Group or book a site visit?",
          "acceptedAnswer": { "@type": "Answer", "text": "You can contact Ceratec Group by calling or WhatsApp-ing +91-7028885608, or emailing info@ceratecgroup.com. For Tower 108 enquiries call +91-9371051400. For Westwinds call +91-9579663732. Site visits are available Monday to Saturday, 9:30 am to 6:30 pm." }
        },
        {
          "@type": "Question",
          "name": "Is Ceratec Group RERA registered?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, Ceratec Group operates in compliance with MahaRERA (Maharashtra Real Estate Regulatory Authority). For project-specific RERA registration numbers, please contact the sales team at +91-7028885608 or visit the respective project pages on the website." }
        }
      ]
    }
  ]
}
