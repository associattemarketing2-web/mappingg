ndefined\",\"nonce\":\"0nQtGDl9xrQ6Qgj2Y4fziA==\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2bn4ht82l5-44.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"0nQtGDl9xrQ6Qgj2Y4fziA==\"}],[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1__rc2-bfjwpr.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"0nQtGDl9xrQ6Qgj2Y4fziA==\"}],[\"$\",\"link\",\"3\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0fomunoovfcq_.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"0nQtGDl9xrQ6Qgj2Y4fziA==\"}]]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}],[\"$\",\"$L2b\",null,{\"children\":[\"$\",\"$L2c\",null,{}]}]]}]\n25:[\"$\",\"$L2d\",null,{}]\n1d:[\"$\",\"$L2e\",null,{\"sectionName\":\"Cookie Consent - We respect your privacy - PopUp\",\"header\":{\"title\":\"Cookie Consent - We respect your privacy\",\"color\":\"white\",\"level\":\"h2\"},\"description\":\"We use cookies and similar technologies to operate our website. With your permission, we also use cookies for analytics, advertising, social media features, and embedded content. Where required by law, we will only use non‑essential cookies with your consent. Where applicable, you may opt out of the sale or sharing of personal information, and we honor Global Privacy Control (GPC) signals.\",\"manageCookiesButton\":{\"buttonName\":\"Primary - Manage cookies\",\"label\":\"Manage cookies\",\"type\":\"primary\",\"color\":\"white\",\"bgColor\":\"black\",\"borderColor\":\"white\"},\"manageCookieSection\":[{\"sectionName\":\"Cookie Consent - Customize Cookies\",\"header\":{\"title\":\"Your Privacy\",\"color\":\"white\",\"level\":\"h2\"},\"description\":\"When you browse the internet, your personal information is often stored as cookies. These cookies can reveal your preferences, device information, and more. While they enhance your browsing experience, they can also compromise your privacy. We understand the importance of protecting your personal data, so we offer the option to control the types of cookies stored on your browser. However, please note that disabling certain cookies may limit your access to certain features and services on the website.\",\"sectionItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies\",\"header\":{\"title\":\"Strictly necessary cookies\",\"color\":\"white\",\"level\":\"h4\"},\"description\":\"Without these cookies, our website cannot function. They are vital for enabling you to access the services you have requested, such as logging in, filling out forms, and setting your privacy preferences. These cookies cannot be disabled as they are integral to the site's smooth operation. While you can adjust your browser settings to block or receive alerts about these cookies, please be aware that doing so may prevent you from accessing certain parts of the website and receiving the services you require. Rest assured, these cookies do not store personally identifiable information, so your privacy remains protected.\",\"sectionItemsTitle\":\"Cookie List\",\"sectionItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Cookie name\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"cookiesession1\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Cookie type\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"First-party cookie\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Category\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Strictly necessary cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Expiration/Duration\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"Session\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Platform name\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Next JS\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Description\",\"cookieTitle\":\"Description\",\"cookieValue\":\"This is a default cookie that gets triggered when the page loads\"}]}],\"isEnabled\":true},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies\",\"header\":{\"title\":\"Performance cookies\",\"color\":\"white\",\"level\":\"h4\"},\"description\":\"These cookies are important for us to measure and improve the performance of our website. By counting visits and traffic sources, we can gain valuable insights into how our site is being used and identify areas for improvement. Additionally, these cookies allow us to remember your preferences, such as your language or region, and provide you with a more personalized browsing experience. They help us understand which pages are popular, which ones need improvement, and how visitors navigate our site. If you choose to disable these cookies, we will not be able to monitor the performance of our site or provide you with the enhanced features that make your experience more enjoyable. Please note that refusing to enable these cookies may impact your overall experience on our website.\",\"sectionItemsTitle\":\"Cookie List\",\"sectionItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie name\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"_gid\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third-party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Category\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"24 months\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Google Analytics\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description\",\"cookieTitle\":\"Description\",\"cookieValue\":\"This cookie is used to store and count page views. To know more, please visit www.cookiedatabase.org/cookiefunctions/count-and-track-pageviews/\"}]},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie name\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"_clck\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third-party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Category\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"1 year\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"MS Clarity\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description\",\"cookieTitle\":\"Description\",\"cookieValue\":\"Ensures the Clarity user ID and preferences, unique to that site, on the browser; this guarantees that behavior in subsequent visits to the same site will be attributed to the same user ID\"}]},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Cookie name\",\"cookieTitle\":\" Cookie name\",\"cookieValue\":\"_clsk\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Cookie type\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third-party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Category\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Expiration/Duration\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"1 Year\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Platform name\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"MS Clarity\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Description\",\"cookieTitle\":\"Description\",\"cookieValue\":\"Ensures the Clarity user ID and preferences, unique to that site, on the browser; this guarantees that behavior in subsequent visits to the same site will be attributed to the same user ID\"}]},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Cookie name\",\"cookieTitle\":\" Cookie name\",\"cookieValue\":\"_clsk\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Cookie type\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third-party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Category\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Expiration/Duration\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"1 Year\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Platform name\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"MS Clarity\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Description\",\"cookieTitle\":\"Description\",\"cookieValue\":\"Connects multiple page views by a user into a single Clarity session recording\"}]},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Cookie name\",\"cookieTitle\":\" Cookie name\",\"cookieValue\":\"gtm-consent\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Cookie type\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Flag-based cookie\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Category\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Expiration/Duration\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"Session\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List - Platform name\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Next JS\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List - Description\",\"cookieTitle\":\"Description\",\"cookieValue\":\"This is a value that gets triggered when the user either accepts all cookies or accepts performance cookies\"}]},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List -  Cookie name\",\"cookieTitle\":\" Cookie name\",\"cookieValue\":\"hjSessionUser_{site_id}\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type-table2\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third-party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Category-table2\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration-table2\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"1 Year\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name-table2\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Hotjar\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description-table\",\"cookieTitle\":\"Description\",\"cookieValue\":\"Persists the Hotjar User ID for a specific site on the browser, ensuring behavior is attributed to the same user across visits\"}],\"slug\":\"cookie-consent-customize-cookies-performance-cookies-cookie-list\"},{\"sectionName\":\"Cookie Consent - Customize Cookies -Performance cookies - Cookie List-table3\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie name-table3\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"hjSession_{site_id} \"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type-table3\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third-party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies -Performance cookies - Category-table3\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration-table3\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"24 Hours\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name (1)\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Hotjar\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description-table3\",\"cookieTitle\":\"Description\",\"cookieValue\":\"A session cookie that stores data about the current visit, such as session recordings and interactions.\"}],\"slug\":\"cookie-consent-customize-cookies-performance-cookies-cookie-list-table3\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List-Vimeo-table2\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie name-vimeo table 2\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"cf_clearance\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type-vimeo table 2\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third‑party (Cloudflare on behalf of Vimeo)\"},{\"sectionName\":\"Cookie Consent - Customize Cookies -Performance cookies - Category-table3\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration-vimeo table 2\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"1 year\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name - vimeo table 2\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Cloudflare (used for Vimeo video security)\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description- vimeo table2\",\"cookieTitle\":\"Description\",\"cookieValue\":\"This important security cookie verifies genuine requests and ensures that the visitor has passed Cloudflare’s security checks. It helps maintain protection against malicious traffic when Vimeo videos are served.\"}],\"slug\":\"cookie-consent-customize-cookies-performance-cookies-cookie-list-vimeo\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List-Vimeo-table 3\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie name-vimeo table 3\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"_cf_bm\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type-vimeo table 3\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third‑party (Cloudflare)\"},{\"sectionName\":\"Cookie Consent - Customize Cookies -Performance cookies - Category-table3\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration-vimeo table 3\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"30 minutes\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name - vimeo table 3\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Cloudflare (supporting Vimeo’s player security)\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description- vimeo table 3\",\"cookieTitle\":\"Description\",\"cookieValue\":\"This cookie is part of Cloudflare’s Bot Management service and distinguishes between humans and bots. It is important for managing and filtering automated traffic to ensure Vimeo video playback remains secure and uninterrupted.\"}],\"slug\":\"cookie-consent-customize-cookies-performance-cookies-cookie-list-vimeo-table\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List-Vimeo-table 4\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie name-vimeo table 4\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"_cfuvid\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type-vimeo table 4\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third‑party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies -Performance cookies - Category-table3\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration-vimeo table 4\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"Session (expires on browser close)\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name - vimeo table 4\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Cloudflare (for Vimeo)\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description- vimeo table 4\",\"cookieTitle\":\"Description\",\"cookieValue\":\"Used to apply rate‑limiting rules, ensuring stable and secure handling of requests to Vimeo’s embedded video services, preventing overload or misuse.\"}],\"slug\":\"cookie-consent-customize-cookies-performance-cookies-cookie-list-vimeo-table\"}],\"isEnabled\":true},{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies\",\"header\":{\"title\":\"Advertising/Targeting cookies\",\"color\":\"white\",\"level\":\"h4\"},\"description\":\"These cookies are used by social media services to enable you to share our content with your friends and networks. Third-party advertising and social media cookies are designed to deliver advertisements that are more relevant to your interests, limit the number of times you see an advertisement, measure the effectiveness of advertising campaigns, and understand people's behavior after they view an advertisement. These cookies are placed on behalf of advertising networks with the site operator's permission and can track your browser across other sites, building a profile of your interests. This can impact the content and messages you see on other websites you visit. If you choose to disable these cookies, you may not be able to use or see sharing tools or play certain videos on our site. Please be aware that these cookies are important to our advertising strategy and play a crucial role in supporting our website.\",\"sectionItemsTitle\":\"Cookie List\",\"sectionItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies - Cookie List - Cookie name\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"Visitor_id*-Hash\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies - Cookie List - Cookie Type\",\"cookieTitle\":\"Cookie Type\",\"cookieValue\":\"Third-party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies - Cookie List - Category\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Advertising/Targeting cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies - Cookie List - Expiration/Duration\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"1 year\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies - Cookie List - Platform name\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Pardot\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies - Cookie List - Description\",\"cookieTitle\":\"Description\",\"cookieValue\":\"To store a unique user ID. To know more, please visit https://cookiedatabase.org/cookiefunctions/provide-protection-against-hackers\"}]},{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies - Cookie List - Cookie name\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"_gcl_au\"},{\"sectionName\":\"Cooki