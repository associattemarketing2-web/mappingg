6 h-0.5 transition-transform duration-300 bg-white "></span></button></div><nav class="hidden md:flex justify-center"><ul class="flex flex-wrap justify-center gap-3 lg:gap-12 transition-colors duration-300 text-white"></ul></nav></div><div class="md:hidden fixed inset-0 z-40 transition-opacity opacity-0 pointer-events-none"><div class="fixed top-0 right-0 h-full w-64 bg-white text-black shadow-2xl transform transition-transform duration-300 translate-x-full"><div class="flex items-center justify-between px-6 py-4 border-b border-gray-100"><button type="button" class="text-black-chocolate text-2xl" aria-label="Close menu">×</button></div><nav class="p-6"><ul class="flex flex-col gap-4 text-black-chocolate"></ul></nav></div></div></header><div class="relative w-full h-screen overflow-hidden"><div class="absolute inset-0 bg-neutral-900" aria-hidden="true"></div><div class="absolute inset-0 pointer-events-none bg-black/20"></div><div class="absolute inset-0 flex items-end justify-center z-40 pb-16 pointer-events-none"><div class="max-w-[1200px] mx-auto px-6 text-center"><h1 class="text-2xl md:text-[28px] font-display-semi text-white mb-6 tracking-tight">Our Services</h1><p class="text-lg md:text-lg lg:text-lg text-white/90 max-w-4xl mx-auto leading-relaxed">Expertise across the full lifecycle of real estate from planning and construction to handover, operations and longterm value management.</p></div></div></div><section class="w-full bg-white py-16 md:py-24"><div class="mx-auto max-w-[1200px] px-6 md:px-16 text-center"><h2 class="text-xl md:text-2xl font-display-semi text-[#1F180D] uppercase tracking-wide">WHETHER BUILDING NEW DESTINATIONS OR SUPPORTING EXISTING DEVELOPMENTS, OUR FOCUS REMAINS THE SAME: THOUGHTFUL EXECUTION, EFFICIENT DELIVERY AND ENDURING VALUE.</h2><p class="mt-6 text-sm md:text-sm text-[#1F180D]/80 leading-relaxed max-w-5xl mx-auto">Panchshil offers integrated services across every stage of the real estate lifecycle from planning and development to construction oversight, fit out execution and longterm operational management. Our approach ensures consistency, accountability and quality across all asset classes, supporting our clients, residents and partners with a single point of ownership and expertise.</p></div></section><div class="bg-white pb-10"><section class="w-full bg-[#FFFAF7] py-16 md:py-24"><div class="mx-auto px-6 md:px-16"><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start"><div class="lg:order-2"><h2 class="text-2xl md:text-[28px] font-display-semi text-black uppercase mb-8 md:mb-12">Asset Management</h2><p class="text-sm md:text-sm text-[#1F180D]/80 leading-relaxed mb-8 -mt-4 max-w-2xl">We provide asset management services that align investment strategy with property performance to protect and enhance long-term value.</p><p class="text-base font-display-semi tracking-[0.16em] uppercase text-black mb-6">OUR CAPABILITIES INCLUDE</p><div class="space-y-6"><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">1</span><p class="text-[#1F180D] text-sm md:text-sm ">Develop portfolio strategies to acquire, hold, enhance, reposition, or divest properties in line with risk and return objectives</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">2</span><p class="text-[#1F180D] text-sm md:text-sm ">Improve asset performance by enhancing occupancy, rental income, operational efficiency, tenant satisfaction, and overall property value</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">3</span><p class="text-[#1F180D] text-sm md:text-sm ">Plan and allocate capital effectively across acquisitions, renovations, redevelopment, maintenance, and sustainability initiatives</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">4</span><p class="text-[#1F180D] text-sm md:text-sm ">Monitor market conditions, regulatory developments, financing exposure, and portfolio concentration to proactively manage risk</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">5</span><p class="text-[#1F180D] text-sm md:text-sm ">Track key performance indicators and provide transparent reporting on income, cash flow, occupancy, valuations, and investment returns</p></div></div><a href="/contact-us" class="inline-flex mt-10 bg-gold-beige text-white text-xs tracking-wide uppercase px-6 py-3 hover:bg-[#7a6a55] transition-colors">Connect With Us</a></div><div class="relative w-full h-[400px] md:h-[600px] lg:h-[700px] lg:order-1"><img alt="Asset Management" decoding="async" data-nimg="fill" class="object-cover " style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fasset-management-986876143.webp&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fasset-management-986876143.webp&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fasset-management-986876143.webp&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fasset-management-986876143.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fasset-management-986876143.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fasset-management-986876143.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fasset-management-986876143.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fasset-management-986876143.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fasset-management-986876143.webp&amp;w=3840&amp;q=75"/></div></div></div></section><section class="w-full bg-[#FFFAF7] py-16 md:py-24"><div class="mx-auto px-6 md:px-16"><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start"><div class="lg:order-2"><h2 class="text-2xl md:text-[28px] font-display-semi text-black uppercase mb-8 md:mb-12">Project Management</h2><p class="text-sm md:text-sm text-[#1F180D]/80 leading-relaxed mb-8 -mt-4 max-w-2xl">We provide end-to-end project management services to ensure projects are delivered efficiently, on time, within budget, and to the highest standards of quality and safety.</p><p class="text-base font-display-semi tracking-[0.16em] uppercase text-black mb-6">OUR CAPABILITIES INCLUDE</p><div class="space-y-6"><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">1</span><p class="text-[#1F180D] text-sm md:text-sm ">Manage day-to-day construction activities and coordinate with contractors, consultants, and suppliers</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">2</span><p class="text-[#1F180D] text-sm md:text-sm ">Maintain high construction standards through regular inspections and rigorous quality checks</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">3</span><p class="text-[#1F180D] text-sm md:text-sm ">Monitor project schedules, track key milestones, and proactively address potential delays</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">4</span><p class="text-[#1F180D] text-sm md:text-sm ">Manage project costs and ensure adherence to approved budgets</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">5</span><p class="text-[#1F180D] text-sm md:text-sm ">Enforce on-site safety protocols and ensure compliance with applicable regulations</p></div></div><a href="/contact-us" class="inline-flex mt-10 bg-gold-beige text-white text-xs tracking-wide uppercase px-6 py-3 hover:bg-[#7a6a55] transition-colors">Connect With Us</a></div><div class="relative w-full h-[400px] md:h-[600px] lg:h-[700px] lg:order-1"><img alt="Project Management" decoding="async" data-nimg="fill" class="object-cover " style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fproject-management-410916242.webp&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fproject-management-410916242.webp&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fproject-management-410916242.webp&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fproject-management-410916242.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fproject-management-410916242.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fproject-management-410916242.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fproject-management-410916242.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fproject-management-410916242.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Fproject-management-410916242.webp&amp;w=3840&amp;q=75"/></div></div></div></section><section class="w-full bg-[#FFFAF7] py-16 md:py-24"><div class="mx-auto px-6 md:px-16"><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start"><div class="lg:order-2"><h2 class="text-2xl md:text-[28px] font-display-semi text-black uppercase mb-8 md:mb-12">Facility Management</h2><p class="text-sm md:text-sm text-[#1F180D]/80 leading-relaxed mb-8 -mt-4 max-w-2xl">We provide comprehensive facility management services to optimise the operational efficiency, safety, sustainability, and long-term performance of real estate properties.</p><p class="text-base font-display-semi tracking-[0.16em] uppercase text-black mb-6">OUR CAPABILITIES INCLUDE</p><div class="space-y-6"><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">1</span><p class="text-[#1F180D] text-sm md:text-sm ">Conduct regular inspections, repairs, and preventive maintenance of building systems</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">2</span><p class="text-[#1F180D] text-sm md:text-sm ">Manage utilities, HVAC systems, and other essential services efficiently</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">3</span><p class="text-[#1F180D] text-sm md:text-sm ">Maintain robust security protocols and ensure compliance with health and safety regulations</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">4</span><p class="text-[#1F180D] text-sm md:text-sm ">Implement energy-efficiency and sustainability initiatives to reduce environmental impact</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">5</span><p class="text-[#1F180D] text-sm md:text-sm ">Deliver high-quality tenant services while maintaining clean, safe, and well-landscaped common areas</p></div></div><a href="/contact-us" class="inline-flex mt-10 bg-gold-beige text-white text-xs tracking-wide uppercase px-6 py-3 hover:bg-[#7a6a55] transition-colors">Connect With Us</a></div><div class="relative w-full h-[400px] md:h-[600px] lg:h-[700px] lg:order-1"><img alt="Facility Management" decoding="async" data-nimg="fill" class="object-cover " style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffacility-management-966517779.webp&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffacility-management-966517779.webp&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffacility-management-966517779.webp&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffacility-management-966517779.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffacility-management-966517779.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffacility-management-966517779.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffacility-management-966517779.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffacility-management-966517779.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffacility-management-966517779.webp&amp;w=3840&amp;q=75"/></div></div></div></section><section class="w-full bg-[#FFFAF7] py-16 md:py-24"><div class="mx-auto px-6 md:px-16"><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start"><div class="lg:order-2"><h2 class="text-2xl md:text-[28px] font-display-semi text-black uppercase mb-8 md:mb-12">Architecture &amp; Interior Design</h2><p class="text-sm md:text-sm text-[#1F180D]/80 leading-relaxed mb-8 -mt-4 max-w-2xl">Panchshil’s architecture and interior design services combine functionality, aesthetics, and innovation to create distinctive spaces tailored to each client’s vision</p><p class="text-base font-display-semi tracking-[0.16em] uppercase text-black mb-6">OUR CAPABILITIES INCLUDE</p><div class="space-y-6"><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">1</span><p class="text-[#1F180D] text-sm md:text-sm ">Understand client requirements and translate their vision into thoughtful architectural and interior design concepts</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">2</span><p class="text-[#1F180D] text-sm md:text-sm ">Develop detailed space plans that optimise functionality, efficiency, and user experience</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">3</span><p class="text-[#1F180D] text-sm md:text-sm ">Select high-quality materials, finishes, furniture, and design elements to create cohesive environments</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">4</span><p class="text-[#1F180D] text-sm md:text-sm ">Collaborate with consultants, contractors, and suppliers to ensure seamless design coordination and execution</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">5</span><p class="text-[#1F180D] text-sm md:text-sm ">Ensure every design meets Panchshil’s quality standards while complying with applicable building codes and regulations</p></div></div><a href="/contact-us" class="inline-flex mt-10 bg-gold-beige text-white text-xs tracking-wide uppercase px-6 py-3 hover:bg-[#7a6a55] transition-colors">Connect With Us</a></div><div class="relative w-full h-[400px] md:h-[600px] lg:h-[700px] lg:order-1"><img alt="Architecture &amp; Interior Design" decoding="async" data-nimg="fill" class="object-cover " style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Farchitecture-interior-d-986141201.webp&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Farchitecture-interior-d-986141201.webp&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Farchitecture-interior-d-986141201.webp&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Farchitecture-interior-d-986141201.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Farchitecture-interior-d-986141201.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Farchitecture-interior-d-986141201.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Farchitecture-interior-d-986141201.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Farchitecture-interior-d-986141201.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Farchitecture-interior-d-986141201.webp&amp;w=3840&amp;q=75"/></div></div></div></section><section class="w-full bg-[#FFFAF7] py-16 md:py-24"><div class="mx-auto px-6 md:px-16"><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start"><div class="lg:order-2"><h2 class="text-2xl md:text-[28px] font-display-semi text-black uppercase mb-8 md:mb-12">Fit-out Management</h2><p class="text-sm md:text-sm text-[#1F180D]/80 leading-relaxed mb-8 -mt-4 max-w-2xl">We oversee the customization and finishing of interior spaces to meet the specific requirements and preferences of clients.</p><p class="text-base font-display-semi tracking-[0.16em] uppercase text-black mb-6">OUR CAPABILITIES INCLUDE</p><div class="space-y-6"><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">1</span><p class="text-[#1F180D] text-sm md:text-sm ">Assess project requirements and establish a clear, customised fit-out strategy</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">2</span><p class="text-[#1F180D] text-sm md:text-sm ">Collaborate with designers and architects to develop functional, compliant fit-out plans</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">3</span><p class="text-[#1F180D] text-sm md:text-sm ">Source quality materials and manage procurement for timely, cost-effective delivery</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">4</span><p class="text-[#1F180D] text-sm md:text-sm ">Oversee contractors, installations, schedules, budgets, and quality standards</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">5</span><p class="text-[#1F180D] text-sm md:text-sm ">Conduct final inspections and ensure completion to the client’s satisfaction</p></div></div><a href="/contact-us" class="inline-flex mt-10 bg-gold-beige text-white text-xs tracking-wide uppercase px-6 py-3 hover:bg-[#7a6a55] transition-colors">Connect With Us</a></div><div class="relative w-full h-[400px] md:h-[600px] lg:h-[700px] lg:order-1"><img alt="Fit-out Management" decoding="async" data-nimg="fill" class="object-cover " style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffit-out-management-672766286.webp&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffit-out-management-672766286.webp&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffit-out-management-672766286.webp&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffit-out-management-672766286.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffit-out-management-672766286.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffit-out-management-672766286.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffit-out-management-672766286.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffit-out-management-672766286.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fwww.panchshil.com%2Fasset%2Fimages%2Fservices%2Ffit-out-management-672766286.webp&amp;w=3840&amp;q=75"/></div></div></div></section><section class="w-full bg-[#FFFAF7] py-16 md:py-24"><div class="mx-auto px-6 md:px-16"><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start"><div class="lg:order-2"><h2 class="text-2xl md:text-[28px] font-display-semi text-black uppercase mb-8 md:mb-12">Residential Leasing &amp; Resale</h2><p class="text-sm md:text-sm text-[#1F180D]/80 leading-relaxed mb-8 -mt-4 max-w-2xl">In addition to delivering exceptional living spaces, Panchshil offers end-to-end residential leasing and resale services to ensure a seamless and transparent experience for property owners, tenants, and buyers.</p><p class="text-base font-display-semi tracking-[0.16em] uppercase text-black mb-6">OUR CAPABILITIES INCLUDE</p><div class="space-y-6"><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">1</span><p class="text-[#1F180D] text-sm md:text-sm ">Understand clients’ requirements and identify properties that best meet their needs</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">2</span><p class="text-[#1F180D] text-sm md:text-sm ">Market properties effectively and facilitate enquiries, viewings, and negotiations</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">3</span><p class="text-[#1F180D] text-sm md:text-sm ">Provide end-to-end assistance with leasing and resale transactions, including documentation and legal formalities</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">4</span><p class="text-[#1F180D] text-sm md:text-sm ">Offer dedicated in-house support throughout the leasing tenure</p></div><div class="flex gap-4 border-b border-[#ab9b815e] pb-4"><span class="text-[#1F180D] font-regular text-sm md:text-sm shrink-0">5</span><p class="text-[#1F180D] text-sm md:text-sm ">Provide comprehensive facility management and on-demand maintenance services</p></div></div><a href="/contact-us" class="inline-flex mt-10 bg-gold-beige text-white text-xs tracking-wide uppercase px-6 py-3 hover:bg-[#7a6a55] transition-colors">Connect With Us</a></div><div class="relative w-full h-[400px] md:h-[600px] lg:h-[700px] lg:or