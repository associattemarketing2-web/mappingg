<!-- active menus script start -->
<script>
$(document).ready(function() {
    function setActiveMenuItems() {
        var scrollY = $(window).scrollTop() + 100; // Adjusting the scroll position check
        $(".sectionBox").each(function() {
            var sectionTop = $(this).offset().top;
            var sectionBottom = sectionTop + $(this).outerHeight();
            var targetId = $(this).attr("id");

            if (scrollY >= sectionTop && scrollY < sectionBottom) {
                $("nav a[href='#" + targetId + "']").parent('li').addClass("active");
            } else {
                $("nav a[href='#" + targetId + "']").parent('li').removeClass("active");
            }
        });
    }

    function highlightActiveMenuItem() {
        setActiveMenuItems();
    }

    highlightActiveMenuItem();
    $(window).on("scroll", setActiveMenuItems);

    $('nav a').on('click', function(e) {
        e.preventDefault();
        var targetId = $(this).attr('href');
        var targetSection = $(targetId);
        if (targetSection.length) {
            $('html, body').animate({
                scrollTop: targetSection.offset().top - 90 // Adjust scrolling to account for 200px offset
            }, 100, function() {
                highlightActiveMenuItem(); // Ensure highlight after scroll animation
            });
        }
        return false;
    });
});
</script>
<!-- active menus script start -->
<!-- show and hide menus script start -->
<script>
$(document).ready(function() {
    var navigation = $(".navigation");
    $(window).scroll(function() {
        var scrollTop = $(window).scrollTop();
        if (scrollTop >= 300) {
            navigation.removeClass("hidden");
        } else {
            navigation.addClass("hidden");
        }
    });
});
</script>
<!-- show and hide menus script end -->
