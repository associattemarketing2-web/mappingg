 <script>
document.addEventListener('DOMContentLoaded', function () {
  const toggle = document.getElementById('ongoingProjectsLink');
  const submenuParent = document.getElementById('ongoingSubmenu');

  // Toggle submenu on click
  toggle.addEventListener('click', function (e) {
    e.preventDefault();
    submenuParent.classList.toggle('show');
  });

  // Hide submenu when mouse leaves the submenu area
  submenuParent.addEventListener('mouseleave', function () {
    submenuParent.classList.remove('show');
  });

  // Optional: also close if you click outside
  document.addEventListener('click', function (e) {
    if (!submenuParent.contains(e.target)) {
      submenuParent.classList.remove('show');
    }
  });
});
</script>

 
