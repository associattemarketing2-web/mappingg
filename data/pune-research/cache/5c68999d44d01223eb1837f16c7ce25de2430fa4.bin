}],\"slug\":\"cookie-consent-customize-cookies-performance-cookies-cookie-list-vimeo\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List-Vimeo-table 3\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie name-vimeo table 3\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"_cf_bm\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type-vimeo table 3\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third‑party (Cloudflare)\"},{\"sectionName\":\"Cookie Consent - Customize Cookies -Performance cookies - Category-table3\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration-vimeo table 3\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"30 minutes\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name - vimeo table 3\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Cloudflare (supporting Vimeo’s player security)\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description- vimeo table 3\",\"cookieTitle\":\"Description\",\"cookieValue\":\"This cookie is part of Cloudflare’s Bot Management service and distinguishes between humans and bots. It is important for managing and filtering automated traffic to ensure Vimeo video playback remains secure and uninterrupted.\"}],\"slug\":\"cookie-consent-customize-cookies-performance-cookies-cookie-list-vimeo-table\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List-Vimeo-table 4\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie name-vimeo table 4\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"_cfuvid\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type-vimeo table 4\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third‑party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies -Performance cookies - Category-table3\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration-vimeo table 4\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"Session (expires on browser close)\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name - vimeo table 4\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Cloudflare (for Vimeo)\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description- vimeo table 4\",\"cookieTitle\":\"Description\",\"cookieValue\":\"Used to apply rate‑limiting rules, ensuring stable and secure handling of requests to Vimeo’s embedded video services, preventing overload or misuse.\"}],\"slug\":\"cookie-consent-customize-cookies-performance-cookies-cookie-list-vimeo-table\"}],\"isEnabled\":true},{\"sectionName\":\"Cookie Consent - Customize Cookies - Advertising/Targeting cookies\",\"header\":{\"title\":\"Advertising/Targeting cookies\",\"color\":\"white\",\"level\":\"h4\"},\"description\":\"These cookies are used by social media services to enable you to share our content with your friends and networks. Third-party advertising and social media cookies are designed to deliver advertisements that are more relevant to your interests, limit the number of times you see an advertisement, measure the effectiveness of advertising campaigns, and understand people's behavior after they view an advertisement. These cookies are placed on behalf of advertising networks with the site operator's permission and can track your browser across other sites, building a profile of your interests. This can impact the content and messages you see on other websites you visit. If you choose 