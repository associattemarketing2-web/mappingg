<style>
  .about-awards-section {
    width: 100%;
    padding: 40px 30px;
    background-color: #f7f9f7;
    background-image: url('https://www.icertis.com/globalassets/about/awards-bg.svg');
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    box-sizing: border-box;
  }

  .about-awards-container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    max-width: 1300px;
    margin: 0 auto;
  }

  .about-awards-card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .about-awards-card img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    padding: 0;
    margin: 0;
  }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 991px) {
    .about-awards-section {
      padding: 40px;
    }

    .about-awards-container {
      gap: 16px;
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .about-awards-section {
      padding: 40px 16px;
    }

    .about-awards-container {
      grid-template-columns: 1fr;
      gap: 16px;
      max-width: 400px;
    }
  }
</style>

