<!-- Ticker Play Pause -->
<script type="text/javascript" charset="utf-8">
(function () {
  'use strict';

  const COMPONENT_ID = 'cibP-llyK-JPMO-oxDi';

  function init() {
    const container = document.getElementById(COMPONENT_ID);
    if (!container) return;

    const marquee = container.querySelector('marquee');
    if (!marquee) return;

    const heading = container.querySelector('.heading');
    if (!heading) return;

    // Inject button styles
    injectStyles();

    // Create pause/play button
    const btn = document.createElement('button');
    btn.className = 'ticker-pp-btn ticker-pp-btn--pause';
    btn.setAttribute('aria-label', 'Pause ticker');
    btn.setAttribute('title', 'Pause scrolling');
    btn.innerHTML = '<span class="ticker-pp-icon ticker-pp-icon--pause"></span>';

    // Determine initial state: playing
    let isPlaying = true;

    // Also disable the native marquee hover stop so our toggle takes full control
    disableNativeMarqueeEvents(marquee);

    btn.addEventListener('click', function () {
      isPlaying = !isPlaying;
      updateButtonState(btn, marquee, isPlaying);
    });

    // Append button inside the heading
    heading.appendChild(btn);

    // Start playing
    marquee.start();
  }

  function updateButtonState(btn, marquee, isPlaying) {
    if (isPlaying) {
      marquee.start();
      btn.className = 'ticker-pp-btn ticker-pp-btn--pause';
      btn.setAttribute('aria-label', 'Pause ticker');
      btn.setAttribute('title', 'Pause scrolling');
      btn.innerHTML = '<span class="ticker-pp-icon ticker-pp-icon--pause"></span>';
    } else {
      marquee.stop();
      btn.className = 'ticker-pp-btn ticker-pp-btn--play';
      btn.setAttribute('aria-label', 'Play ticker');
      btn.setAttribute('title', 'Resume scrolling');
      btn.innerHTML = '<span class="ticker-pp-icon ticker-pp-icon--play"></span>';
    }
  }

  function disableNativeMarqueeEvents(marquee) {
    // Remove inline event handlers so our toggle has full control
    marquee.removeAttribute('onmousedown');
    marquee.removeAttribute('onmouseup');
    marquee.removeAttribute('onmouseover');
    marquee.removeAttribute('onmouseout');
  }

  function injectStyles() {
    if (document.getElementById('ticker-pp-styles')) return;

    const styleEl = document.createElement('style');
    styleEl.id = 'ticker-pp-styles';
    styleEl.textContent = `
      .ticker-pp-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        margin-left: 8px;
        border: 1.5px solid rgba(255, 255, 255, 0.7);
        border-radius: 50%;
        background: transparent;
        cursor: pointer;
        vertical-align: middle;
        transition: background 0.2s, border-color 0.2s;
        flex-shrink: 0;
      }
      .ticker-pp-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: #ffffff;
      }
      .ticker-pp-btn:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 2px;
      }

      .ticker-pp-icon {
        display: block;
        line-height: 1;
      }
      /* Pause icon: two vertical bars */
      .ticker-pp-icon--pause {
        width: 10px;
        height: 12px;
        position: relative;
      }
      .ticker-pp-icon--pause::before,
      .ticker-pp-icon--pause::after {
        content: '';
        position: absolute;
        top: 0;
        width: 3px;
        height: 100%;
        background: #ffffff;
        border-radius: 1px;
      }
      .ticker-pp-icon--pause::before {
        left: 0;
      }
      .ticker-pp-icon--pause::after {
        right: 0;
      }
      /* Play icon: right-pointing triangle */
      .ticker-pp-icon--play {
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 6px 0 6px 10px;
        border-color: transparent transparent transparent #ffffff;
        margin-left: 2px;
      }
    `;
    document.head.appendChild(styleEl);
  }

  // Run on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
<!-- Ticker Play Pause -->

<!-- Slider Play Pause -->
<script type="text/javascript" charset="utf-8">
(function () {
  'use strict';

  var COMPONENT_ID = 'tqtV-tnRk-aGai-lMbS';

  function init() {
    var container = document.getElementById(COMPONENT_ID);
    if (!container) return;

    // Wait for Owl Carousel to be initialized (polling approach)
    var attempts = 0;
    var maxAttempts = 30;

    function trySetup() {
      var owl = getOwlInstance(container);
      if (owl) {
        setupButton(container, owl);
        return;
      }
      attempts++;
      if (attempts < maxAttempts) {
        setTimeout(trySetup, 200);
      }
    }

    trySetup();
  }

  function getOwlInstance(container) {
    var carousel = container.querySelector('.owl-carousel');
    if (!carousel) return null;

    // Check if jQuery and Owl are available
    if (typeof jQuery === 'undefined') return null;

    var $carousel = jQuery(carousel);
    // Owl Carousel stores data on the element
    if ($carousel.data('owl.carousel')) {
      return $carousel;
    }
    return null;
  }

  function setupButton(container, $owl) {
    // Read autoplay speed from data attr (default 5000ms)
    var speed = parseInt(container.getAttribute('data-speed'), 10) || 5000;

    // Inject styles
    injectStyles();

    // Track state
    var isPlaying = container.getAttribute('data-autoplay') !== 'false';

    // Create button
    var btn = document.createElement('button');
    btn.className = 'slider-pp-btn';
    btn.setAttribute('aria-label', 'Pause slider');
    btn.setAttribute('title', 'Pause slideshow');
    btn.innerHTML =
      '<span class="slider-pp-icon slider-pp-icon--pause"></span>';

    // Set initial visual state
    updateButtonAppearance(btn, isPlaying);

    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      isPlaying = !isPlaying;

      if (isPlaying) {
        $owl.trigger('play.owl.autoplay', [speed]);
      } else {
        $owl.trigger('stop.owl.autoplay');
      }

      updateButtonAppearance(btn, isPlaying);
    });

    // Append button to the slider container
    container.appendChild(btn);

    // Listen for Owl events to stay in sync
    $owl.on('changed.owl.carousel', function () {
      // Owl may restart autoplay after user interaction; sync state
      if (!isPlaying) {
        $owl.trigger('stop.owl.autoplay');
      }
    });
  }

  function updateButtonAppearance(btn, isPlaying) {
    if (isPlaying) {
      btn.className = 'slider-pp-btn slider-pp-btn--pause';
      btn.setAttribute('aria-label', 'Pause slider');
      btn.setAttribute('title', 'Pause slideshow');
      btn.innerHTML =
        '<span class="slider-pp-icon slider-pp-icon--pause"></span>';
    } else {
      btn.className = 'slider-pp-btn slider-pp-btn--play';
      btn.setAttribute('aria-label', 'Play slider');
      btn.setAttribute('title', 'Resume slideshow');
      btn.innerHTML =
        '<span class="slider-pp-icon slider-pp-icon--play"></span>';
    }
  }

  function injectStyles() {
    if (document.getElementById('slider-pp-styles')) return;

    var styleEl = document.createElement('style');
    styleEl.id = 'slider-pp-styles';
    styleEl.textContent = '' +
      '#' + COMPONENT_ID + '.Slider-Grid-1-v1 {\n' +
      '  position: relative;\n' +
      '}\n' +
      '\n' +
      '.slider-pp-btn {\n' +
      '  position: absolute;\n' +
      '  top: 12px;\n' +
      '  right: 12px;\n' +
      '  z-index: 20;\n' +
      '  width: 36px;\n' +
      '  height: 36px;\n' +
      '  padding: 0;\n' +
      '  border: 2px solid rgba(255, 255, 255, 0.85);\n' +
      '  border-radius: 50%;\n' +
      '  background: rgba(0, 0, 0, 0.35);\n' +
      '  cursor: pointer;\n' +
      '  display: flex;\n' +
      '  align-items: center;\n' +
      '  justify-content: center;\n' +
      '  transition: background 0.25s, border-color 0.25s, transform 0.15s;\n' +
      '  backdrop-filter: blur(4px);\n' +
      '  -webkit-backdrop-filter: blur(4px);\n' +
      '}\n' +
      '.slider-pp-btn:hover {\n' +
      '  background: rgba(0, 0, 0, 0.55);\n' +
      '  border-color: #ffffff;\n' +
      '  transform: scale(1.08);\n' +
      '}\n' +
      '.slider-pp-btn:focus-visible {\n' +
      '  outline: 2px solid #ffffff;\n' +
      '  outline-offset: 2px;\n' +
      '}\n' +
      '\n' +
      '.slider-pp-icon {\n' +
      '  display: block;\n' +
      '  line-height: 0;\n' +
      '}\n' +
      '\n' +
      '/* ── Pause icon: two vertical bars ── */\n' +
      '.slider-pp-icon--pause {\n' +
      '  position: relative;\n' +
      '  width: 12px;\n' +
      '  height: 14px;\n' +
      '}\n' +
      '.slider-pp-icon--pause::before,\n' +
      '.slider-pp-icon--pause::after {\n' +
      '  content: "";\n' +
      '  position: absolute;\n' +
      '  top: 0;\n' +
      '  width: 4px;\n' +
      '  height: 100%;\n' +
      '  background: #ffffff;\n' +
      '  border-radius: 2px;\n' +
      '}\n' +
      '.slider-pp-icon--pause::before {\n' +
      '  left: 0;\n' +
      '}\n' +
      '.slider-pp-icon--pause::after {\n' +
      '  right: 0;\n' +
      '}\n' +
      '\n' +
      '/* ── Play icon: right-pointing triangle ── */\n' +
      '.slider-pp-icon--play {\n' +
      '  width: 0;\n' +
      '  height: 0;\n' +
      '  border-style: solid;\n' +
      '  border-width: 7px 0 7px 12px;\n' +
      '  border-color: transparent transparent transparent #ffffff;\n' +
      '  margin-left: 3px;\n' +
      '}\n';
    document.head.appendChild(styleEl);
  }

  // Run on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
