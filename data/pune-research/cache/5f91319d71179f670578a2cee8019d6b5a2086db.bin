225b8\",\"mime\":\"image/webp\",\"name\":\"thumbnail_Board-Members-02.webp\",\"path\":null,\"size\":3.51,\"width\":156,\"height\":156,\"sizeInBytes\":3508}},\"hash\":\"Board_Members_02_94d4f225b8\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":10.84,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/Board_Members_02_94d4f225b8.webp\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2026-09-01T12:10:57.432Z\",\"updatedAt\":\"2026-09-01T12:10:57.432Z\",\"publishedAt\":\"2026-09-01T12:10:57.432Z\",\"focalPoint\":null}},{\"order\":30,\"id\":539,\"documentId\":\"x2kycw5dd7x16qv7wbmp1m0k\",\"title\":\"Charlie Diao\",\"description\":\"$33\",\"designation\":\"Board Member\",\"secondaryDesignation\":null,\"leadersProfileURL\":\"https://www.linkedin.com/in/charlie-diao-8a67955\",\"boardOrLeadership\":\"Board\",\"showDetailsPage\":true,\"boardMemberAudit\":\"NA\",\"boardMemberNominatingAndGovernance\":\"Committee Chair\",\"boardMemberCompensationAndHumanCapital\":\"NA\",\"createdAt\":\"2025-06-30T07:20:31.324Z\",\"updatedAt\":\"2026-09-01T12:13:39.170Z\",\"publishedAt\":\"2026-09-01T12:13:39.201Z\",\"locale\":\"en\",\"image\":{\"id\":5167,\"documentId\":\"k7uey6mp8fg0sc9dt4bem3l2\",\"name\":\"Board-Members-03.webp\",\"alternativeText\":null,\"caption\":null,\"width\":296,\"height\":296,\"formats\":{\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/thumbnail_Board_Members_03_a37cba7fb3.webp\",\"etag\":\"c630da0a99a07fa2f48b24abf370a84d\",\"hash\":\"thumbnail_Board_Members_03_a37cba7fb3\",\"mime\":\"image/webp\",\"name\":\"thumbnail_Board-Members-03.webp\",\"path\":null,\"size\":2.84,\"width\":156,\"height\":156,\"sizeInBytes\":2842}},\"hash\":\"Board_Members_03_a37cba7fb3\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":12.25,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/Board_Members_03_a37cba7fb3.webp\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2026-09-01T12:10:57.721Z\",\"updatedAt\":\"2026-09-01T12:10:57.721Z\",\"publishedAt\":\"2026-09-01T12:10:57.721Z\",\"focalPoint\":null}},{\"order\":40,\"id\":540,\"documentId\":\"ggodr2kjfnbxtth4g8qf8if8\",\"title\":\"Stéphane Biehler\",\"description\":\"**Stéphane Biehler** has served on our board of directors since April 2022. He began his career at Deloitte, where he spent nearly a decade managing the audit of large multinational corporations in both France and the US. Stéphane was then Chief Accounting Officer and Corporate Controller at NYSE Euronext, an exchange operator and parent of the New York Stock Exchange, from 2007 to 2013, and from 2013 to 2017, he was CFO of Morningstar, Inc. (NASDAQ: MORN), a provider of independent investment research. In his latest role, Stéphane was CFO of Jump Trading Group, a global quantitative trading and investment firm, between 2017 and 2023.\\n\\nStéphane holds a Bachelor of International Business from the Université de Haute Alsace, France, and is also a US certified public accountant.\",\"designation\":\"Board Member\",\"secondaryDesignation\":null,\"leadersProfileURL\":\"https://www.linkedin.com/in/st%C3%A9phane-biehler-190b032b\",\"boardOrLeadership\":\"Board\",\"showDetailsPage\":true,\"boardMemberAudit\":\"Member\",\"boardMemberNominatingAndGovernance\":\"NA\",\"boardMemberCompensationAndHumanCapital\":\"Committee Chair\",\"createdAt\":\"2025-06-30T07:27:48.333Z\",\"updatedAt\":\"2026-09-01T12:14:10.577Z\",\"publishedAt\":\"2026-09-01T12:14:10.604Z\",\"locale\":\"en\",\"image\":{\"id\":5168,\"documentId\":\"h0fv8rwcbnu7y5oitspv1xl9\",\"name\":\"Board-Members-04.webp\",\"alternativeText\":null,\"caption\":null,\"width\":296,\"height\":296,\"formats\":{\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/thumbnail_Board_Members_04_ac4e9620cc.webp\",\"etag\":\"ba717b42554ad52c9842805f7d689378\",\"hash\":\"thumbnail_Board_Members_04_ac4e9620cc\",\"mime\":\"image/webp\",\"name\":\"thumbnail_Board-Members-04.webp\",\"path\":null,\"size\":1.91,\"width\":156,\"height\":156,\"sizeInBytes\":1914}},\"hash\":\"Board_Members_04_ac4e9620cc\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":4.86,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/Board_Members_04_ac4e9620cc.webp\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2026-09-01T12:10:57.755Z\",\"updatedAt\":\"2026-09-01T12:10:57.755Z\",\"publishedAt\":\"2026-09-01T12:10:57.756Z\",\"focalPoint\":null}},{\"order\":50,\"id\":491,\"documentId\":\"cnu2jgsbka9rg8utimnip3sv\",\"title\":\"John Gaunt\",\"description\":\"**John Gaunt** has served on our board of directors since April 2022. From 2017 to 2022, he was our Chief Human Resources Officer, focusing on enhancing our business operating model across the globe, and prior to his time at Synechron, he was Executive Vice President of International Human Resources at HCL Technologies, where he managed people operations across 110,000 employees. Before this, he served as Global Head of Human Resources of the Technology and Capital Markets division at Genpact Ltd (NYSE: G), a multinational professional services firm, and as Global Head of Human Resources Operations at Accenture Plc (NYSE: ACN), a multinational professional services company. He has recently joined the US board of Afrika Tikkun, a non-profit organization dedicated to the eradication of poverty by caring for vulnerable children in townships.\\n\\nJohn holds a Bachelor of Arts in Organizational Theory from the University of Pretoria, South Africa, where he graduated with honors.\",\"designation\":\"Board Member\",\"secondaryDesignation\":null,\"leadersProfileURL\":\"https://www.linkedin.com/in/johnmgaunt\",\"boardOrLeadership\":\"Board\",\"showDetailsPage\":true,\"boardMemberAudit\":\"NA\",\"boardMemberNominatingAndGovernance\":\"Member\",\"boardMemberCompensationAndHumanCapital\":\"Member\",\"createdAt\":\"2025-06-30T07:29:32.996Z\",\"updatedAt\":\"2026-01-07T11:42:48.117Z\",\"publishedAt\":\"2026-01-07T11:42:48.134Z\",\"locale\":\"en\",\"image\":{\"id\":2806,\"documentId\":\"ugvngh70zyrx6c8vj3d3dhdm\",\"name\":\"John_Gaunt.webp\",\"alternativeText\":null,\"caption\":null,\"width\":353,\"height\":240,\"formats\":{\"xsmall\":{\"ext\":\".webp\",\"url\":\"/uploads/xsmall_John_Gaunt_a308e89d4c.webp\",\"hash\":\"xsmall_John_Gaunt_a308e89d4c\",\"mime\":\"image/webp\",\"name\":\"xsmall_John_Gaunt.webp\",\"path\":null,\"size\":0.57,\"width\":64,\"height\":44,\"sizeInBytes\":568},\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/thumbnail_John_Gaunt_a308e89d4c.webp\",\"hash\":\"thumbnail_John_Gaunt_a308e89d4c\",\"mime\":\"image/webp\",\"name\":\"thumbnail_John_Gaunt.webp\",\"path\":null,\"size\":3.8,\"width\":229,\"height\":156,\"sizeInBytes\":3796}},\"hash\":\"John_Gaunt_a308e89d4c\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":7.95,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/John_Gaunt_a308e89d4c.webp\",\"previewUrl\":null,\"provider\":\"local\",\"provider_metadata\":null,\"createdAt\":\"2025-06-30T07:28:49.136Z\",\"updatedAt\":\"2025-06-30T07:28:49.136Z\",\"publishedAt\":\"2025-06-30T07:28:49.136Z\",\"focalPoint\":null}},{\"order\":60,\"id\":506,\"documentId\":\"xmayq5jkuugxoyex4nep1exa\",\"title\":\"DeLisa Alexander\",\"description\":\"**DeLisa Alexander** has served on our board since April 2023. In 2021, she founded DeLisa Alexander Executive Coaching, a provider of executive coaching, advising and team development services. Previously, DeLisa held various leadership positions at Red Hat, Inc. (NYSE: RHT), a global infrastructure software solutions company, between 2001 and 2021, most recently as Executive Vice President, Chief People Officer, and Special Counsel, where she led the company’s human resources function. DeLisa is also on the boards of Sophos Ultimate Parent, GP, LLC, a worldwide provider of advanced cybersecurity solutions, and of Qlik Tech International AB, a global provider of data integration and analytics solutions. She also serves on the advisory boards of various other venture capital and educational organizations.\\n\\nDeLisa holds a Bachelor of Business Administration from James Madison University, a Master of Business Administration from the University of Baltimore, and a Juris Doctor from George Mason University.\",\"designation\":\"Board Member\",\"secondaryDesignation\":null,\"leadersProfileURL\":\"https://www.linkedin.com/in/delisa-alexander-4934772\",\"boardOrLeadership\":\"Board\",\"showDetailsPage\":true,\"boardMemberAudit\":\"NA\",\"boardMemberNominatingAndGovernance\":\"Member\",\"boardMemberCompensationAndHumanCapital\":\"Member\",\"createdAt\":\"2025-06-30T07:31:52.700Z\",\"updatedAt\":\"2025-12-11T07:30:42.922Z\",\"publishedAt\":\"2025-12-11T07:30:42.931Z\",\"locale\":\"en\",\"image\":{\"id\":2807,\"documentId\":\"x62r99z2njvbhn6m5z9ifc2n\",\"name\":\"DeLisa_Alexander.webp\",\"alternativeText\":null,\"caption\":null,\"width\":353,\"height\":240,\"formats\":{\"xsmall\":{\"ext\":\".webp\",\"url\":\"/uploads/xsmall_De_Lisa_Alexander_51711993d2.webp\",\"hash\":\"xsmall_De_Lisa_Alexander_51711993d2\",\"mime\":\"image/webp\",\"name\":\"xsmall_DeLisa_Alexander.webp\",\"path\":null,\"size\":0.63,\"width\":64,\"height\":44,\"sizeInBytes\":626},\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/thumbnail_De_Lisa_Alexander_51711993d2.webp\",\"hash\":\"thumbnail_De_Lisa_Alexander_51711993d2\",\"mime\":\"image/webp\",\"name\":\"thumbnail_DeLisa_Alexander.webp\",\"path\":null,\"size\":3.24,\"width\":229,\"height\":156,\"sizeInBytes\":3238}},\"hash\":\"De_Lisa_Alexander_51711993d2\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":6.54,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/De_Lisa_Alexander_51711993d2.webp\",\"previewUrl\":null,\"provider\":\"local\",\"provider_metadata\":null,\"createdAt\":\"2025-06-30T07:31:08.202Z\",\"updatedAt\":\"2025-06-30T07:31:08.202Z\",\"publishedAt\":\"2025-06-30T07:31:08.202Z\",\"focalPoint\":null}},{\"order\":70,\"id\":536,\"documentId\":\"iilvhey1kda2p7o8q49p3zt5\",\"title\":\"Amit Singh\",\"description\":\"$34\",\"designation\":\"Board Member\",\"secondaryDesignation\":null,\"leadersProfileURL\":null,\"boardOrLeadership\":\"Board\",\"showDetailsPage\":true,\"boardMemberAudit\":\"Member\",\"boardMemberNominatingAndGovernance\":\"NA\",\"boardMemberCompensationAndHumanCapital\":\"NA\",\"createdAt\":\"2025-06-30T07:34:01.595Z\",\"updatedAt\":\"2026-09-01T12:12:11.292Z\",\"publishedAt\":\"2026-09-01T12:12:11.376Z\",\"locale\":\"en\",\"image\":{\"id\":5169,\"documentId\":\"huppyrgoqav1ukceb218n4fk\",\"name\":\"Board-Members-07.webp\",\"alternativeText\":null,\"caption\":null,\"width\":296,\"height\":296,\"formats\":{\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/thumbnail_Board_Members_07_49bd01f214.webp\",\"etag\":\"737b020b95172bf79b0ba75c4ce87bb3\",\"hash\":\"thumbnail_Board_Members_07_49bd01f214\",\"mime\":\"image/webp\",\"name\":\"thumbnail_Board-Members-07.webp\",\"path\":null,\"size\":2.65,\"width\":156,\"height\":156,\"sizeInBytes\":2648}},\"hash\":\"Board_Members_07_49bd01f214\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":6.78,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/Board_Members_07_49bd01f214.webp\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2026-09-01T12:10:57.781Z\",\"updatedAt\":\"2026-09-01T12:10:57.781Z\",\"publishedAt\":\"2026-09-01T12:10:57.781Z\",\"focalPoint\":null}},{\"order\":80,\"id\":474,\"documentId\":\"pepqp5k458hz53iz38bz5add\",\"title\":\"Scott Brubaker\",\"description\":\"**Scott Brubaker** has served on our board of directors since April 2024. He currently is a Managing Director at Alvarez \u0026 Marsal North America, LLC, an international management consulting firm, since January 2024. From 2019 to 2023, Scott was Chief Financial Officer of GlobalLogic Inc., a digital product engineering company. Previously, he served as Managing Director at TPG Opportunities Partners, L.P., a global investment firm. He began his career at Arthur Andersen LLP, a multinational professional services company.\\n\\nScott holds a Bachelor of Science in Finance from the University of Illinois at Urbana-Champaign and a Master of Business Administration from the Wharton School at the University of Pennsylvania.\",\"designation\":\"Board Member\",\"secondaryDesignation\":null,\"leadersProfileURL\":null,\"boardOrLeadership\":\"Board\",\"showDetailsPage\":true,\"boardMemberAudit\":\"Member\",\"boardMemberNominatingAndGovernance\":\"NA\",\"boardMemberCompensationAndHumanCapital\":\"Member\",\"createdAt\":\"2025-06-30T07:36:05.290Z\",\"updatedAt\":\"2025-12-22T10:15:50.533Z\",\"publishedAt\":\"2025-12-22T10:15:50.545Z\",\"locale\":\"en\",\"image\":{\"id\":2810,\"documentId\":\"ol6u1c85yrzukuxpddl4se07\",\"name\":\"Scott_Brubaker.webp\",\"alternativeText\":null,\"caption\":null,\"width\":353,\"height\":240,\"formats\":{\"xsmall\":{\"ext\":\".webp\",\"url\":\"/uploads/xsmall_Scott_Brubaker_bd1da6798b.webp\",\"hash\":\"xsmall_Scott_Brubaker_bd1da6798b\",\"mime\":\"image/webp\",\"name\":\"xsmall_Scott_Brubaker.webp\",\"path\":null,\"size\":0.45,\"width\":64,\"height\":44,\"sizeInBytes\":452},\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/thumbnail_Scott_Brubaker_bd1da6798b.webp\",\"hash\":\"thumbnail_Scott_Brubaker_bd1da6798b\",\"mime\":\"image/webp\",\"name\":\"thumbnail_Scott_Brubaker.webp\",\"path\":null,\"size\":1.91,\"width\":229,\"height\":156,\"sizeInBytes\":1912}},\"hash\":\"Scott_Brubaker_bd1da6798b\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":3.28,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/Scott_Brubaker_bd1da6798b.webp\",\"previewUrl\":null,\"provider\":\"local\",\"provider_metadata\":null,\"createdAt\":\"2025-06-30T07:34:54.309Z\",\"updatedAt\":\"2025-06-30T07:34:54.309Z\",\"publishedAt\":\"2025-06-30T07:34:54.309Z\",\"focalPoint\":null}}],\"__component\":\"shared.leaders-profile-list\"}]}],\"leadershipData\":[{\"id\":1969,\"documentId\":\"xhr6apgedipm2ipn6mdnxgn4\",\"title\":\"Leadership Team\",\"description\":\"Any successful business starts with experienced leaders who believe in the company’s mission. Our leadership team is focused on making that mission – to facilitate positive business change and growth – a reality.\",\"sectionSlug\":\"who-we-are-leadership-team\",\"createdAt\":\"2025-06-30T08:44:05.614Z\",\"updatedAt\":\"2025-11-07T07:25:15.091Z\",\"publishedAt\":\"2025-11-07T07:25:15.120Z\",\"locale\":\"en\",\"page\":\"who-we-are\",\"collection\":[{\"id\":53,\"leaders_profiles\":[{\"order\":90,\"id\":380,\"documentId\":\"bz5nq775r8ee3cc96gewnjai\",\"title\":\"Mihir Shah\",\"description\":\"**Mihir Shah** is President, Head of EMEA, APAC, India, and North America, overseeing Synechron's expansive operations across 21 countries, as well as our global Delivery Centers in India, Serbia, Canada, Belfast, Mexico, Poland and Bulgaria.\\n\\nHe previously served here as Managing Director and Head of Europe and APAC, and has held various leadership positions elsewhere, including as IT Chief of Staff at UBS Investment Bank.\\n\\nMihir holds a Bachelor of Science in Computer Science from Royal Holloway, University of London.\",\"designation\":\"President\",\"secondaryDesignation\":\"Head of EMEA, APAC \u0026 India\",\"leadersProfileURL\":\"https://www.linkedin.com/in/mihir-shah-710993b4\",\"boardOrLeadership\":\"Leadership\",\"showDetailsPage\":true,\"boardMemberAudit\":null,\"boardMemberNominatingAndGovernance\":null,\"boardMemberCompensationAndHumanCapital\":null,\"createdAt\":\"2025-06-30T07:41:32.657Z\",\"updatedAt\":\"2025-06-30T07:41:35.573Z\",\"publishedAt\":\"2025-06-30T07:41:35.583Z\",\"locale\":\"en\",\"image\":{\"id\":3814,\"documentId\":\"zrv1kv0ohpj3fpdrra0vrrv9\",\"name\":\"Mihir_Shah.webp\",\"alternativeText\":null,\"caption\":null,\"width\":353,\"height\":240,\"formats\":{\"xsmall\":{\"ext\":\".webp\",\"url\":\"/uploads/xsmall_Mihir_Shah_694c53a00b.webp\",\"hash\":\"xsmall_Mihir_Shah_694c53a00b\",\"mime\":\"image/webp\",\"name\":\"xsmall_Mihir_Shah.webp\",\"path\":null,\"size\":0.47,\"width\":64,\"height\":44,\"sizeInBytes\":466},\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/thumbnail_Mihir_Shah_694c53a00b.webp\",\"hash\":\"thumbnail_Mihir_Shah_694c53a00b\",\"mime\":\"image/webp\",\"name\":\"thumbnail_Mihir_Shah.webp\",\"path\":null,\"size\":2.17,\"width\":229,\"height\":156,\"sizeInBytes\":2170}},\"hash\":\"Mihir_Shah_694c53a00b\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":4.5,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/Mihir_Shah_694c53a00b.webp\",\"previewUrl\":null,\"provider\":\"local\",\"provider_metadata\":null,\"createdAt\":\"2025-06-23T13:35:50.458Z\",\"updatedAt\":\"2025-06-23T13:35:50.458Z\",\"publishedAt\":\"2025-06-23T13:35:50.458Z\",\"focalPoint\":null}},{\"order\":100,\"id\":418,\"documentId\":\"ynojidx3ptf079sbvzqeaey6\",\"title\":\"Christin Spigai\",\"description\":\"**Christin Spigai** is at the helm of Synechron's global people strategy, focusing on enhancing the company culture and employee experience. She directs initiatives across Talent Acquisition, Benefits, HR Systems, HR Operations, and Payroll, and drives the DEI agenda.\\n\\nHer expertise spans over two decades in human resources, advising and coaching leaders to foster organizational growth. Prior to joining Synechron, she served as Executive Vice President, Talent Acquisition and Shared HR Services at Broadridge Financial Solutions.\\n\\nChristin earned her Bachelor of Science in Psychology from George Mason University and a Master of Science in Industrial Psychology from Fairleigh Dickinson University.\",\"designation\":\"Chief Human Resources Officer\",\"secondaryDesignation\":\"Managing Director\",\"leadersProfileURL\":\"https://www.linkedin.com/in/christinspigai/\",\"boardOrLeadership\":\"Leadership\",\"showDetailsPage\":true,\"boardMemberAudit\":\"NA\",\"boardMemberNominatingAndGovernance\":\"NA\",\"boardMemberCompensationAndHumanCapital\":\"NA\",\"createdAt\":\"2025-06-30T07:45:13.837Z\",\"updatedAt\":\"2025-11-28T05:53:58.649Z\",\"publishedAt\":\"2025-11-28T05:53:58.662Z\",\"locale\":\"en\",\"image\":{\"id\":2811,\"documentId\":\"dghto6iregveole22jx8sorh\",\"name\":\"Christin_Spigai.webp\",\"alternativeText\":null,\"caption\":null,\"width\":353,\"height\":240,\"formats\":{\"xsmall\":{\"ext\":\".webp\",\"url\":\"/uploads/xsmall_Christin_Spigai_053a7adace.webp\",\"hash\":\"xsmall_Christin_Spigai_053a7adace\",\"mime\":\"image/webp\",\"name\":\"xsmall_Christin_Spigai.webp\",\"path\":null,\"size\":0.49,\"width\":64,\"height\":44,\"sizeInBytes\":486},\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/thumbnail_Christin_Spigai_053a7adace.webp\",\"hash\":\"thumbnail_Christin_Spigai_053a7adace\",\"mime\":\"image/webp\",\"name\":\"thumbnail_Christin_Spigai.webp\",\"path\":null,\"size\":2.66,\"width\":229,\"height\":156,\"sizeInBytes\":2662}},\"hash\":\"Christin_Spigai_053a7adace\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":5.92,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/Christin_Spigai_053a7adace.webp\",\"previewUrl\":null,\"provider\":\"local\",\"provider_metadata\":null,\"createdAt\":\"2025-06-30T07:44:28.533Z\",\"updatedAt\":\"2025-06-30T07:44:28.533Z\",\"publishedAt\":\"2025-06-30T07:44:28.533Z\",\"focalPoint\":null}},{\"order\":110,\"id\":410,\"documentId\":\"ef50odbjqzul3zvjw75uw2s6\",\"title\":\"David Sewell\",\"description\":\"**David Sewell** is the Chief Technology Officer at Synechron. He is responsible for overseeing the Global CTO office, providing strategic, architectural, and engineering expertise to support Synechron’s business units and clients.\\n\\nWith over thirty years in technology and applications architecture, his experience includes roles at top tier banks and as CTO at Citihub Digital, prior to its acquisition by Synechron. Additionally, he was the Engineering Lead for trading technology at J.P. Morgan Chase and Accenture.\\n\\nDavid graduated with an M.Eng. in Electronic and Electrical Engineering from The University of Glasgow.\",\"designation\":\"Chief Technology Officer\",\"secondaryDesignation\":null,\"leadersProfileURL\":\"https://www.linkedin.com/in/david-sewell-62556a1/\",\"boardOrLeadership\":\"Leadership\",\"showDetailsPage\":true,\"boardMemberAudit\":\"NA\",\"boardMemberNominatingAndGovernance\":\"NA\",\"boardMemberCompensationAndHumanCapital\":\"NA\",\"createdAt\":\"2025-06-30T07:47:12.538Z\",\"updatedAt\":\"2025-11-28T05:53:39.573Z\",\"publishedAt\":\"2025-11-28T05:53:39.590Z\",\"locale\":\"en\",\"image\":{\"id\":2812,\"documentId\":\"t0ijl2d0w8wmr4iyxubfcv9p\",\"name\":\"David_Sewell.webp\",\"alternativeText\":null,\"caption\":null,\"width\":353,\"height\":240,\"formats\":{\"xsmall\":{\"ext\":\".webp\",\"url\":\"/uploads/xsmall_David_Sewell_dfcdc2ffd1.webp\",\"hash\":\"xsmall_David_Sewell_dfcdc2ffd1\",\"mime\":\"image/webp\",\"name\":\"xsmall_David_Sewell.webp\",\"path\":null,\"size\":0.52,\"width\":64,\"height\":44,\"sizeInBytes\":518},\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/thumbnail_David_Sewell_dfcdc2ffd1.webp\",\"hash\":\"thumbnail_David_Sewell_dfcdc2ffd1\",\"mime\":\"image/webp\",\"name\":\"thumbnail_David_Sewell.webp\",\"path\":null,\"size\":2.8,\"width\":229,\"height\":156,\"sizeInBytes\":2798}},\"hash\":\"David_Sewell_dfcdc2ffd1\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":6.09,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/David_Sewell_dfcdc2ffd1.webp\",\"previewUrl\":null,\"provider\":\"local\",\"provider_metadata\":null,\"createdAt\":\"2025-06-30T07:46:30.326Z\",\"updatedAt\":\"2025-06-30T07:46:30.326Z\",\"publishedAt\":\"2025-06-30T07:46:30.327Z\",\"focalPoint\":null}},{\"order\":120,\"id\":402,\"documentId\":\"fet5j7u1qm435ishz01yzzzp\",\"title\":\"Rakesh Gupta\",\"description\":\"**Rakesh Gupta** has been Synechron's Chief Financial Officer since December 2011 and a member of our board of directors since April 2022.\\n\\nWith over 15 years of experience, Rakesh’s expertise spans financial reporting, internal controls, and risk management. Before joining us, he was the Chief Financial Officer Asia Pacific at Keane India Limited and served as the VP Finance at WNS Global Services.\\n\\nRakesh holds a Bachelor of Commerce from Mumbai University in, India, and is a qualified Chartered Accountant.\",\"designation\":\"Chief Financial Officer\",\"secondaryDesignation\":null,\"leadersProfileURL\":null,\"boardOrLeadership\":\"Leadership\",\"showDetailsPage\":true,\"boardMemberAudit\":null,\"boardMemberNominatingAndGovernance\":null,\"boardMemberCompensationAndHumanCapital\":null,\"createdAt\":\"2025-06-30T07:48:31.345Z\",\"updatedAt\":\"2025-06-30T07:48:34.343Z\",\"publishedAt\":\"2025-06-30T07:48:34.353Z\",\"locale\":\"en\",\"image\":{\"id\":2813,\"documentId\":\"xnv30fgz4c2agdny0z6mi0a8\",\"name\":\"Rakesh_Gupta.webp\",\"alternativeText\":null,\"caption\":null,\"width\":353,\"height\":240,\"formats\":{\"xsmall\":{\"ext\":\".webp\",\"url\":\"/uploads/xsmall_Rakesh_Gupta_1e27e2435b.webp\",\"hash\":\"xsmall_Rakesh_Gupta_1e27e2435b\",\"mime\":\"image/webp\",\"name\":\"xsmall_Rakesh_Gupta.webp\",\"path\":null,\"size\":0.55,\"width\":64,\"height\":44,\"sizeInBytes\":546},\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/thumbnail_Rakesh_Gupta_1e27e2435b.webp\",\"hash\":\"thumbnail_Rakesh_Gupta_1e27e2435b\",\"mime\":\"image/webp\",\"name\":\"thumbnail_Rakesh_Gupta.webp\",\"path\":null,\"size\":2.42,\"width\":229,\"height\":156,\"sizeInBytes\":2416}},\"hash\":\"Rakesh_Gupta_1e27e2435b\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":4.76,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/uploads/Rakesh_Gupta_1e27e2435b.webp\",\"previewUrl\":null,\"provider\":\"local\",\"provider_metadata\":null,\"createdAt\":\"2025-06-30T07:48:02.536Z\",\"updatedAt\":\"2025-06-30T07:48:02.536Z\",\"publishedAt\":\"2025-06-30T07:48:02.536Z\",\"focalPoint\":null}},{\"order\":130,\"id\":338,\"documentId\":\"fpfyvquh9m35tsruoihsrlqg\",\"title\":\"Aaron Momin\",\"description\":\"**Aaron Momin** is Synechron’s Chief Information Security Officer.  He oversees the execution of Synechron's worldwide information security strategy and information security program, aimed at mitigating reputational and operational risks to an acceptable level. Additionally, he leads the security governance, risk management and compliance efforts to align with leading industry security practices and to meet regulatory mandates.\\n \\nAaron possesses nearly three decades of extensive experience in cyber risk, IT risk, information security, and business continuity planning. He most recently served as the Chief Information Security Officer at Certinia. Over the years, Aaron has also held significant positions at prestigious global consulting firms. He was a Managing Director at PwC and held managerial roles in security at both Ernst \u0026 Young and Accenture.\\n \\nAaron graduated from the Ramapo College of New Jersey with a Bachelor of Science in Computer Information Systems.\",\"designation\":\"Chief Information Security Officer\",\"secondaryDesignation\":\"Managing Director\",\"leadersProfileURL\":\"https://www.linkedin.com/in/aaronmomin/\",\"boardOrLeadership\":\"Leadership\",\"showDetailsPage\":true,\"boardMemberAudit\":\"NA\",\"boardMemberNominatingAndGovernance\":\"NA\",\"boardMemberCompensationAndHumanCapital\":\"NA\",\"createdAt\":\"2025-06-30T07:50:16.871Z\",\"updatedAt\":\"2026-05-21T10:25:31.479Z\",\"publishedAt\":\"2026-05-21T10:25:31.603Z\",\"locale\":\"en\",\"image\":{\"id\":2631,\"documentId\":\"tz3ch1g8ov3shajwio0w9szg\",\"name\":\"Aaron Momin.webp\",\"alternativeText\":null,\"caption\":null,\"width\":353,\"height\":240,\"formats\":{\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/thumbnail_Aaron_Momin_e94269f8f4.webp\",\"hash\":\"thumbnail_Aaron_Momin_e94269f8f4\",\"mime\":\"image/webp\",\"name\":\"thumbnail_Aaron Momin.webp\",\"path\":null,\"size\":2.45,\"width\":229,\"height\":156,\"sizeInBytes\":2446}},\"hash\":\"Aaron_Momin_e94269f8f4\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":4.84,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/Aaron_Momin_e94269f8f4.webp\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2026-05-21T10:24:55.814Z\",\"updatedAt\":\"2026-05-21T10:24:55.814Z\",\"publishedAt\":\"2026-05-21T10:24:55.815Z\",\"focalPoint\":null}},{\"order\":140,\"id\":343,\"documentId\":\"li8u45yzn7shi11bnq2hqvwr\",\"title\":\"Zafar Hasan\",\"description\":\"**Zafar Hasan** serves as Chief Legal Officer and Board Secretary for Synechron. In this role, he leads Synechron's global legal strategy and serves as a partner to the Company's leadership team, providing legal support for key initiatives across the company.  \\n\\nZafar has a broad legal background, with significant experience with large law firms, the United States Securities and Exchange Commission, and in-house with two Fortune 250 companies. In these roles, he has led legal teams in M\u0026A; securities law; corporate governance; finance; global employment (including executive compensation); corporate litigation; cybersecurity; and real estate. He has also advised executive teams and boards of directors on legal, reputational, and regulatory implications in these areas. \\n\\nZafar is a graduate of Northwestern University (Phi Beta Kappa), The University of Michigan Law School, and The University of Chicago Graduate School of Business (MBA with Honors in Finance and Accounting).\",\"designation\":\"Chief Legal Officer \u0026 Board Secretary\",\"secondaryDesignation\":\"Managing Director\",\"leadersProfileURL\":\"https://www.linkedin.com/in/zafar-hasan-6bab0933/\",\"boardOrLeadership\":\"Leadership\",\"showDetailsPage\":true,\"boardMemberAudit\":\"NA\",\"boardMemberNominatingAndGovernance\":\"NA\",\"boardMemberCompensationAndHumanCapital\":\"NA\",\"createdAt\":\"2025-06-30T07:52:10.668Z\",\"updatedAt\":\"2026-05-21T10:25:55.926Z\",\"publishedAt\":\"2026-05-21T10:25:55.969Z\",\"locale\":\"en\",\"image\":{\"id\":2630,\"documentId\":\"deza13apjnvbgbf9x1casi35\",\"name\":\"Zafar Hasan.webp\",\"alternativeText\":null,\"caption\":null,\"width\":353,\"height\":240,\"formats\":{\"thumbnail\":{\"ext\":\".webp\",\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/thumbnail_Zafar_Hasan_12596dac78.webp\",\"hash\":\"thumbnail_Zafar_Hasan_12596dac78\",\"mime\":\"image/webp\",\"name\":\"thumbnail_Zafar Hasan.webp\",\"path\":null,\"size\":2.22,\"width\":229,\"height\":156,\"sizeInBytes\":2218}},\"hash\":\"Zafar_Hasan_12596dac78\",\"ext\":\".webp\",\"mime\":\"image/webp\",\"size\":4.48,\"url\":\"https://synegmc-strapi-bucket.s3.us-east-1.amazonaws.com/qaunidev/Zafar_Hasan_12596dac78.webp\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2026-05-21T10:24:55.810Z\",\"updatedAt\":\"2026-05-21T10:24:55.810Z\",\"publishedAt\":\"2026-05-21T10:24:55.810Z\",\"focalPoint\":null}}],\"__component\":\"shared.leaders-profile-list\"}]}],\"lang\":\"en\"}]\n"])</script><script>self.__next_f.push([1,"35:I[42241,[\"5592\",\"static/chunks/c15bf2b0-c59ed6c02f757fc5.js\",\"2545\",\"static/chunks/c16f53c