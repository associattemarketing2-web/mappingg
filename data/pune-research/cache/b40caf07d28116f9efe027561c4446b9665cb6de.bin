    jQuery(document).ready(function ($) {
        $('#discoverToggle').on('click', function () {

            $(this).toggleClass('active');
            $('#footerMega').toggleClass('active');
            // Scroll slightly down when expanding
            if ($('#footerMega').hasClass('active')) {
                $('html, body').animate({
                    scrollTop: $('#footerMega').offset().top - 50
                }, 400);
            }

        });
    });

    jQuery(function ($) {
        jQuery(window).on('load', function () {
            jQuery('.enquire-now-btn').fadeIn(300);
        });
        if ($(window).width() >= 992) {
            var enquireBtn = $('.enquire-btn');
            var banner = $('section:first');
            var stopSection = $('.faq-heading');
            //enquireBtn.hide();
            $(window).on('scroll', function () {
                var scrollTop = $(this).scrollTop();
                var bannerBottom = banner.offset().top + banner.outerHeight();
                var stopTop = stopSection.offset().top - 500;
                if (scrollTop > bannerBottom && scrollTop < stopTop) {
                    enquireBtn.fadeIn(200);
                } else {
                    enquireBtn.fadeOut(200);
                }

            });
        }
    });
</script>
