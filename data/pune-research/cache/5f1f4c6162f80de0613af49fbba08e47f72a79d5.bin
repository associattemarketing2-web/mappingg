			<script>
				// Show the first tab content by default
				document.getElementById('start-tab1').style.display = 'block';
				document.getElementById('start-tabBtn1').classList.add('start-active-tab'); // Highlight the first tab by default

				function openTab(tabNumber) {
					// Hide all tab contents
					var tabContents = document.getElementsByClassName('start-tab-content');
					for (var i = 0; i < tabContents.length; i++) {
						tabContents[i].style.display = 'none';
					}

					// Remove start-active-tab class from all buttons
					var tabButtons = document.getElementsByClassName('start-button');
					for (var i = 0; i < tabButtons.length; i++) {
						tabButtons[i].classList.remove('start-active-tab');
					}

					// Display the selected tab content and highlight the clicked tab button
					document.getElementById('start-tab' + tabNumber).style.display = 'block';
					document.getElementById('start-tabBtn' + tabNumber).classList.add('start-active-tab');

					// Ensure the first page is shown when switching tabs
					changePage(tabNumber, 1);
				}

				// Function to change page within a tab
				function changePage(tabNumber, pageNumber) {
					// Hide all pages within the tab
					var tabContent = document.getElementById('start-tab' + tabNumber).getElementsByClassName('start-tab-info')[0];
					var pages = tabContent.getElementsByClassName('start-tab-list');
					for (var i = 0; i < pages.length; i++) {
						pages[i].style.display = 'none';
					}

					// Show the selected page
					var selectedPage = tabContent.querySelector('.start-tab-list[data-page="' + pageNumber + '"]');
					if (selectedPage) {
						selectedPage.style.display = 'block';
					}

					// Toggle active class for pagination buttons
					var paginationButtons = document.querySelectorAll('#start-tab' + tabNumber + ' .pagination-controls button');
					for (var i = 0; i < paginationButtons.length; i++) {
						paginationButtons[i].classList.remove('active');
					}
					var activeButton = document.querySelector('#start-tab' + tabNumber + ' .pagination-controls button:nth-child(' + pageNumber + ')');
					if (activeButton) {
						activeButton.classList.add('active');
					}
				}
			</script>







