</div> -->

<div class="loader">
    <div class="loaderCenter">
        <p data-text="Claim Settlement Ratio of 99.33%">Claim Settlement Ratio of 99.33%<sup>~</sup></p>
    </div>
</div>
<style>
    .loader{
        display: none;
    }
    .loaderCenter p {
    color: #0072bc;
    /* font-size: 5em; */
    font-size: 4em;
    font-weight: bolder;
    position: absolute;
    top: 50%;
    left: 50%;
    -webkit-transform: translate(-50%, -50%);
    transform: translate(-50%, -50%);
    width: 100%;
    text-align: center;
}
 
.loaderCenter p:before {
    content: attr(data-text);
    position: absolute;
    overflow: hidden;
    max-width: 100%;
    white-space: nowrap;
    color: #fff;
   /* line-height: 1.6;*/
    -webkit-animation: mainloading 3s linear infinite;
    animation: mainloading 3s linear infinite
}
 
.loaderCenter p sup {
    font-size: 3rem;
    vertical-align: text-top;
}
.loader {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, .8);
    position: fixed;
    left: 0;
    top: 0;
    z-index: 99999;
}
 
@keyframes mainloading {
    0% {
        max-width: 0;
    }
 
    100% {
        max-width: auto;
    }
}
@media only screen and (max-width: 768px) {
    .loaderCenter p {
        font-size: 20px;
    }

    .loaderCenter p sup {
        font-size: 20px;
        vertical-align: text-top;
    }
}
</style>

<!-- Google Preferred Sources Card (starts) -->
<style>
    #balic-gps-card{position:fixed;bottom:110px;left:18px;z-index:98;display:none;animation:balic-gps-slide .3s ease;background:#ffffff;border:1.5px solid #dadce0;border-radius:12px;padding:14px 18px;box-shadow:0 2px 12px rgba(0,0,0,.15);cursor:pointer;transition:box-shadow .2s;width:fit-content}
    #balic-gps-card:hover{box-shadow:0 4px 20px rgba(0,0,0,.22)}
    #balic-gps-inner{display:flex;align-items:center;gap:14px}
    #balic-gps-card svg{width:36px;height:36px;flex-shrink:0}
    #balic-gps-desktop-text{font-size:14px;font-weight:500;color:#202124;line-height:1.5;width:190px;display:block}
    #balic-gps-desktop-text b{color:#0072bc;font-weight:700}
    #balic-gps-mobile-text{font-size:13px;color:#202124;line-height:1.4;display:none}
    #balic-gps-mobile-text b{color:#0072bc}
    #balic-gps-close{position:absolute;top:-8px;right:-8px;width:22px;height:22px;background:#ffffff;border:1.5px solid #dadce0;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:12px;color:#5f6368;box-shadow:0 1px 4px rgba(0,0,0,.15);line-height:1;padding:0}
    #balic-gps-close:hover{background:#f1f3f4;color:#202124}
    @media(max-width:480px){
        #balic-gps-card{bottom:16px;left:16px;right:16px;padding:10px 14px}
        #balic-gps-desktop-text{display:none}
        #balic-gps-mobile-text{display:block}
    }
    @keyframes balic-gps-slide{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
</style>
<div id="balic-gps-card" onclick="if(window._balicPS)window._balicPS.addPreferredSource();" role="link" aria-label="Add Bajaj Life as a preferred source on Google">
    <button id="balic-gps-close" aria-label="Close">&#x2715;</button>
    <div id="balic-gps-inner">
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        <span id="balic-gps-desktop-text">Add <b>Bajaj Life</b> as a preferred source on Google</span>
        <span id="balic-gps-mobile-text">Add to <b>preferred source</b></span>
    </div>
</div>
<script>
    (function() {
        var card = document.getElementById('balic-gps-card');
        if (localStorage.getItem('balic-gps-done') || sessionStorage.getItem('balic-gps-closed')) return;
        var observerStarted = false;
        window.addEventListener('load', function() {
            setTimeout(function() { card.style.display = 'block'; }, 1000);
        });
        card.addEventListener('click', function() {
            if (observerStarted) return;
            observerStarted = true;
            var observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    mutation.addedNodes.forEach(function(node) {
                        if (node.nodeType !== 1) return;
                        if (node.classList.contains('publisher-toast') || node.querySelector('.publisher-toast')) {
                            observer.disconnect();
                            card.style.display = 'none';
                            localStorage.setItem('balic-gps-done', '1');
                        }
                    });
                });
            });
            observer.observe(document.body, { childList: true, subtree: true });
        });
        document.getElementById('balic-gps-close').addEventListener('click', function(e) {
            e.stopPropagation();
            card.style.display = 'none';
            sessionStorage.setItem('balic-gps-closed', '1');
        });
    })();
</script>
<!-- Google Preferred Sources Card (ends) -->
 
    

    

    
    

        
