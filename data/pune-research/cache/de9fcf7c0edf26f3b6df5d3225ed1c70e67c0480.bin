            <style>
:root {
--kalp-black: #000000;
--kalp-text: #1a1a1a;
--kalp-gold: #c09841;
--kalp-gold-muted: #BF9B30;
--kalp-line: #dddddd;
--kalp-muted: #4a4a4a;
}
/* body {margin: 0;font-family: "Roboto", sans-serif;font-weight: 400;color: var(--kalp-text);background: #ffffff;-webkit-font-smoothing: antialiased;} */
a {color: inherit;text-decoration: none;}

ul {list-style: none;margin: 0;padding: 0;}
/* <!-- New CSS for Footer start --> */

.kalp__footer__section {background: #ffffff;padding: 64px 0 0;border-top: 1px solid var(--kalp-line);}
.kalp__footer__section__wrapper {width: 100%;margin: 0 auto;padding: 0 40px;}

/* —— Top: brand + quick links —— */
.kalp__footer__top {display: grid;grid-template-columns: minmax(220px, 1100px) 1fr;gap: 48px 64px;align-items: start;padding-bottom: 40px;}
.kalp__footer__brand {display: flex;flex-direction: column;align-items:flex-start;min-width:0;}
.kalp__footer__logo {display: inline-block;line-height: 0;width: min(100%, 284px);margin-bottom: 48px;}
.kalp__footer__logo svg {width: 100%;height: auto;display: block;}
.kalp__footer__contact {display: flex;flex-direction: column;align-items:flex-start;gap: 10px;}
.kalp__footer__contact a {display: inline-block;margin: 0;font-family: "Roboto", sans-serif;font-size: 0.6em;font-style: normal;font-weight: 400;line-height: 1.35;color: var(--kalp-black);text-decoration: none;}
.kalp__footer__contact a.nav-link.head-nav-link,
.kalp__footer__brand > .head-nav-link {padding: 0;margin: 0 0 2px;font-size: 0.725em;font-weight: 500;line-height: 1.3;letter-spacing: 1.2px;text-transform: uppercase;color: var(--kalp-gold-muted);}
.kalp__footer__brand > .head-nav-link {display: flex;margin-top: 14px;}
.kalp__footer__social {display: flex;align-items: center;justify-content: flex-start;gap: 12px;margin-top: 10px;}
.kalp__footer__social a {display: inline-flex;align-items: center;justify-content: center;box-sizing: border-box;width: 32px;height: 32px;padding: 6px;border: 1px solid var(--kalp-gold-muted);border-radius: 9px;color: var(--kalp-gold-muted);transition: background-color 0.2s ease, color 0.2s ease;}
.kalp__footer__social a:hover {background-color: var(--kalp-gold-muted);color: #ffffff;}
.kalp__footer__social svg {display: block;width: 100%;height: 100%;}
.kalp__footer__nav ul {display: grid;grid-template-columns: repeat(5, minmax(0, 1fr));grid-template-rows: repeat(3, auto);grid-auto-flow: column;column-gap: 40px;}
.kalp__footer__nav ul li {margin-bottom: 14px;}
.kalp__footer__nav a {display: inline-block;font-size:0.6em;line-height: 1.2;color: var(--kalp-black);font-family: "Roboto", sans-serif;text-transform: uppercase;}

/* —— Divider + projects toggle (desktop) —— */
.kalp__footer__divider {position: relative;height: 1px;background: var(--kalp-line);margin: 0 0 48px;transition: margin-bottom 0.45s ease;}
.kalp__footer__to-top {position: absolute;left: 50%;top: 50%;transform: translate(-50%, -50%);width: 36px;height: 36px;border-radius: 50%;border: 0px solid var(--kalp-gold);background: #ffffff;color: var(--kalp-gold);display: inline-flex;align-items: center;justify-content: center;cursor: pointer;padding: 0;transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;}
.kalp__footer__to-top:hover {transform: translate(-50%, -50%) translateY(-2px);opacity: 1;}
.kalp__footer__to-top svg {width: 24px;height: 24px;transition: transform 0.35s ease;}
.kalp__footer__section.is-projects-collapsed .kalp__footer__to-top svg {transform: rotate(180deg);}
.kalp__footer__section.is-projects-collapsed .kalp__footer__divider {margin-bottom: 0;}

/* Smooth slide wrapper for desktop projects */
.kalp__footer__projects-shell {display: grid;grid-template-rows: 1fr;transition: grid-template-rows 0.45s ease;}
.kalp__footer__section.is-projects-collapsed .kalp__footer__projects-shell {grid-template-rows: 0fr;}
.kalp__footer__projects-shell-inner {overflow: hidden;min-height: 0;}

/* —— Project link columns (desktop) —— */
.kalp__footer__projects {display: grid;grid-template-columns: 2fr 1fr 1fr 1fr;gap: 28px 32px;padding-bottom: 36px;}
.kalp__footer__heading {margin: 0 0 20px;font-size: 0.725em;font-weight: 500;letter-spacing: 0.04em;line-height: 1.35;text-transform: uppercase;color: var(--kalp-gold-muted); font-family:"Roboto", sans-serif;}
.kalp__footer__heading:not(:first-child) {margin-top: 28px;}
.kalp__footer__link-list {display: flex;flex-direction: column;}
.kalp__footer__link-list li {margin-bottom: 14px;}
.kalp__footer__link-list li a {display: inline-block;font-size: 0.6em;line-height: 1.2;color: var(--kalp-black);font-family: "Roboto", sans-serif;text-transform: uppercase;}
.kalp__footer__locations {display: grid;grid-template-columns: 1fr 1fr;gap: 0 28px;}
.kalp__footer__locations ul {display: flex;flex-direction: column;}
.kalp__footer__locations ul li {margin-bottom: 14px;}
.kalp__footer__locations a {display: inline-block;font-size: 14px;line-height: 1.2;color: var(--kalp-black);font-family: "Roboto", sans-serif;}
.kalp__footer__stack {display: flex;flex-direction: column;}
/* .kalp__footer__col:nth-child(2){margin-top: 60px;} */

/* —— Accordion (mobile) —— */
.kalp__footer__accordion {display: none;padding-bottom: 8px;}
.kalp__footer__acc-item {border-bottom: 1px solid #727171;}
.kalp__footer__acc-item:last-child {border-bottom: none;}
.kalp__footer__acc-btn {width: 100%;display: flex;align-items: center;justify-content: space-between;gap: 16px;padding: 16px 0;border: 0;background: transparent;cursor: pointer;text-align: left;font-size: 0.725em;font-weight: 500;letter-spacing: 0.03em;line-height: 1.35;text-transform: uppercase;color: var(--kalp-gold-muted);}
.kalp__footer__acc-icon {flex-shrink: 0;width: 18px;height: 18px;position: relative;}
.kalp__footer__acc-icon::before,.kalp__footer__acc-icon::after {content: "";position: absolute;background: var(--kalp-gold-muted);transition: transform 0.25s ease, opacity 0.25s ease;}
.kalp__footer__acc-icon::before {width: 12px;height: 1.5px;left: 3px;top: 8px;}
.kalp__footer__acc-icon::after {width: 1.5px;height: 12px;left: 8.25px;top: 3px;}
.kalp__footer__acc-item.is-open .kalp__footer__acc-icon::after {opacity: 0;transform: scaleY(0);}
.kalp__footer__acc-panel {display: grid;grid-template-rows: 0fr;transition: grid-template-rows 0.3s ease;}
.kalp__footer__acc-item.is-open .kalp__footer__acc-panel {grid-template-rows: 1fr;}
.kalp__footer__acc-panel-inner {overflow: hidden;}
.kalp__footer__acc-panel .kalp__footer__link-list,.kalp__footer__acc-panel .kalp__footer__locations {padding: 0 0 18px;}

/* —— Bottom bar —— */
.kalp__footer__bottom {display: flex;align-items: center;justify-content: space-between;gap: 16px;padding: 48px 0 64px;border-top: 1px solid var(--kalp-line);}
.kalp__footer__bottom .kalp__footer__copy {font-size: 0.6em;line-height: 1.2;color: var(--kalp-black);font-family: "Roboto", sans-serif;text-transform:uppercase;padding: .5rem 1rem;}
.kalp__footer__legal {display: flex;align-items: center;gap: 28px;}
.kalp__footer__legal a {font-size: 0.6em;line-height: 1.2;color: var(--kalp-black);font-family: "Roboto", sans-serif;text-transform:uppercase;}

.kalp__footer__section button:focus{outline:none;}

/* —— Responsive —— */
@media (max-width: 1280px) {
.kalp__footer__section__wrapper {padding: 0 20px;}
}
/* 1200px → 901px: two columns, next two wrap below */
@media (max-width: 1200px) and (min-width: 901px) {
.kalp__footer__projects {grid-template-columns: 1fr 1fr;gap: 36px 40px;}
.kalp__footer__projects .kalp__footer__col--locality {grid-column: auto;display: block;}
.kalp__footer__top {grid-template-columns: minmax(220px, 400px) 1fr;gap: 30px 40px;}
}
/* Desktop footer columns */
@media (min-width: 901px) {
    .kalp__footer__top {grid-template-columns: minmax(0, 1fr) 212px;gap: 40px;align-items: start;}
}
@media (max-width: 900px) {
.kalp__footer__section {padding-top: 32px;}
.kalp__footer__top {grid-template-columns: 1fr;gap: 32px;text-align: center;padding-bottom: 28px;}
.kalp__footer__brand {align-items: center;}
.kalp__footer__logo {width: min(100%, 203px);margin-bottom: 24px;}
.kalp__footer__social {justify-content: center;}
.kalp__footer__nav {grid-template-columns: 1fr 1fr;grid-template-rows: repeat(6, auto);grid-auto-flow: column;column-gap: 24px;text-align: left;width: 100%;}
.kalp__footer__projects {display: none;}
.kalp__footer__accordion {display: block;}
.kalp__footer__projects-shell {display: grid;}
.kalp__footer__bottom {flex-direction: column;flex-wrap: wrap;justify-content: space-between;padding: 32px 0;}
.kalp__footer__legal {gap: 18px;}
.kalp__footer__divider{margin: 0 0 20px;}
.kalp__footer__contact {align-items: center;}
.kalp__footer__brand > .head-nav-link {justify-content: center;}
}
@media (max-width: 599px) {
.kalp__footer__nav ul {display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-template-rows: repeat(5, auto);
        grid-auto-flow: column;
        column-gap: 20px;
    }
}
@media (max-width: 480px) {
.kalp__footer__bottom {flex-direction: column;align-items: flex-center;gap: 10px;}
}
</style>
