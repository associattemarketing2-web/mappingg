function validateMaterialGrade(){
	$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-material-grade-error").html('');
	var fieldVal = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-material-grade").val();
	if(typeof fieldVal == "undefined" || fieldVal == ""){
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-material-grade-error").html('* Material Grade Required.');
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-material-grade").addClass("error-border");
