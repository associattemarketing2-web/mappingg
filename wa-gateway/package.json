{
  "name": "mappingg-wa-gateway",
  "private": true,
  "version": "1.0.0",
  "description": "Linked-device WhatsApp gateway (QR scan) for the Mappingg s-admin WhatsApp Inbox. Runs on an always-on server, not Vercel.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "start:local": "node --env-file=../.env --dns-result-order=ipv4first src/server.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "qrcode": "1.5.4"
  }
}
