	<section id="search_popup">
		<div class="search_field">
			<input id="top-search" type="search" placeholder="Search" autofocus>
		</div>
		<div class="search_list">
			<ul>
			</ul>
			<script>
				function cleanText(text) {
    return text.replace(/[^a-zA-Z0-9 ]/g, '');
}
				const searchArray = localStorage.getItem("searchHistory") ? localStorage.getItem("searchHistory").split(',') : null;
				const searchSet = new Set(searchArray);
								searchSet.size>0?localStorage.setItem("searchHistory", Array.from(searchSet)):"";
				searchSet.forEach(element => {
					$("div.search_list > ul").prepend("<li class='searchSuggestion' onclick='window.location = `https://www.finolexpipes.com/search-page/?q="+element+"`'>" + cleanText(element) + "</li>");
				});
			</script>
		</div>
	</section>
