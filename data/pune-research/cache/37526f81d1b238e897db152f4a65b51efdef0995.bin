<div class="code-embed">
  <style>

.carousel-container {
  width: 100%;
  margin: auto;
  overflow: hidden; /* Crucial: Hides overflowing content */
  position: relative; /* Needed for positioning the fade overlays */
  /* Masking approach (alternative to pseudo-elements for fade) */
  /* -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent); */
}

/* --- Fade Overlays using Pseudo-elements --- */
.carousel-container::before,
.carousel-container::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  width: 15%; /* Adjust percentage width of the fade */
  z-index: 2; /* Ensure overlays are above the track */
  pointer-events: none; /* Allows interaction with elements underneath */
}

.carousel-container::before {
  left: 0;
  background: linear-gradient(to right, #000822 0%, rgba(0, 8, 34, 0) 100%); /* Fade from background color */
}

.carousel-container::after {
  right: 0;
  background: linear-gradient(to left, #000822 0%, rgba(0, 8, 34, 0) 100%); /* Fade from background color */
}
/* --- End Fade Overlays --- */


.carousel-track {
  display: flex;
  /* Calculate width: (Tile Width + Gap) * Total Number of Tiles (Originals + Duplicates) */
  /* Example: (300px + 20px) * 16 = 5120px */
  width: calc((320px + 20px) * 12); /* Adjust tile width and gap as needed */
  gap: 20px; /* Space between tiles */
  animation: scrollLeft 40s linear infinite; /* Adjust duration as needed */
  will-change: transform; /* Optimization hint */
}

/* Pause animation on hover */
.carousel-container:hover .carousel-track {
  animation-play-state: paused;
}

@keyframes scrollLeft {
  0% {
    transform: translateX(0);
  }
  100% {
    /* Scroll by the width of ONE set of original tiles + gaps */
    /* (Tile Width + Gap) * Number of ORIGINAL Tiles */
    /* (300px + 20px) * 8 = 2560px */
    transform: translateX(calc(-1 * (320px + 20px) * 6)); /* Adjust tile width, gap, and ORIGINAL count */
  }
}

.carousel-tile {
  background-color: #fff; /* White background for tiles */
  color: #333; /* Dark text color */
  border-radius: 12px;
  padding: 25px 20px 35px;
  width: 320px; /* Fixed width for each tile */
  flex-shrink: 0; /* Prevent tiles from shrinking */
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  gap: 10px;
}

.carousel-tile p {
  font-size: 16px;
  font-weight: 700;
  margin-top: 0;
  margin-bottom: 15px;
  text-align: center;
  color: #111;
}

.carousel-tile img {
  width: 100%;
  object-fit: contain;
  margin: 0px auto;
}

.carousel-tile a.image-link {
  align-self: center;
}

.carousel-tile ul {
  /* list-style: disc; */
  margin-left: 25px;
  padding-left: 0;
  font-size: 0.9em;
  flex-grow: 1; /* Push link to bottom */
  margin-bottom: 15px;
  color: #555;
}

.carousel-tile li {
  margin-bottom: 5px;
}

.carousel-tile a {
  color: #0056b3;
  text-decoration: none;
  font-weight: bold;
  align-self: flex-start; /* Align link to the left */
}

.carousel-tile a:hover {
  text-decoration: underline;
}

/* Placeholder image style */
img[src="placeholder-logo.png"] {
    background-color: #eee;
    border: 1px dashed #ccc;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 0.8em;
    color: #999;
}

img[src="placeholder-logo.png"]::after {
    content: 'Logo';
}

</style>

</div>

        
