            //             }, 1500);
            //         });
            //         result.data.forEach(item2 => {
            //             let option = "<option value='" + item2.configuration_type_id + "'>" + item2.configuration_type + "</option>";
            //             setTimeout(() => {
            //             $(".our_project_new").append(option);
            //             }, 1500);
            //         });

            //         // ✅ Set selected value from storage if present
            //         if (storedParams?.configuration_type_id) {
            //             $('#configuration_id').val(storedParams.configuration_type_id).trigger('change');
            //             setTimeout(() => {
            //                 $('#configuration_id2').val(storedParams.configuration_type_id).trigger('change');
            //             }, 2000);
