			<a href="#legacy" target="_self" class="btn btn-line-black btn-big  ">OUR LEGACY</a>
	    
</div></div></div></div></div></section></section><section id="legacy" class="wpb_row vc_row-fluid hidden-overflow vc_custom_1726912868926"><div class="container"><div class="row"><div class="wpb_column vc_column_container vc_col-sm-12"><div class="vc_column-inner"><div class="wpb_wrapper "  >
