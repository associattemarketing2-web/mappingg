<script>
document.addEventListener("DOMContentLoaded", function () {

    const observer = new IntersectionObserver(function(entries) {

        entries.forEach(function(entry) {

            if (entry.isIntersecting) {

                const img = entry.target;

                if (img.dataset.src) {
                    img.src = img.dataset.src;
                    img.removeAttribute("data-src");
                }

                observer.unobserve(img);
            }

        });

    }, {
        root: null,
        rootMargin: "0px",
        threshold: 0.1
    });

    // Observe existing images
    function observeLazyImages(scope = document) {

        const lazyImages = scope.querySelectorAll(".lazy-image[data-src]");

        lazyImages.forEach(function(img) {

            // prevent duplicate observing
            if (!img.dataset.lazyObserved) {
                observer.observe(img);
                img.dataset.lazyObserved = "true";
            }

        });
    }

    observeLazyImages();

    // Watch dynamically added elements
    const mutationObserver = new MutationObserver(function(mutations) {

        mutations.forEach(function(mutation) {

            mutation.addedNodes.forEach(function(node) {

                if (node.nodeType === 1) {

                    // if added node itself is lazy image
                    if (node.matches('.lazy-image[data-src]')) {
                        observeLazyImages(node.parentNode);
                    }

                    // if lazy images exist inside added node
                    observeLazyImages(node);
                }

            });

        });

    });

    mutationObserver.observe(document.body, {
        childList: true,
        subtree: true
    });

});

// immmense page footer form
 $("form[name='enquiryform_immensa']").validate({
          rules: {
            name: {
                required: true,
                validName: true
            },
            email: {
