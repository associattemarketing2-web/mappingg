<script type="text/javascript">
 $(document).ready(function(){
	if($('.topProgressBar').length){
		var pageHeight = $('body').innerHeight();

		$(window).scroll(function(){
			var s = $(window).scrollTop();
			var d = $(document).height();
			var c = $(window).height();

			var scrollPercent = (s / (d - c)) * 100;

			$('.topProgressBar').css('width', scrollPercent+'%');
		});
	}
});
</script>
<script>
var iFramesSangrahaIFrameAutoAdjustHtAndW = $('.SangrahaIFrameAutoAdjustHtAndW');

		function iResize() {

			//alert("repeat");
			
			if(iFramesSangrahaIFrameAutoAdjustHtAndW.length > 0)
			{
		
				for (var i = 0, j = iFramesSangrahaIFrameAutoAdjustHtAndW.length; i < j; i++) 
				{
				  iFramesSangrahaIFrameAutoAdjustHtAndW[i].style.height = iFramesSangrahaIFrameAutoAdjustHtAndW[i].contentWindow.document.body.offsetHeight + 'px';
				  iFramesSangrahaIFrameAutoAdjustHtAndW[i].style.width = iFramesSangrahaIFrameAutoAdjustHtAndW[i].contentWindow.document.body.scrollWidth + 'px';	
				}
			
			}
		}

		if ($.support.safari || $.support.opera) { 

			if(iFramesSangrahaIFrameAutoAdjustHtAndW.length > 0)
			{
		
			   iFramesSangrahaIFrameAutoAdjustHtAndW.load(function(){
				   setTimeout(iResize, 0);
			   });
		   
		    }

			if(iFramesSangrahaIFrameAutoAdjustHtAndW.length > 0)
			{
			
			   for (var i = 0, j = iFramesSangrahaIFrameAutoAdjustHtAndW.length; i < j; i++) {
					var iSource = iFramesSangrahaIFrameAutoAdjustHtAndW[i].src;
					iFramesSangrahaIFrameAutoAdjustHtAndW[i].src = '';
					iFramesSangrahaIFrameAutoAdjustHtAndW[i].src = iSource;
			   }
		   
		    }

		} else {
		
			if(iFramesSangrahaIFrameAutoAdjustHtAndW.length > 0)
			{
		
			   iFramesSangrahaIFrameAutoAdjustHtAndW.load(function() { 
				   this.style.height = this.contentWindow.document.body.offsetHeight + 'px';
				   this.style.width = this.contentWindow.document.body.scrollWidth + 'px';
				   //alert("else");
				   
			   });
		   
		   }
		}

		setInterval(iResize, 1000);
		
        </script>

</body>

