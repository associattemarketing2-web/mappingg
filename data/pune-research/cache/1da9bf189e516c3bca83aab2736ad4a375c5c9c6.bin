            // }
            success: function(result) {
                $(".our_project_new").html("");

                if (result.status === 200 && Array.isArray(result.data)) {

                    // ✅ SORT DESCENDING
                    result.data.sort((a, b) => b.configuration_type_id - a.configuration_type_id);

                    const defaultOption = '';
                    $("#configuration_id").html(defaultOption);
                    $("#configuration_id2").html(defaultOption);
                    $(".our_project_new").html(defaultOption);

                    // Populate every configuration dropdown in a single loop
                    result.data.forEach(item => {
