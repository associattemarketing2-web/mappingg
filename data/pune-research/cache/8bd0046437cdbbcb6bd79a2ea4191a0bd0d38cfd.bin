.98-96-96-96S80 42.98 80 96v160c0 53.02 42.98 96 96 96zm160-160h-16c-8.84 0-16 7.16-16 16v48c0 74.8-64.49 134.82-140.79 127.38C96.71 376.89 48 317.11 48 250.3V208c0-8.84-7.16-16-16-16H16c-8.84 0-16 7.16-16 16v40.16c0 89.64 63.97 169.55 152 181.69V464H96c-8.84 0-16 7.16-16 16v16c0 8.84 7.16 16 16 16h160c8.84 0 16-7.16 16-16v-16c0-8.84-7.16-16-16-16h-56v-33.77C285.71 418.47 352 344.9 352 256v-48c0-8.84-7.16-16-16-16z"></path></svg></button><button class="text-white"><img alt="menu" loading="lazy" width="36" height="24" decoding="async" data-nimg="1" style="color:transparent" src="/_next/static/media/menu-bar.4e6c9ff9.svg"/></button></div></div></nav></header><main class="flex-1"><div class="relative w-full w-full h-[300px] md:h-[400px] lg:h-[430px] xl:h-[430px] 2xl:h-[500px]"><div class="relative w-full h-full"><div class="absolute top-0 w-full h-full bg-black/50 z-[1]"></div><div class="absolute top-0 w-full h-full bg-gradient-to-r from-black/80 via-black/50 to-black/40"></div><div class="absolute top-0 w-full h-full bg-gradient-to-r from-black via-black/40 to-transparent"></div><div class="relative w-full h-full overflow-hidden"><img alt="Background Image" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="/_next/static/media/hero_image.e73c5d81.webp"/></div></div><div class="absolute inset-0 z-10"><div class="container mx-auto h-full px-10"><div class="flex h-full flex-col items-start justify-center text-white"><h1 class="
    font-semibold
    text-left
    leading-tight
    md:leading-[3.5rem]
    w-full
    md:w-2/3
