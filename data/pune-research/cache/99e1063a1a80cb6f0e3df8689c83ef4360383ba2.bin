<header class="banner-head" style="background-image:url(https://www.vascon.com/images/team/banner.jpg); height:60vh"><meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <div class="container">
    <h1 data-aos="zoom-in-up" class="aos-init aos-animate">Our Team</h1>
  </div>
</header>

<div class="team-heading">
<div class="container">
  <ol class="breadcrumb">
