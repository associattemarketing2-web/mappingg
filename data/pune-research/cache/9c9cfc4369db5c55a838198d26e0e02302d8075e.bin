    <script>
        (function () {
            var startX = 0, startY = 0, dragged = false, tracking = false;
            document.addEventListener('pointerdown', function (e) {
                if (!e.target.closest('.swiper-slide[data-href]')) return;
                startX = e.clientX;
                startY = e.clientY;
                dragged = false;
                tracking = true;
            }, true);
            document.addEventListener('pointermove', function (e) {
                if (!tracking) return;
                if (Math.abs(e.clientX - startX) > 10 || Math.abs(e.clientY - startY) > 10) dragged = true;
            }, true);
            document.addEventListener('pointerup', function () { tracking = false; }, true);
            document.addEventListener('click', function (e) {
                var slide = e.target instanceof Element && e.target.closest('.swiper-slide[data-href]');
                if (!slide) return;
                if (dragged) return;
                if (e.target.closest('a, button')) return;
                var href = slide.getAttribute('data-href');
                if (href) window.location.assign(href);
                dragged = false;
            }, true);
        })();
    </script>
