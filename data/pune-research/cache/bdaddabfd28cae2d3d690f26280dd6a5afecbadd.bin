.mediapage-index-index .list-media-release ul .news-content {
padding:25px 0 0px;
}

</style>
<style>
@media (max-width: 767px) { 
.catalog-product-view .product.media {text-align: center;}
.antifraud-section .qh-fraud-prevention-tab-section {
    z-index: 99; top: 55px; position: sticky;background: #fff;
}
}

</style>
<style>
    @media (min-width: 768px) {
.aboutUsSection .sectionFive .sectionFiveWrap .sectionFiveImageCard button.slick-prev {z-index:100}
.aboutUsSection .sectionFive .sectionFiveWrap .sectionFiveImageCard button.slick-next {z-index:100}
            .product-quick-heal-internet-security-essentials .product-detail-container .qh-online-threats-section .right-pane .qh-card-online-threads .qh-card-online-threads-img-container {
            max-height: 355px;
        }
    }
@media (max-width:767px) {
	.product-detail-container .feature-container.qh-h-fit .qh-card-section [class^="qh-card-content-section-"] .qh-card-description, .product-detail-container .feature-container.qh-h-fit .qh-card-section [class^="qh-card-content-section-"] .qh-qh-card-description-three {font-size: 14px;margin-top: 8px;}
}
@media print {
    body, html {
        margin: 0 !important;
        padding: 0 !important;
    }

    .page-wrapper,
    .page-main,
    .columns,
    .column.main {
        margin-top: 0 !important;
        padding-top: 0 !important;
        break-before: avoid !important;
        page-break-before: avoid !important;
    }

    /* Remove useless Chrome top margin */
    @page {
        margin-top: 0;
        margin-bottom: 0;
    }
}

.product-quick-heal-total-security-multi-device .product-info-main .userGuideDatasheetWrap {
@media (max-width: 767px) {
   flex-wrap: wrap;
   margin-left: 20px;
}
}

.product-info-main .userGuideDatasheetWrap .product-download {
    @media (max-width: 767px) {
       margin-right: 60px;
   }
}
.product-download .dropdown-menu.active {
    z-index: 999;
}

.fieldset.hidden-fields{display:none;}
.in-website.checkout-with-renewal.renew-checkout .address .field-error {display:block !important;}
