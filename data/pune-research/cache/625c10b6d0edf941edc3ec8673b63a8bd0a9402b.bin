						</div>

						<div class="mo-osp-puzzle-error" id="mo-osp-puzzle-error" style="display: none;">
							<svg class="mo-osp-error-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
