	<script>
		// Show the first tab content by default
		document.getElementById('commerical-tab1').style.display = 'block';
		document.getElementById('commerical-tabBtn1').classList.add('commerical-active-tab'); // Highlight the first tab by default

		function openCommericalTab(tabNumber) {
			// Hide all tab contents
			var tabContents = document.getElementsByClassName('commerical-tab-content');
			for (var i = 0; i < tabContents.length; i++) {
				tabContents[i].style.display = 'none';
			}

			// Remove commerical-active-tab class from all buttons
			var tabButtons = document.getElementsByClassName('commerical-button');
			for (var i = 0; i < tabButtons.length; i++) {
				tabButtons[i].classList.remove('commerical-active-tab');
			}

			// Display the selected tab content and highlight the clicked tab button
			document.getElementById('commerical-tab' + tabNumber).style.display = 'block';
			document.getElementById('commerical-tabBtn' + tabNumber).classList.add('commerical-active-tab');
		}
	</script>
















