						<input type="text" name="mobileno" id="enquiryNum" class="form-control required" placeholder="Enter Mobile Number">
						<div class="error-msg" id="errenquirymobnum"></div>
					</div>
				</div>
				<div class="col-12 col-sm-6">
					<div class="form-group">
						<label for="productName">Product Name *</label>
