<script type="text/javascript">
$(document).ready(function() {
    //Empty Array for Categories
    var categories = [];

    //Get Access Token
    fetch('https://nthrewardsid.novusloyalty.com/connect/token', {
        method: 'POST', 
        body: new URLSearchParams({
            client_id:'janata sahakari bank637673694810739960', 
            grant_type:'client_credentials', 
            client_secret:'JPLKSRWYOV'
        }),
        headers:{
        'Content-Type': 'application/x-www-form-urlencoded'
        }
    }).then((response) => response.json())
    .then((responseData) => {
        var token = responseData.access_token;

        //Get Offers
        $.ajax({
            url: 'https://nthrewardsprogramapi.novusloyalty.com/api/offers',
            type: 'GET',
            beforeSend : function( xhr ) {
                xhr.setRequestHeader( "Authorization", "Bearer " + token );
            },
            success: function( response ) {
                $('#UyDK-zXhb-HGyB-IljR .load').hide();
                
                //Get Offers
                var count = 0;
                $.each(response.data, function(key, value){
                    count++;
                    if(count > 11){
                        var title       = response.data[key].title;
                        var description = response.data[key].description.replaceAll("<br />\n", '');
                        var image       = response.data[key].imageLink;
                        var code        = response.data[key].offerCode;
                        if(code == ''){
                            code = '<span class="coupon nocoupon">No Coupon Required</span>';
                        }else{
                            code = '<span class="coupon">'+code+'</span>';
                        }
                        var redemption  = response.data[key].redemptionProcess;
                        var terms       = response.data[key].termAndCondition;
                        var start       = response.data[key].startDateTime;
                        var end         = response.data[key].endDateTime.split('T');
                        var category    = '';
                        var status      = response.data[key].status;


                        $.each(response.data[key].tags, function(key2, value2){
                            if(response.data[key].tags[key2].TagKey == 'Category'){
                                category = response.data[key].tags[key2].values[0].Name;
                            }
                        });

                        $('#UyDK-zXhb-HGyB-IljR .grid').append(`
                            <div class="box">
                                <div class="content">
                                    <h1><a href="#">`+title+`</a></h1>
                                </div>
                                <div href="#" class="image" style="background-image:url(`+image+`); background-size:cover; background-position:top center;">
                                    <span class="category"><a href="#">`+category+`</a></span>
                                </div>
                                <div class="content">
                                    <p><a>`+description+` | Offer Valid Till: `+end[0]+`</a></p>
                                    `+code+`
                                    <div class="process">`+redemption+`</div>
                                    <div class="terms">`+terms+`</div>
                                </div>
                            </div>
                        `);
                    }
                });
                load_more();

                // console.log(description+' | Offer Valid Till: '+end[0]);
                console.log(response);
            }
        });
    }).catch(err=>{console.log(err)});
    
    //Show popup on click
    $('body').on('click', '#UyDK-zXhb-HGyB-IljR .grid .box .image', function(){
        var title       = $(this).closest('.box').find('h1').text();
        var category    = $(this).closest('.box').find('.category').text();
        var image       = $(this).closest('.box').find('.image').attr('style');
        var desc        = $(this).closest('.box').find('p').text();
        var coupon      = $(this).closest('.box').find('.coupon').text();
        var proc        = $(this).closest('.box').find('.process').html();
        var terms       = $(this).closest('.box').find('.terms').html();

        $('#UyDK-zXhb-HGyB-IljR .popup .box .image').attr('style', image);
        $('#UyDK-zXhb-HGyB-IljR .popup .box .image h1').text(title+' | '+category);
        $('#UyDK-zXhb-HGyB-IljR .popup .box .content .desc p').text(desc);
        $('#UyDK-zXhb-HGyB-IljR .popup .box .content .desc .coupon').text(coupon);
        if($(this).closest('.box').find('.coupon').hasClass('nocoupon')){
            $('#UyDK-zXhb-HGyB-IljR .popup .box .content .desc .coupon').addClass('nocoupon');
        }else{
            $('#UyDK-zXhb-HGyB-IljR .popup .box .content .desc .coupon').removeClass('nocoupon');
        }
        $('#UyDK-zXhb-HGyB-IljR .popup .box .content .process p').html(proc);
        $('#UyDK-zXhb-HGyB-IljR .popup .box .content .terms p').html(terms);
        $('#UyDK-zXhb-HGyB-IljR .popup').fadeIn();
    });

    //Show popup on click
    $('body').on('click', '#UyDK-zXhb-HGyB-IljR .popup .image i', function(){
        $('#UyDK-zXhb-HGyB-IljR .popup').fadeOut();
    });
});

function load_more(){
     //Load More
    if ($('#UyDK-zXhb-HGyB-IljR').attr('data-load') == 'true') {
        var count1 = $('#UyDK-zXhb-HGyB-IljR').attr('data-count1');
        var count2 = $('#UyDK-zXhb-HGyB-IljR').attr('data-count2');
        var count3 = 0;

        //Check if items are available to load
        $('#UyDK-zXhb-HGyB-IljR .box').each(function() { count3++; });
        if (count3 <= count1) {
            $('#UyDK-zXhb-HGyB-IljR .load_more').hide();
        } else {
            $('#UyDK-zXhb-HGyB-IljR .load_more').show();

            //Hide items
            $('#UyDK-zXhb-HGyB-IljR .box').each(function(count) {
                if (count >= count1) {
                    $(this).hide();
                }
            });

            //Load more items on click
            $('#UyDK-zXhb-HGyB-IljR .load_more').click(function(e) {
                e.preventDefault();
                $(this).addClass('load_more_active').text('');

                setTimeout(function() {
                    for (var i = 1; i <= count2; i++) {
                        $('#UyDK-zXhb-HGyB-IljR .box').each(function(count) {
                            if ($(this).css('display') == 'none') {
                                $(this).fadeIn();
                                return false;
                            }
                        });
                    }

                    //check if any hidden item left
                    var hidden_item = false;
                    $('#UyDK-zXhb-HGyB-IljR .box').each(function() {
                        if ($(this).css('display') == 'none') {
                            hidden_item = true;
                            return false;
                        }
                    });
                    if (hidden_item == false) {
                        $('#UyDK-zXhb-HGyB-IljR .load_more').hide();
                    } else {
                        $('#UyDK-zXhb-HGyB-IljR .load_more').removeClass('load_more_active').text('load more');
                    }
                }, 1000);
            });
        }
    }
}
