ay-950 dark:text-white">Western Sahara</option><option value="Yemen" class="dark:bg-gray-950 dark:text-white">Yemen</option><option value="Zambia" class="dark:bg-gray-950 dark:text-white">Zambia</option><option value="Zimbabwe" class="dark:bg-gray-950 dark:text-white">Zimbabwe</option><option value="Åland Islands" class="dark:bg-gray-950 dark:text-white">Åland Islands</option></select></div><div class="relative"><label for="contactNumber" id="contactNumber-label">Phone Number<span class="ml-0.5 text-red-500">*</span></label><input type="tel" id="contactNumber" placeholder="Enter your phone number *" class="field-focus block w-full rounded-md border bg-white p-3 text-black dark:border-gray-500 dark:bg-gray-950 dark:text-white border-gray-300" aria-describedby="contactNumber-label" aria-invalid="false" name="contactNumber" value=""/></div><div class="relative"><label for="firstName" id="firstName-label">First Name<span class="ml-0.5 text-red-500">*</span></label><input type="text" id="firstName" placeholder="e.g. John *" maxLength="20" class="field-focus block w-full rounded-md border bg-white p-3 text-black dark:border-gray-500 dark:bg-gray-950 dark:text-white border-gray-300" aria-describedby="firstName-label" aria-invalid="false" name="firstName" value=""/></div><div class="relative"><label for="lastName" id="lastName-label">Last Name</label><input type="text" id="lastName" placeholder="e.g. Doe" maxLength="20" class="field-focus block w-full rounded-md border bg-white p-3 text-black dark:border-gray-500 dark:bg-gray-950 dark:text-white border-gray-300" aria-describedby="lastName-label" aria-invalid="false" name="lastName" value=""/></div><div><label for="jobTitle" id="jobTitle-label">Job Title</label><input type="text" id="jobTitle" maxLength="20" placeholder="e.g. Manager" class="field-focus w-full rounded-md border border-gray-300 bg-white p-3 text-black dark:border-gray-500 dark:bg-gray-950 dark:text-white" aria-labelledby="jobTitle-label" name="jobTitle"/></div><div><label for="companyName" id="companyName-label">Company name<span class="ml-0.5 text-red-500">*</span></label><input type="text" id="companyName" placeholder="e.g. Zensar" maxLength="20" class="field-focus w-full rounded-md border bg-white p-3 text-black dark:border-gray-500 dark:bg-gray-950 dark:text-white border-gray-300" aria-describedby="companyName-label" aria-invalid="false" name="companyName" value=""/></div></div><div><label for="commentsBox" id="commentsBox-label">Tell us briefly about your requirement</label><textarea id="commentsBox" name="commentsBox" placeholder="Your message" class="field-focus w-full rounded-md border border-gray-300 bg-white p-3 text-black dark:border-gray-500 dark:bg-gray-950 dark:text-white" rows="4" maxLength="400" aria-labelledby="commentsBox-label"></textarea></div><fieldset class="space-y-4"><legend class="sr-only">Subscription Options</legend><div class="flex items-center space-x-3"><input type="checkbox" id="newsletter" class="h-5 w-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-400 dark:bg-gray-950" name="newsletter"/><label for="newsletter" class="text-sm">Subscribe to Zensar’s blogs, thought leadership assets, and updates.</label></div><div class="flex items-center space-x-3 rounded-md " id="privacy-error"><input type="checkbox" id="privacyPolicy" class="h-5 w-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-400 dark:bg-gray-950" name="privacyPolicy"/><label for="privacyPolicy" class="text-sm">I agree with Zensar’s<!-- --> <a class="cursor-pointer font-semibold underline" target="_blank" rel="noopener noreferrer" href="/privacy-notice">Privacy Notice</a><span class="ml-0.5 text-red-500">*</span></label></div></fieldset><div class="pt-2"><button type="submit" class="flex items-center justify-center space-x-2 rounded-full bg-black px-8 py-3.5 text-white transition-all hover:bg-gray-800 dark:bg-white dark:text-black dark:hover:bg-gray-200"><span class="font-medi