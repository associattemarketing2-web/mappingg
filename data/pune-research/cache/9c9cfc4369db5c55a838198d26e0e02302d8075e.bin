            height: 560px;
            max-height: 92vh;
            border-radius: 16px;
            transform: scale(0.92);
            transition: transform 0.35s ease;
        }

        #coming-soon-popup-overlay.show #coming-soon-popup-box {
            transform: scale(1);
        }

        #coming-soon-popup-box .popup-bg-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

        .coming-soon-popup-close {
            cursor: pointer;
            z-index: 2;
            background-color: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(4px);
            transition: transform 0.2s ease;
        }

        .coming-soon-popup-close:hover {
            transform: rotate(90deg);
        }

        /* Steps after the first keep the image's own ratio (portrait news, landscape certificate) */
        .coming-soon-popup-step[hidden] {
            display: none !important;
        }

        .coming-soon-popup-fit {
            border-radius: 12px;
