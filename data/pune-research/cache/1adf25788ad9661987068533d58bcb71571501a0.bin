<script>
    if (screen.width <= 768) {
        $("#gallerytab .item a, #gallerytab .owl-item a, #gallerytab1 .item a,#gallerytab1 .owl-item a, #gallerytab2 .item a, #gallerytab2 .owl-item a, #gallerytab .owl-item a, #gallerytab1 .owl-item a, #gallerytab2 .owl-item a, #gallery3 a,#gallery1 a, #gallery2 a").click(function() {
            var a = $(this).children("img").attr('src');
            $("#imgshow").modal();
            $("#imgshow .modal-body").html("<img src=" + a + " class='img-fluid'>");
        });


        $(".text-justify p").css("text-align", "left");
    }
    if (screen.width <= 950) {
        $(".mobileslider").addClass("bgnone");
    }
</script>

