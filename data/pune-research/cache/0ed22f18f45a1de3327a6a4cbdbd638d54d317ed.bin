<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
$( document ).ready(function() {
	changeFormType();
});

function changeFormType(){
	var ferrousFormType = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_ferrous-dropdown").find("option:selected").val();
	if (ferrousFormType == "none"){
		ferrousFormType = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_ferrous-dropdown").find("option:nth-child(2)").val();
	}
	$.ajax({
       	url : 'https://www.kirloskarferrous.com/contact?p_p_id=com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_cacheability=cacheLevelPage',
       	type: 'POST',
       	dataType : "text",
       	data : {
       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_ferrousFormType" :ferrousFormType,
       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_site" :"ferrous",
	    	"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_cmd" :"product-enquiry-filter" 
        },
       	success : function(responseData) {
       		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_dynamic-form-section").html("");
       		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_dynamic-form-section").html(responseData);
       		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_ferrous-enquiry-form")[0].reset();
    	},
      	error: function () {
          
       	}	
	});
}

function submitFerrousEnquiryForm(){
	var productType = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_ferrous-dropdown").find("option:selected").val();
	var firstName = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-first-name").val();
	var lastName = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-last-name").val();
	var organizationName = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-organization-name").val();
	var country = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-country").val();
	var phoneNumber = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-phone-number").val();
	var emailAddress = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-email").val();
	var message = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-message").val();
	var formType = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_formType").val();
	var backUrl = window.location.href;
	
	var componentName = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-component-name").val();
	var materialGrade = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-material-grade").val();
	var castingSize = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-size").val();
	var castingWeight = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-weight").val();
	var machiningScope = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-machine-scope").val();
	var annualQuantity = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-annual-quantity").val();
	var castingDeliveryLocation = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_casting-delivery-location").val();
	
	var pigIronGrade = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_pig-iron-grade").val();
	var pigIronQuantity = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_pig-iron-quantity").val();
	var pigIronDeliveryLocation = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_pig-iron-delivery-location").val();
	switch(formType) {
		case "casting":
			var formTypeValidation = (validateComponentName() && validateMaterialGrade()
					&& validateSize() && validateCastingWeight() && validateMachineScope() && validateAnnualQuantity() && validateCastingDeliveryLocation());
	    	break;
	  	case "pig-iron":
	  		var formTypeValidation = (validatePigIronGrade() && validateQuantity() && validatePigIronDeliveryLocation());
	   	 	break;
	}
	
	if (validateFirstName() && validateLastName() && validatePhoneNumber() && validateFerrousEnquiryEmail()
			&& validateCountry() && validateOrganizationName() && formTypeValidation){
		$.ajax({
	       	url : 'https://www.kirloskarferrous.com/contact?p_p_id=com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_cacheability=cacheLevelPage',
	       	type: 'POST',
	       	dataType : "text",
	       	data : {
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_productType" : productType,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_firstName" :firstName,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_lastName" :lastName,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_organizationName" :organizationName,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_country" :country,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_phoneNumber" :phoneNumber,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_message" :message,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_email" :emailAddress,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_productName" :formType,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_backUrl" :backUrl,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_componentName" :componentName,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_materialGrade" :materialGrade,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_castingSize" :castingSize,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_castingWeight" :castingWeight,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_machiningScope" :machiningScope,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_annualQuantity" :annualQuantity,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_castingDeliveryLocation" :castingDeliveryLocation,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_pigIronGrade" :pigIronGrade,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_pigIronQuantity" :pigIronQuantity,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_pigIronDeliveryLocation" :pigIronDeliveryLocation,
	       		"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_site" :"ferrous",
		    	"_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_cmd" :"product-enquiry-filter" 
	        },
	       	success : function(responseData) {
	       		$("#content").hide();
	       		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_ferrous-enquiry-form")[0].reset();
	       		$("#content").html("");
	       		$("#content").html(responseData);
	       		$("html, body").animate({ scrollTop: 0 }, "fast");
	       		$("#content").slideDown();
	    	},
	      	error: function () {
	          
	       	}	
		});
	} else {
		validateFirstName();
		validateLastName();
		validatePhoneNumber();
		validateFerrousEnquiryEmail();
		validateCountry();
		validateOrganizationName();
		if (formType == "casting"){
			validateComponentName(); 
			validateMaterialGrade(); 
			validateSize(); 
			validateCastingWeight(); 
			validateMachineScope(); 
			validateAnnualQuantity(); 
			validateCastingDeliveryLocation();
		} else if (formType == "pig-iron"){
			validatePigIronGrade(); 
			validateQuantity(); 
			validatePigIronDeliveryLocation();
		}
	}
}

function validateFirstName(){ 
	$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-first-name-error").html('');
	var fieldVal = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-first-name").val();
	if(typeof fieldVal == "undefined" || fieldVal == ""){
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-first-name-error").html('* First Name Required.');
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-first-name").addClass("error-border");
		return false;
	} else if(checkCharDotHifen(fieldVal) == false){
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-first-name-error").html('');
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-first-name-error").html('* Enter valid First Name.');
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-first-name").addClass("error-border");
		return false;
	} else {
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-first-name").removeClass("error-border");
	} 
	return true;
}

function validateLastName(){ 
	$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-last-name-error").html('');
	var fieldVal = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-last-name").val();
	if(typeof fieldVal == "undefined" || fieldVal == ""){
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-last-name-error").html('* Last Name Required.');
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-last-name").addClass("error-border");
		return false;
	} else if(checkCharDotHifen(fieldVal) == false){
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-last-name-error").html('');
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-last-name-error").html('* Enter valid Last Name.');
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-last-name").addClass("error-border");
		return false;
	} else {
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-last-name").removeClass("error-border");
	} 
	return true;
}
function validatePhoneNumber() {
    var errorElement = document.getElementById("_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-phone-number-error");
    errorElement.innerHTML = '';
    var phoneNumberField = document.getElementById("_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-phone-number");
    var fieldVal = phoneNumberField.value;
    var isNumeric = /^\d+$/.test(fieldVal);
    var zeroPattern = /^0/;  // Regex to check if the number starts with 0

    if (typeof fieldVal == "undefined" || fieldVal == "") {
        errorElement.innerHTML = '* Phone Number Required';
        phoneNumberField.classList.add("error-border");
        return false;
    } else if (zeroPattern.test(fieldVal)) {
        errorElement.innerHTML = '* Mobile number cannot start with 0';
        phoneNumberField.classList.add("error-border");
        return false;
    } else if (!isNumeric) {
        errorElement.innerHTML = '* Enter a valid Phone Number.';
        phoneNumberField.classList.add("error-border");
        return false;
    } else if (fieldVal.length > 10) {
        errorElement.innerHTML = '* Phone Number length exceeded.';
        phoneNumberField.classList.add("error-border");
        return false;
    } else if (fieldVal.length < 10) {
        errorElement.innerHTML = 'Phone Number is less than the required length';
        phoneNumberField.classList.add("error-border");
        return false;
    } else {
        phoneNumberField.classList.remove("error-border");
    }
    return true;
}
function isNumber(evt) {
	  if(evt == undefined){
	    return false;
	  }
	  if (evt.which != 8 && evt.which != 0 && (((evt.which) < 48) || ((evt.which) > 57))) {
	    return false;
	  }
	}



function validateFerrousEnquiryEmail(){
	$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-email-error").html('');
	var fieldVal = $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-email").val();
	if(typeof fieldVal == "undefined" || fieldVal == ""){
		 $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-email-error").html('* Email Address Required');
		 $("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-email").addClass("error-border");
		 return false;
	} else if(checkEmailPattern(fieldVal) == false){
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-email-error").html('* Enter valid Email Address');
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-email").addClass("error-border");
		return false;
	} else {
		$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-email").removeClass("error-border");
	}
	return true;
}

function checkCharDotHifen(strVal){
	var regex = "[a-zA-Z_]";
	if(!strVal.match(regex)){
	return false;
   }
}

function checkEmailPattern(strVal){
	var regex = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;
	if(!strVal.match(regex)){
		return false;
	}
}

function validateCountry(){
	$("#_com_kirloskar_generic_forms_web_GenericFormsPortlet_INSTANCE_lpnk_enquire-country-error").html('');
