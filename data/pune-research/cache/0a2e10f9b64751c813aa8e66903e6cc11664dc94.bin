		<script>
				$(document).on('click', '#redirectotppr', function(e) {
					var $form = $(
						'<form action="https://www.gera.in/media-center/pune-realty-report" method="POST">');
					$form.append('<input name="from" value="popup" />');
					$form.appendTo($('body')).submit();
				});

				$(window).on('load', function() {
					$('.loader').removeClass('active');
				});

				$(".popup-form-wrp .heading span").on("click", function() {
					$(".popup-form-wrp").removeClass("active")
				})

				$('.popup-wrp.askrohitgera-popup-wrp .close-btn').click(function() {
					$('.popup-wrp.askrohitgera-popup-wrp').removeClass('active');
					// $("html, body").animate({
					// 	scrollTop: $('.prr-wrp').offset().top
					// }, 500);
				})

				function openCity(evt, cityName) {
					$(".home-sub-nav .nav-link").removeClass('active');
					var i, tabcontent, tablinks;
					tabcontent = document.getElementsByClassName("tabcontent");
					for (i = 0; i < tabcontent.length; i++) {
						tabcontent[i].style.display = "none";
					}
					tablinks = document.getElementsByClassName("tablinks");
					for (i = 0; i < tablinks.length; i++) {
						tablinks[i].className = tablinks[i].className.replace(" active", "");
					}
					document.getElementById(cityName).style.display = "block";
					evt.currentTarget.className += " active";
				}

				function subtab(evt, subTabData) {
					var i, tabcontent, tablinks;
					tabcontent = document.getElementsByClassName("tabcontent");
					for (i = 0; i < tabcontent.length; i++) {
						tabcontent[i].style.display = "none";
					}
					tablinks = document.getElementsByClassName("tablinks");
					for (i = 0; i < tablinks.length; i++) {
						tablinks[i].className = tablinks[i].className.replace(" active", "");
					}
					document.getElementById(subTabData).style.display = "block";
					evt.currentTarget.className += " active";
				}
				// Get the element with id="defaultOpen" and click on it
				// document.getElementById("defaultOpen").click();



				// Start for leasing popup added by sanket on 10-09-2021
				$(document).on('click', '.modal .close', function(e) {
					$("#leasedownload")[0].reset();
					$('#leasedownload #project').attr("style", "");

				});
				$(document).on('click', '#enqbtn', function(e) {
					e.preventDefault();

					var option = $(this).data("id");
					if ($(this).data("for") == 'banner') {
						$("#enquirynow #project").val(option);

						$('#enquirynow #project').attr("style", "pointer-events: none;");
						$('#myModal').modal('show');
					} else {
						$("#leasedownload #project").val(option);
						$('#leasedownload #project').attr("style",
							"pointer-events: none; appearance: none; -webkit-appearance: none;");

						$("#file_to_download").val($(this).attr('data-href'));
						$('#myModal_lease').modal('show');
					}
					$.ajax({
						type: "POST",
						url: "https://www.gera.in/home/projectconfigdata",
						data: 'project_name=' + option,
						success: function(data) {
							$("#leasedownload #configuration").html(data);
							$("#enquirynow #configuration").html(data);

						},
						error: function(data) {
							console.log('something went wrong');
						},
					});
				});
				$(document).on('click', '#downloadlink', function(e) {
					e.preventDefault();

					$("#downloadpopup .close-btn").click();
					window.open($(this).attr('data-href'), '_blank');
				});

				$(document).on('click', '#leasedownloadbtnsubm', function(e) {
					e.preventDefault();

					$("#leasedownloadbtnsubm").val('Please wait...');
					$('#leasedownloadbtnsubm').attr("disabled", "disabled");

					var formData = new FormData(leasedownload);

					var filetodownload = $("#leasedownload #file_to_download").val();

					$.ajax({
						type: "POST",
						url: "https://www.gera.in/home/saveleasedownload",
						data: formData,
						processData: false,
						contentType: false,
						success: function(data) {
							var response = jQuery.parseJSON(data);
							$("input[name='csrf_test_name'").val(response.csrftoken).trigger('change');

							if (response.status == 'failure') {
								$.each(response.data, function(index, value) {
									if (value != '') {
										$("#leasedownload #" + index).addClass('error');
									}
								});
								$("#leasedownloadbtnsubm").val('Submit');
								$('#leasedownloadbtnsubm').attr("disabled", false);
								return false;
							} else {
								$("#leasedownload")[0].reset();
								$("#leasedownloadbtnsubm").val('Submit');
								$('#leasedownloadbtnsubm').attr("disabled", false);

								$("#downloadpopup #downloadlink").attr('data-href', filetodownload);
								$("#downloadpopup").addClass('active');

								$(".modal .close").click();

								return false;
							}
						},
						error: function(data) {
							console.log('something went wrong');
						},
					});
				});
			</script>
			  

<style>
    * Style for fields with errors */
.error {
    border: 1px solid red;
}

/* Style for error messages */
.error.cmnerr {
    color: red;
    font-size: 12px;
    margin-top: 5px;
    display: none; /* Hidden by default, shown when there's an error */
}

/* Additional optional style to make the error message more prominent */
.error.cmnerr.show {
    display: block;
}
</style>
