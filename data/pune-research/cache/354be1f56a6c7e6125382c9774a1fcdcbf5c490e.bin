  <!-- Call Button -->
  <a href="tel:+918822898989" id="call-button"
     style="background:#0084FF; color:white; padding:11px 18px; border-radius:50px;
            font-size:13px; font-family:sans-serif; font-weight:600; text-decoration:none;
            box-shadow:0 4px 20px rgba(0,0,0,0.3); display:flex; align-items:center;
            gap:8px; transition:all 0.3s ease;">
    <img src="https://cdn-icons-png.flaticon.com/512/597/597177.png" id="call-icon" alt="Call icon"
         style="display:block; flex-shrink:0; filter:brightness(0) invert(1); width:18px; height:18px;">
    <span id="call-text">Call Us Now</span>
  </a>

  <!-- WhatsApp Button (href set by script below) -->
  <a href="#" id="wa-button"
     style="background:#25D366; color:white; padding:11px 18px; border-radius:50px;
            font-size:13px; font-family:sans-serif; font-weight:600; text-decoration:none;
            box-shadow:0 4px 20px rgba(0,0,0,0.3); display:flex; align-items:center;
            gap:8px; transition:all 0.3s ease;">
    <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" id="wa-icon" alt="WhatsApp icon"
         style="display:block; flex-shrink:0; width:18px; height:18px;">
    <span id="wa-text">Chat on WhatsApp</span>
  </a>
</div>

<script>
(function () {
  var WA_NUMBER = '917026260227';   // the CRM-connected Sales WhatsApp number

  // match = a case-insensitive substring of the project page URL.
  var PROJECTS = [
    { match: 'tower-108',           name: 'Tower 108',            code: 'T108' },
    { match: 'tower108',            name: 'Tower 108',            code: 'T108' },
    { match: 'west-winds',          name: 'West Winds',           code: 'WW'  },
    { match: 'presidential-tower',  name: 'Presidential Towers',  code: 'PT'  },
    { match: 'akshardham',          name: 'Akshardham',           code: 'AK'  },
    { match: 'pavilion',            name: 'Pavilion',             code: 'PV'  },
    { match: 'antra',               name: 'Antra',                code: 'AN'  },
    { match: 'central-park',        name: 'Ceratec Central Park', code: 'CCP' }
  ];

  // Non-project pages (homepage etc.) fall back to Tower 108.
  var DEFAULT = { name: 'Tower 108', code: 'T108' };

  function buildLink() {
    var url = (location.pathname + ' ' + location.href).toLowerCase();
    var hit = PROJECTS.find(function (p) { return url.indexOf(p.match) !== -1; }) || DEFAULT;

    var msg = "Hi Ceratec! \uD83D\uDC4B I'm interested in " + hit.name +
              ". Could you please share more details and help me schedule a site visit? " +
              "(ref: " + hit.code + ")";
    return 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(msg);
  }

  document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('wa-button');
    if (btn) btn.setAttribute('href', buildLink());
  });
})();
</script>

<style>
  #call-button:hover { background:#0073e6 !important; box-shadow:0 6px 24px rgba(0,0,0,0.35) !important; transform:scale(1.05) !important; }
  #wa-button:hover   { background:#20b858 !important; box-shadow:0 6px 24px rgba(0,0,0,0.35) !important; transform:scale(1.05) !important; }
  @media (max-width:1024px) and (min-width:769px) {
    #call-button, #wa-button { padding:10px 16px !important; font-size:12px !important; }
    #call-icon, #wa-icon { width:16px !important; height:16px !important; }
  }
  @media (max-width:768px) {
    #float-buttons { bottom:16px !important; right:16px !important; gap:14px !important; }
    #call-button, #wa-button { padding:10px !important; border-radius:50% !important; width:44px !important; height:44px !important; justify-content:center !important; gap:0 !important; }
    #call-text, #wa-text { display:none !important; }
    #call-icon, #wa-icon { width:20px !important; height:20px !important; }
  }
</style>
<!-- Scroll to Top Button -->
<button id="scroll-top"
     onclick="window.scrollTo({top:0, behavior:'smooth'})"
     style="position:fixed;
            bottom:24px;
            left:24px;
            z-index:9999;
            background:#222222;
            color:white;
            border:none;
            width:46px;
            height:46px;
            border-radius:50%;
            font-size:20px;
            cursor:pointer;
            box-shadow:0 4px 20px rgba(0,0,0,0.3);
            display:none;
            align-items:center;
            justify-content:center;
            opacity:0;
            transition:all 0.4s ease;">
  ↑
</button>

<style>
  /* HOVER EFFECT */
  #scroll-top:hover {
    background: #C9A84C !important;
    transform: scale(1.1) !important;
    box-shadow: 0 6px 24px rgba(0,0,0,0.35) !important;
  }

  /* FADE IN ANIMATION */
  #scroll-top.visible {
    opacity: 1 !important;
    display: flex !important;
  }

  /* TABLET */
  @media (max-width: 1024px) and (min-width: 769px) {
    #scroll-top {
      width: 44px !important;
      height: 44px !important;
      font-size: 19px !important;
      bottom: 20px !important;
      left: 20px !important;
    }
  }

  /* MOBILE */
  @media (max-width: 768px) {
    #scroll-top {
      bottom: 16px !important;
      left: 16px !important;
      width: 40px !important;
      height: 40px !important;
      font-size: 17px !important;
    }
  }
</style>

<script>
  window.addEventListener('scroll', function() {
    var btn = document.getElementById('scroll-top');
    if (window.scrollY > 300) {
      btn.classList.add('visible');
    } else {
      btn.classList.remove('visible');
      btn.style.display = 'none';
    }
  });
</script>
