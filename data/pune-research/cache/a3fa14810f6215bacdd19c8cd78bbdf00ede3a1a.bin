<section class="testimonial-block">
    <div class="container">
        <div class="row testimonial-wrapper">
            <div class="testimonial-slider owl-carousel owl-theme owl-nav-wrp">
                                <div class="testi-box">
                    <a data-fancybox="image_testi" href="#sandeep0">
                        <span class="comma"><img src="https://www.gera.in/assets/images/comma-big.png" alt=""></span>
                        <h4>MR. SHAHZAD JOKHI </h4>
                        <h6>Gera's Planet of Joy</h6>
                        <p>
                        When we first shifted to Pune
