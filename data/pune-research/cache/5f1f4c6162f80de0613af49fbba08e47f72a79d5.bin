			<script>
				$(document).ready(function () {
					$('.owl-carousel').owlCarousel({

						margin: 10,

						responsive: {
							0: {
								items: 1
							},
							600: {
								items: 1
							},
							1000: {
								items: 1
							}
						}
					});

					// Custom Navigation Events
					$('.owl-preves').click(function () {
						$('.owl-carousel').trigger('prev.owl.carousel');
					});

					$('.owl-nextes').click(function () {
						$('.owl-carousel').trigger('next.owl.carousel');
					});
				});




			</script>























