    <style>
      /* Hide WhatsApp buttons from third-party widgets */
      [class*="whatsapp"],[id*="whatsapp"],[class*="WhatsApp"],[id*="WhatsApp"],
      [class*="wa_btn"],[class*="wa-btn"],[id*="wa_btn"],[id*="wa-btn"],
      a[href*="wa.me"]:not([data-testid]) { display: none !important; }
    </style>
    <script>
      (function() {
        function hideWhatsApp() {
          document.querySelectorAll('a[href*="wa.me"], a[href*="whatsapp.com"], [class*="whatsapp"], [id*="whatsapp"], [class*="WhatsApp"], [id*="WhatsApp"]').forEach(function(el) {
            if (!el.getAttribute('data-testid')) {
              el.style.setProperty('display', 'none', 'important');
              el.style.setProperty('visibility', 'hidden', 'important');
            }
          });
        }

        var observer = new MutationObserver(function() {
          hideWhatsApp();
        });

        document.addEventListener('DOMContentLoaded', function() {
          observer.observe(document.body, { childList: true, subtree: true });
          hideWhatsApp();
        });

        setTimeout(hideWhatsApp, 1000);
        setTimeout(hideWhatsApp, 3000);
      })();
    </script>
