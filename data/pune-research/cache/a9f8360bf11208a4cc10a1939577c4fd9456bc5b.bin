ult\"]\n20:I[15837,[\"/_next/static/chunks/10n9zylvmfici.js\",\"/_next/static/chunks/0w9xav7sj6xj6.js\",\"/_next/static/chunks/0oorctqrahy3r.js\",\"/_next/static/chunks/1gx4cqxg2nvha.js\",\"/_next/static/chunks/2zpa725bnqk5k.js\",\"/_next/static/chunks/2wuybl-_9h3-k.js\",\"/_next/static/chunks/3mov5pn62cmsb.js\",\"/_next/static/chunks/0ehpe0zvz2m5g.js\",\"/_next/static/chunks/3zvhgh4u-pk1r.js\",\"/_next/static/chunks/0o_xxh4pnwr13.js\",\"/_next/static/chunks/3a43qsn9n7l_2.js\",\"/_next/static/chunks/0yz98094_8gd3.js\"],\"default\"]\n2:[\"$\",\"html\",null,{\"lang\":\"en-us\",\"children\":[[\"$\",\"head\",null,{\"children\":[\"$\",\"$L14\",null,{\"baseURL\":\"https://www.zensar.com\"}]}],[\"$\",\"body\",null,{\"className\":\"auth-pending antialiased dark:bg-black\",\"suppressHydrationWarning\":true,\"children\":[\"$\",\"$L15\",null,{\"nonce\":\"SPtqp+endBOrmKwlkM8EqA==\",\"children\":[\"$\",\"$L16\",null,{\"children\":[\"$\",\"$L17\",null,{\"children\":[[\"$\",\"$L18\",null,{}],[\"$\",\"$L19\",null,{\"children\":[\"$\",\"$L1a\",null,{\"children\":[\"$\",\"$L1b\",null,{\"children\":[\"$L1c\",[\"$\",\"$L1d\",null,{}],[\"$\",\"$L1e\",null,{}],[\"$\",\"$L1f\",null,{}],\" \",[\"$\",\"$L20\",null,{\"initialContent\":{\"name\":\"Navigation  Menu\",\"menu\":[{\"label\":\"What We Do\",\"identifier\":\"Navigation\",\"submenu\":[{\"label\":\"Explore Our Services\",\"href\":\"/tech-services\",\"image\":{\"title\":\"Services\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/5gRJszK26WHyDGLVpagAjQ/79906103352787f2d83eb3630751f170/Services.jpg\",\"mediaType\":\"image/jpeg\"},\"infoText\":\"Explore our full-stack services across applications, data, cloud, security, platforms, and marketing - built to help businesses grow, adapt, and lead.\"},{\"label\":\"Application Services\",\"href\":\"/tech-services/enterprise-applications\",\"image\":{\"title\":\"Overview of enterprise application services for Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/7D6lrGrPUZEf4i3lZdo446/174e76a8c146f3594cd5409d067aa55c/Services_0005s_0005_ApplicationService.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Manage, modernize, and scale apps with services that enhance performance, usability, and integration across the enterprise.\"},{\"label\":\"Artificial Intelligence\",\"href\":\"/tech-services/artificial-intelligence\",\"image\":{\"title\":\"Professional demonstrating augmented reality and AI technology\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3iFjYbI4glxbFMHd58IaWh/4a1c0854e6fe9e5d3cc6a70ea4392512/Services_0005s_0000_AI.png\",\"mediaType\":\"image/png\"},\"infoText\":\"By turning data into actionable insights, our Al solutions unlock growth, boost efficiency, and power intelligent decision-making.\"},{\"label\":\"Cloud, Infrastructure, and Security\",\"href\":\"/tech-services/cloud-infrastructure-and-security\",\"image\":{\"title\":\"Abstract representation of AI-native cloud infrastructure and security\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/1K4eTzxHE6dg6kicalU2LL/37880bf2bd87fdeef2cc8848f4c21993/Mobile_Banner_CIS_page.jpg\",\"mediaType\":\"image/jpeg\"},\"infoText\":\"Transform operations with intelligent cloud, robust infrastructure, and secure-by-design solutions that build trust and scale value.\"},{\"label\":\"Data Engineering and Analytics\",\"href\":\"/tech-services/data-analytics-and-ai\",\"image\":{\"title\":\"Abstract representation of data analytics services for enterprise\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/wPONFxrJCu1UregHQbxLa/50cf4073c33fe759c6e3eeeaebcdea10/Services_0005s_0003_Data-and-analysis.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Drive smarter decisions with modern data practices - governance, AI, and products that turn insight into impact.\"},{\"label\":\"Marketing and Engagement\",\"href\":\"/tech-services/marketing-and-engagement\",\"image\":{\"title\":\"Marketing and engagement services overview\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/2j0vDwJelfU1g76dzldlbJ/6df01f14d794e558d07fbc46458269ef/Services_0005s_0002_Marketing-and-Engagement.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Blend strategy, storytelling, and design to connect with audiences in meaningful, timely, and measurable ways.\"},{\"label\":\"Product and Platforms\",\"href\":\"/tech-services/product-and-platforms\",\"image\":{\"title\":\"Digital products and platforms interface with scalable enterprise solutions\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3l0yNMrpX5hm1WXqEfRSs8/0e99012a88c56534ec39f4090a1c3a76/Services_0005s_0001_Product-and-platform.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Accelerate growth with next-gen engineering that transforms products, platforms, and possibilities across the lifecycle.\"},{\"label\":\"Quality Intelligence\",\"href\":\"/tech-services/enterprise-applications/quality-intelligence-platform\",\"image\":{\"title\":\"UI of AI-powered quality intelligence platform for enterprise applications\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/5Cz66d2lWfN1ITG0OlbhpT/f11800b0f6038896d9516cb668f491d8/QI-mobile_banner.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Transform quality engineering with AI-powered automation, predictive testing, and intelligent assurance that improves speed, reliability, and business impact.\"}]},{\"label\":\"Industries We Empower\",\"identifier\":\"Navigation\",\"submenu\":[{\"label\":\"Explore By Industry\",\"href\":\"/industries\",\"image\":{\"title\":\"Industry solutions across banking, healthcare, retail, manufacturing, and telecom\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/75lw6k6U6vcC4DM7QCaliC/7ebe0dee4c3598846abdc24dd34843dc/Industry.png\",\"mediaType\":\"image/png\"},\"infoText\":\"See how we help industries adapt and grow with tailored solutions that unlock agility, innovation, and impact.\"},{\"label\":\"Banking and Financial Services\",\"href\":\"/industries/banking-and-financial-services\",\"image\":{\"title\":\"Person using a smartwatch while interacting with a digital kiosk in a tech service context\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/gNmX1FtIqTEbT0jkGfLuY/18307f6639de6b6ab1e2cd1287096b4c/Industries_0004s_0005_BFS.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Powering secure, personalized experiences that make banking faster, smarter, and more connected.\",\"subMenuItems\":[{\"label\":\"Cards and Payments\",\"buttonUrl\":\"/industries/banking-and-financial-services/cards-and-payments\"},{\"label\":\"Lending\",\"buttonUrl\":\"/industries/banking-and-financial-services/lending\"}]},{\"label\":\"Consumer Services\",\"href\":\"/industries/consumer-services\",\"image\":{\"title\":\"Person shopping with multiple colorful bags and checking a phone in a festive setting.\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/54inF5fqyEnkpQ4mD2QTkQ/dcb4a3bff0bc44beb514b0ceda664f58/Industries_0004s_0003_Consumer-Services.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Building brand loyalty through immersive, personalized, and tech-forward consumer experiences.\"},{\"label\":\"Healthcare and Life Sciences\",\"href\":\"/industries/healthcare-and-life-sciences\",\"image\":{\"title\":\"Professional in a lab coat using a tablet in a laboratory setting with colorful glassware.\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3oi0GGxqRnMnW5pSxYPmSf/ab476b29abc1ca5e30c9e576c1b4f148/Industries_0004s_0004_HLS.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Enabling better care with data-led, intelligent solutions that improve outcomes and accelerate innovation.\"},{\"label\":\"Insurance\",\"href\":\"/industries/insurance-technology-solutions\",\"image\":{\"title\":\"Insurance technology solutions driving digital transformation at Zensar\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/fzkMmaz4IsPDZrQ4hnLag/2dd7dae10372a04fac11116c1d36517c/mobile-Insurance.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Modernizing insurance with cloud, AI, and customer-first strategies that drive trust and efficiency.\",\"subMenuItems\":[{\"label\":\" Guidewire Services\",\"buttonUrl\":\"/industries/insurance-technology-solutions/insurance-guidewire-services\"}]},{\"label\":\"Manufacturing\",\"href\":\"/industries/manufacturing-technology-solutions\",\"image\":{\"title\":\"Automated assembly of a circuit board using precision tools in a tech service environment.\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/XahCV1kYQq7VXmlmjPyhR/8c0d91f5eb179706db4a3acf35487467/Industries_0004s_0002_Manufacturing.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Smarter factories, faster innovation - leveraging AI, IoT, and cloud to transform how manufacturing works.\"},{\"label\":\"Hi Tech\",\"href\":\"/industries/hi-tech\",\"image\":{\"title\":\"Digital screens displaying various concepts related to AI and digital transformation\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/5z7pJc67UNBfoaZZPCQ78m/f5bc4bae277b83b7776af149d19aacdf/Industries_0004s_0001_TMT.jpg\",\"mediaType\":\"image/jpeg\"},\"infoText\":\"Enabling Intelligent Hi Tech Organizations with Agile, AI-Driven Solutions.\"},{\"label\":\"Public Sector\",\"href\":\"/industries/public-sector\",\"image\":{\"title\":\"thumb-banner\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/18jxUc9VJ0YPuHv10XtWH6/6bf151db67c25fb6abe7acf7ef1a73b8/thumb-banner.jpg\",\"mediaType\":\"image/jpeg\"},\"infoText\":\"Empowering public sector transformation through digital innovation and citizen-centric solutions.\"},{\"label\":\"Gaming\",\"href\":\"/industries/zensar-gaming\",\"image\":{\"title\":\"Gaming-Mobile-Banner\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/7DkyfhJJuavoLTiXY9FtGX/80f3ee56f3d847343cd16c3297582899/Gaming-Mobile-Banner.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Engineering intelligent, immersive, and scalable gaming experiences.\"}]},{\"label\":\"Our Perspectives\",\"identifier\":\"Navigation\",\"submenu\":[{\"label\":\"Stories and Insights\",\"href\":\"/insights\",\"image\":{\"title\":\"our-perspective 0003s 0002 insightss\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/77Iqlu9l1c82r5q3fQk2rZ/3211f685c54c8be74799f81b4a106b5c/our-perspective_0003s_0002_insightss.png\",\"mediaType\":\"image/png\"},\"infoText\":\"From AI and cybersecurity to human-centered design and digital strategy, find insights by topic, format, or industry.\"},{\"label\":\"Thought Leadership\",\"href\":\"/thought-leadership\",\"image\":{\"title\":\"our-perspective 0003s 0001 Get-change-right\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/47ZPNXWUuivAqb6oA9Hsar/e2f396151c1d04e5c8a65186fb808c74/our-perspective_0003s_0001_Get-change-right.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Thought leadership insights that explore fresh ideas, emerging trends, and expert takes to help you navigate change and lead with confidence. \"},{\"label\":\"Podcast\",\"href\":\"/podcasts-slated-for-tomorrow\",\"image\":{\"title\":\"our-perspective 0003s 0000 Slated-for-tomorrow\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/40q6irOHjvXD0utAgf5sHC/353ea472eac962d00a139ea6090c7669/our-perspective_0003s_0000_Slated-for-tomorrow.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Our exclusive podcast series that brings together leaders from across industries to explore what’s next in tech, business, and beyond. \"}]},{\"label\":\"Who We Are\",\"identifier\":\"Navigation\",\"submenu\":[{\"label\":\"About Us\",\"href\":\"/about-us\",\"image\":{\"title\":\"Who-we-are 0002s 0000 about-us\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/5S0XzByQyajUAXx90DALhx/95ce1663993dd59f88b3ddf929dec860/Who-we-are_0002s_0000_about-us.png\",\"mediaType\":\"image/png\"},\"infoText\":\"We’re a global technology solutions company that puts people first - solving complex challenges through creativity, empathy, and bold thinking.\"},{\"label\":\"Leadership\",\"href\":\"/about-us/leadership\",\"image\":{\"title\":\"Who-we-are 0002s 0002 Leadership\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/6BZeCG5aMU702OjhbjhW5m/4377c13a8ab709d7883845806de0ec6a/Who-we-are_0002s_0002_Leadership.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Meet the minds shaping our strategy and pushing boundaries to unlock growth, innovation, and impact.\"},{\"label\":\"Our Brand\",\"href\":\"/about-us/our-brand\",\"image\":{\"title\":\"Person holding a smartphone with money symbols around her, while another works at a laptop.\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/4jlsjxL0tqbE5wrhw4vkgZ/8dbf0b1273b477940a895e3e88b5c3de/brand.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Built on ‘Experience-led Everything,’ our brand stands for solutions that are human-first, outcome-driven, and designed for real-world impact.\"},{\"label\":\"Our Innovation - Zenlabs\",\"href\":\"/zenlabs\",\"image\":{\"title\":\"Digital human profile representing ZenLabs innovation and AI research\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/5alYDdfZmVgdUbC90Frc8L/abeb51baa108c761b4d9489407835090/Zenlabs_Mobile_800x800.jpg\",\"mediaType\":\"image/jpeg\"},\"infoText\":\"Zenlabs, Zensar’s innovation hub, drives AI, GenAI, Cloud, NVIDIA tech, and IoT R\u0026D. It incubates CoEs, co-innovates with clients from ideation to prototype, files patents, and delivers solutions for BFSI, retail, and healthcare.\"},{\"label\":\"Awards and Recognition\",\"href\":\"/about-us/awards-and-recognitions\",\"image\":{\"title\":\"awards\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/71VBhym1sHq41bLUmdBt8L/b5636afc612528acd68d27a002a3bb4a/awards.png\",\"mediaType\":\"image/png\"},\"infoText\":\"From innovation to excellence, see how our work has been recognized by global analysts, partners, and industry leaders.\"},{\"label\":\"Sustainability\",\"href\":\"/about-us/sustainability\",\"image\":{\"title\":\"Sustainability\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/7y7u2xENlB7RMbX1WHgkkb/d76d98ed17c0912c6af08d5b54d6963e/Sustainability.png\",\"mediaType\":\"image/png\"},\"infoText\":\"From design to delivery, we're committed to solutions that care for the business, communities, and the environment.\"},{\"label\":\"CSR\",\"href\":\"/about-us/corporate-social-responsibility\",\"image\":{\"title\":\"CSR-1\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3XY1xKIbmanqwVmkqu9gwZ/1bd50b123f9ceaaba25a34379b7e31bb/CSR-1.jpg\",\"mediaType\":\"image/jpeg\"},\"infoText\":\"We use the power of technology, compassion, and community to build more inclusive, equitable, and empowered futures. \"},{\"label\":\"Partners\",\"href\":\"/partners\",\"image\":{\"title\":\"Partners-Page\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3kEdevECN4ky6OwQO3YZyL/efc32dfb200ea89f09f41cadfa0f87b7/Partners-Page.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Strategic collaborations power better outcomes. Together with our partners, we help clients unlock efficiency, scale smarter, and stay ahead.\"},{\"label\":\"PR and News\",\"href\":\"/newsroom\",\"image\":{\"title\":\"PR\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/7yMHuBb3MOOF8qGnjrmdRF/1f6cde7413489f528c896685f0ca2443/PR.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Catch up on the latest stories - from press releases to media resources - straight from our newsroom.\"},{\"label\":\"Events and Webinars\",\"href\":\"/events-and-webinars\",\"image\":{\"title\":\"Event-and-webinats\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3E6igPHgGTlduZ2QO5Cxuu/4dca60dd37c52c950b6486f00eed341b/Event-and-webinats.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Stay in the know with upcoming events and webinars. Learn from experts, discover cutting-edge technologies, and explore what’s next.\"}]},{\"label\":\"For Our Investors\",\"identifier\":\"Navigation\",\"submenu\":[{\"label\":\"Investor Relations\",\"href\":\"/investors\",\"image\":{\"title\":\"Investors 0001s 0003 investor-Relations\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/I84Uqk0P7nsnmb2IIbBna/d67736450b9b9fc45196dcdf7e707260/Investors_0001s_0003_investor-Relations.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Access our financial insights, reports, and updates, backed by our commitment to transparency, trust, and long-term value.\"},{\"label\":\"Investor Corner\",\"href\":\"/investors/investor-corner\",\"image\":{\"title\":\"Business professionals collaborating with laptops during an investor discussion\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/4nhk2xqTk0ZhKzouuSwGH/d4fb11035313d9e630a6f573381532e0/Investors_0001s_0001_Investorcorner.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Explore how our experience-led strategy shapes our financial story.\"},{\"label\":\"Shareholder's Information\",\"href\":\"/investors/shareholders-information\",\"image\":{\"title\":\"Professional walking through a modern corporate office with a leather bag\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/7fCy8IO43QMKe7Xoui3anf/dba2d53d2c07e84b86683fd5a708057f/Investors_0001s_0002_shareholdersinformation.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Your one-stop source for shareholder updates, statutory notices, and regulatory information. \"},{\"label\":\"Corporate Governance\",\"href\":\"/investors/corporate-governance\",\"image\":{\"title\":\"Investors 0001s 0000 corporategovernance\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/1V9ksiT6fUnOJQqS4b6yNT/bcdb7eff14875704c0733d1eb827bca7/Investors_0001s_0000_corporategovernance.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Explore our governance framework, Board structure, key policies, and CSR disclosures. \"}]},{\"label\":\"Find Your Career Path\",\"identifier\":\"Navigation\",\"submenu\":[{\"label\":\"Current Opportunities\",\"href\":\"https://fa-etvl-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/jobs\",\"image\":{\"title\":\"Careers\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/Vho1rbkFFPGqfZZpy41P5/9c8854f7c1fb1535190e3dd5a9ff9420/Careers.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Find work that inspires you, teammates who support you, and opportunities that grow with you - every step of the way.\"},{\"label\":\"Life At Zensar\",\"href\":\"/careers\",\"image\":{\"title\":\"career 0000s 0003 Life-at-Zensar\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/1IYFSaXd3Q6tltaKH4artG/180518cf324d5cf25e12bed8f730a232/career_0000s_0003_Life-at-Zensar.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Ready to shape a better future? Join a team that celebrates innovation, growth, and the freedom to explore endless opportunities.\"},{\"label\":\"Diversity, Equity, and Inclusion\",\"href\":\"/diversity-equity-and-inclusion\",\"image\":{\"title\":\"DEI-Thumbnail\",\"description\":\"\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/3sQHytm912ZC3pjHlnZqrs/538cde68aa5bef83bc08aa4f04d38f0d/DEI-Thumbnail.jpg\",\"mediaType\":\"image/jpeg\"},\"infoText\":\"We believe diverse teams spark better ideas. Our inclusive culture ensures every voice is heard and every individual has the space to thrive.\"},{\"label\":\"Zensar Learning Academy\",\"href\":\"/careers/learning-academy\",\"image\":{\"title\":\"career 0000s 0001 Learning-academy\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/40kQj5euJ2GOqofyuXmbyu/ae4a1091d09316d208f1832d2056d52e/career_0000s_0001_Learning-academy.png\",\"mediaType\":\"image/png\"},\"infoText\":\"At Zensar, learning never stops. Our Talent Transformation Programs are designed to grow your skills and fast-track your career journey.\"},{\"label\":\"Z@Z: Gen Z At Zensar\",\"href\":\"/careers/genz-at-zensar\",\"image\":{\"title\":\"career 0000s 0000 Z@Z\",\"url\":\"//images.ctfassets.net/bjl3f17nyta4/38UQLqV5jnY9ZYZNQNN4sS/a8303ae2c88fbb7c1e88b1362ff243f9/career_0000s_0000_Z_Z.png\",\"mediaType\":\"image/png\"},\"infoText\":\"Purpose-driven, collaborative, and bold - we create spaces where Gen Z can do meaningful work, feel seen, and lead the future.\"}]},{\"label\":\"Let's Connect\",\"identifier\":\"Navigation\",\"submenu\":[{\"label\":\"Contact Us\",\"href\":\"/contact-us\",\"im