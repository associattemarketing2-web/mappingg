<!-- active menus script start -->
<script>
$(document).ready(function() {
    var metaTags = {}; 
    function loadMetaConfig() {
        $.getJSON('../assets/js/meta-config.json', function(data) {
            metaTags = data;
            setActiveMenuItems();
        }).fail(function(jqXHR, textStatus, errorThrown) {
            console.error('Failed to load meta tag configuration:', textStatus, errorThrown);
        });
    }

    function setActiveMenuItems() {
        var scrollY = $(window).scrollTop() + 100; // Adjusting the scroll position check
        var currentSectionId = null; // Track the currently active section

        $(".sectionBox").each(function() {
            var sectionTop = $(this).offset().top;
            var sectionBottom = sectionTop + $(this).outerHeight();
            var targetId = $(this).attr("id");

            if (scrollY >= sectionTop && scrollY < sectionBottom) {
                $("nav a[href='#" + targetId + "']").parent('li').addClass("active");
                currentSectionId = targetId; // Update the current section ID
            } else {
                $("nav a[href='#" + targetId + "']").parent('li').removeClass("active");
            }
        });

        // Update the browser's URL to match the currently active section
        if (currentSectionId) {
            history.replaceState(null, null, '#' + currentSectionId);

            // Update meta tags
            updateMetaTags(currentSectionId);
        }
    }

    function highlightActiveMenuItem() {
        setActiveMenuItems();
    }

    function updateMetaTags(sectionId) {
        var metaTag = metaTags[sectionId] || {
            title: 'Bharat Forge',
            description: '',
            keywords: '',
            canonical: ''
        };

        // Update the title tag
        document.title = metaTag.title;

        // Update meta description
        var metaDescription = $('meta[name="description"]');
        if (metaDescription.length) {
            metaDescription.attr('content', metaTag.description);
        } else {
            $('head').append('<meta name="description" content="' + metaTag.description + '">');
        }

        // Update meta keywords
        var metaKeywords = $('meta[name="keywords"]');
        if (metaKeywords.length) {
            metaKeywords.attr('content', metaTag.keywords);
        } else {
            $('head').append('<meta name="keywords" content="' + metaTag.keywords + '">');
        }

        // Update canonical link
        var canonicalLink = $('link[rel="canonical"]');
        if (canonicalLink.length) {
            canonicalLink.attr('href', metaTag.canonical);
        } else {
            $('head').append('<link rel="canonical" href="' + metaTag.canonical + '">');
        }
    }

    // Load meta configuration file
    loadMetaConfig();

    highlightActiveMenuItem();
    $(window).on("scroll", setActiveMenuItems);

    $('nav a').on('click', function(e) {
        e.preventDefault();
        var targetId = $(this).attr('href');
        var targetSection = $(targetId);
        if (targetSection.length) {
            $('html, body').animate({
                scrollTop: targetSection.offset().top -
                    200 // Adjust scrolling to account for 50px offset
            }, 100, function() {
                highlightActiveMenuItem(); // Ensure highlight after scroll animation
            });

            // Update the browser's URL after clicking a link
            history.pushState(null, null, targetId);
        }
        return false;
    });
});
</script>
<!-- active menus script end -->
<!-- awards tabing start -->
<script>
$(document).ready(function() {
    var award1 = $("#award1");
    var award2 = $("#award2");

    award1.owlCarousel({
        singleItem: true,
        items: 1,
        pagination: false,
        afterAction: syncPosition,
        responsiveRefreshRate: 200,
    });

    award2.owlCarousel({
        items: 5,
        itemsDesktop: [1199, 5],
        itemsDesktopSmall: [979, 4],
        itemsTablet: [768, 3],
        itemsMobile: [479, 2],
        navigation: true,
        pagination: false,
        loop: true,
        responsiveRefreshRate: 100,
        afterInit: function(el) {
            el.find(".owl-item").eq(0).addClass("synced");
        }
    });


    function syncPosition(el) {
        var current = this.currentItem;
        $("#award2")
            .find(".owl-item")
            .removeClass("synced")
            .eq(current)
            .addClass("synced")
        if ($("#award2").data("owlCarousel") !== undefined) {
            center(current)
        }
    }

    $("#award2").on("click", ".owl-item", function(e) {
        e.preventDefault();
        var number = $(this).data("owlItem");
        award1.trigger("owl.goTo", number);
    });

    function center(number) {
        var sync2visible = award2.data("owlCarousel").owl.visibleItems;
        var num = number;
        var found = false;
        for (var i in sync2visible) {
            if (num === sync2visible[i]) {
                var found = true;
            }
        }

        if (found === false) {
            if (num > sync2visible[sync2visible.length - 1]) {
                award2.trigger("owl.goTo", num - sync2visible.length + 2)
            } else {
                if (num - 1 === -1) {
                    num = 0;
                }
                award2.trigger("owl.goTo", num);
            }
        } else if (num === sync2visible[sync2visible.length - 1]) {
            award2.trigger("owl.goTo", sync2visible[1])
        } else if (num === sync2visible[0]) {
            award2.trigger("owl.goTo", num - 1)
        }

    }

});
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/1.8.0/jquery.min.js"></script>
