<div class="code-embed">
  <style>
.ai-homepage-diagram-ctn * {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.ai-homepage-diagram-ctn {
  color: #fff;
  max-width: 1200px;
  margin: 0 auto;
}

.diagram-top-ctn {
  display: flex;
}

.diagram-top-column {
  position: relative;
  border-radius: 50px 50px 0 0;
  padding: 40px 35px 130px 45px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  width: 25%;
}

.diagram-top-column::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50px 50px 0 0;
  padding: 1.5px;
  background: linear-gradient(
    to top left, 
    rgba(255, 255, 255, 0) 0%, 
    rgba(255, 255, 255, 0) 70%, 
    rgba(255, 255, 255, 0.4) 100%
  );
  -webkit-mask: 
    linear-gradient(#fff 0 0) content-box, 
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
          mask-composite: exclude;
}

.diagram-top-column-heading {
  font-size: 28px;
  font-weight: 400;
}

.diagram-top-column-desc {
  font-size: 18px;
  font-weight: 300;
  line-height: 25px;
}

/* top column coloring */

.diagram-top-column.blue {
  background: linear-gradient(60deg, #000833, #000DA1 85%);
}

.diagram-top-column.purple {
  background: linear-gradient(60deg, #000833, #8C00FF 85%);
}

.diagram-top-column.orange {
  background: linear-gradient(60deg, #000833, #FF9D00 85%);
}

.diagram-top-column.pink {
  background: linear-gradient(60deg, #000833, #FF04D1 85%);
}

/* bottom container */
.diagram-bottom-ctn {
  border-radius: 0 0 50px 50px;
  background: linear-gradient(to right, #000C85, #8C01FF 25%, #FF9D00 66%, #FF04D1);
  padding: 4px 15px 15px;
}

.diagram-bottom-inner-ctn {
  display: flex;
  justify-content: center;
  border-radius: 0 0 50px 50px;
  background: linear-gradient(to bottom, rgba(0, 8, 51, 0.00) -20%, #000833 83.1%);
}

.diagram-bottom-column {
  width: 25%;
  position: relative;
  border-left: 1px solid rgba(255, 255, 255, 0.3);
  border-right: 1px solid rgba(255, 255, 255, 0.3);
  isolation: isolate;
  cursor: pointer;
  height: 180px;
  display: flex;
  align-items: center;
}

.diagram-bottom-column::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(0, 111, 255, 0.00) 45%, rgba(0, 111, 255, 0.6) 100%);
  opacity: 0; 
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: -1; 
  pointer-events: none;
}

.diagram-bottom-column:hover::before {
  opacity: 1;
}

.diagram-bottom-logo-ctn {
  height: 45px;
  width: 100%;
  text-align: center;
}

.diagram-bottom-button-icon {
  position: absolute;
  right: 20px;
  bottom: 20px;
  width: 24px;
  height: 24px;
  background-color: #fff;
  -webkit-mask: url("/content/dam/druvaincprogram/redesign/icons/arrow-circle-white-btn.svg") no-repeat center / contain;
  mask: url("/content/dam/druvaincprogram/redesign/icons/arrow-circle-white-btn.svg") no-repeat center / contain;
  transition: background-color 0.3s ease;
}

.diagram-bottom-column:hover .diagram-bottom-button-icon {
  background-color: #FF9D00;
}

/* ==========================================
   TABLET & SMALL LAPTOP STYLES (768px - 1024px)
   ========================================== */
@media (max-width: 1024px) {
  .diagram-top-column {
    padding: 30px 20px 100px 25px;
  }

  .diagram-top-column-heading {
    font-size: 22px;
  }

  .diagram-top-column-desc {
    font-size: 15px;
    line-height: 22px;
  }

  .diagram-bottom-column {
    height: 140px;
  }
}

/* ==========================================
   MOBILE STYLES (Under 768px)
   ========================================== */
@media (max-width: 767px) {
  
  /* 1. Transform Top Pillars into a 2x2 Grid */
  .diagram-top-ctn {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .diagram-top-column {
    width: 100%; /* Override desktop 25% width */
    padding: 25px 20px; /* Compact padding for mobile grid */
    gap: 10px;
  }

  /* 2. Precision Border Radius for 2x2 Grid */
  /* Top-Left Card */
  .diagram-top-column:nth-child(1),
  .diagram-top-column:nth-child(1)::after {
    border-radius: 24px 0 0 0;
  }
  
  /* Top-Right Card */
  .diagram-top-column:nth-child(2),
  .diagram-top-column:nth-child(2)::after {
    border-radius: 0 24px 0 0;
  }

  /* Bottom two cards have flat tops to connect cleanly */
  .diagram-top-column:nth-child(3),
  .diagram-top-column:nth-child(3)::after,
  .diagram-top-column:nth-child(4),
  .diagram-top-column:nth-child(4)::after {
    border-radius: 0;
  }

  .diagram-top-column-heading {
    font-size: 18px; /* Slightly smaller for mobile grid */
  }

  .diagram-top-column-desc {
    font-size: 13px;
    line-height: 18px;
  }

  /* 3. Keep Bottom Workloads Horizontal */
  .diagram-bottom-ctn {
    border-radius: 0 0 24px 24px; /* Matches the top card scale */
    padding: 4px 10px 10px;
  }

  .diagram-bottom-inner-ctn {
    border-radius: 0 0 24px 24px;
    display: flex; /* Ensure they stay side-by-side */
  }

  .diagram-bottom-column {
    width: 33.33%; /* Split horizontally into 3 columns */
    height: 90px;  /* Shorter height is perfect for just logos */
    padding: 10px;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    border-right: none; /* Prevent double borders */
  }

  .diagram-bottom-column:first-child {
    border-left: none; /* Clean outer edge */
  }

  .diagram-bottom-logo-ctn {
    height: 30px; /* Scale down logos to fit mobile width */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .diagram-bottom-logo {
    max-width: 80%;
    max-height: 100%;
  }

  /* Shrink and reposition the tiny button icon */
  .diagram-bottom-button-icon {
    right: 8px;
    bottom: 8px;
    width: 16px;
    height: 16px;
  }
}
</style>

