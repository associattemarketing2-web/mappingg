    <div id="becomemyModal" class="modal">

        <!-- Modal content -->
        <div class="becomemodal-content">
          <span class="close">&times;</span>
          <div class="becomeanpoplink">
            <a href="https://www.bajajgeneralinsurance.com/become-an-agent.html"><div class="becomeanlink btn" id="becomeanagent" onclick="myFunctionBecomeanagent()"><button id="linka">Become an Agent</button></div></a>
            <a href="https://www.bajajgeneralinsurance.com/become-a-POSP-agent.html"> <div class="posplink btn" id="becomeposp" onclick="myFunctionBecomeposp()"><button id="linka1">Become a POSP</button></div></a>
          </div>
