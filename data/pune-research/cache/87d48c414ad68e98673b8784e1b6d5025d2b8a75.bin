th":null,"size":2.77,"width":93,"height":156,"sizeInBytes":2770}},"hash":"Bengaluru_1_18bb935592","ext":".webp","mime":"image/webp","size":40.29,"url":"/uploads/Bengaluru_1_18bb935592.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-07-01T06:52:45.349Z","updatedAt":"2025-09-10T06:03:16.233Z"}}}}},{"id":2,"attributes":{"city_name":"Chennai","slug":"chennai","sequenceNo":null,"sectionTitle":"Discover Office spaces in Chennai’s Growing Business Landscape","createdAt":"2025-03-17T12:51:26.335Z","updatedAt":"2026-05-28T06:37:48.924Z","publishedAt":"2025-03-17T12:51:30.118Z","Description":"\u003cp\u003eExplore premium commercial projects in Chennai, a rapidly evolving business and IT hub in South India. Purva Commercial has created Grade A office spaces in prime locality like OMR. Designed for modern enterprises, these commercial properties offer cutting-edge infrastructure, excellent connectivity, and strong investment potential. Whether you're a growing startup or a multinational corporation, find the ideal commercial office space in Chennai to elevate your operations.\u003c/p\u003e","featuredImage":{"data":{"id":2824,"attributes":{"name":"chennai (1).webp","alternativeText":null,"caption":null,"width":481,"height":800,"formats":{"small":{"ext":".webp","url":"/uploads/small_chennai_1_9a3a4772a2.webp","hash":"small_chennai_1_9a3a4772a2","mime":"image/webp","name":"small_chennai (1).webp","path":null,"size":28.9,"width":301,"height":500,"sizeInBytes":28896},"medium":{"ext":".webp","url":"/uploads/medium_chennai_1_9a3a4772a2.webp","hash":"medium_chennai_1_9a3a4772a2","mime":"image/webp","name":"medium_chennai (1).webp","path":null,"size":49.96,"width":451,"height":750,"sizeInBytes":49956},"thumbnail":{"ext":".webp","url":"/uploads/thumbnail_chennai_1_9a3a4772a2.webp","hash":"thumbnail_chennai_1_9a3a4772a2","mime":"image/webp","name":"thumbnail_chennai (1).webp","path":null,"size":5.04,"width":94,"height":156,"sizeInBytes":5040}},"hash":"chennai_1_9a3a4772a2","ext":".webp","mime":"image/webp","size":58.89,"url":"/uploads/chennai_1_9a3a4772a2.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-07-01T06:52:45.355Z","updatedAt":"2025-07-01T06:52:45.355Z"}}}}},{"id":3,"attributes":{"city_name":"Hyderabad","slug":"hyderabad","sequenceNo":null,"sectionTitle":"Premium Offices Spaces in Hyderabad’s IT Powerhouse","createdAt":"2025-03-17T22:54:43.191Z","updatedAt":"2026-05-28T06:38:03.996Z","publishedAt":"2025-03-17T22:54:44.853Z","Description":"\u003cp\u003eDiscover world-class commercial projects in Hyderabad’s premier IT and business district. From state-of-the-art office spaces to tech parks and retail hubs, these developments offer prime locations, seamless connectivity, and future-ready infrastructure. Ideal for startups, global firms, and investors - explore top-rated commercial real estate in Hyderabad and secure your space in the heart of innovation and growth. Hyderabad is where business meets opportunity.\u003c/p\u003e","featuredImage":{"data":{"id":2825,"attributes":{"name":"Hyderabad.png","alternativeText":null,"caption":null,"width":480,"height":800,"formats":{"small":{"ext":".png","url":"/uploads/small_Hyderabad_b39eb82a1e.png","hash":"small_Hyderabad_b39eb82a1e","mime":"image/png","name":"small_Hyderabad.png","path":null,"size":231.39,"width":300,"height":500,"sizeInBytes":231390},"medium":{"ext":".png","url":"/uploads/medium_Hyderabad_b39eb82a1e.png","hash":"medium_Hyderabad_b39eb82a1e","mime":"image/png","name":"medium_Hyderabad.png","path":null,"size":482.58,"width":450,"height":750,"sizeInBytes":482584},"thumbnail":{"ext":".png","url":"/uploads/thumbnail_Hyderabad_b39eb82a1e.png","hash":"thumbnail_Hyderabad_b39eb82a1e","mime":"image/png","name":"thumbnail_Hyderabad.png","path":null,"size":28.53,"width":94,"height":156,"sizeInBytes":28526}},"hash":"Hyderabad_b39eb82a1e","ext":".png","mime":"image/png","size":147.7,"url":"/uploads/Hyderabad_b39eb82a1e.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-07-01T08:00:33.288Z","updatedAt":"2025-07-01T08:00:33.288Z"}}}}}]},"res_cities":{"data":[{"id":1,"attributes":{"city_name":"Bengaluru","slug":"bengaluru","sequenceNo":1,"sectionTitle":"Residential Projects \u0026 Apartments for Sale in Bangalore","createdAt":"2025-03-07T06:00:32.990Z","updatedAt":"2026-10-26T13:14:02.128Z","publishedAt":"2025-03-07T06:00:34.809Z","Description":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eBengaluru is one of India’s most sought-after cities for homebuyers, offering excellent connectivity, a thriving IT ecosystem, established social infrastructure and diverse residential opportunities. From well-connected neighbourhoods to emerging growth corridors, buyers can explore a wide range of\u0026nbsp;apartments in Bangalore designed for different lifestyles and family needs.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eAs an established\u0026nbsp;real estate developer in Bangalore, Puravankara develops thoughtfully planned residential communities in strategic locations, with convenient access to schools, hospitals, workplaces, shopping destinations, entertainment and everyday amenities.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eOur portfolio includes well-designed\u0026nbsp;2 BHK apartments in Bangalore for individuals, couples and small families, spacious\u0026nbsp;3 BHK apartments in Bangalore for growing families, and expansive\u0026nbsp;4 BHK apartments in Bangalore for buyers seeking additional space, privacy and comfort. Homebuyers can also explore premium and\u0026nbsp;luxury apartments in Bangalore across carefully planned residential communities.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eThese\u0026nbsp;residential projects in Bangalore feature lifestyle amenities such as swimming pools, landscaped gardens, fitness centres, jogging tracks, children's play areas, yoga spaces and community facilities. Whether you are looking for a new home or exploring\u0026nbsp;flats for sale in Bangalore, our residential developments offer options across multiple locations and configurations.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eExplore Puravankara's\u0026nbsp;apartments for sale in Bengaluru and discover homes designed around connectivity, comfort, community and contemporary urban living.\u003c/span\u003e\u003c/p\u003e","featuredImage":{"data":{"id":342,"attributes":{"name":"Bengaluru.webp","alternativeText":"residential projects in bangalore","caption":null,"width":479,"height":800,"formats":{"small":{"ext":".webp","url":"/uploads/small_Bengaluru_f5298ea9fb.webp","hash":"small_Bengaluru_f5298ea9fb","mime":"image/webp","name":"small_Bengaluru.webp","path":null,"size":19.36,"width":299,"height":500,"sizeInBytes":19362},"medium":{"ext":".webp","url":"/uploads/medium_Bengaluru_f5298ea9fb.webp","hash":"medium_Bengaluru_f5298ea9fb","mime":"image/webp","name":"medium_Bengaluru.webp","path":null,"size":33.07,"width":449,"height":750,"sizeInBytes":33066},"thumbnail":{"ext":".webp","url":"/uploads/thumbnail_Bengaluru_f5298ea9fb.webp","hash":"thumbnail_Bengaluru_f5298ea9fb","mime":"image/webp","name":"thumbnail_Bengaluru.webp","path":null,"size":2.8,"width":93,"height":156,"sizeInBytes":2802}},"hash":"Bengaluru_f5298ea9fb","ext":".webp","mime":"image/webp","size":40.83,"url":"/uploads/Bengaluru_f5298ea9fb.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-03-12T04:57:24.588Z","updatedAt":"2026-09-16T12:58:45.822Z"}}}}},{"id":2,"attributes":{"city_name":"Chennai","slug":"chennai","sequenceNo":2,"sectionTitle":"Explore Top Residential Apartments for Sale in Chennai: Modern Luxury Meets Cultural Heritage","createdAt":"2025-03-07T06:00:42.044Z","updatedAt":"2026-07-01T10:33:00.227Z","publishedAt":"2025-03-07T06:00:49.912Z","Description":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eChennai, a city where heritage meets progress, offers a dynamic real estate landscape for homebuyers and investors alike. With its strong infrastructure and seamless connectivity, the city ensures effortless travel via its international airport, well-connected railway network, and extensive highways, linking residents to key business hubs, IT corridors, and cultural landmarks.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eBeyond connectivity, Chennai is home to top educational institutions, world-class healthcare facilities, vibrant shopping malls, and a thriving culinary scene. Whether you're looking for\u0026nbsp;\u003c/span\u003e\u003ca href=\"https://www.puravankara.com/residential/chennai/purva-somerset-house\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eluxury apartments in Chennai\u003c/span\u003e\u003c/a\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003e or\u0026nbsp;\u003c/span\u003e\u003ca href=\"https://www.puravankara.com/residential/chennai/purva-windermere\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eflats for sale in Chennai\u003c/span\u003e\u003c/a\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003e, you may desire vibrant, community-rich\u0026nbsp;flats for sale in Chennai. Or you may aspire to something grander: luxury apartments in Chennai that redefine elegance. Either way, the city offers a diverse selection of meticulously designed residences featuring smart features and premium amenities.\u003c/span\u003e\u003cbr\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eFrom contemporary high-rises to exclusive gated communities,\u0026nbsp;Chennai properties for sale consistently offer a perfect mix of comfort, security, and sophistication. Modern developments incorporate intelligent design, sustainable architecture, and world-class leisure facilities, ensuring an elevated lifestyle.\u003c/span\u003e\u003cbr\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eWith a thriving economy, stable property appreciation, and a high demand for housing, investing in\u0026nbsp;property in Chennai is a strategic move for those seeking long-term value and quality living. Whether for personal use or investment, Chennai’s diverse real estate market provides an unparalleled opportunity to own a home in one of India’s most vibrant metropolitan cities.\u003c/span\u003e\u003c/p\u003e","featuredImage":{"data":{"id":344,"attributes":{"name":"chennai.webp","alternativeText":"flats for sale in chennai","caption":null,"width":481,"height":800,"formats":{"small":{"ext":".webp","url":"/uploads/small_chennai_f9ba6c78c8.webp","hash":"small_chennai_f9ba6c78c8","mime":"image/webp","name":"small_chennai.webp","path":null,"size":29.16,"width":301,"height":500,"sizeInBytes":29162},"medium":{"ext":".webp","url":"/uploads/medium_chennai_f9ba6c78c8.webp","hash":"medium_chennai_f9ba6c78c8","mime":"image/webp","name":"medium_chennai.webp","path":null,"size":50.26,"width":451,"height":750,"sizeInBytes":50262},"thumbnail":{"ext":".webp","url":"/uploads/thumbnail_chennai_f9ba6c78c8.webp","hash":"thumbnail_chennai_f9ba6c78c8","mime":"image/webp","name":"thumbnail_chennai.webp","path":null,"size":4.99,"width":94,"height":156,"sizeInBytes":4992}},"hash":"chennai_f9ba6c78c8","ext":".webp","mime":"image/webp","size":59.48,"url":"/uploads/chennai_f9ba6c78c8.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-03-12T04:57:24.732Z","updatedAt":"2025-09-10T05:21:45.073Z"}}}}},{"id":6,"attributes":{"city_name":"Coimbatore","slug":"coimbatore","sequenceNo":3,"sectionTitle":"Coimbatore","createdAt":"2025-03-10T06:40:01.444Z","updatedAt":"2026-07-01T10:35:04.325Z","publishedAt":"2025-03-10T06:42:44.368Z","Description":"","featuredImage":{"data":{"id":8397,"attributes":{"name":"481x800.jpg","alternativeText":"Flats in Coimbatore","caption":null,"width":481,"height":800,"formats":{"small":{"ext":".jpg","url":"/uploads/small_481x800_2bdec33a3c.jpg","hash":"small_481x800_2bdec33a3c","mime":"image/jpeg","name":"small_481x800.jpg","path":null,"size":13.4,"width":301,"height":500,"sizeInBytes":13404},"medium":{"ext":".jpg","url":"/uploads/medium_481x800_2bdec33a3c.jpg","hash":"medium_481x800_2bdec33a3c","mime":"image/jpeg","name":"medium_481x800.jpg","path":null,"size":23.78,"width":451,"height":750,"sizeInBytes":23783},"thumbnail":{"ext":".jpg","url":"/uploads/thumbnail_481x800_2bdec33a3c.jpg","hash":"thumbnail_481x800_2bdec33a3c","mime":"image/jpeg","name":"thumbnail_481x800.jpg","path":null,"size":2.55,"width":94,"height":156,"sizeInBytes":2546}},"hash":"481x800_2bdec33a3c","ext":".jpg","mime":"image/jpeg","size":25.51,"url":"/uploads/481x800_2bdec33a3c.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-04-13T10:42:01.492Z","updatedAt":"2026-07-01T10:34:19.161Z"}}}}},{"id":7,"attributes":{"city_name":"Kochi","slug":"kochi","sequenceNo":4,"sectionTitle":"Discover Luxury Apartments in Kochi: A Blend of Culture and Modernity","createdAt":"2025-03-19T23:26:08.956Z","updatedAt":"2026-07-01T10:36:08.205Z","publishedAt":"2025-03-19T23:26:12.369Z","Description":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eNestled along the breathtaking Malabar Coast, Kochi is a prime destination for luxury real estate, offering a seamless blend of rich heritage, modern infrastructure, and coastal serenity. The demand for\u0026nbsp;luxury apartments in Kochi is rising, as the city boasts top-tier amenities, excellent connectivity, and a high standard of living. Adding to its allure,\u0026nbsp;waterfront homes in Kochi provide a unique living experience with stunning views and tranquil surroundings. With its proximity to Cochin International Airport, Kochi Metro, and major IT hubs, the city offers both unmatched convenience and strong\u0026nbsp;investment potential for homebuyers.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eFor those seeking an elite lifestyle,\u0026nbsp;luxury flats in Kochi offer world-class architecture, state-of-the-art smart home features, and premium recreational spaces. From expansive views to modern interiors to resort-like amenities, an elevated living experience is now a reality for those exploring\u0026nbsp;luxury flats for sale in Kochi.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eOne of the most sought-after locations is\u0026nbsp;Marine Drive, Kochi, an iconic waterfront stretch renowned for its upscale residential projects.\u0026nbsp;Marine Drive flats in Kochi\u0026nbsp;are unique: they offer breathtaking views of the serene backwaters, coupled with modern conveniences like landscaped gardens, infinity pools, fitness centers, and private lounges. Designed for those who value exclusivity and elegance in an urban setting, these Marine Drive Kochi apartments are truly a class apart.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eDiscover a new standard of luxury living in Kochi, where contemporary design meets coastal charm, making every home an extraordinary retreat.\u003c/span\u003e\u003c/p\u003e","featuredImage":{"data":{"id":1595,"attributes":{"name":"cityscape.png","alternativeText":"3 bhk apartments for sale in kochi","caption":null,"width":479,"height":800,"formats":{"small":{"ext":".png","url":"/uploads/small_cityscape_5ee7cd70a1.png","hash":"small_cityscape_5ee7cd70a1","mime":"image/png","name":"small_cityscape.png","path":null,"size":271.83,"width":299,"height":500,"sizeInBytes":271833},"medium":{"ext":".png","url":"/uploads/medium_cityscape_5ee7cd70a1.png","hash":"medium_cityscape_5ee7cd70a1","mime":"image/png","name":"medium_cityscape.png","path":null,"size":576.67,"width":449,"height":750,"sizeInBytes":576669},"thumbnail":{"ext":".png","url":"/uploads/thumbnail_cityscape_5ee7cd70a1.png","hash":"thumbnail_cityscape_5ee7cd70a1","mime":"image/png","name":"thumbnail_cityscape.png","path":null,"size":32.94,"width":93,"height":156,"sizeInBytes":32941}},"hash":"cityscape_5ee7cd70a1","ext":".png","mime":"image/png","size":144.92,"url":"/uploads/cityscape_5ee7cd70a1.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-04-01T00:08:19.216Z","updatedAt":"2026-07-01T10:35:54.643Z"}}}}},{"id":4,"attributes":{"city_name":"Mumbai","slug":"mumbai","sequenceNo":6,"sectionTitle":"World-class, Luxury Apartments and Flats for Sale in Mumbai","createdAt":"2025-03-07T06:01:21.699Z","updatedAt":"2026-09-11T05:51:34.083Z","publishedAt":"2025-03-07T06:01:22.652Z","Description":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eMumbai’s powerful charisma, rich heritage, and magnificent architecture make it a city that captivates people from all walks of life. It is a dynamic metropolis where history meets modernity, offering a seamless blend of old-world charm and cutting-edge skyscrapers. From its thriving business districts to its vibrant nightlife, Mumbai provides a secure, well-connected, and opportunity-rich environment. The city welcomes everyone with open arms, whether it's the breathtaking ocean views, cultural diversity, or energetic shopping avenues.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eFor those seeking premium living,\u0026nbsp;new residential projects in Mumbai offer world-class amenities, contemporary architecture, and well-planned spaces. You may be seeking a comfortable\u0026nbsp;flat in Mumbai\u0026nbsp;or you might aspire to something bigger: A rare, exclusive\u0026nbsp;property in Mumbai. Whatever your desire, these homes are designed to provide unmatched comfort and elegance.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eChoose from a curated selection of\u0026nbsp;2, 3 \u0026amp; 4 BHK apartments that exemplify architectural finesse and spacious layouts. The 2 BHK homes range from 533 – 629 sq. ft, 3 BHKs from 974 – 1681 sq. ft, and 4 BHKs from 2162 – 2429 sq. ft super built-up area, catering to diverse needs.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eDiscover exceptional\u0026nbsp;properties in Mumbai, crafted for superior living experiences in one of India’s most sought-after real estate destinations.\u003c/span\u003e\u003c/p\u003e","featuredImage":{"data":{"id":343,"attributes":{"name":"mumbai.webp","alternativeText":"New residential projects in mumbai","caption":null,"width":479,"height":800,"formats":{"small":{"ext":".webp","url":"/uploads/small_mumbai_fcef872329.webp","hash":"small_mumbai_fcef872329","mime":"image/webp","name":"small_mumbai.webp","path":null,"size":20.42,"width":299,"height":500,"sizeInBytes":20424},"medium":{"ext":".webp","url":"/uploads/medium_mumbai_fcef872329.webp","hash":"medium_mumbai_fcef872329","mime":"image/webp","name":"medium_mumbai.webp","path":null,"size":38.95,"width":449,"height":750,"sizeInBytes":38948},"thumbnail":{"ext":".webp","url":"/uploads/thumbnail_mumbai_fcef872329.webp","hash":"thumbnail_mumbai_fcef872329","mime":"image/webp","name":"thumbnail_mumbai.webp","path":null,"size":2.52,"width":93,"height":156,"sizeInBytes":2520}},"hash":"mumbai_fcef872329","ext":".webp","mime":"image/webp","size":56.29,"url":"/uploads/mumbai_fcef872329.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-03-12T04:57:24.688Z","updatedAt":"2025-09-10T05:26:33.208Z"}}}}},{"id":5,"attributes":{"city_name":"Pune","slug":"pune","sequenceNo":5,"sectionTitle":"Luxury residential apartments/flats for sale in Pune","createdAt":"2025-03-07T06:02:02.093Z","updatedAt":"2026-06-16T10:17:15.364Z","publishedAt":"2025-03-07T06:02:03.461Z","Description":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eWelcome to\u0026nbsp;Pune, a city that effortlessly blends old-world charm with a vibrant, cosmopolitan lifestyle. Surrounded by lush green hills and shimmering lakes, Pune offers a refreshing escape while remaining a thriving hub of opportunity. The city boasts superlative infrastructure, booming IT and automobile industries, and abundant job opportunities, making it an ideal destination for homebuyers and investors alike. The city is rich with options.\u0026nbsp;Flats in Pune offer seamless connectivity. If you're looking for premium amenities,\u0026nbsp;luxury flats in Pune are your option. There are also coveted, exclusive properties in Pune that raise the bar. In short, the city offers something for everyone.\u003c/span\u003e\u003cbr\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eAs a reputed builder in Pune, we understand the importance of proximity to essential services and modern comforts. Our residential developments are strategically located, ensuring easy access to bus stops, railway stations, malls, schools, hospitals, and recreational hubs. These thoughtfully designed homes, whether\u0026nbsp;2 BHK, 3 BHK apartments, or villas, offer elegant interiors, spacious layouts, and world-class amenities, including swimming pools, jogging tracks, gyms, and kids’ play areas.\u003c/span\u003e\u003cbr\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eWith the perfect balance of nature, connectivity, and modern living,\u0026nbsp;flats for sale in Pune truly redefine contemporary urban lifestyles. Invest in Pune’s thriving real estate market and enjoy a home that offers luxury, comfort, and long-term value.\u003c/span\u003e\u003c/p\u003e","featuredImage":{"data":{"id":341,"attributes":{"name":"pune.webp","alternativeText":"apartments in pune","caption":null,"width":479,"height":800,"formats":{"small":{"ext":".webp","url":"/uploads/small_pune_730add9d57.webp","hash":"small_pune_730add9d57","mime":"image/webp","name":"small_pune.webp","path":null,"size":14.67,"width":299,"height":500,"sizeInBytes":14674},"medium":{"ext":".webp","url":"/uploads/medium_pune_730add9d57.webp","hash":"medium_pune_730add9d57","mime":"image/webp","name":"medium_pune.webp","path":null,"size":23.92,"width":449,"height":750,"sizeInBytes":23918},"thumbnail":{"ext":".webp","url":"/uploads/thumbnail_pune_730add9d57.webp","hash":"thumbnail_pune_730add9d57","mime":"image/webp","name":"thumbnail_pune.webp","path":null,"size":2.45,"width":93,"height":156,"sizeInBytes":2454}},"hash":"pune_730add9d57","ext":".webp","mime":"image/webp","size":28.66,"url":"/uploads/pune_730add9d57.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-03-12T04:57:24.555Z","updatedAt":"2025-09-10T05:30:13.481Z"}}}}}]}},"sustainability":{"id":3,"sectionTitle":"Sustainable Luxury, Built for the Future ","sectionSubtitle":"Sustainability","Description":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eAt Puravankara, \u003c/span\u003e\u003cspan style=\"background-color:transparent;color:hsl(0,0%,0%);\"\u003esustainability \u003c/span\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eisn’t just a commitment, it’s a way of life. We seamlessly blend eco-conscious design with luxurious living, ensuring every home is crafted with energy-efficient materials, advanced water conservation systems, and effective waste management solutions. Our thoughtfully designed landscapes feature native plants, rainwater harvesting, and expansive green spaces, fostering a deep connection with nature.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eWith energy efficiency at the core of our developments, we actively minimize our carbon footprint and integrate eco-friendly practices across all projects. By prioritizing sustainable innovation, Puravankara is shaping a greener tomorrow, one home at a time.\u003c/span\u003e\u003c/p\u003e","CTA":{"id":6,"Title":"Know More","url":"#"},"image":{"data":{"id":3304,"attributes":{"name":"2_16e3dac6e1.webp","alternativeText":"Top Real Estate Developers in India","caption":null,"width":800,"height":682,"formats":{"small":{"ext":".webp","url":"/uploads/small_2_16e3dac6e1_c5ad9ee998.webp","hash":"small_2_16e3dac6e1_c5ad9ee998","mime":"image/webp","name":"small_2_16e3dac6e1.webp","path":null,"size":33.42,"width":500,"height":426,"sizeInBytes":33418},"medium":{"ext":".webp","url":"/uploads/medium_2_16e3dac6e1_c5ad9ee998.webp","hash":"medium_2_16e3dac6e1_c5ad9ee998","mime":"image/webp","name":"medium_2_16e3dac6e1.webp","path":null,"size":60.07,"width":750,"height":639,"sizeInBytes":60072},"thumbnail":{"ext":".webp","url":"/uploads/thumbnail_2_16e3dac6e1_c5ad9ee998.webp","hash":"thumbnail_2_16e3dac6e1_c5ad9ee998","mime":"image/webp","name":"thumbnail_2_16e3dac6e1.webp","path":null,"size":6.09,"width":183,"height":156,"sizeInBytes":6092}},"hash":"2_16e3dac6e1_c5ad9ee998","ext":".webp","mime":"image/webp","size":77.32,"url":"/uploads/2_16e3dac6e1_c5ad9ee998.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-08-14T05:43:41.652Z","updatedAt":"2026-07-22T10:38:58.641Z"}}}},"Testimonial":{"id":17,"sectionTitle":"Testimonials","se