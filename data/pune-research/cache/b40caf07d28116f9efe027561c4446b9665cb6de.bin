                <script type="text/rocketlazyloadscript">
                    document.addEventListener("DOMContentLoaded", function () {

                        function getCheckedValues(name) {
                            return Array.from(document.querySelectorAll('input[name="' + name + '"]:checked'))
                                .map(input => input.value.toLowerCase());
                        }

                        function hasMatch(selectedValues, dataValue) {
                            if (selectedValues.length === 0) return true;
                            if (!dataValue) return false;

                            var dataValues = dataValue.toLowerCase().split('|');
                            return selectedValues.some(value => dataValues.includes(value));
                        }

                        function updateBoxText(dropdown) {
                            var box = dropdown.querySelector(".select-box");
                            var text = dropdown.querySelector(".select-text");
                            var checked = dropdown.querySelectorAll('input[type="checkbox"]:checked');

                            if (checked.length === 0) {
                                text.textContent = box.getAttribute("data-placeholder");
                            } else if (checked.length === 1) {
                                text.textContent = checked[0].parentElement.textContent.trim();
                            } else {
                                text.textContent = checked.length + " selected";
                            }
                        }

                        function getVisibleProjectData() {
                            var selectedCities = getCheckedValues("city[]");
                            var selectedProjects = getCheckedValues("project[]");
                            var selectedConfigs = getCheckedValues("configuration[]");
                            var selectedTypes = getCheckedValues("property_type[]");

                            var visibleProjects = [];

                            document.querySelectorAll('input[name="project[]"]').forEach(function (input) {
                                var label = input.closest("label");

                                var projectId = input.value.toLowerCase();
                                var city = label.getAttribute("data-city") || "";
                                var config = label.getAttribute("data-config") || "";
                                var type = label.getAttribute("data-type") || "";

                                var show =
                                    hasMatch(selectedCities, city) &&
                                    hasMatch(selectedProjects, projectId) &&
                                    hasMatch(selectedConfigs, config) &&
                                    hasMatch(selectedTypes, type);

                                if (show) {
                                    visibleProjects.push({
                                        city: city,
                                        config: config,
                                        type: type,
                                        projectId: projectId
                                    });
                                }
                            });

                            return visibleProjects;
                        }

                        function valueExistsInProjects(value, key, projects) {
                            value = value.toLowerCase();

                            return projects.some(function (project) {
                                var data = project[key] || "";
                                return data.toLowerCase().split("|").includes(value);
                            });
                        }

                        function filterOptions() {
                            var selectedCities = getCheckedValues("city[]");
                            var selectedProjects = getCheckedValues("project[]");
                            var selectedConfigs = getCheckedValues("configuration[]");
                            var selectedTypes = getCheckedValues("property_type[]");

                            function projectMatches(label, ignoreField) {
                                var projectId = label.querySelector('input').value.toLowerCase();
                                var city = label.getAttribute("data-city") || "";
                                var config = label.getAttribute("data-config") || "";
                                var type = label.getAttribute("data-type") || "";

                                return (
                                    (ignoreField === "city" || hasMatch(selectedCities, city)) &&
                                    (ignoreField === "project" || selectedProjects.length === 0 || selectedProjects.includes(projectId)) &&
                                    (ignoreField === "config" || hasMatch(selectedConfigs, config)) &&
                                    (ignoreField === "type" || hasMatch(selectedTypes, type))
                                );
                            }

                            function hasAvailableProject(value, key, ignoreField) {
                                value = value.toLowerCase();

                                return Array.from(document.querySelectorAll('input[name="project[]"]')).some(function (projectInput) {
                                    var label = projectInput.closest("label");

                                    if (!projectMatches(label, ignoreField)) return false;

                                    var data = "";

                                    if (key === "city") data = label.getAttribute("data-city") || "";
                                    if (key === "config") data = label.getAttribute("data-config") || "";
                                    if (key === "type") data = label.getAttribute("data-type") || "";
                                    if (key === "project") return projectInput.value.toLowerCase() === value;

                                    return data.toLowerCase().split("|").includes(value);
                                });
                            }

                            // City filter
                            // City filter
                            document.querySelectorAll('input[name="city[]"]').forEach(function (input) {
                                var label = input.closest("label");
                                var show = hasAvailableProject(input.value, "city", "city");

                                label.style.display = show ? "flex" : "none";
                            });

                            // Project filter
                            document.querySelectorAll('input[name="project[]"]').forEach(function (input) {
                                var label = input.closest("label");
                                var show = projectMatches(label, "project");
                                label.style.display = show ? "flex" : "none";
                            });

                            // Configuration filter
                            document.querySelectorAll('input[name="configuration[]"]').forEach(function (input) {
                                var label = input.closest("label");
                                var show = hasAvailableProject(input.value, "config", "config");
                                label.style.display = show ? "flex" : "none";
                            });

                            // Property Type filter
                            document.querySelectorAll('input[name="property_type[]"]').forEach(function (input) {
                                var label = input.closest("label");
                                var show = hasAvailableProject(input.value, "type", "type");
                                label.style.display = show ? "flex" : "none";
                            });

                            document.querySelectorAll(".custom-multiselect").forEach(updateBoxText);
                        }

                        document.querySelectorAll(".custom-multiselect").forEach(function (dropdown) {
                            var selectBox = dropdown.querySelector(".select-box");
                            var checkboxList = dropdown.querySelector(".checkbox-list");

                            // Entire select box opens and closes the dropdown
                            selectBox.addEventListener("click", function (e) {
                                e.stopPropagation();

                                document.querySelectorAll(".custom-multiselect").forEach(function (item) {
                                    if (item !== dropdown) {
                                        item.classList.remove("active");
                                    }
                                });

                                dropdown.classList.toggle("active");
                            });

                            // Checkbox area should not close dropdown
                            checkboxList.addEventListener("click", function (e) {
                                e.stopPropagation();
                            });
                        });

                        document.querySelectorAll('.custom-multiselect input[type="checkbox"]').forEach(function (checkbox) {
                            checkbox.addEventListener("change", function () {
                                filterOptions();

                                var dropdown = checkbox.closest(".custom-multiselect");

                                if (dropdown) {
                                    dropdown.classList.add("active");
                                }
                            });
                        });

                        document.querySelectorAll('.custom-multiselect input[type="checkbox"]').forEach(function (checkbox) {
                            checkbox.addEventListener("change", function () {
                                filterOptions();

                                var dropdown = checkbox.closest(".custom-multiselect");

                                if (dropdown) {
                                    dropdown.classList.add("active");
                                }
                            });
                        });

                        function resetProjectSearchFilters() {
                            document.querySelectorAll('.custom-multiselect input[type="checkbox"]').forEach(function (checkbox) {
                                checkbox.checked = false;
                                checkbox.disabled = false;
                            });

                            document.querySelectorAll(".custom-multiselect").forEach(function (dropdown) {
                                dropdown.classList.remove("active");

                                var box = dropdown.querySelector(".select-box");
                                var textElement = dropdown.querySelector(".select-text");

                                if (textElement && box) {
                                    textElement.textContent = box.getAttribute("data-placeholder");
                                } else if (box) {
                                    box.textContent = box.getAttribute("data-placeholder");
                                }
                            });

                            document.querySelectorAll(".checkbox-list label").forEach(function (label) {
                                label.style.display = "flex";
                                label.classList.remove("disabled-option");
                            });

                            if (typeof filterOptions === "function") {
                                filterOptions();
                            }
                        }

                        window.addEventListener("pageshow", function (event) {
                            var navigationEntries = performance.getEntriesByType("navigation");
                            var isBackForward = navigationEntries.length && navigationEntries[0].type === "back_forward";

                            if (event.persisted || isBackForward) {
                                setTimeout(resetProjectSearchFilters, 0);
                            }
                        });

                    });

                </script>
            </div>
        </div>
        </div>

    </header><style type="text/css">
