			<script>(function () {
    'use strict';

    var LAST_COOKIE_NAME = 'mj_utm';
    var FIRST_COOKIE_NAME = 'mj_utm_first';
    var COOKIE_DAYS = 90;

    var UTM_KEYS = [
        'utm_source',
        'utm_medium',
        'utm_campaign',
        'utm_term',
        'utm_content'
    ];

    function getCookie(name) {
        var nameEQ = name + '=';
        var cookies = document.cookie.split(';');

        for (var i = 0; i < cookies.length; i++) {
            var cookie = cookies[i].trim();

            if (cookie.indexOf(nameEQ) === 0) {
                try {
                    return JSON.parse(
                        decodeURIComponent(cookie.substring(nameEQ.length))
                    );
                } catch (e) {
                    return null;
                }
            }
        }

        return null;
    }

    function setCookie(name, data) {
        var expires = new Date();

        expires.setTime(
            expires.getTime() + COOKIE_DAYS * 24 * 60 * 60 * 1000
        );

        document.cookie =
            name +
            '=' +
            encodeURIComponent(JSON.stringify(data)) +
            ';expires=' +
            expires.toUTCString() +
            ';path=/' +
            ';SameSite=Lax' +
            (window.location.protocol === 'https:' ? ';Secure' : '');
    }

    function getCurrentUTM() {
        var params = new URLSearchParams(window.location.search);

        var hasCampaign =
            params.get('utm_source') ||
            params.get('utm_medium') ||
            params.get('utm_campaign') ||
            params.get('utm_term') ||
            params.get('utm_content');

        if (!hasCampaign) {
            return null;
        }

        return {
            source: params.get('utm_source') || '',
            medium: params.get('utm_medium') || '',
            campaign: params.get('utm_campaign') || '',
            term: params.get('utm_term') || '',
            content: params.get('utm_content') || '',
            landing: window.location.pathname,
            landing_url: window.location.href,
            ts: new Date().toISOString()
        };
    }

    function populateCF7Fields(lastTouch, firstTouch) {
        var mapping = {
            'utm_source': lastTouch ? lastTouch.source : '',
            'utm_medium': lastTouch ? lastTouch.medium : '',
            'utm_campaign': lastTouch ? lastTouch.campaign : '',
            'utm_term': lastTouch ? lastTouch.term : '',
            'utm_content': lastTouch ? lastTouch.content : '',

            'first_utm_source': firstTouch ? firstTouch.source : '',
            'first_utm_medium': firstTouch ? firstTouch.medium : '',
            'first_utm_campaign': firstTouch ? firstTouch.campaign : '',
            'first_utm_term': firstTouch ? firstTouch.term : '',
            'first_utm_content': firstTouch ? firstTouch.content : ''
        };

        Object.keys(mapping).forEach(function (fieldName) {
            var fields = document.querySelectorAll(
                'input[name="' + fieldName + '"]'
            );

            fields.forEach(function (field) {
                field.value = mapping[fieldName];
            });
        });
    }

    var currentUTM = getCurrentUTM();

    var firstTouch = getCookie(FIRST_COOKIE_NAME);
    var lastTouch = getCookie(LAST_COOKIE_NAME);

    /*
     * Only create/update attribution cookies when this is actually
     * a campaign visit.
     */
    if (currentUTM) {

        /*
         * FIRST TOUCH
         *
         * Never overwrite the original campaign.
         */
        if (!firstTouch) {
            firstTouch = currentUTM;
            setCookie(FIRST_COOKIE_NAME, firstTouch);
        }

        /*
         * LAST TOUCH
         *
         * Always update when a new campaign URL is visited.
         */
        lastTouch = currentUTM;
        setCookie(LAST_COOKIE_NAME, lastTouch);

        /*
         * Keep the existing cookie name for backward compatibility
         * with your current PHP bridge.
         */
        setCookie(LAST_COOKIE_NAME, lastTouch);

    } else {

        /*
         * No UTM in current URL.
         *
         * Keep existing cookies untouched.
         */
        if (!lastTouch) {
            lastTouch = getCookie(LAST_COOKIE_NAME);
        }
    }

    /*
     * Populate CF7 hidden fields after the page loads.
     */
    function initializeUTMFields() {
        var currentLastTouch = getCookie(LAST_COOKIE_NAME);
        var currentFirstTouch = getCookie(FIRST_COOKIE_NAME);

        populateCF7Fields(
            currentLastTouch,
            currentFirstTouch
        );
    }

    if (document.readyState === 'loading') {
        document.addEventListener(
            'DOMContentLoaded',
            initializeUTMFields
        );
    } else {
        initializeUTMFields();
    }

})();</script><!-- Google tag (gtag.js) -->
