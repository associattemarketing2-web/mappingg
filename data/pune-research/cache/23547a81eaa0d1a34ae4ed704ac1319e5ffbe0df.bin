ht":800,"formats":{"small":{"ext":".jpg","url":"/uploads/small_img2_for_mobile_e3a1d92e6d.jpg","hash":"small_img2_for_mobile_e3a1d92e6d","mime":"image/jpeg","name":"small_img2-for-mobile.jpg","path":null,"size":25.39,"width":313,"height":500,"sizeInBytes":25388},"medium":{"ext":".jpg","url":"/uploads/medium_img2_for_mobile_e3a1d92e6d.jpg","hash":"medium_img2_for_mobile_e3a1d92e6d","mime":"image/jpeg","name":"medium_img2-for-mobile.jpg","path":null,"size":45.1,"width":469,"height":750,"sizeInBytes":45098},"thumbnail":{"ext":".jpg","url":"/uploads/thumbnail_img2_for_mobile_e3a1d92e6d.jpg","hash":"thumbnail_img2_for_mobile_e3a1d92e6d","mime":"image/jpeg","name":"thumbnail_img2-for-mobile.jpg","path":null,"size":4.12,"width":97,"height":156,"sizeInBytes":4116}},"hash":"img2_for_mobile_e3a1d92e6d","ext":".jpg","mime":"image/jpeg","size":49.53,"url":"/uploads/img2_for_mobile_e3a1d92e6d.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-03-18T08:14:31.941Z","updatedAt":"2025-03-18T08:14:31.941Z"}}},"Desktopbanner":{"data":{"id":987,"attributes":{"name":"img2-for-desktop.jpg","alternativeText":null,"caption":null,"width":1920,"height":800,"formats":{"large":{"ext":".jpg","url":"/uploads/large_img2_for_desktop_2793349023.jpg","hash":"large_img2_for_desktop_2793349023","mime":"image/jpeg","name":"large_img2-for-desktop.jpg","path":null,"size":50.48,"width":1000,"height":417,"sizeInBytes":50478},"small":{"ext":".jpg","url":"/uploads/small_img2_for_desktop_2793349023.jpg","hash":"small_img2_for_desktop_2793349023","mime":"image/jpeg","name":"small_img2-for-desktop.jpg","path":null,"size":17.35,"width":500,"height":208,"sizeInBytes":17347},"medium":{"ext":".jpg","url":"/uploads/medium_img2_for_desktop_2793349023.jpg","hash":"medium_img2_for_desktop_2793349023","mime":"image/jpeg","name":"medium_img2-for-desktop.jpg","path":null,"size":32.37,"width":750,"height":313,"sizeInBytes":32369},"thumbnail":{"ext":".jpg","url":"/uploads/thumbnail_img2_for_desktop_2793349023.jpg","hash":"thumbnail_img2_for_desktop_2793349023","mime":"image/jpeg","name":"thumbnail_img2-for-desktop.jpg","path":null,"size":5.86,"width":245,"height":102,"sizeInBytes":5864}},"hash":"img2_for_desktop_2793349023","ext":".jpg","mime":"image/jpeg","size":142.75,"url":"/uploads/img2_for_desktop_2793349023.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-03-18T08:14:35.427Z","updatedAt":"2025-03-18T08:14:35.427Z"}}}},"teamsection":{"id":1,"sectiontitle":"Our Board of Directors","subtitle":"Meet our Board","shortdesc":"Our Board of Directors brings expertise and vision to guide our mission. Their leadership ensures growth, excellence, and a commitment to serving our clients and communities.","teams":{"data":[{"id":2,"attributes":{"Name":"Mr. Ravi Puravankara","Description":"\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eRavi Puravankara, a visionary and dynamic leader, is the Founder \u0026amp; Chairman of Puravankara Limited – one of India’s most admired and trusted real estate brands. Under his guidance and decisive leadership, the company has built an impressive portfolio of completed residential and commercial properties across nine cities.\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eA developer extraordinaire, Ravi prioritises all business decisions, keeping the company’s long-term trust and credibility among stakeholders in mind. He established a strong framework of good corporate governance and decided not to deal with unaccounted money from the very beginning. This was unheard of in the early 70s and is one of the most distinguishing features of the company’s culture even today. It helped lay a strong foundation for the brand Puravankara based on transparency and ethical practices.\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eThis also helped Puravankara Limited secure one of the first foreign direct investments (FDI) in the Indian real estate market in 2005. The group then established a joint venture (JV) with Keppel Land, a development company owned by the Singapore Government.\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eUnder Ravi Puravankara's strategic leadership, Puravankara Limited made history by becoming one of the early real estate players to list on the Indian stock exchanges in 2007. In 2008, Provident Housing Limited, a wholly owned subsidiary, was established under his aegis to address the aspirations of upwardly mobile Indians and first-home buyers. Further, in December 2020, the Company successfully mobilised US$ 76 million from the International Finance Corporation (IFC) and IFC Emerging Asia Fund (EAF) for investment in Provident Housing. Subsequently, he led the launch of Purva Land to cater to the needs of people desirous of plotted developments.\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eRecognising the need for backward integration in construction, he established Starworth Infrastructure and Construction Limited (SICL) as an internal engineering division of the group. Additionally, Purva Streaks, the interior design arm, caters to customers looking for an integrated interior design solution.\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eHis constant emphasis on customer needs and delight has earned him several awards and accolades, including the Lifetime Achievement Award 2023 by CREDAI Karnataka and the Lifetime Achievement Award by Construction Week Magazine. Under his stewardship, in 2020, Puravankara Limited was bestowed with an Honourable Mention for Excellence in Digital Disruption at the World Economic Forum New Champion Awards.\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eBeyond business, Ravi Puravankara is dedicated to driving positive social and environmental outcomes. Under his guidance, the company’s CSR initiatives are helping transform people’s lives positively in educating underprivileged children, water conservation; afforestation, and several long-term initiatives championing a sustainable and equitable future. For these efforts, the company bagged the prestigious Vishwakarma Award for Social Development and Impact in 2024, instituted by the Construction Industry Development Council (CIDC).\u0026nbsp;\u0026nbsp;\u003c/span\u003e\u003c/p\u003e","createdAt":"2025-03-19T05:06:09.802Z","updatedAt":"2026-07-28T06:09:24.823Z","publishedAt":"2025-03-19T05:13:12.171Z","position":"Founder and Chairman","subpos":"Chairman of the Board and Management Sub-Committee.","slug":"mr-ravi-puravankara","leadership_description":"\u003cp\u003eMr. Ravi Puravankara, is the Founder and Chairman of Puravankara Limited, one of the most admired and trusted real estate brands in India. Over the years, under his strategic guidance and effective leadership, the company has successfully developed an array of residential and commercial projects spread across nine Indian cities.\u003c/p\u003e\u003cp\u003eMr. Ravi is a trailblazer in the industry, and his approach has always been centered on long-term trust and credibility in every business decision.\u0026nbsp;\u003c/p\u003e\u003cp\u003eMr. Ravi’s vision has helped Puravankara Limited secure one of the earliest FDI deals in the Indian real estate sector in 2005.\u0026nbsp;\u003c/p\u003e\u003cp\u003eHe has successfully led the company through yet another milestone by being one of the earliest entrants in the Indian real estate sector to get listed on stock exchanges in India in 2007.\u0026nbsp;\u003c/p\u003e\u003cp\u003eRavi Puravankara is committed to the cause of social and environmental responsibility. Through his leadership, the company’s CSR initiatives have created significant impact in the areas of education for underprivileged children, water conservation, afforestation, and sustainability.\u0026nbsp;\u003c/p\u003e","full_time_positions":"\u003ch3 style=\"text-align:center;\"\u003e\u003cspan style=\"color:#215E99;\"\u003eDirectorships and full-time positions in Body Corporates\u003c/span\u003e\u003c/h3\u003e\u003cfigure class=\"table\"\u003e\u003ctable style=\";\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd style=\"background-color:#0F9ED5;border-bottom-style:solid;border-color:#0F9ED5;border-left-style:solid;border-right-style:none;border-top-style:solid;border-width:1.0pt;height:41.25pt;padding:0cm 5.4pt;vertical-align:top;width:52.35pt;\"\u003e\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:white;\"\u003e\u003cstrong\u003eSR.\u0026nbsp; \u0026nbsp;NO.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd style=\"background-color:#0F9ED5;border-bottom:1.0pt solid #0F9ED5;border-left-style:none;border-right-style:none;border-top:1.0pt solid #0F9ED5;height:41.25pt;padding:0cm 5.4pt;vertical-align:top;width:252.2pt;\"\u003e\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:white;\"\u003e\u003cstrong\u003eNAMES OF THE BODY CORPORATE\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd style=\"background-color:#0F9ED5;border-bottom-style:solid;border-color:#0F9ED5;border-left-style:none;border-right-style:solid;border-top-style:solid;border-width:1.0pt;height:41.25pt;padding:0cm 5.4pt;vertical-align:top;width:159.7pt;\"\u003e\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:white;\"\u003e\u003cstrong\u003eDESIGNATION\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"background-color:#CAEDFB;border-bottom-style:solid;border-color:#60CAF3;border-left-style:solid;border-right-style:solid;border-top-style:none;border-width:1.0pt;height:53.0pt;padding:0cm 5.4pt;vertical-align:top;width:464.25pt;\" colspan=\"3\"\u003e\u003cp style=\"text-align:center;\"\u003e\u0026nbsp;\u003c/p\u003e\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:black;\"\u003eNIL\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/figure\u003e","Image":{"data":{"id":2761,"attributes":{"name":"11 (2).png","alternativeText":null,"caption":null,"width":517,"height":487,"formats":{"small":{"ext":".png","url":"/uploads/small_11_2_320bf8a3aa.png","hash":"small_11_2_320bf8a3aa","mime":"image/png","name":"small_11 (2).png","path":null,"size":336.91,"width":500,"height":471,"sizeInBytes":336912},"thumbnail":{"ext":".png","url":"/uploads/thumbnail_11_2_320bf8a3aa.png","hash":"thumbnail_11_2_320bf8a3aa","mime":"image/png","name":"thumbnail_11 (2).png","path":null,"size":51.33,"width":166,"height":156,"sizeInBytes":51331}},"hash":"11_2_320bf8a3aa","ext":".png","mime":"image/png","size":97.18,"url":"/uploads/11_2_320bf8a3aa.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-06-18T05:53:02.372Z","updatedAt":"2025-06-18T05:53:02.372Z"}}}}},{"id":1,"attributes":{"Name":"Mr. Ashish R Puravankara","Description":"\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eMr. Ashish R. Puravankara is the Managing Director and Director on the board of Puravankara Limited. He oversees the entire business, primarily identifying growth opportunities for Puravankara Limited. He has played a vital role in ensuring superior construction quality by leveraging innovative technologies. Ashish's strong entrepreneurial vision led to the launch of Provident Housing, a leading large-scale community developer. This venture also led to the subsequent launch of Purva Land, a plotted development arm.\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eUnder Ashish's decisive leadership, Puravankara has completed several residential and commercial projects across nine cities (Bengaluru, Mumbai, Pune, Goa, Hyderabad, Chennai, Kochi, Coimbatore, and Mangaluru) in India. The company has also successfully entered the Mumbai redevelopment market and is looking to expand its presence in the West. Puravankara Limited's steady growth is a testament to his strategic formulation, financial acumen, and enterprise development expertise. His global exposure and access to a diverse network have continually enabled him to innovate and redefine success for the company.\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eToday, Ashish is widely recognised in the industry for his deep understanding and knowledge of the real estate sector and his drive for excellence. He has held the position of President of CREDAI Bengaluru in the past. He has been recognised with several awards, some of which are – the Grohe Hurun India Residential Real Estate Developer Award 2023, the Real Estate Person of the Year-South by Construction Week India (2023), the Real Estate Thought Leader of the Year - IBE 6th India Property Awards (2021) and Best MD of the Year - CIA World Awards (2020).\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"background-color:transparent;color:#000000;\"\u003eAshish holds a Bachelor of Science (BSc.) Degree in Business from Virginia Polytechnic Institute and State University and a Master of Business Administration (MBA) from Willamette University in Salem, Oregon. He is passionate about travel, adventure and motorsports.\u003c/span\u003e\u003c/p\u003e","createdAt":"2025-03-19T05:06:06.811Z","updatedAt":"2026-07-28T06:26:10.710Z","publishedAt":"2025-03-19T05:17:12.662Z","position":"Managing Director","subpos":"Board Member, Member of Audit Committee, Stakeholder Relationship Committee, Corporate Social Responsibility (CSR) Committee, Management Sub-Committee and Chairperson of Risk Management Committee.","slug":"mr-ashish-ravi-puravankara","leadership_description":"\u003cp\u003eMr. Ashish R. Puravankara is the Managing Director and a member of the Board of Directors at Puravankara Limited. His role in the company involves managing the overall business operations with a special focus on exploring business growth. Ashish has been successful in improving the quality of construction by incorporating new technologies.\u0026nbsp;\u003c/p\u003e\u003cp\u003eWith the dynamic leadership of Mr. Ashish R. Puravankara, the company has successfully delivered several projects in the residential and commercial segments across nine cities in India. The company is currently working towards strengthening its presence in western India. The success of Puravankara Limited is a clear indication of the strategic acumen, financial knowledge, and capabilities of Mr. Ashish R. Puravankara in the field of enterprise development.\u0026nbsp;\u003c/p\u003e\u003cp\u003eAshish is highly regarded within the industry for his knowledge and commitment to excellence. He has also served as the President of CREDAI Bengaluru. Over the years, Ashish has received many accolades for his work. These include the Grohe Hurun India Residential Real Estate Developer Award (2023), Real Estate Person of the Year – South at Construction Week India (2023), to name a few.\u003c/p\u003e","full_time_positions":"\u003ch3 style=\"text-align:center;\"\u003e\u003cspan style=\"color:#215E99;\"\u003eDirectorships and full-time positions in Body Corporates\u003c/span\u003e\u003c/h3\u003e\u003cfigure class=\"table\"\u003e\u003ctable style=\";\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd style=\"background-color:#0F9ED5;border-bottom-style:solid;border-color:#0F9ED5;border-left-style:solid;border-right-style:none;border-top-style:solid;border-width:1.0pt;height:41.25pt;padding:0cm 5.4pt;vertical-align:top;width:52.35pt;\"\u003e\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:white;\"\u003e\u003cstrong\u003eSR.\u0026nbsp; \u0026nbsp;NO.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd style=\"background-color:#0F9ED5;border-bottom:1.0pt solid #0F9ED5;border-left-style:none;border-right-style:none;border-top:1.0pt solid #0F9ED5;height:41.25pt;padding:0cm 5.4pt;vertical-align:top;width:232.35pt;\"\u003e\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:white;\"\u003e\u003cstrong\u003eNAMES OF THE BODY CORPORATE\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd style=\"background-color:#0F9ED5;border-bottom-style:solid;border-color:#0F9ED5;border-left-style:none;border-right-style:solid;border-top-style:solid;border-width:1.0pt;height:41.25pt;padding:0cm 5.4pt;vertical-align:top;width:179.55pt;\"\u003e\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:white;\"\u003e\u003cstrong\u003eDESIGNATION\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"border-bottom-style:solid;border-color:#60CAF3;border-left-style:solid;border-right-style:solid;border-top-style:none;border-width:1.0pt;height:45.85pt;padding:0cm 5.4pt;vertical-align:top;width:52.35pt;\"\u003e1.\u003c/td\u003e\u003ctd style=\"border-bottom:1.0pt solid #60CAF3;border-left-style:none;border-right:1.0pt solid #60CAF3;border-top-style:none;height:45.85pt;padding:0cm 5.4pt;vertical-align:top;width:232.35pt;\"\u003eVarishtha Property Developers Private Limited\u003c/td\u003e\u003ctd style=\"border-bottom:1.0pt solid #60CAF3;border-left-style:none;border-right:1.0pt solid #60CAF3;border-top-style:none;height:45.85pt;padding:0cm 5.4pt;vertical-align:top;width:179.55pt;\"\u003e\u003cp style=\"text-align:center;\"\u003eDirector\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"border-bottom-style:solid;border-color:#60CAF3;border-left-style:solid;border-right-style:solid;border-top-style:none;border-width:1.0pt;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:52.35pt;\"\u003e2.\u003c/td\u003e\u003ctd style=\"border-bottom:1.0pt solid #60CAF3;border-left-style:none;border-right:1.0pt solid #60CAF3;border-top-style:none;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:232.35pt;\"\u003ePropmart Technologies Limited\u003c/td\u003e\u003ctd style=\"border-bottom:1.0pt solid #60CAF3;border-left-style:none;border-right:1.0pt solid #60CAF3;border-top-style:none;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:179.55pt;\"\u003e\u003cp style=\"text-align:center;\"\u003eDirector\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"border-bottom-style:solid;border-color:#60CAF3;border-left-style:solid;border-right-style:solid;border-top-style:none;border-width:1.0pt;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:52.35pt;\"\u003e3.\u003c/td\u003e\u003ctd style=\"border-bottom:1.0pt solid #60CAF3;border-left-style:none;border-right:1.0pt solid #60CAF3;border-top-style:none;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:232.35pt;\"\u003ePurva Good Earth Properties Private Limited\u003c/td\u003e\u003ctd style=\"border-bottom:1.0pt solid #60CAF3;border-left-style:none;border-right:1.0pt solid #60CAF3;border-top-style:none;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:179.55pt;\"\u003e\u003cp style=\"text-align:center;\"\u003eDirector\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"border-bottom-style:solid;border-color:#60CAF3;border-left-style:solid;border-right-style:solid;border-top-style:none;border-width:1.0pt;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:52.35pt;\"\u00