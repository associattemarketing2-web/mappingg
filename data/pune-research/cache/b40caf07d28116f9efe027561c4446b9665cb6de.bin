<style type="text/css">
    .search-modal {
        position: unset !important;
    }

    .project-search-page {
        padding: 120px 0 60px !important;
        background: #fff;
    }

    .search-modal input {
        background: 0 0;
        font-size: 20px;
        height: 40px;
        padding-left: 15px;
        border: 0;
        color: #fff;
        border-bottom: 1px solid #9a9a9a;
        border-radius: 4px;
        box-shadow: 0 0 !important;
    }

    body.search-active .header-sticky {
        display: block;
    }

    body.search-active img.search-btn {
        display: none;
    }

    .search-active a.close-btn img {
        filter: brightness(0) invert(0);
    }

    .search-active header .menu-bar span {
        background-color: #000 !important;
    }

    .search-active header.header {
        background-color: #fff !important;
    }

    .search-active img.img-fluid.logo.normal-logo,
    .search-active img.img-fluid.logo.sticky-logo {
        filter: brightness(0) invert(0);
    }

    .search-active .menu-wrapper a,
    .search-active .menu-bar span {
        color: #000;
    }

    .search-active .menu-bar span {
        background: #000;
    }

    body.search-active::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.55);
        z-index: 998;
    }

    body.search-active header .search-modal {
        position: absolute;
        z-index: 1000;
    }

    /*
.search-active header.header-sticky .menu-bar span {
      background-color: #fff !important;
}
.search-active header.header.header-sticky {
    background-color: rgba(19, 36, 36, 0.68) !important;
}
.search-active header.header-sticky a.close-btn img {
   filter: unset;
}
.search-active header.header.header-sticky .menu-wrapper a, .search-active header.header.header-sticky .menu-bar span {
color:#fff;
}
.search-active header.header.header-sticky img.img-fluid.logo.normal-logo, .search-active header.header.header-sticky img.img-fluid.logo.sticky-logo {
    filter: unset;
}
.search-active header.header.header-sticky .menu-bar span {
background:#fff;
}
*/
    .search-modal .sobha-project-search .checkbox-list label {
        text-transform: uppercase
    }

    div#p-overview h2 {
        text-align: center;
    }

    .search-modal .close-btn,
    #iframe-modal .close-btn {
        right: 100px !important;
    }

    .second-navigation .second-nav-wrapper {
        overflow-y: auto;
        /* allow vertical scroll */
        scrollbar-width: none;
        /* Firefox */
        -ms-overflow-style: none;
        /* IE & Edge */
    }

    .search-modal .sobha-project-search .checkbox-list label.disabled-option {
        opacity: 0.4;
        cursor: not-allowed;
        background: #f1f1f1;
    }

    .search-modal .sobha-project-search .checkbox-list label.disabled-option input {
        pointer-events: none;
    }

    .second-navigation .second-nav-wrapper::-webkit-scrollbar {
        display: none;
        /* Chrome, Safari */
    }

    .grecaptcha-badge {
        visibility: hidden;
    }

    @media (max-width: 767px) {

        .close-nav {
            left: 50%;
            right: 0px;
        }

    }
</style>





<body class="wp-singular page-template page-template-contact page-template-contact-php page page-id-142 wp-theme-sobha post-id-142">

    <!-- Menu script moved from script.js to header.php for faster loading – 18/Feb/2026-->
    <!--script>
(function() {

  document.addEventListener("click", function(e) {

    var trigger = e.target.closest(".menu-wrapper a");
    if (!trigger) return;

    e.preventDefault();

    var menu = document.querySelector(".menu-container");
    var bg = document.querySelector(".background-wrap");

    if (menu) menu.classList.toggle("active");

    document.body.classList.toggle("translate-headerhide");

    if (bg) {
      if (menu && menu.classList.contains("active")) {
        bg.style.display = "block";
        document.body.style.overflow = "hidden";
      } else {
        bg.style.display = "none";
        document.body.style.overflow = "auto";
      }
    }

  });

})();
</script-->


    <header class="header">
        <div class="container custom-container top-logo">
            <div class="row justify-content-between align-items-center">
                <div class="col-md-4 col-4 menu-wrapper">
                    <a href="javascript:" class="d-flex align-items-center" aria-label="Menu" title="Menu">
                        <span class="d-none d-md-block">MENU</span>
                        <div class="menu-bar ml-2">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </a>
                </div>
                <div class="col-md-4 col-4 text-center" style="padding:0;">
                    <a href="https://www.sobha.com">
                        <img src="https://www.sobha.com/wp-content/themes/sobha/images/SOBHA_White_new.svg" width="133"
                            height="132" class="img-fluid logo normal-logo" style="max-width:133px;min-width: 48px;"
                            alt="Sobha Limited" title="Sobha Limited">
                        <img  src="https://www.sobha.com/wp-content/themes/sobha/images/SOBHA_White_new.svg"
                            width="133" height="56" class="img-fluid logo sticky-logo"
                            style="max-width:133px;min-width: 48px;" alt="Sobha Limited" title="Sobha Limited">
                    </a>
                </div>
                <div class="col-md-4 col-4 text-right">
                    <img class="search-btn" src="https://www.sobha.com/wp-content/themes/sobha/images/search.svg" width="20"
                        height="20" class="img-fluid" style="max-width:20px;" alt="search-icon">
                </div>
            </div>
            <section id="search" class="search-wrapper">
                <div class="search-wrap">
                    <form id="f1" name="f1" class="w-100" method="get" action="/search">
                        <input type="text" id="" class="form-control" name="ss" placeholder="Search in SOBHA">
                    </form>
