            <script>
        $(document).on('click', '.searchProjects', function(){
            var data = {};
            var location = $("#filter_location").val();
            var type = $("#filter_type").val();
            var configuration = $("#filter_configuration").val();
            var status = $("#filter_status").val();

            location = location === 'Location' ? '' : location;
            type = type === 'Type' ? '' : type;
            configuration = configuration === 'Configuration' ? '' : configuration;
            status = status === 'Status' ? '' : status;

            data['location'] = location;
            data['type'] = type;
            data['configuration'] = configuration;
            data['status'] = status;

            var redirect_url = modifyUrl(data);
            window.location.href = redirect_url;
        });

        function modifyUrl(data){
            var str = '';
            var i = 0;
            $.each(data, function(a, b) {
                var and = (i>0) ? '&' : '';
                if(a != ''){
                    str += and+a+'='+b;
                    i++;
                }
            });
            return  'https://www.supremeuniversal.com/projects/'+'?'+str
        }
    </script>

                    <script>
                let check = localStorage.getItem("disclaimerShown");
                if (!check) {
                    setTimeout(() => {
                        $('.disclaimerModal').modal('show');
                    }, 1500);
                }

                $(".disclaimerModal .lineBtn").click(function (e) {
                    e.preventDefault();
                    $('.disclaimerModal').modal('hide');
                    localStorage.setItem("disclaimerShown", "true");
                });
                
            </script>
            
