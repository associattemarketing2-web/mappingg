	<script>
		$(document).ready(function () {
			var communityCarousel = $("#community-carousel");

			// Initialize Owl Carousel with default settings
			communityCarousel.owlCarousel({
				items: 5,
				loop: true,
				margin: 15,



			});

			// Custom navigation button functionality
			$(".custom-prev").click(function () {
				communityCarousel.trigger('prev.owl.carousel');
			});

			$(".custom-next").click(function () {
				communityCarousel.trigger('next.owl.carousel');
			});

			// Adjust number of items based on window width
			$(window).resize(function () {
				var windowWidth = $(window).width();
				var itemsToShow = windowWidth >= 768 ? 2 : 1; // Show 2 items on desktop, 5 items on smaller screens
				communityCarousel.trigger('destroy.owl.carousel'); // Destroy existing instance
				communityCarousel.owlCarousel({
					items: itemsToShow,
					loop: true,
					margin: 30,



				});
			}).resize(); // Trigger resize event on page load
		});


	</script>








