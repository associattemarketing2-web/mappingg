<script type="text/javascript">
    $(".telli").on("input", function() {
        var current = $(this).val();
        var sanitized = current.replace(/[^0-9]/g, '');
        $(this).val(sanitized);
    });


    $(".fname").on("input", function() {
        var current = $(this).val();
        var sanitized = current.replace(/[^a-zA-Z ]/g, '');
        if (current !== sanitized) {
            alert("Only letters and spaces are allowed.");
        }
        $(this).val(sanitized);
    });
</script>
<script>
    $("#send").click(function() {
        var name2 = $("#name2").val();
        var email2 = $("#email2").val();
        var phone2 = $("#phone2").val();
        var city2 = $("#city2").val();

        var utm_source = $("#utm_source").val();
        var utm_camp = $("#utm_campaign_name").val();
        var utm_id = $("#utm_campaign_id").val();
        var utm_city = $("#utm_campaign_city").val();

        var response2 = $("#response2").val();
        var g_recaptcha = $("#g-recaptcha-response").val();

        if (!name2) {
            $("#error5").html("Please enter name");
            return false;
        }
        if (!email2) {
            $("#error5").html("Please enter email");
            return false;
        }
        var emailReg = /^(("[\w-\s]+")|([\w-]+(?:\.[\w-]+)*)|("[\w-\s]+")([\w-]+(?:\.[\w-]+)*))(@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$)|(@\[?((25[0-5]\.|2[0-4][0-9]\.|1[0-9]{2}\.|[0-9]{1,2}\.))((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\.){2}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\]?$)/i;
        if (emailReg.test(email2) == false) {
            $("#error5").html("Please enter valid email address");
            return false;
        }
        if (!phone2) {
            $("#error2").html("Please enter phone");
            return false;
        }
        var mob = /^[0-9]{10}$/;
        if (mob.test(phone2) == false) {
            $("#error5").html("Please enter 10 digit number");
            return false;
        }
        if (!city2) {
            $("#error5").html("Please enter city");
            return false;
        }
        if (!response2) {
            $("#error5").html("Please enter feedback");
            return false;
        }
        $("#send").html('<i class="fa fa-spinner fa-pulse fa-fw"></i> Loading..');
        $.ajax({
            type: "POST",
            url: "https://naiknavare.com/send_enquiry",
            data: {
                'name2': name2,
                'email2': email2,
                'phone2': phone2,
                'city2': city2,
                'response2': response2,
                'g_recaptcha': g_recaptcha
            },
            success: function(response) {
                console.log(response);
                if (response.status == "1") {
                    $("#formenquire").trigger("reset");
                    $("#error5").html("");
                    window.location.href = 'https://naiknavare.com/thanku_page';
                    //   alert("Your Enquiry has been sent successfully ..!");

                } else if (response.status == "false") {
                    alert("Something went wrong, Please try again ..!");
                    $("#formenquire").trigger("reset");
                    $("#send").html('Send');

                } else {
                    $("#send").html('Send');
                    alert(response);
                }
            }
        });
    });

    $("#send1").click(function() {
        var name1 = $("#name1").val();
        var email1 = $("#email1").val();
        var phone1 = $("#phone1").val();
        var city1 = $("#city1").val();

        //var g_recaptcha=$("#g-recaptcha-response").val();

        let g_recaptcha = grecaptcha.getResponse(feedback_r);


        var response1 = $("#response1").val();

        if (!name1) {
            $("#error3").html("Please enter name");
            return false;
        }
        if (!email1) {
            $("#error3").html("Please enter email");
            return false;
        }
        var emailReg = /^(("[\w-\s]+")|([\w-]+(?:\.[\w-]+)*)|("[\w-\s]+")([\w-]+(?:\.[\w-]+)*))(@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$)|(@\[?((25[0-5]\.|2[0-4][0-9]\.|1[0-9]{2}\.|[0-9]{1,2}\.))((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\.){2}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\]?$)/i;
        if (emailReg.test(email1) == false) {
            $("#error3").html("Please enter valid email address");
            return false;
        }
        if (!phone1) {
            $("#error3").html("Please enter phone");
            return false;
        }
        var mob = /^[0-9]{10}$/;
        if (mob.test(phone1) == false) {
            $("#error3").html("Please enter 10 digit number");
            return false;
        }
        if (!city1) {
            $("#error3").html("Please enter city");
            return false;
        }
        if (!response1) {
            $("#error3").html("Please enter feedback");
            return false;
        }
        $("#send1").html('<i class="fa fa-spinner fa-pulse fa-fw"></i> Loading..');
        $('#send1').prop('disabled', true);


        $.ajax({
            type: "POST",
            url: "https://naiknavare.com/send_feedback",
            data: {
                'name1': name1,
                'email1': email1,
                'phone1': phone1,
                'city1': city1,
                'response1': response1,
                'g_recaptcha': g_recaptcha
            },
            success: function(response) {
                console.log(response);
                if (response.status == true) {
                    alert("Your Enquiry has been sent successfully ..!");
                    $("#formfeedback").trigger("reset");
                    $("#error3").html("");
                    $("#send1").html('Send');
                    $('#send1').prop('disabled', false);
                    $('#feedback').modal('hide');
                } else if (response.status == false) {
                    alert("Something went wrong, Please try again ..!");
                    $("#formfeedback").trigger("reset");
                    $("#send1").html('Send');
                    $('#send1').prop('disabled', false);

                } else {
                    $("#send1").html('Send');
                    $('#send1').prop('disabled', false);
                    alert(response);
                }
            }
        });
    });

    $("#complain").click(function() {
        var name4 = $("#name4").val();
        var email4 = $("#email4").val();
