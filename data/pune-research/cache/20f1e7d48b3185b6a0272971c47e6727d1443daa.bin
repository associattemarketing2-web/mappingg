eater" tabindex="-1" role="group"><div data-testid="responsive-container-content" role="list" aria-live="off" class="comp-m64m3csy7-container"><div class="p9hNc1 xjQkF3 fABPvj"><!--$--><div id="comp-m64m3csz3__item1" role="listitem" class="HFEOE3 NaeT1r comp-m64m3csz3-container comp-m64m3csz3 comp-m64m3csz3__item1 wixui-repeater__item" dir="ltr"><div aria-hidden="true" class="jdJeEr NYfD3h inner-box wixui-repeater__item"></div><!--$--><div id="comp-m64m3csz9__item1" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-m64m3csz9 comp-m64m3csz9__item1 wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text"><span class="wixui-rich-text__text">&quot;Working with Mittal Brothers&nbsp;was a seamless experience. Their commitment to quality is truly unmatched.&quot;</span></p></div><!--/$--></div><!--/$--></div><div class="p9hNc1"><!--$--><div id="comp-m64m3csz3__item-j9ples3e" role="listitem" class="HFEOE3 NaeT1r comp-m64m3csz3-container comp-m64m3csz3 comp-m64m3csz3__item-j9ples3e wixui-repeater__item" dir="ltr"><div aria-hidden="true" class="jdJeEr NYfD3h inner-box wixui-repeater__item"></div><!--$--><div id="comp-m64m3csz9__item-j9ples3e" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-m64m3csz9 comp-m64m3csz9__item-j9ples3e wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text">&quot;Our expectations with their professionalism and attention to detail. Our new home is everything we dreamed of.&quot;</p></div><!--/$--></div><!--/$--></div><div class="p9hNc1"><!--$--><div id="comp-m64m3csz3__item-j9plerjk" role="listitem" class="HFEOE3 NaeT1r comp-m64m3csz3-container comp-m64m3csz3 comp-m64m3csz3__item-j9plerjk wixui-repeater__item" dir="ltr"><div aria-hidden="true" class="jdJeEr NYfD3h inner-box wixui-repeater__item"></div><!--$--><div id="comp-m64m3csz9__item-j9plerjk" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-m64m3csz9 comp-m64m3csz9__item-j9plerjk wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text"><span class="wixui-rich-text__text">​I have had the pleasure of being part of the Mittal Brothers team for the past.The support from the team and the induction process was seamless and invaluable, and the work environment is characterized by a systematic approach and streamlined policies.</span></p></div><!--/$--></div><!--/$--></div></div></div><!--/$--><!--$--><div id="comp-m64m3ct08" role="" class="HFEOE3 NaeT1r comp-m64m3ct08-container comp-m64m3ct08 wixui-box" dir="ltr"><div aria-hidden="true" class="jdJeEr NYfD3h inner-box wixui-box"></div><!--$--><div id="comp-m64m3ct14" data-semantic-classname="button"><button type="button" class="StylableButton2545352419__root StylableButton2545352419__root SlideshowButton2197735472__root style-m64m3ct112__root wixui-button" data-testid="buttonContent" aria-label="Previous"><span class="StylableButton2545352419__container"><span class="StylableButton2545352419__icon wixui-button__icon" aria-hidden="true" data-testid="stylablebutton-icon"><span>
