          // lazy load chat widget after 5s or scroll
          const loadChat = () => {
            if (window.chatLoaded) return;
            window.chatLoaded = true;
            const s = document.createElement("script");
            s.src = "https://s3.ap-south-1.amazonaws.com/cdn.limechat.ai/packs/js/LC_sdk/v1/sdk.js";
            s.defer = true;
            s.onload = () => {
              window.chatwootSDK.run({
