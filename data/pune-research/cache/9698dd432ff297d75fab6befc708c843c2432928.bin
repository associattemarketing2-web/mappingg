    </script>  <script>
        function repeatTxt() {
            if (window.innerWidth < 1024) {
                var featureTicker = document.querySelector('.featuredProject__ticker').textContent;
                var featureTicker2 = document.querySelectorAll('.featuredProject__ticker');

                // Define the text to be repeated and the number of repetitions                
                featureTicker2.forEach(ele => {
                    var txtCopy = featureTicker;
                    var numRepetitions = 15;
                    // Loop through the desired number of repetitions
                    for (var i = 0; i < numRepetitions; i++) {
                        // Create a new <span> element and set its text content
                        var span = document.createElement("span");
                        span.textContent = txtCopy;
                        ele.appendChild(span);
                    }
                })
            }

        }
        repeatTxt();
    </script> <script>
        function allowNoSpecialChars(event) {
            const char = event.key;

            // Allow control keys
            if (
                event.keyCode === 8 ||   // backspace
                event.keyCode === 9 ||   // tab
                event.keyCode === 13 ||  // enter
                event.keyCode === 46 ||  // delete
                event.ctrlKey || event.metaKey
            ) {
                return true;
            }

            // Regex: letters, numbers, space, . , 
            const regex = /^[a-zA-Z0-9 .,]$/;

            return regex.test(char);
        }
    </script> <script>
        document.getElementById('contactGuestManagerPopup__nameInput')
            ?.addEventListener('paste', function (e) {
                e.preventDefault();

                const text = (e.clipboardData || window.clipboardData)
                    .getData('text')
                    .replace(/[^a-zA-Z ]/g, '');

                document.execCommand('insertText', false, text);
            });
    </script> <script>
        document.getElementById('comments')?.addEventListener('paste', function (e) {
            e.preventDefault();
            const text = (e.clipboardData || window.clipboardData)
                .getData('text')
                .replace(/[^a-zA-Z0-9 .,]/g, '');
            document.execCommand('insertText', false, text);
        });
    </script> <script>
        function sanitizeComments() {
            const textarea = document.getElementById('comments');
            if (textarea) {
                textarea.value = textarea.value.replace(/^[a-zA-Z0-9 .,]$/g, '');
            }
        }
    </script>  <style>
        .loadOpacity {
            opacity: 0 !important;
            transition: 0.3s linear;
        }
    </style> <script>
        var recentlyViewedPopup = document.querySelector('.c-recentlyViewedPopup');
        recentlyViewedPopup.classList.add('loadOpacity');
        window.addEventListener("load", (event) => {
            recentlyViewedPopup.classList.remove('loadOpacity');
            document.querySelector(".c-recentlyViewedPopup").classList.add("show");
            // recentlyViewedPopup.style.transition = 'opacity 0.3s linear';

            // recently Viewed Popup overflow hide and show
            setTimeout(() => {
                if (document.querySelector('.c-recentlyViewedPopup').classList.contains('show')) {
                    document.querySelector("body").classList.add("ov-h");
                }
                if (document.querySelector('.c-recentlyViewedPopup').hasAttribute('style') == true) {
                    document.querySelector("body").classList.remove("ov-h");
                }
            }, 50);
            document.querySelector('.c-recentlyViewedPopup__closeButton').addEventListener('click', () => {
                document.querySelector("body").classList.remove("ov-h");
                document.querySelector("body").style.overflow = "auto";
                document.querySelector("body").style.overflowX = "hidden";
            });
            window.onclick = function (event) {
                if (event.target == document.querySelector('.c-recentlyViewedPopup')) {
                    document.querySelector("body").classList.remove("ov-h");
                    document.querySelector("body").style.overflow = "auto";
                    document.querySelector("body").style.overflowX = "hidden";
                }
            }
        });
    </script> <script>
        document.addEventListener('DOMContentLoaded', () => {
            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) {
                    return parts.pop().split(';').shift();
                }
                return null;
            }

            function setCookie(name, value, days = 30) {
                const date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                document.cookie = `${name}=${value}; expires=${date.toUTCString()}; path=/`;
            }

            function deleteCookie(name) {
                document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/`;
            }

            const cookieName = "recentlyViewedProjects";
            const cookieData = getCookie(cookieName);

            if (!cookieData) return;

            try {
                let projects = JSON.parse(decodeURIComponent(cookieData));

                // If it's not an array, bail safely
                if (!Array.isArray(projects)) {
                    deleteCookie(cookieName);
                    return;
                }

                // Remove Codename Zest
                projects = projects.filter(project =>
                    !(
                        project?.url?.includes("codename-zest") &&
                        project?.name === "Codename Zest"
                    )
                );
                projects = projects.filter(project =>
                    !(
                        project?.url?.includes("codename-np-1-2") &&
                        project?.name === "Codename NP 1-2"
                    )
                );

                // Limit to 8
                projects = projects.slice(0, 8);

                // If empty AFTER filtering → delete cookie
                if (projects.length === 0) {
                    deleteCookie(cookieName);
                    return;
                }

                // Otherwise, save cleaned cookie
                setCookie(
                    cookieName,
                    encodeURIComponent(JSON.stringify(projects)),
                    30
                );

            } catch (err) {
                // Invalid JSON → remove corrupted cookie
                deleteCookie(cookieName);
            }
        });
    </script> </body></html>