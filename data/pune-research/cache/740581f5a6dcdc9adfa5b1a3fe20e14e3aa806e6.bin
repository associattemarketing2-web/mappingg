							<form class="property_enquiry_form" autocomplete="off">
	
	<input type="hidden" name="property_brochure_download" class="property_brochure_download" value="0">
	<div class="mb-3">
		<input type="text" class="form-control property_enquiry_full_name" placeholder="Name" name="property_enquiry_full_name" >
		<div class="error">
			<span class="property_enquiry_full_name_err"></span>
		</div>
	</div>
	<div class="mb-3">
		<input type="email" class="form-control property_enquiry_email_id" placeholder="Email" name="property_enquiry_email_id" >
		<div class="error">
			<span class="property_enquiry_email_id_err"></span>
		</div>
	</div>
	<div class="mb-3">
		<input type="text" class="form-control property_enquiry_phone_number" placeholder="Mobile" name="property_enquiry_phone_number" inputmode="numeric" >
		<div class="error">
			<span class="property_enquiry_phone_number_err"></span>
		</div>
	</div>
	
	<div class="mb-3">
		<select class="form-select property_ids" name="property_ids" title="Property">
			<option value="">Select Property</option>
            
            <option value="68ee13ea57785ba78517f919" >Mantra Mistara</option>
            
            <option value="67a60c52991cfb004a45a55c" >Mantra Magnus Elite</option>
            
            <option value="66a3d6d97133eac5bbef4b99" >Mantra Meridian</option>
            
            <option value="67a60f91991cfb004a45a705" >Mantra Melange</option>
            
            <option value="66a3d6d97133eac5bbef4b8c" >Mantra Mirari</option>
            
            <option value="66a3d6d97133eac5bbef4ba0" >Mantra Magnus</option>
            
            <option value="66a3d6d97133eac5bbef4b8f" >Mantra Business Centre</option>
            
            <option value="6a9287e915ebf4528e52cb9e" >Mantra Marquis</option>
            
		</select>
		<div class="error">
			<span class="property_ids_err"></span>
		</div>
	</div>
	<div class="mb-3">
		<textarea class="form-control property_enquiry_comments" placeholder="Comments" name="property_enquiry_comments" ></textarea>
		<div class="error">
			<span class="property_enquiry_comments_err"></span>
		</div>
	</div>
	
	
	<div class="mb-3" style="display: none;">
		<input type="text" class="form-control property_enquiry_otp" placeholder="OTP" name="property_enquiry_otp" maxlength="4" inputmode="numeric" >
		<div class="error">
			<span class="property_enquiry_otp_err"></span>
		</div>
	</div>
	<button type="submit">Enquire Now
        <span>
			<svg xmlns="http://www.w3.org/2000/svg" width="15.705" height="12.564" viewBox="0 0 15.705 12.564">
				<path id="Icon_material-mail-outline" data-name="Icon material-mail-outline" d="M17.135,6H4.571A1.568,1.568,0,0,0,3.008,7.571L3,16.994a1.575,1.575,0,0,0,1.571,1.571H17.135a1.575,1.575,0,0,0,1.571-1.571V7.571A1.575,1.575,0,0,0,17.135,6Zm0,10.994H4.571V9.141l6.282,3.926,6.282-3.926Zm-6.282-5.5L4.571,7.571H17.135Z" transform="translate(-3 -6)" fill="#35393B" />
			</svg>
		</span>
	</button>
</form>
