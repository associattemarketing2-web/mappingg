ame\":\"pointer-events-none relative col-span-full row-span-full h-full w-full overflow-hidden\",\"children\":[[\"$\",\"picture\",null,{\"children\":\"$18\"}],[\"$\",\"div\",null,{\"className\":\"absolute inset-x-0 bottom-0 h-6 bg-ever-teal-100 md:hidden\",\"aria-hidden\":\"true\"}]]}]}]}],[[\"$\",\"$L19\",\"intro\",{\"className\":\"relative z-10 -mt-12 sm:-mt-20 lg:-mt-[100px] xl:-mt-[200px] min-[1440px]:-mt-[310px]\",\"children\":[\"$\",\"$L1a\",null,{\"data\":{\"breadcrumb\":[{\"label\":\"Home\",\"href\":\"/\"},{\"label\":\"About\",\"href\":\"/about-us\"},{\"label\":\"Group Profile\"}],\"title\":\"Group Profile: Constantly advancing\",\"titleHighlight\":\"good energies\",\"titleSuffix\":\"that work\",\"lead\":\"The Suzlon Group is a leading global wind-first, full-stack renewable energy partner with 21,700 MW of renewable energy assets across 17 countries. We create and manage integrated clean energy systems and are with you through every stage of your good energies project, across wind, solar, storage, and emerging technologies. Always end-to-end and good. Founded in 1995 by Tulsi Tanti, we are headquartered in India and present in six continents.\",\"sideImageSrc\":\"/images/About/group-profile/02/group-profile.jpg\",\"sideImageAlt\":\"Wind turbines\",\"sideParagraph\":\"Industries today need clean energy ecosystems that are firm, flexible and tailored to changing realities. That is why we bring together renewable energy expertise across wind, solar, storage and emerging technologies under one roof, with leadership grounded in operational confidence and long-term responsibility.\",\"paragraphs\":[\"In the wake of a digital world and geostrategic energy security, the need for dependable, affordable, round-the-clock power has never been greater. Our three decades of proven renewable expertise, in-house global R\u0026D centres, state-of-the-art manufacturing facilities, and a vast service network support our team of 8,500+ experts to drive your energy transition.\"]}}]}],[\"$\",\"div\",\"process\",{\"children\":[\"$\",\"$L1b\",null,{\"data\":{\"title\":\"Full-stack renewable energy,\",\"titleHighlight\":\"under one roof\",\"lead\":\"From R\u0026D and technology to manufacturing, execution and lifecycle care, we bring together the capabilities needed to make renewable energy work in the real world.\",\"steps\":[{\"step\":\"01\",\"title\":\"Development\",\"description\":\"We help develop clean energy projects from the earliest stage, aligning site potential, project needs and long-term performance expectations.\",\"tags\":[\"Site assessment\",\"Feasibility\",\"Project planning\"]},{\"step\":\"02\",\"title\":\"Technology\",\"description\":\"Our global R\u0026D centres support the development of renewable energy systems made for diverse markets, operating conditions and client needs.\",\"tags\":[\"R\u0026D\",\"Engineering\",\"Innovation\"]},{\"step\":\"03\",\"title\":\"Manufacturing\",\"description\":\"Our manufacturing capabilities support high-quality components, disciplined processes and renewable energy assets designed for long-lasting lifecycle performance.\",\"tags\":[\"Components\",\"Quality\",\"Scale\"]},{\"step\":\"04\",\"title\":\"Project execution\",\"description\":\"We manage project delivery with focus on safety, coordination and on-ground execution across complex renewable energy environments.\",\"tags\":[\"Delivery\",\"Safety\",\"Coordination\"]},{\"step\":\"05\",\"title\":\"Services\",\"description\":\"Our service teams provide complete visibility into renewable energy asset performance through operations, maintenance and lifecycle care that help improve long-term efficiency.\",\"tags\":[\"Operations \u0026 Maintenance\",\"Asset care\",\"Performance\"]},{\"step\":\"06\",\"title\":\"Partnerships\",\"description\":\"We work with clients and partners to create clean energy systems that stay relevant across changing business and energy realities.\",\"tags\":[\"Clients\",\"Partners\",\"Long-term value\"]}]}}]}],\"$L1c\",\"$L1d\"],false]}]}]\n"])</script><script>self.__next_f.push([1,"1e:I[209491,[\"/_next/static/chunks/11urp~c3h48hr.js\",\"/_next/static/chunks/0d3j1t.f~n0_..js\",\"/_next/static/chunks/0i1xn6azr-jv8.js\",\"/_next/static/chunks/0vlamz72s5jd9.js\",\"/_next/static/chunks/0m-dt_1r50v7h.js\",\"/_next/static/chunks/0wbw_aigm92.r.js\",\"/_next/static/chunks/0_tzaov-eela_.js\"],\"default\"]\n1f:I[670813,[\"/_next/static/chunks/11urp~c3h48hr.js\",\"/_next/static/chunks/0d3j1t.f~n0_..js\",\"/_next/static/chunks/0i1xn6azr-jv8.js\",\"/_next/static/chunks/0vlamz72s5jd9.js\",\"/_next/static/chunks/0m-dt_1r50v7h.js\",\"/_next/static/chunks/0wbw_aigm92.r.js\",\"/_next/static/chunks/0_tzaov-eela_.js\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"1c:[\"$\",\"div\",\"capabilities\",{\"children\":[\"$\",\"$L1e\",null,{\"capabilities\":{\"titleLine1\":\"Capabilities that make\",\"titleHighlight\":\"clean energy\",\"titleLine2\":\" work\",\"cards\":[{\"id\":\"rd\",\"title\":\"Global R\u0026D\",\"description\":\"Our R\u0026D centres in Germany, Denmark, the Netherlands and India strengthen the technology behind our renewable energy systems.\",\"imageSrc\":\"/images/About/group-profile/04/global-rd.jpg\",\"imageAlt\":\"Global R\u0026D\"},{\"id\":\"manufacturing\",\"title\":\"Manufacturing strength\",\"description\":\"Our manufacturing footprint supports the creation of renewable energy systems with quality, consistency and operational discipline.\",\"imageSrc\":\"/images/About/group-profile/04/manufacturing-strength.jpg\",\"imageAlt\":\"Manufacturing strength\"},{\"id\":\"service\",\"title\":\"Service network\",\"description\":\"Our service network helps clients manage renewable energy assets across their lifecycle, from operations to long-term care.\",\"imageSrc\":\"/images/About/group-profile/04/service-network.jpg\",\"imageAlt\":\"Service network\"},{\"id\":\"integrated\",\"title\":\"Integrated solutions\",\"description\":\"Wind, solar, storage and emerging technologies 