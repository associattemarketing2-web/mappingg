<style type="text/css">
    .container.custom-container.footer-wrapper {
        margin-bottom: 0px;
    }

    footer .custom-container {
        max-width: 96%;
    }

    footer {
        background: #000000;
        /* color: rgb(157, 157, 157); */
        padding: 20px 60px 0px 60px;
    }

    footer .social-wrapper a:nth-child(2) img,
    footer .social-wrapper a:nth-child(5) img,
    footer .social-wrapper a:nth-child(3) img {
        width: 33px;
        height: 33px;
        max-width: 100px;
    }

    footer .social-wrapper a img {
        max-width: 100px;
    }

    footer a {
        color: #fff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 400;
    }

    footer a:hover {
        color: #fff !important;
        text-decoration: none;
    }

    footer h6 {
        font-size: 16px;
        font-weight: 600;
        line-height: 22px;
        color: #fff;
        letter-spacing: 0px;
        margin-bottom: 8px;
    }

    footer ul {
        padding-top: 8px;
    }

    .phone-icon {
        width: 16px;
        height: 16px;
        object-fit: cover;
    }

    .footer-wrapper .row.menu-row {
        display: flex;
        justify-content: space-between;
        align-content: space-between;
        padding-right: 40px;
    }

    ul.footer-list-menu_2,
    ul.footer-list-menu_3 {
        line-height: 24px;
        display: flex;
        flex-wrap: wrap;
        flex-direction: column;
    }

    .social-wrapper a {
        margin: 0 !important;
        padding: 0 !important;
        line-height: 0 !important;
        font-size: 0 !important;
    }


    .menu-row {
        /* padding-top: 24px; */
        padding-top: 36px;
        padding-bottom: 10px;
        border-bottom: 1px solid #D9D9D9;
    }

    .privacy-section {
        display: flex;
        padding-top: 24px;
        padding-bottom: 15px;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .privacy-section p {
        text-align: center;
    }

    .contact-section {
        padding-top: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-bottom: 16px;
        border-bottom: 1px solid #D9D9D9;
    }

    .contact-section p {
        font-size: 16px;
        color: #fff;
        font-weight: 400;
        margin-bottom: 12px;
        line-height: 16px;
    }

    footer .menu-row h6 {
        position: relative;
        display: inline-block;
        padding-bottom: 6px;
    }

    footer .menu-row h6::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        display: block;
        border-bottom: 2px solid #AE9751;
    }

    span.no-breakword {
        white-space: nowrap;
    }

    /* ===== FOOTER MEGA DISCOVER SECTION ===== */
    .footer-mega {
        display: none;
        background: #000;
        /* padding: 0px 60px; */
    }

    .footer-mega.active {
        display: block;
    }

    .footer-mega .top-res {
        font-size: 16px;
        font-weight: 600;
        font-style: italic;
        color: #AE9751;
        gap: 16px;
        padding: 20px 20px;
    }

    .cities-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        column-gap: 80px;
        margin-bottom: 30px;
        padding: 0 25px 0;
        gap: 8px;
    }

    .city-line {
        display: flex;
        gap: 22px;
        margin-bottom: 14px;
    }

    .city-projects a::after {
        content: " | ";
    }

    .city-projects a:last-child::after {
        content: "";
    }

    .bengaluru-line .city-projects a:nth-of-type(4) {
        display: inline-block;

    }

    .city-projects {
        font-size: 14px;
        font-weight: 400;
        line-height: 21px;
        color: #fff;
    }

    .city-label {
        min-width: 200px;
        font-size: 16px;
        font-weight: 600;
        white-space: nowrap;
        color: #fff;
        text-transform: uppercase;
    }

    .city-projects {
        font-size: 14px;
        font-weight: 400;
        line-height: 21px;
        color: #fff;
    }

    .city-projects a {
        color: #fff;

        text-decoration: none;
    }

    .apartments-grid {
        display: grid;
        line-height: 19px;
        padding: 0 20px 10px 20px;
        grid-template-columns: repeat(4, 1fr);
        /* gap: 30px; */
    }

    .apartment-item a {
        display: block;
        font-size: 14px;
        color: #fff;
        margin-bottom: 8px;
        text-decoration: none;
    }

    /*discover button*/
    .discover-more {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #000;
        position: relative;
        padding: 10px 0px 0px 0px;
    }

    .discover-line {
        width: 96%;
        height: 1px;
        background: #AE9751;
        margin-top: 0px;
        display: none;
    }

    /* show line when active */
    .trap-btn.active+.discover-line {
        display: block;
        margin-top: -1px;
    }

    .trap-btn {
        position: relative;
        padding: 11px 20px 11px;
        background: none;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 0 auto;
    }

    .trap-btn .label {
        position: relative;
        z-index: 4;
        font-size: 16px;
        color: #fff;
        background: #000;
    }

    .trap-btn .arrow {
        position: relative;
        z-index: 4;
        width: 8px;
        height: 8px;
        border-right: 2px solid #AE9751;
        border-bottom: 2px solid #AE9751;
        transform: rotate(45deg);
        transition: transform 0.3s ease;
    }

    .trap-btn::before,
    .trap-btn::after {
        content: "";
        position: absolute;
        inset: 0;
        clip-path: polygon(8% 0%, 92% 0%, 100% 100%, 0% 100%);
        pointer-events: none;
    }

    button#discoverToggle {
        margin-bottom: 20px !important;
    }

    .trap-btn::before {
        /*background: #AE9751;*/
        z-index: 1;
    }

    .trap-btn::after {
        inset: 1px;
        background: #000;
        z-index: 2;

    }

    .trap-btn .label::before,
    .trap-btn .label::after {
        content: "";
        position: absolute;
        bottom: -2px;
        /* height: 2px; */
        background: #AE9751;
        width: 0;
        transition: width 0.3s ease;
    }

    .trap-btn,
    .trap-btn:focus,
    .trap-btn:active,
    .trap-btn:focus-visible {
        outline: none !important;
        box-shadow: none !important;
    }

    /* .trap-btn .label::before { left: -46vw; }
.trap-btn .label::after  { right: -46vw; } */

    /* ACTIVE STATE */
    .trap-btn.active .arrow {
        transform: rotate(-133deg);
    }

    .trap-btn.active::before {
        opacity: 0;
    }

    .trap-btn.active .label::before,
    .trap-btn.active .label::after {
        width: 45vw;
    }

    .trap-btn.active::before,
    .trap-btn.active::after {
        opacity: 1;
        /* clip-path: polygon(8% 0%, 92% 0%, 90% 85%, 0% 85% ); */
        clip-path: polygon(8% 0%, 92% 0%, 100% 100%, 0% 100%);
    }


    @media (max-width: 767px) {
        .row.form-row-city .col-md-3 {
            flex: 0 0 50%;
            max-width: 36%;
        }

        .row.form-row-city .col-md-9 {
            flex: 0 0 58%;
            max-width: 58%;
        }

        .city-line {
            display: block !important;
        }

        span.city-projects {
            margin-top: 10px;
        }

        .city-projects a {
            display: inline;
            white-space: nowrap;
        }

        a.city-label {
            position: relative;
            display: block;
            width: 100%;
            padding-bottom: 5px;
        }

        footer ul {
            padding-top: 0px;
        }

        span.city-projects {
            margin-top: 10px;
        }

        footer {
            padding: 20px 0px 0px 0px;
        }

        .footer-mega {
            padding: 20px;
        }

        .footer-mega .top-res {
            margin-top: 20px !important;
        }

        .cities-grid,
        .apartments-grid {
            grid-template-columns: 2fr;
            gap: 0;
            padding: 0px;
        }

        .city-line {
            flex-direction: row;
            gap: 20px;
            margin-bottom: 25px;
        }

        .footer-mega .top-res {
            padding: 20px 0px !important;
        }

        .footer-mega.active {
            display: block !important;
            margin: -40px 0 0 0 !important;
            padding: 20px 20px 40px 20px;
        }

        .bengaluru-line .city-projects a:nth-of-type(4) {
            display: inline-block;
            margin-top: 0px !important;
        }

        .footer-mega .top-res {
            margin-top: 20px;
        }

        /* button */
        .mobile-cta {
            display: none;
        }

        .enquire-now-btn {
            display: none;
        }

        /* Enquire now button */

        .enquire-btn:focus,
        .enquire-btn:active {
            outline: none;
            box-shadow: none;
        }
    }

    /* Mobile view only */
    @media (min-width: 992px) {}

    /*For tablet view*/
    @media (max-width: 991px) {}

    @media (max-width: 767px) {

        .select-wrapper #direction-type,
        .select-wrapper #direction-type1 {
            text-transform: uppercase;
        }

        .discover-more {
            position: relative;
            margin-bottom: 0px;
        }
    }

    @media(max-width:767px) {

        ul.footer-list-menu_2,
        ul.footer-list-menu_3 {
            flex-direction: row;
        }

        footer p.cin-head,
        footer p.cin-head a {
            font-size: 14px;
        }

        .foot_col {
            padding-bottom: 20px;
        }

        .footer-wrapper .row.menu-row {
            padding-left: 20px;
            padding-right: 0px;
        }

        ul.footer-list-menu_2 li:after,
        ul.footer-list-menu_3 li:after {
            content: '|';
            padding-left: 5px;
            padding-right: 5px;
        }

        .footer-list-menu_2 li:last-child::after,
        .footer-list-menu_3 li:last-child::after {
            content: none;
        }
    }
</style>


