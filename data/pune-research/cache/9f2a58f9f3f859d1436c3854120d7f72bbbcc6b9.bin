	background-color: #2A3B6D;
}

.about-style-two.single-team-page .content-box .info li {
	color: #2A3B6D;
}


/** education-section **/


.education-section .inner-content .single-item .content-box span {
	color: #2A3B6D;
}



/*** 

====================================================================
						Faq-Page
====================================================================

***/


