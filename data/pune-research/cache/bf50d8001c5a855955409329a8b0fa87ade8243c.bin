<script>/*onload();*/</script>     
<script>
    AOS.init();
</script>
<script>
  $("#ftmobile").intlTelInput({
      utilsScript:"https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/11.0.4/js/utils.js",
      preferredCountries : ["in"],
    });
    
    $("#ftmobile").blur(function() {
    var getCode = $("#ftmobile").intlTelInput('getSelectedCountryData').dialCode;
    $("#countryCode").val(getCode);
    });

  /*Error message only for mobile number and for microsite page start here*/
  var telInput = $("#ftmobile"),
  errorMsg = $("#error-msg"),
  validMsg = $("#valid-msg");

  // initialise plugin
  telInput.intlTelInput({
    utilsScript: "../../build/js/utils.js"
  });

  var reset = function() {
    telInput.removeClass("error");
    errorMsg.addClass("hide");
    
  };

  // on blur: validate
  telInput.blur(function() {
    reset();
    if ($.trim(telInput.val())) {
      if (telInput.intlTelInput("isValidNumber")) {
           $("#ftmobile").removeClass("error");
      } else {
        $("#ftmobile").val('');
        $("#ftmobile").addClass("error");
      }
    }
  });

  telInput.on("keyup change", reset);
   /*Error message only for mobile number and for microsite page ends here*/
</script>

<script>
  $("#phone").intlTelInput({
      utilsScript:"https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/11.0.4/js/utils.js",
      preferredCountries : ["in"],
    });
    
    $("#phone").blur(function() {
    var getCode = $("#phone").intlTelInput('getSelectedCountryData').dialCode;
    $("#countryCode").val(getCode);
    });

/*Error message only for mobile number and for microsite page start here*/
  var phone = $("#phone"),
  errorMsg = $("#error-msg"),
  validMsg = $("#valid-msg");

  // initialise plugin
  phone.intlTelInput({
    utilsScript: "../../build/js/utils.js"
  });

  var reset = function() {
    phone.removeClass("error");
    errorMsg.addClass("hide");
    
  };

  // on blur: validate
  phone.blur(function() {
    reset();
    if ($.trim(phone.val())) {
      if (phone.intlTelInput("isValidNumber")) {
           $("#phone").removeClass("error");
      } else {
        $("#phone").val('');
        $("#phone").addClass("error");
      }
    }
  });

  phone.on("keyup change", reset);
   /*Error message only for mobile number and for microsite page ends here*/
</script>

<script>
/*Feedback js*/

   $("#feedback-tab").on('click',function() {
      $("#feedback-form").toggle("slide");
   });

  
   $(document).keyup(function(e) {
       if(e.which == 27){
           $("#showFloorPlanModal").removeClass("in");
           $("#feedback-form").hide("slide");
          
          
           if($("body").hasClass("show-menu")){
              $('body').removeClass('show-menu');
           }

       }
   });
   
        </script>
<script type="text/javascript">
$(window).scroll(function() {
  if ($(document).scrollTop() > 350) {
    $('.nav').removeClass('transparent');
  } else {
    $('.nav').addClass('transparent');
  }
});


function showProjects(divId,currentLinkId) {
  $("#firstMenu ."+'project-active-resi').removeClass("active");
  $("#"+currentLinkId).addClass("active");

  if(divId=='ongoingProjectsSecResi'){

    $("#completedProjectsSecResi").hide();
       $("#ongoingProjectsSecResi").show();
       $("#allResidentialProject").hide();
       
  }else if(divId=='completedProjectsSecResi'){
      $("#completedProjectsSecResi").show();
       $("#ongoingProjectsSecResi").hide();
       $("#allResidentialProject").hide();

  }else{
     $("#allResidentialProject").show();
       $("#ongoingProjectsSecResi").hide();
       $("#completedProjectsSecResi").hide();
  }
}


function showCommercialProjects(divId,currentLinkId) {
  $("#secondMenu ."+'project-active-resi').removeClass("active");
  $("#"+currentLinkId).addClass("active");

  if(divId=='ongoingProjectsSecComm'){
   
    $("#completedProDivComm").hide();
       $("#ongoingProjectsSecComm").show();
       $("#allCommercialProject").hide();
       
  }else if(divId=='completedProDivComm'){
      $("#completedProDivComm").show();
       $("#ongoingProjectsSecComm").hide();
        $("#allCommercialProject").hide();

  }else{
     $("#allCommercialProject").show();
     $("#completedProDivComm").hide();
       $("#ongoingProjectsSecComm").hide();
  }
}
</script>

<script type="text/javascript">
  $(function(){
    $('#gear').click(function(){
       $('#phn-dropdown').slideToggle(); 
    });
});
</script>
