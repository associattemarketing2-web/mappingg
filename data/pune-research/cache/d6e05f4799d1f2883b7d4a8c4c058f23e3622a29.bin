   <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": "What’s the booking process and what documents are required for the same?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "We have a simple booking process that can be broken down into three steps:
You have to pay 10% of the total cost
You have to carry a photo ID, a residential proof and a cost sheet signed by the buyers
The registration of Agreement for Sale will start once the booking process is done"
    }
  },{
    "@type": "Question",
    "name": "What are the documents that will be necessary to book a flat?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "The following documents will be required:
Signed application form
Signed payment plan
Signed unit plan and floor plan
Self-attested PAN card/Form 60
Aadhar Card
Address Proof"
    }
  },{
    "@type": "Question",
    "name": "Can we combine two units into one unit?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes, it can be done. The registration of the two units though will be done separately."
    }
  },{
    "@type": "Question",
    "name": "Can we resell or transfer the property?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "The transfer/resale of property will be possible only after the OC has been received. In case you want to sell it before that, the booking shall be cancelled and transfer charges will be levied."
    }
  },{
    "@type": "Question",
    "name": "Are internal modifications allowed inside the apartments?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Internal modifications are not permitted in the apartments."
    }
  },{
    "@type": "Question",
    "name": "Is it possible to do the booking online?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes, it’s possible to do the booking online. You can send the booking form along with the relevant documents through email and transfer the requisite amount in our designated RERA account."
    }
  },{
    "@type": "Question",
    "name": "How can one pay the property tax?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Property tax can be paid online on: portal.mcgm.gov.in."
    }
  },{
    "@type": "Question",
    "name": "What happens if the payment gets delayed?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Interest will be levied at the specified rate as per agreement."
    }
  }]
}
</script><!-- Footer Js End Here -->
