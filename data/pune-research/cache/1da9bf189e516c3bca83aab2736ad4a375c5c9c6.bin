    $(document).on('change', '#project_type_id, #project_type_id2, #our_project_type', function() {
        let selectedProjectType = $(this).val();
        let storedParams = JSON.parse(localStorage.getItem('searchParams')) || {};
        if (selectedProjectType) {
            storedParams.project_type_id = selectedProjectType;
        } else {
            delete storedParams.project_type_id;
        }

        localStorage.setItem('searchParams', JSON.stringify(storedParams));
        getallconfiguration();
    });

    $(document).on('change', '#location_id, #location_id2, #our_location', function() {
        let selectedLocation = $(this).val();
        let storedParams = JSON.parse(localStorage.getItem('searchParams')) || {};

        if (selectedLocation) {
            storedParams.location_name = selectedLocation;
        } else {
            delete storedParams.location_name;
        }

        localStorage.setItem('searchParams', JSON.stringify(storedParams));
        getallconfiguration();
    });



    function getProjectLocation(selectedTypeId) {
        const storedParams = JSON.parse(localStorage.getItem('searchParams')) || {};

        $.ajax({
            type: "POST",
            url: apipath + "/getprojectlocation",
            dataType: 'json',
            data: {
                "project_type_id": selectedTypeId
            },
            headers: {
                'Authorization': 'Bearer ' + API_TOKEN
            },
            success: function(result) {
                if (result.status == 200) {

                    let decoded = JSON.parse(atob(result.data));

                    const defaultOption = '<option value="" selected >Select</option>';

                    // Clear and reset all dropdowns synchronously
                    $("#location_id").html(defaultOption);
                    $("#location_id2").html(defaultOption);
                    $("#our_location").html(defaultOption);

                    // Populate locations into every filter in the same loop
                    $.each(decoded.locations, function(i, item) {
                        const option = `<option value="${item}">${item}</option>`;
                        $("#location_id").append(option);
                        $("#location_id2").append(option);
                        $("#our_location").append(option);
                    });

                    // ✅ Apply stored location/config after data loaded
                    const storedParams = JSON.parse(localStorage.getItem('searchParams'));
                    if (storedParams?.location_name) {
                        $('#location_id, #location_id2, #our_location')
                            .val(storedParams.location_name)
                            .trigger('change');
                    }

                    if (storedParams?.configuration_type_id) {
                        $('.our_project_new').val(storedParams.configuration_type_id).trigger('change');
                        // toggleSearchFields();
                    }

                    if (storedParams?.raw_min_size !== undefined) $('#oursearchminrang').val(storedParams.raw_min_size);
                    if (storedParams?.raw_max_size !== undefined) $('#oursearchmaxrang').val(storedParams.raw_max_size);

                    if (
                        storedParams?.raw_min_size ||
                        storedParams?.raw_max_size

                    ) {
                        initializeSliders();
                    }


                }
            }
        });
    }


    function initializeSliders() {
        $(".form-group.custom-range-slider").each(function() {
            const $wrapper = $(this);
            const $range = $wrapper.find(".properties-range-slider");

            const min = +$range.data("min");
            const max = +$range.data("max");

            // 👇 Detect based on slider range (budget vs size)
            let $inputFrom, $inputTo, $labelFrom, $labelTo;

            if (min >= 1000000) {
                // Budget range
                $inputFrom = $("#oursearchminprice");
                $inputTo = $("#oursearchmaxprice");
                $labelFrom = $(".header_from_search1");
                $labelTo = $(".header_to_search1");
            } else {
                // Size range
                $inputFrom = $("#oursearchminrang");
                $inputTo = $("#oursearchmaxrang");
                $labelFrom = null;
                $labelTo = null;
            }

            const storedFrom = parseInt($inputFrom.val()) || min;
            const storedTo = parseInt($inputTo.val()) || max;

            function formatCurrency(val) {
                if (val >= 10000000) {
                    return (val / 10000000).toFixed(val % 10000000 === 0 ? 0 : 1) + ' Cr';
                } else {
                    return (val / 100000).toFixed(val % 100000 === 0 ? 0 : 1) + ' L';
                }
            }

            function updateLabels(fromVal, toVal) {
                if ($labelFrom && $labelTo) {
                    $labelFrom.text(formatCurrency(fromVal));
                    $labelTo.text(formatCurrency(toVal));
                }
            }

            // Step 1: Init slider
            $range.ionRangeSlider({
                skin: "round",
                type: "double",
                min: min,
                max: max,
                from: min,
                to: max,
                grid: false,
                onStart: function(data) {
                    updateLabels(data.from, data.to);
                },
                onChange: function(data) {
                    updateLabels(data.from, data.to);
                    $inputFrom.val(data.from);
                    $inputTo.val(data.to);
                }
            });

            const slider = $range.data("ionRangeSlider");

            // Step 2: Update to stored values
            slider.update({
                from: storedFrom,
                to: storedTo
            });

            updateLabels(storedFrom, storedTo);

            // Manual input syncing
            $inputFrom.off("input").on("input", function() {
                let val = +$(this).val();
                if (val < min) val = min;
                if (val > +$inputTo.val()) val = +$inputTo.val();
                slider.update({
                    from: val
                });
                updateLabels(val, +$inputTo.val());
            });

            $inputTo.off("input").on("input", function() {
                let val = +$(this).val();
                if (val > max) val = max;
                if (val < +$inputFrom.val()) val = +$inputFrom.val();
                slider.update({
                    to: val
                });
                updateLabels(+$inputFrom.val(), val);
            });
        });

        var range_sliders = $('.common-range-slider');
        range_sliders.on('input', function() {
            var str1 = $('.common-range-slider').siblings(".irs").find(".irs").find(".irs-from").html().replace(/\s/g, '');
            var str2 = $('.common-range-slider').siblings(".irs").find(".irs").find(".irs-to").html().replace(/\s/g, '');
            var fromValue = parseInt(str1);
            var toValue = parseInt(str2);

            $('.header_from_search1').text(formatIndianNumber(fromValue));
            $('.header_to_search1').text(formatIndianNumber(toValue));

        });
    }


    function formatBudget(val) {
        val = parseInt(val);
        if (val >= 10000000) {
            return (val / 10000000).toFixed(2).replace(/\.00$/, '') + ' Cr';
        } else {
            return (val / 100000).toFixed(2).replace(/\.00$/, '') + ' L';
        }
    }




    $('.searchproject').on('click', function(e) {
        e.preventDefault();

        let projecttypeid = $('#project_type_id').val() || $('#project_type_id2').val();
        let locationName = $('#location_id').val() || $('#location_id2').val();
        let configuration = $('#configuration_id').val() || $('#configuration_id2').val();
        let configuration2 = Array.isArray(configuration) ?
            configuration :
            configuration ? [configuration] : [];
        // let configurationText = $('#configuration_id option:selected').text().trim().toLowerCase() || $('#configuration_id2 option:selected').text().trim().toLowerCase();
        let minCarpet = parseInt($('#searchminrang').val());
        let maxCarpet = parseInt($('#searchmaxrang').val());

        const defaultMin = 650;
        const defaultMax = 2500;

        // 🟡 If user actually selected a carpet size (i.e. changed defaults)
        const userSelectedCarpetSize = (minCarpet !== defaultMin || maxCarpet !== defaultMax);

        if (userSelectedCarpetSize) {
            projecttypeid = "1"; // ✅ Override with 1
        }

        const configIdBlacklist = ["16", "17", "18"];
        const specialLocations = ['KP Annexe', 'Pimpari', 'Baner'];

        const shouldRemoveSizeBudget =
            specialLocations.includes(locationName) ||
            projecttypeid === "3" ||
            configuration2.some(id => configIdBlacklist.includes(id));

        let queryObj = {
            project_type_id: projecttypeid || null,
            location_name: locationName || null
        };

        if (configuration2.length > 0) {
            queryObj.configuration_type_id = configuration2;
        }

        if (!shouldRemoveSizeBudget) {
            queryObj.raw_min_size = minCarpet || null;
            queryObj.raw_max_size = maxCarpet || null;
            // queryObj.raw_min_budget = minBudgetRaw || null;
            // queryObj.raw_max_budget = maxBudgetRaw || null;
        }

        // Store in localStorage
        localStorage.setItem('searchParams', JSON.stringify(queryObj));

        // Redirect
        let url = "https://iamkohinoor.com/our-projects";
        window.location.href = url;
    });

    $(document).on('click', '.searchprojecthome', function(e) {
        e.preventDefault();

        // Collect values from home filters
        let projecttypeid = $('#project_type_id2').val() || $('#project_type_id').val();
        let locationName = $('#location_id2').val() || $('#location_id').val();
        let configurationVal = $('#configuration_id2').val() || $('#configuration_id').val();
        let configuration1 = Array.isArray(configurationVal) ?
            configurationVal :
            configurationVal ? [configurationVal] : [];

        let minCarpet = parseInt($('#searchminranghome').val());
        let maxCarpet = parseInt($('#searchmaxranghome').val());

        const defaultMin = 650;
        const defaultMax = 2500;

        // 🟡 If user actually selected a carpet size (i.e. changed defaults)
        const userSelectedCarpetSize = (minCarpet !== defaultMin || maxCarpet !== defaultMax);

        if (userSelectedCarpetSize) {
            projecttypeid = "1"; // ✅ Override with 1
        }

        const configIdBlacklist = ["16", "17", "18"];
        const specialLocations = ['KP Annexe', 'Pimpari', 'Baner'];

        const shouldRemoveSizeBudget =
            specialLocations.includes(locationName) ||
            projecttypeid === "3" ||
            configuration1.some(id => configIdBlacklist.includes(id));

        let queryObj = {
            project_type_id: projecttypeid || null,
            location_name: locationName || null
        };

        if (configuration1.length > 0) {
            queryObj.configuration_type_id = configuration1;
        }

        if (!shouldRemoveSizeBudget) {
            queryObj.raw_min_size = minCarpet || null;
            queryObj.raw_max_size = maxCarpet || null;
        }

        // Store in localStorage
        localStorage.setItem('searchParams', JSON.stringify(queryObj));

        // Redirect
        let url = "https://iamkohinoor.com/our-projects";
        window.location.href = url;
    });
    // Loader
    function showLoader() {
        $(".loader-wrapper").removeClass("none");
        $("html").addClass("loader-processing");
    }

    function hideLoader() {
        $(".loader-wrapper").addClass("none");
        $("html").removeClass("loader-processing");
    }
</script>

<script>
    // Reusable, null-safe menu search filter.
    function initMenuSearch(inputId, listId) {
        const input = document.getElementById(inputId);
        const list = document.getElementById(listId);

        // Bail out gracefully if the markup isn't present on this page.
        if (!input || !list) {
            return;
        }

        input.addEventListener('input', function() {
            const searchTerm = this.value.trim().toLowerCase();

            // Show list only while there is a search term.
            list.style.display = searchTerm ? 'block' : 'none';

            // Filter list items and track whether anything matched.
            const items = list.querySelectorAll('li');
            let anyMatch = false;
            items.forEach(item => {
                const text = item.textContent.toLowerCase();
                const match = text.includes(searchTerm);
                item.style.display = match ? 'block' : 'none';
                if (match) {
                    anyMatch = true;
                }
            });

            // Optional "no results" row handling.
            let emptyRow = list.querySelector('.menu-search-empty');
            if (searchTerm && !anyMatch) {
                if (!emptyRow) {
                    emptyRow = document.createElement('li');
                    emptyRow.className = 'menu-search-empty';
                    emptyRow.textContent = 'No results found';
                    list.appendChild(emptyRow);
                }
                emptyRow.style.display = 'block';
            } else if (emptyRow) {
                emptyRow.style.display = 'none';
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        initMenuSearch('searchProjects', 'projectList');
        initMenuSearch('searchBlogs', 'blogList');
    });
</script>
<script>
    function formatIndianNumber(number) {
        if (number >= 10000000) {
            return (number / 10000000).toFixed(2) + ' Cr';
        } else if (number >= 100000) {
            return (number / 100000).toFixed(2) + ' L';
        } else {
            return number.toString();
        }
    }


