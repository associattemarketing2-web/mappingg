<div class="code-embed">
  <div class="ai-homepage-diagram-ctn">
    <!-- diagram top start -->
    <div class="diagram-top-ctn">
      <div class="diagram-top-column blue">
        <h3 class="diagram-top-column-heading">
          Recover
        </h3>
        <p class="diagram-top-column-desc">
          Reverse autonomous actions and restore to a trusted state.
        </p>
      </div>
      <div class="diagram-top-column purple">
        <h3 class="diagram-top-column-heading">
          Govern
        </h3>
        <p class="diagram-top-column-desc">
          Ensure AI systems operate on trusted, governed, and recoverable data.
        </p>
      </div>
      <div class="diagram-top-column orange">
        <h3 class="diagram-top-column-heading">
          Defend
        </h3>
        <p class="diagram-top-column-desc">
          Protect backup environments from AI-driven threats.
        </p>
      </div>
      <div class="diagram-top-column pink">
        <h3 class="diagram-top-column-heading">
          Accelerate
        </h3>
        <p class="diagram-top-column-desc">
          Enable trusted AI across the ecosystems customers choose.
        </p>
      </div>
