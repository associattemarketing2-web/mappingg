        }

        // Add to cart: pixelId 19309 + clmbtrck iframe pixel.
        // Fires once per completed add-to-cart via the theme's own
        // eurus:cart:items-changed / eurus:cart:add-as-bundle events (dispatched
        // exactly once per add-to-cart action in product-cart.js and friends),
        // instead of intercepting /cart/add network calls. Intercepting network
        // calls double-fired whenever an upsell add-on (gift wrap, engraving,
        // insurance, linked product) triggered its own extra /cart/add.js request.
        function fireAddToCartPixel() {
          fireAdePixel('19309');
          if (window.oaiq) {
