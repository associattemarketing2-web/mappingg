<script type="text/javascript">
/*NORMAL-JS-btJX-OQRz-PepZ-sGpA */

    $(document).ready(function(){
        $('#btJX-OQRz-PepZ-sGpA .Img-Title-Intro-UI-1-v1 .image').each(function(){
            var src = $(this).find('img').attr('src');
			
			//Remove Image Optimization
            var optimize = $('#btJX-OQRz-PepZ-sGpA').attr('data-optimize');
            if(optimize == 'false'){
                src     = src.replace('Web_','');
            }
			
            $(this).css('background-image','url("'+src+'")');
            $(this).css('background-repeat','no-repeat');
            $(this).css('background-size','cover');
        });

        //Load More
        if($('#btJX-OQRz-PepZ-sGpA').attr('data-load') == 'true'){
            var count1 = $('#btJX-OQRz-PepZ-sGpA').attr('data-count1');
            var count2 = $('#btJX-OQRz-PepZ-sGpA').attr('data-count2');
            var count3 = 0;

            //Check if items are available to load
            $('#btJX-OQRz-PepZ-sGpA .Img-Title-Intro-UI-1-v1').each(function(){ count3++; });
            if(count3 <= count1){
                $('#btJX-OQRz-PepZ-sGpA .Img-Title-Intro-UI-1-v1_load_more').hide();
            }else{
                //Hide items
                $('#btJX-OQRz-PepZ-sGpA .Img-Title-Intro-UI-1-v1').each(function(count){ 
                     if(count >= count1){
                        $(this).hide();
                     }
                });

                //Load more items on click
                $('#btJX-OQRz-PepZ-sGpA .Img-Title-Intro-UI-1-v1_load_more').click(function(e){
                    e.preventDefault();
                    $(this).addClass('Img-Title-Intro-UI-1-v1_load_more_active').text('');

                    setTimeout(function(){
                        for (var i = 1; i <= count2; i++) {
                            $('#btJX-OQRz-PepZ-sGpA .Img-Title-Intro-UI-1-v1').each(function(count){ 
                                 if($(this).css('display') == 'none'){
                                    $(this).fadeIn();
                                    return false;
                                 }
                            });
                        }

                        //check if any hidden item left
                        var hidden_item = false;
                        $('#btJX-OQRz-PepZ-sGpA .Img-Title-Intro-UI-1-v1').each(function(){ 
                             if($(this).css('display') == 'none'){
                                hidden_item = true;
                                return false;
                             }
                        });
                        if(hidden_item == false){
                            $('#btJX-OQRz-PepZ-sGpA .Img-Title-Intro-UI-1-v1_load_more').hide();
                        }else{
                            $('#btJX-OQRz-PepZ-sGpA .Img-Title-Intro-UI-1-v1_load_more').removeClass('Img-Title-Intro-UI-1-v1_load_more_active').text('load more');
                        }
                    },1000);
                });
            }
        }
    });

</script>
