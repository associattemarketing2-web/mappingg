			$('#project').html('<div class="row"><div class="col-md-12"><div class="form-group"><label for="project" class="control-label">Project*</label><select class="form-control" name="project" class="form-control" placeholder="" data-validation="required"><option selected="selected" disabled="disabled"></option><option value="Trump Towers Delhi NCR">Trump Towers Delhi NCR</option><option value="Trump Tower Kolkata">Trump Tower Kolkata</option><option value="Espana Bangalore">Espana Bangalore</option><option value="NIBM Pune">NIBM Pune</option><option value="City Center 150">City Center 150</option> </select></div></div></div>');
		}else{
			$('#project').html('');
		}
	}); 
});

</script>


  
 