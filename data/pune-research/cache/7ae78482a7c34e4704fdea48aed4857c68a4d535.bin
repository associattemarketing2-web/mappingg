 class="amount-cell">20,000</td><td class="amount-cell">2,40,000</td><td>-</td><td>-</td><td class="amount-cell">27,54,121</td></tr><tr class="investing"><td class="year-cell">10</td><td>12</td><td class="amount-cell">20,000</td><td class="amount-cell">2,40,000</td><td>-</td><td>-</td><td class="amount-cell">31,87,435</td></tr><tr class="compounding"><td class="year-cell">11</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td class="amount-cell">34,02,473</td></tr><tr class="compounding"><td class="year-cell">12</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td class="amount-cell">36,33,238</td></tr><tr class="compounding"><td class="year-cell">13</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td class="amount-cell">38,80,332</td></tr><tr class="compounding"><td class="year-cell">14</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td class="amount-cell">41,44,644</td></tr><tr class="compounding"><td class="year-cell">15</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td class="amount-cell">44,27,376</td></tr><tr class="monthly-payout"><td class="year-cell">16</td><td>-</td><td>-</td><td>-</td><td class="amount-cell">22,153</td><td class="amount-cell">2,65,602</td><td class="amount-cell">44,56,661</td></tr><tr class="monthly-payout"><td class="year-cell">17</td><td>-</td><td>-</td><td>-</td><td class="amount-cell">22,280</td><td class="amount-cell">2,67,360</td><td class="amount-cell">44,87,026</td></tr><tr class="monthly-payout"><td class="year-cell">18</td><td>-</td><td>-</td><td>-</td><td class="amount-cell">22,431</td><td class="amount-cell">2,69,183</td><td class="amount-cell">45,17,909</td></tr><tr class="monthly-payout"><td class="year-cell">19</td><td>-</td><td>-</td><td>-</td><td class="amount-cell">22,586</td><td class="amount-cell">2,71,037</td><td class="amount-cell">45,49,043</td></tr><tr class="monthly-payout"><td class="year-cell">20</td><td>-</td><td>-</td><td>-</td><td class="amount-cell">22,742</td><td class="amoun