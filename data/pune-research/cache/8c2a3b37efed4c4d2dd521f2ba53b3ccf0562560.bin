</div></div></div><div class="wpb_column vc_column_container vc_col-sm-3 vc_col-has-fill"><div class="vc_column-inner vc_custom_1740130082898"><div class="wpb_wrapper "  >
	<!-- Element: OT Our Team 2 --> 	 
    <!-- team member -->
