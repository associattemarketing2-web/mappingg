<script>
    $(document).ready(function() {

        var str = location.href.toLowerCase().split('/').pop().trim();
        console.log(str);
        $("#mainmenu li a").each(function() {
            if (this.href.toLowerCase().split('/').pop().trim() == str) {
                $("#mainmenu li.active a").parent().removeClass('active');
                $(this).parent().addClass('active');
            }
        });

        var str2 = location.href.toLowerCase().split('/').pop().trim();

        $("#mainmenu .dropdown a").each(function() {
            if (this.href.toLowerCase().split('/').pop().trim() == str2) {
                $("#mainmenu li.active a").parent().parent().removeClass('active');
                $(this).parent().parent().addClass('active');
            }

            var str1 = location.href.toLowerCase().split('/').pop().trim();

            $("#mainmenu .dropdown-menu li a").each(function() {
                if (this.href.toLowerCase().split('/').pop().trim() == str1) {
                    $(".dropdown-menu li.active a").parent().parent().parent().removeClass('active');
                    $(this).parent().parent().parent().addClass('active');
                }
            });


        });

        var str3 = location.href.toLowerCase().split('/').pop().trim();

        $(".dropdown-menu li a").each(function() {
            if (this.href.toLowerCase().split('/').pop().trim() == str3) {
                $(".dropdown-menu li.active a").parent().parent().parent().parent().parent().removeClass('active');
                $(this).parent().parent().parent().parent().parent().addClass('active');
            }
        });

    });
</script>

