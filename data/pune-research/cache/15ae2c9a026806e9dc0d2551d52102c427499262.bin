<script>
    $("#subscribe").click(function() {
        var phone_reg = $("#phone_reg").val();
        // alert(phone_reg);
        if (!phone_reg) {
            $("#error2").html("<strong>Please enter Phone No.</strong>");
            return false;
        }
        var mob = /^[0-9]{10}$/;
        if (mob.test(phone_reg) == false) {
            alert('Please check number');
            return false;
        }
        $("#subscribe").html('<i class="fa fa-spinner fa-pulse fa-fw"></i> Loading..');

        $.ajax({
            type: "POST",
            url: "https://naiknavare.com/subscribe",
            data: {
                'phone_reg': phone_reg
            },
            success: function(response) {
                console.log(response);
                if (response.status == "1") {
                    window.location.href = 'https://naiknavare.com/thanku_page';
                    // $('#result').modal('show');
                    // $('#result').css('z-index','99999999999');
                    // $('#result .modal-title').text("Success");
                    // $('#result .modal-body').text("Your Contact Has Been Saved..!!!");
                    // $("#error2").html("");
                    $(".subscribe").trigger("reset");
                    $("#subscribe").html('Go');


                }
                if (response.status == "false") {
                    $('#result').modal('show');
                    $('#result').css('z-index', '99999999999');
                    $('#result .modal-title').text("Oops..!");
                    $('#result .modal-body').text("Please Check Your Mobile Number.");
                    $("#subscribe").html('Go');
                }
            }
        });
    });
</script>




<script>
    $("#submit").click(function() {



        var project_name = $("#project_name").val();
        var project_code = $("#project_code").val();
        var name = $("#name").val();
        var email = $("#email").val();
        var phone = $("#phone").val();
        var message = $("#message").val();
        //var g_recaptcha=$("#g-recaptcha-response").val();
        let g_recaptcha = grecaptcha.getResponse(project_r);
        var utm_source = $("#utm_source").val();
        var utm_camp = $("#utm_campaign_name").val();
        var utm_id = $("#utm_campaign_id").val();
        var utm_city = $("#utm_campaign_city").val();

        //alert(g_recaptcha);


        if (!name) {
            $("#error").html("Please enter name");
            return false;
        }
        if (/[^a-zA-Z \-]/.test(name)) {
            $('#error').html("Enter only alphabets in name.");
            return false;
        }
        if (!email) {
            $("#error").html("Please enter email");
            return false;
        }
        var emailReg = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$/;
        if (emailReg.test(email) == false) {
            $("#error").html("Please enter valid email address");
            return false;
        }
        if (!phone) {
            $("#error").html("Please enter phone");
            return false;
        }
        var mob = /^[0-9]{10}$/;
        if (mob.test(phone) == false) {
            $("#error").html("Please enter 10 digit number");
            return false;
        }
        if (!message) {
            $("#error").html("Please enter message");
            return false;
        }



        $.ajax({
            url: 'https://naiknavare.com/check_unique',
            type: 'POST',
            data: {
                email: email,
                mobile: phone
            },
            dataType: 'json',
            success: function(response) {
                if (response.isEmailUnique && response.isMobileUnique) {

                    $("#submit").html('Submitting...');
                    $('#submit').prop('disabled', true);

                    $.ajax({
                        type: "POST",
                        url: "https://naiknavare.com/project_enquiry",
                        data: {
                            'project_name': project_name,
                            'project_code': project_code,
                            'name': name,
                            'email': email,
                            'phone': phone,
                            'message': message,
                            'utm_source': utm_source,
                            'utm_campaign_name': utm_camp,
                            'utm_campaign_id': utm_id,
                            'g_recaptcha': g_recaptcha,
                            'utm_campaign_city': utm_city
                        },
                        success: function(response) {
                            $("#submit").html('Submit');
                            $('#submit').prop('disabled', false);
                            console.log(response);
                            //alert("Your Enquiry has been sent successfully ..!");
                            //alert(response);
                            if (response.status == true) {
                                // $('#result').modal('show');
                                // $('#result').css('z-index','99999999999');
                                // $('#result .modal-title').text("Success");
                                // $('#result .modal-body').text("Your Enquiry Has Been Saved..!!!");
                                // $("#error").html("");
                                window.location.replace('https://naiknavare.com/thanku_page?utm_source=' + utm_source + '&utm_campaign_name=' + utm_camp + '&utm_campaign_id=' + utm_id + '&utm_campaign_city=' + utm_city + '&utm_project=' + project_name);
                                $(".subscribe").trigger("reset");
                                $("#submit").html('Submit');
                            } else if (response.status == "false") {
                                $('#result').modal('show');
                                $('#result').css('z-index', '99999999999');
                                $('#result .modal-title').text("Oops..!");
                                $('#result .modal-body').text("Something went wrong..! Please try again.");
                                $("#submit").html('Submit');
                            } else {
                                alert(response);
                            }
                            $("#enquiry").trigger("reset");
                        }
                    });



                } else {
                    alert('Email or mobile number already exists!');
                    return false;
                }
            }
        });







    });
</script>

