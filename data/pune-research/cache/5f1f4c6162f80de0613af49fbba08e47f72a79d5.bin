				document.addEventListener("DOMContentLoaded", function () {
					const popupOverlay = document.querySelector(".from5cx-popup-overlay");
					const formcxDetails = document.querySelector(".from5cx-details");
					const closeIcon = document.querySelector(".from5cx-close-icon");

					formcxDetails.addEventListener("click", function (event) {
						event.preventDefault();
						popupOverlay.style.display = "flex";
					});

					closeIcon.addEventListener("click", function (event) {
						event.preventDefault();
						popupOverlay.style.display = "none";
					});
				});

			</script>
