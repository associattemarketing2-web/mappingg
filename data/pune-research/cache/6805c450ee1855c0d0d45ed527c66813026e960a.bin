s.about-what-we-do-section-3625-2\",{\"className\":\"contents\",\"children\":[\"$\",\"$L2a\",null,{\"data\":{\"title\":\"\",\"headingPrefix\":\"Renewable energy, \",\"headingHighlight\":\"integrated for \",\"headlineSuffix\":\"real-world needs\",\"leadLine\":\"From R\u0026D and manufacturing to project execution, lifecycle care and long-term partnerships, we bring the capabilities needed to make renewable energy work across changing business and energy realities.\",\"fadedLines\":[],\"stats\":[{\"value\":\"22,000+\",\"label\":\"MW Renewable energy assets worldwide\"},{\"value\":\"8,500+\",\"label\":\"Good energy people driving the energy transition\"},{\"value\":\"Global Top 10\",\"label\":\"Among the World's Most Sustainable Organisations\"},{\"value\":\"1,900+\",\"label\":\"Clients served globally\"}],\"backgroundImage\":\"\",\"backgroundVideoSrc\":\"https://www.suzlon.com/uploads/renewable_energy_1_ead5d113fd.mp4?v=2026-09-29T16%3A23%3A41.794Z\",\"fallbackBackgroundColor\":\"#3E4F5B\"}}]}],[\"$\",\"div\",\"sections.about-where-we-are-section-3625-3\",{\"className\":\"contents\",\"children\":[\"$\",\"$L2b\",null,{\"data\":{\"title\":\"Good energies,\",\"titleHighlight\":\"wherever you are\",\"subtitle\":\"Our renewable energy assets operate across 17 countries in six continents, supported by in-house global R\u0026D centres, end-to-end manufacturing strength, and service capabilities across markets.\",\"continents\":[{\"id\":\"asia\",\"label\":\"ASIA\",\"title\":\"ASIA\",\"description\":\"16,459.8 MW of renewable energy assets installed across Asia in India, China, and Sri Lanka\",\"key\":\"Asia\",\"marker\":[78.96,22.59],\"active\":true,\"countries\":[{\"id\":\"india\",\"label\":\"India\",\"title\":\"India\",\"description\":\"15,500 MW installed across all nine windy states of India\\n\\nOur Manufacturing Footprint\\n\\n1. Nacelle and Hub\\n- Daman\\n- Puducherry\\n\\n2. Rotor Blades\\n- Anantpur, India\\n- Badnawar, India\\n- Bhuj, India\\n- Dhule, India\\n- Jaisalmer, India\\n- Puducherry, India\\n\\n3. Tower\\n- Gandhidham, India\\n\\n4. Nacelle Cover\\n- Daman, India\\n\\n5. Electrical\\n- Daman, India\\n- Vadodara, India\",\"knowMoreHref\":\"$undefined\"},{\"id\":\"china\",\"label\":\"China\",\"title\":\"China\",\"description\":\"928.8 MW installed in China\",\"knowMoreHref\":\"$undefined\"},{\"id\":\"sri-lanka\",\"label\":\"Sri Lanka\",\"title\":\"Sri Lanka\",\"description\":\"31 MW installed in Sri Lanka\",\"knowMoreHref\":\"$undefined\"}]},{\"id\":\"europe\",\"label\":\"EUROPE\",\"title\":\"EUROPE\",\"description\":\"513.6 MW of renewable energy assets installed across Europe in Bulgaria, Germany, Portugal, Romania, Spain, Sweden, and Turkey, with a trusted 20+ years of presence\",\"key\":\"Europe\",\"marker\":[10,50],\"countries\":[{\"id\":\"bulgaria\",\"label\":\"Bulgaria\",\"title\":\"Bulgaria\",\"description\":\"12.6 MW installed in Bulgaria\",\"knowMoreHref\":\"$undefined\"},{\"id\":\"germany\",\"label\":\"Germany\",\"title\":\"Germany\",\"description\":\"2.1 MW installed in Germany\",\"knowMoreHref\":\"$undefined\"},{\"id\":\"portugal\",\"label\":\"Portugal\",\"title\":\"Portugal\",\"description\":\"105 MW installed in Portugal\",\"knowMoreHref\":\"$undefined\"},{\"id\":\"romania\",\"label\":\"Romania\",\"title\":\"Romania\",\"description\":\"44.1 MW installed in Romania\",\"knowMoreHref\":\"$undefined\"},{\"id\":\"spain\",\"label\":\"Spain\",\"title\":\"Spain\",\"description\":\"236.4 MW installed in Spain\",\"knowMoreHref\":\"$undefined\"},{\"id\":\"sweden\",\"label\":\"Sweden\",\"title\":\"Sweden\",\"description\":\"4.2 MW installed in Sweden\",\"knowMoreHref\":\"$undefined\"},{\"id\":\"turkey\",\"label\":\"Turkey\",\"title\":\"Turkey\",\"description\":\"109.2 MW installed in Turkey\",\"knowMoreHref\":\"$undefined\"}]},{\"id\":\"africa\",\"label\":\"AFRICA\",\"title\":\"AFRICA\",\"description\":\"138.6 MW of renewable energy assets installed in Africa\",\"key\":\"Africa\",\"marker\":[22,5],\"countries\":[{\