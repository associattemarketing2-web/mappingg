        .popup-form-wrp {
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            display: none
        }

        .popup-form-wrp.active {
            display: flex
        }

        .popup-form-wrp>div {
            width: 336px;
            background: #fff;
            position: relative;
            overflow: hidden;
            border-radius: 14px
        }

        .popup-form-wrp .heading {
            background: #3b95d1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            padding: 10px;
            border-bottom: 4px solid #3b95d1
        }

        .popup-form-wrp .heading b {
            font-weight: 500;
            margin-left: auto
        }

        .popup-form-wrp .heading span {
            line-height: normal;
            margin-left: auto;
            cursor: pointer
        }

        .popup-form-wrp form {
            padding: 32px
        }

        .popup-form-wrp .input-wrp {
            margin-bottom: 14px
        }

        .popup-form-wrp .input-wrp:last-child {
            margin-bottom: 0;
            margin-top: 32px
        }

        .popup-form-wrp .btn {
            font-size: 15px;
            font-weight: 500
        }

        .popup-form-wrp.popup-image-wrp>div {
            width: 55%;
            overflow: visible;
            margin-top: 2%
        }

        .popup-form-wrp.popup-image-wrp .heading {
            width: 40px;
            position: absolute;
            right: 0;
            top: -40px
        }

        .popup-form-wrp.popup-image-wrp img {
            display: block;
            width: 100%
        }

        .popup-form-wrp.popup-image-wrp .desktop-popup {
            display: block
        }

        .popup-form-wrp.popup-image-wrp .mobile-popup {
            display: none
        }

		.overlay {
			background: rgba(0, 0, 0, .8);
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			height: 100%
		}
		.popup-wrp.askrohitgera-popup-wrp > div {
			width: 800px;
			padding: 0;
		}
		.popup-wrp.askrohitgera-popup-wrp .close-btn {
			color: #fff;
			padding: 10px;
			right: 0px;
			top: -3px;
		}

		.construction-update-btn {
			position: fixed;
			right: 0;
			top: 50%;
			z-index: 9;
			transform: rotate(-90deg) translateY(94px);
		}
		.construction-update-btn a {
			box-shadow: none;
			border-radius: 5px 5px 0 0;
		}
		.construction-video.enquire a, .construction-video.enquire .sbt-btn {
			font-size: 12px;
			padding: 12px 20px 10px;
			    font-family: 'futura-bt-medium';
		}
		.subProjectInnerTab {
			width: 82% !important;
		}

        @media only screen and (max-width:999px) {
            .popup-form-wrp.popup-image-wrp>div {
                width: 90%
            }
            .popup-form-wrp.popup-image-wrp .desktop-popup {
                display: none
            }
            .popup-form-wrp.popup-image-wrp .mobile-popup {
                display: block
            }
            .popup-form-wrp.popup-image-wrp .heading {
                width: 30px;
                top: -34px
            }
        }
    </style>


