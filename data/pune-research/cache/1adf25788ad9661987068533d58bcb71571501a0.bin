<script type="text/javascript">
    $("#download_brochure_btn").click(function() {
        var name = $("#d_name").val();
        var email = $("#d_email").val();
        var phone = $("#d_phone").val();

        var project = $('#brochure_project_name').val();

        var utm_source = $('#utm_source').val();

        //alert(utm_source);

        /*var g_recaptcha=$("#g-recaptcha-response").val();*/

        if (!name) {
            alert("Please enter name");
            $("#d_name").focus();
            $("#d_name").css("border", "1px solid #ff0000");
            return false;
        }
        if (!email) {
            alert("Please enter email");
            $("#d_email").focus();
            $("#d_email").css("border", "1px solid #ff0000");
            return false;
        }
        var emailReg = /^(("[\w-\s]+")|([\w-]+(?:\.[\w-]+)*)|("[\w-\s]+")([\w-]+(?:\.[\w-]+)*))(@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$)|(@\[?((25[0-5]\.|2[0-4][0-9]\.|1[0-9]{2}\.|[0-9]{1,2}\.))((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\.){2}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\]?$)/i;
        if (emailReg.test(email) == false) {
            alert("Please enter valid email address");
            return false;
        }
        if (!phone) {
            alert("Please enter phone");
            $("#d_phone").focus();
            $("#d_phone").css("border", "1px solid #ff0000");
            return false;
        }
        var mob = /^[0-9]{10}$/;
        if (mob.test(phone) == false) {
            alert("Please enter 10 digit number");
            $("#d_phone").focus();
            $("#d_phone").css("border", "1px solid #ff0000")
            return false;
        }

        $("#download_brochure_btn").html('<i class="fa fa-spinner fa-pulse fa-fw"></i> Loading..');

        $.ajax({
            type: "POST",
            url: "https://naiknavare.com/send_enquiry_for_download_brochure",
            data: {
                'name': name,
                'email': email,
                'phone': phone,
                'project': project,
                'utm_source': utm_source
            },
            success: function(response) {
                console.log(response);
                if (response.status == "1") {
                    $("#formenquire").trigger("reset");
                    $("#download_brochure_btn").html("Send");

                    if (project == 'dbs') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=dbs';

                    }
                    if (project == 'central vista main') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=central vista main';

                    }
                    if (project == 'central vista technical') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=central vista technical';

                    }
                    if (project == 'aranya') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=aranya';

                    }
                    if (project == 'dwarka') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=dwarka';

                    }
                    if (project == 'kutumb') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=kutumb';

                    }
                    if (project == 'shivatman') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=shivatman';

                    }
                    if (project == 'kutumb_bhumi_2') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=kutumb_bhumi_2';

                    }
                    if (project == 'kutumb_woods') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=kutumb_woods';

                    }
                    if (project == 'shridhar_bhalchandra') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=shridhar_bhalchandra';

                    }
                    if (project == 'banashree') {

                        window.location.href = 'https://naiknavare.com/thanku_page?download=banashree';

                    }

                    //   alert("Your Enquiry has been sent successfully ..!");

                } else if (response.status == "false") {
                    alert("Something went wrong, Please try again ..!");
                    $("#formenquire").trigger("reset");
                    $("#download_brochure_btn").html('Send');

                } else {
                    $("#download_brochure_btn").html('Send');
                    alert(response);
                }
            }
        });
    });
</script>


<!-- popup -->

<script>
    $("#homepopup_btn_submit").click(function() {



        var project_name = $("#popup_project").val();
        var name = $("#popup_name").val();
        var email = $("#popup_email").val();
        var phone = $("#popup_phone").val();
        let g_recaptcha = grecaptcha.getResponse(popup_r);

        var utm_source = $("#utm_source").val();
        var utm_camp = $("#utm_campaign_name").val();
        var utm_id = $("#utm_campaign_id").val();
        var utm_city = $("#utm_campaign_city").val();

        //alert(g_recaptcha);


        if (!name) {
            alert("Please enter name");
            return false;
        }
        if (/[^a-zA-Z \-]/.test(name)) {
            alert("Enter only alphabets in name.");
            return false;
        }
        if (!email) {
            alert("Please enter email");
            return false;
        }
        var emailReg = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$/;
        if (emailReg.test(email) == false) {
            $("#error").html("Please enter valid email address");
            return false;
        }
        if (!phone) {
            alert("Please enter phone");
            return false;
        }
        var mob = /^[0-9]{10}$/;
        if (mob.test(phone) == false) {
            alert("Please enter 10 digit number");
            return false;
        }



        $.ajax({
            url: 'https://naiknavare.com/check_unique',
            type: 'POST',
            data: {
                email: email,
                mobile: phone
            },
            dataType: 'json',
            success: function(response) {
                if (response.isEmailUnique && response.isMobileUnique) {

                    $("#homepopup_btn_submit").html('Submitting...');
                    $('#homepopup_btn_submit').prop('disabled', true);

                    $.ajax({
                        type: "POST",
                        url: "https://naiknavare.com/popup_project_enquiry",
                        data: {
                            'project_name': project_name,
                            'name': name,
                            'email': email,
                            'phone': phone,
                            'utm_source': utm_source,
                            'utm_campaign_name': utm_camp,
                            'utm_campaign_id': utm_id,
                            'utm_campaign_city': utm_city,
                            'g_recaptcha': g_recaptcha
                        },
                        success: function(response) {
                            $("#homepopup_btn_submit").html('Submit');
                            $('#homepopup_btn_submit').prop('disabled', false);
                            console.log(response);
                            //alert("Your Enquiry has been sent successfully ..!");
                            //alert(response);
                            if (response.status == true) {
                                // $('#result').modal('show');
                                // $('#result').css('z-index','99999999999');
                                // $('#result .modal-title').text("Success");
                                // $('#result .modal-body').text("Your Enquiry Has Been Saved..!!!");
                                // $("#error").html("");
                                window.location.replace('https://naiknavare.com/thanku_page?utm_source=' + utm_source + '&utm_campaign_name=' + utm_camp + '&utm_campaign_id=' + utm_id + '&utm_campaign_city=' + utm_city + '&utm_project=' + project_name);
                                $(".subscribe").trigger("reset");
                                $("#homepopup_btn_submit").html('Submit');
                            } else if (response.status == "false") {
                                $('#result').modal('show');
                                $('#result').css('z-index', '99999999999');
                                $('#result .modal-title').text("Oops..!");
                                $('#result .modal-body').text("Something went wrong..! Please try again.");
                                $("#homepopup_btn_submit").html('Submit');
                            } else {
                                alert(response);
                            }
                            $("#enquiry").trigger("reset");
                        }
                    });



                } else {
                    alert('Email or mobile number already exists!');
                    return false;
                }
            }
        });







    });
</script>



