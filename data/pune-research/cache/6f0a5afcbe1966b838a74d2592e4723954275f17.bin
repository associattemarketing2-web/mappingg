            cmp-image__align-left round-corners   " itemscope itemtype="http://schema.org/ImageObject">
  
    <img src="/adobe/dynamicmedia/deliver/dm-aid--d2373dc0-13b1-41e1-a16b-46b29f3d00e7/thumb-cloud-native-origins.png?preferwebp=true&quality=85" srcset="/adobe/dynamicmedia/deliver/dm-aid--d2373dc0-13b1-41e1-a16b-46b29f3d00e7/thumb-cloud-native-origins.png?preferwebp=true&amp;quality=85&amp;width=110 110w,/adobe/dynamicmedia/deliver/dm-aid--d2373dc0-13b1-41e1-a16b-46b29f3d00e7/thumb-cloud-native-origins.png?preferwebp=true&amp;quality=85&amp;width=320 320w,/adobe/dynamicmedia/deliver/dm-aid--d2373dc0-13b1-41e1-a16b-46b29f3d00e7/thumb-cloud-native-origins.png?preferwebp=true&amp;quality=85&amp;width=480 480w,/adobe/dynamicmedia/deliver/dm-aid--d2373dc0-13b1-41e1-a16b-46b29f3d00e7/thumb-cloud-native-origins.png?preferwebp=true&amp;quality=85&amp;width=600 600w,/adobe/dynamicmedia/deliver/dm-aid--d2373dc0-13b1-41e1-a16b-46b29f3d00e7/thumb-cloud-native-origins.png?preferwebp=true&amp;quality=85&amp;width=800 800w,/adobe/dynamicmedia/deliver/dm-aid--d2373dc0-13b1-41e1-a16b-46b29f3d00e7/thumb-cloud-native-origins.png?preferwebp=true&amp;quality=85&amp;width=1024 1024w,/adobe/dynamicmedia/deliver/dm-aid--d2373dc0-13b1-41e1-a16b-46b29f3d00e7/thumb-cloud-native-origins.png?preferwebp=true&amp;quality=85&amp;width=1220 1220w,/adobe/dynamicmedia/deliver/dm-aid--d2373dc0-13b1-41e1-a16b-46b29f3d00e7/thumb-cloud-native-origins.png?preferwebp=true&amp;quality=85&amp;width=1600 1600w" loading="lazy" class="cmp-image__image" itemprop="contentUrl" width="526" height="526" alt="cloud native origins thumbnail"/>
  
  
  
  
