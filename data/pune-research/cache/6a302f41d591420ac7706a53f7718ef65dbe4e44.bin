      <style>
/* ========================================
   FULL WIDTH BREAKOUT
   ======================================== */

.sqs-block-code:has(.ceratec-hero) {
  padding: 0;
  margin: 0;
}

.ceratec-hero {
  width: 100vw;
  position: relative;
  left: 50%;
  margin-left: -50vw;
  padding: 0;
  overflow: hidden;
}

.ceratec-banner {
  position: relative;
  width: 100%;
  background: #000;
}

.banner-aspect-ratio {
  position: relative;
  width: 100%;
  padding-bottom: 42.5%;
  overflow: hidden;
}

.banner-slides {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.banner-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 1s ease-in-out;
}

.banner-slide.active {
  opacity: 1;
  z-index: 1;
}

.banner-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

/* Controls */
.banner-controls {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 20px;
  z-index: 10;
}

.banner-arrow {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.4);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  padding: 0;
}

.banner-arrow:hover {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(1.1);
}

.banner-arrow svg {
  width: 20px;
  height: 20px;
  stroke: #fff;
  stroke-width: 2.5;
  fill: none;
}

.banner-dots {
  display: flex;
  gap: 8px;
}

.banner-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  cursor: pointer;
  transition: all 0.3s ease;
}

.banner-dot:hover {
  background: rgba(255, 255, 255, 0.7);
  transform: scale(1.2);
}

.banner-dot.active {
  background: #fff;
  width: 24px;
  border-radius: 4px;
}

/* Responsive */
@media screen and (max-width: 1024px) {
  .banner-aspect-ratio {
    padding-bottom: 50%;
  }
  .banner-controls {
    bottom: 25px;
    gap: 18px;
  }
  .banner-arrow {
    width: 48px;
    height: 48px;
  }
}

/* Mobile: square banner */
@media screen and (max-width: 767px) {
  .banner-aspect-ratio {
    padding-bottom: 100%;
  }
  .banner-slide img {
    object-fit: contain;
    background: #000;
  }
  .banner-controls {
    bottom: 20px;
    gap: 15px;
  }
  .banner-arrow {
    width: 45px;
    height: 45px;
  }
  .banner-arrow svg {
    width: 18px;
    height: 18px;
  }
  .banner-dot {
    width: 7px;
    height: 7px;
  }
  .banner-dot.active {
    width: 20px;
  }
}

@media screen and (max-height: 500px) and (orientation: landscape) {
  .banner-aspect-ratio {
    padding-bottom: 40%;
  }
  .banner-controls {
    bottom: 15px;
    gap: 12px;
  }
  .banner-arrow {
    width: 40px;
    height: 40px;
  }
}
</style>

<div class="ceratec-hero">
  <div class="ceratec-banner">
    <div class="banner-aspect-ratio">

      <div class="banner-slides">
        <div class="banner-slide active">
          <img src="https://images.squarespace-cdn.com/content/v1/693020673eff441b1ed384cc/23a08912-2729-49b3-b977-21f0961e2821/Ceratec+Website+Call+Ceratec+4.jpg.jpeg?format=1500w" alt="Ceratec - Innovation Has A Name">
        </div>
        <div class="banner-slide">
          <img src="https://images.squarespace-cdn.com/content/v1/693020673eff441b1ed384cc/171c903a-7933-48ca-a931-ef14b8dac179/Ceratec+Website+Call+Ceratec+3.jpg.jpeg?format=1500w" alt="Ceratec - Commitmen Has A Name">
        </div>
        <div class="banner-slide">
          <img src="https://images.squarespace-cdn.com/content/v1/693020673eff441b1ed384cc/048c9f13-70ad-4f1c-a510-3411784ac536/Ceratec+Website+Call+Ceratec+2.jpg.jpeg?format=1500w" alt="Ceratec - Quality Has A Name">
        </div>
        <div class="banner-slide">
          <img src="https://images.squarespace-cdn.com/content/v1/693020673eff441b1ed384cc/77ff3c45-eb28-426e-bc15-4c30db2e9db4/Ceratec+Website+Call+Ceratec+1.jpg.jpeg?format=1500w" alt="Ceratec - Turst Has A Name">
        </div>
        <div class="banner-slide">
          <img src="https://images.squarespace-cdn.com/content/v1/693020673eff441b1ed384cc/0345a2be-1967-46be-8ef8-e4afef271465/Ceratec+Website+Westwinds.jpg.jpeg?format=1500w" alt="Westwinds - Ceratec residential project in Hinjewadi">
        </div>
        <div class="banner-slide">
          <img src="https://images.squarespace-cdn.com/content/v2/namespaces/website/libraries/693020673eff441b1ed384cc/fdf4f597-65c7-4bdc-bccc-547282870d27/Ceratec+Website+Tower+108+Orange.jpg.jpeg?format=1500w" alt="Tower 108 - Ceratec Grade A commercial project in Balewadi">
        </div>
      </div>

      <div class="banner-controls">
        <button class="banner-arrow prev-btn" aria-label="Previous slide">
          <svg viewBox="0 0 24 24">
            <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="banner-dots">
          <div class="banner-dot active" data-index="0"></div>
          <div class="banner-dot" data-index="1"></div>
          <div class="banner-dot" data-index="2"></div>
          <div class="banner-dot" data-index="3"></div>
          <div class="banner-dot" data-index="4"></div>
          <div class="banner-dot" data-index="5"></div>
        </div>

        <button class="banner-arrow next-btn" aria-label="Next slide">
          <svg viewBox="0 0 24 24">
            <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</div>

<script>
(function() {
  let currentIndex = 0;
  const slides = document.querySelectorAll('.banner-slide');
  const dots = document.querySelectorAll('.banner-dot');
  const totalSlides = slides.length;
  let autoplayTimer;

  function showSlide(index) {
    slides.forEach(s => s.classList.remove('active'));
    dots.forEach(d => d.classList.remove('active'));
    slides[index].classList.add('active');
    dots[index].classList.add('active');
    currentIndex = index;
  }

  function nextSlide() {
    showSlide((currentIndex + 1) % totalSlides);
    resetAutoplay();
  }

  function prevSlide() {
    showSlide((currentIndex - 1 + totalSlides) % totalSlides);
    resetAutoplay();
  }

  function startAutoplay() {
    autoplayTimer = setInterval(nextSlide, 5000);
  }

  function resetAutoplay() {
    clearInterval(autoplayTimer);
    startAutoplay();
  }

  let touchStart = 0;
  let touchEnd = 0;

  function handleSwipe() {
    if (touchStart - touchEnd > 50) nextSlide();
    if (touchEnd - touchStart > 50) prevSlide();
  }

  function init() {
    const banner = document.querySelector('.ceratec-banner');
    document.querySelector('.prev-btn').addEventListener('click', prevSlide);
    document.querySelector('.next-btn').addEventListener('click', nextSlide);

    dots.forEach(dot => {
      dot.addEventListener('click', function() {
        showSlide(parseInt(this.dataset.index));
        resetAutoplay();
      });
    });

    banner.addEventListener('touchstart', e => {
      touchStart = e.changedTouches[0].screenX;
    });
    banner.addEventListener('touchend', e => {
      touchEnd = e.changedTouches[0].screenX;
      handleSwipe();
    });

    startAutoplay();
  }

  // Squarespace can inject code after DOMContentLoaded has already fired
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

  
  



