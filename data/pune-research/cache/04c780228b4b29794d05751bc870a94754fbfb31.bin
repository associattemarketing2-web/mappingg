<script>
var video1 = document.getElementById("my-video");
var video2 = document.getElementById("myVideo1");
var isScrolling;

window.addEventListener('scroll', function() {
  // Clear the timeout to prevent rapid firing of scroll events
  clearTimeout(isScrolling);

  // Set a timeout to pause the videos after scrolling stops for a certain delay
  isScrolling = setTimeout(function() {
    video1.pause();
    video2.pause();
  }, 80); // Adjust the delay as needed
});
 
</script>


