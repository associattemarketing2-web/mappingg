2.2pt;\"\u003ePPL Hebbal Developers Private Limited\u003c/td\u003e\u003ctd style=\"border-bottom:1.0pt solid #60CAF3;border-left-style:none;border-right:1.0pt solid #60CAF3;border-top-style:none;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:159.7pt;\"\u003e\u003cp style=\"text-align:center;\"\u003eDirector\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"border-bottom-style:solid;border-color:#60CAF3;border-left-style:solid;border-right-style:solid;border-top-style:none;border-width:1.0pt;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:52.35pt;\"\u003e15.\u003c/td\u003e\u003ctd style=\"border-bottom:1.0pt solid #60CAF3;border-left-style:none;border-right:1.0pt solid #60CAF3;border-top-style:none;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:252.2pt;\"\u003eT- Hills Private Limited\u003c/td\u003e\u003ctd style=\"border-bottom:1.0pt solid #60CAF3;border-left-style:none;border-right:1.0pt solid #60CAF3;border-top-style:none;height:26.25pt;padding:0cm 5.4pt;vertical-align:top;width:159.7pt;\"\u003e\u003cp style=\"text-align:center;\"\u003eDirector\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/figure\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e","Image":{"data":{"id":2947,"attributes":{"name":"Amanda Joy Puravankara, Additional Whole-time Director, Puravankara Limited.jpg","alternativeText":"Amanda Joy Puravankara","caption":null,"width":519,"height":486,"formats":{"small":{"ext":".jpg","url":"/uploads/small_Amanda_Joy_Puravankara_Additional_Whole_time_Director_Puravankara_Limited_34062b6409.jpg","hash":"small_Amanda_Joy_Puravankara_Additional_Whole_time_Director_Puravankara_Limited_34062b6409","mime":"image/jpeg","name":"small_Amanda Joy Puravankara, Additional Whole-time Director, Puravankara Limited.jpg","path":null,"size":26.04,"width":500,"height":468,"sizeInBytes":26038},"thumbnail":{"ext":".jpg","url":"/uploads/thumbnail_Amanda_Joy_Puravankara_Additional_Whole_time_Director_Puravankara_Limited_34062b6409.jpg","hash":"thumbnail_Amanda_Joy_Puravankara_Additional_Whole_time_Director_Puravankara_Limited_34062b6409","mime":"image/jpeg","name":"thumbnail_Amanda Joy Puravankara, Additional Whole-time Director, Puravankara Limited.jpg","path":null,"size":5.51,"width":166,"height":156,"sizeInBytes":5514}},"hash":"Amanda_Joy_Puravankara_Additional_Whole_time_Director_Puravankara_Limited_34062b6409","ext":".jpg","mime":"image/jpeg","size":27.29,"url":"/uploads/Amanda_Joy_Puravankara_Additional_Whole_time_Director_Puravankara_Limited_34062b6409.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-08-11T10:37:06.482Z","updatedAt":"2025-08-21T10:50:20.892Z"}}}}},{"id":8,"attributes":{"Name":"Mr. Mallanna Sasalu","Description":"\u003cp\u003eDistinguished as a global wealth creator, value grower, and adept organisation builder, Mallanna has achieved remarkable success throughout his career in profitable real estate development startups, business scaling, PE fundraising, and real estate asset investment and management.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eHis expertise lies in profitably scaling startups across Asia-Pacific (APAC) and North America, seamlessly combining financial acumen with extensive development experience to navigate the full project lifecycle.\u0026nbsp;\u003c/p\u003e\u003cp\u003eWith a visionary mindset, he has conceptualised and developed a spectrum of real estate asset classes, exceeding $1 billion in value, spanning commercial, residential, retail, hospitality, and mixed-use projects.\u0026nbsp;\u003c/p\u003e\u003cp\u003eHis commitment to sustainability stands as a hallmark of his leadership, actively championing environmentally conscious measures in new projects and our corporate office. Beyond mere profit margins, his leadership prioritises long-term environmental responsibility through the integration of eco-friendly construction and practices.\u0026nbsp;\u003c/p\u003e\u003cp\u003eA leader with a multicultural background and global business experience, Mallanna guides diverse teams to deliver success for investors, employees, and customers. He is an esteemed alumnus of the Harvard Business School and possesses a Bachelor's degree in Civil Engineering. He brings a unique blend of academic excellence and practical proficiency to his role.\u003c/p\u003e","createdAt":"2025-07-17T12:14:59.200Z","updatedAt":"2026-07-04T09:48:39.056Z","publishedAt":"2025-07-18T05:56:14.317Z","position":"CEO - South","subpos":null,"slug":"mallanna-sasalu","leadership_description":"","full_time_positions":null,"Image":{"data":{"id":2856,"attributes":{"name":"Mallanna.png","alternativeText":null,"caption":null,"width":1034,"height":974,"formats":{"large":{"ext":".png","url":"/uploads/large_Mallanna_b8f93fe66f.png","hash":"large_Mallanna_b8f93fe66f","mime":"image/png","name":"large_Mallanna.png","path":null,"size":1205.47,"width":1000,"height":942,"sizeInBytes":1205475},"small":{"ext":".png","url":"/uploads/small_Mallanna_b8f93fe66f.png","hash":"small_Mallanna_b8f93fe66f","mime":"image/png","name":"small_Mallanna.png","path":null,"size":341.47,"width":500,"height":471,"sizeInBytes":341469},"medium":{"ext":".png","url":"/uploads/medium_Mallanna_b8f93fe66f.png","hash":"medium_Mallanna_b8f93fe66f","mime":"image/png","name":"medium_Mallanna.png","path":null,"size":737.75,"width":750,"height":706,"sizeInBytes":737746},"thumbnail":{"ext":".png","url":"/uploads/thumbnail_Mallanna_b8f93fe66f.png","hash":"thumbnail_Mallanna_b8f93fe66f","mime":"image/png","name":"thumbnail_Mallanna.png","path":null,"size":46.31,"width":166,"height":156,"sizeInBytes":46308}},"hash":"Mallanna_b8f93fe66f","ext":".png","mime":"image/png","size":333.94,"url":"/uploads/Mallanna_b8f93fe66f.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-07-18T05:56:10.386Z","updatedAt":"2025-07-18T05:56:10.386Z"}}}}},{"id":9,"attributes":{"Name":"Mr. Rajat Rastogi","Description":"\u003cp\u003eRajat Rastogi is the Chief Executive Officer (CEO) of West Region \u0026amp; Commercial Assets Pan India, Puravankara Limited. He has been instrumental in driving growth and scaling the company’s presence across the western region for residential projects and for creating commercial platforms at the pan-India level. \u0026nbsp;\u003cbr\u003e\u003cbr\u003eRajat Rastogi is a seasoned real estate leader with an impressive 21 years of industry experience. His career spans two decades in real estate \u0026amp; financial services, during which he has successfully set up and led new businesses, driving substantial revenue growth. His expertise extends to various domains, including business leadership, finance, P\u0026amp;L, brand and distribution, team management, \u0026amp; customer centricity, making him a well-rounded professional in the real estate sector.\u003cbr\u003e\u0026nbsp;\u0026nbsp;\u003cbr\u003eRajat has held leadership positions with the Runwal Group, Lodha Group, Deutsche Bank, and CitiBank. He has an MBA from the ICFAI Business School in Hyderabad.\u0026nbsp;\u003c/p\u003e","createdAt":"2025-07-17T12:15:48.723Z","updatedAt":"2026-07-04T09:52:41.292Z","publishedAt":"2025-07-18T05:52:53.672Z","position":"CEO - West \u0026 Commercial Assests","subpos":null,"slug":"rajat-rastogi","leadership_description":"","full_time_positions":null,"Image":{"data":{"id":2854,"attributes":{"name":"Rajat.png","alternativeText":null,"caption":null,"width":1034,"height":974,"formats":{"large":{"ext":".png","url":"/uploads/large_Rajat_c1bf1d6b65.png","hash":"large_Rajat_c1bf1d6b65","mime":"image/png","name":"large_Rajat.png","path":null,"size":1503.9,"width":1000,"height":942,"sizeInBytes":1503904},"small":{"ext":".png","url":"/uploads/small_Rajat_c1bf1d6b65.png","hash":"small_Rajat_c1bf1d6b65","mime":"image/png","name":"small_Rajat.png","path":null,"size":438.58,"width":500,"height":471,"sizeInBytes":438577},"medium":{"ext":".png","url":"/uploads/medium_Rajat_c1bf1d6b65.png","hash":"medium_Rajat_c1bf1d6b65","mime":"image/png","name":"medium_Rajat.png","path":null,"size":922.25,"width":750,"height":706,"sizeInBytes":922254},"thumbnail":{"ext":".png","url":"/uploads/thumbnail_Rajat_c1bf1d6b65.png","hash":"thumbnail_Rajat_c1bf1d6b65","mime":"image/png","name":"thumbnail_Rajat.png","path":null,"size":57.64,"width":166,"height":156,"sizeInBytes":57640}},"hash":"Rajat_c1bf1d6b65","ext":".png","mime":"image/png","size":429.21,"url":"/uploads/Rajat_c1bf1d6b65.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-07-18T05:52:49.524Z","updatedAt":"2025-07-18T05:52:49.524Z"}}}}},{"id":13,"attributes":{"Name":"Mr. Neeraj Gautam","Description":"\u003cp\u003eMr. Neeraj Gautam has over 24 years of experience in financial strategy, capital management and corporate governance, and has been with Puravankara Limited for over 13 years. While at Puravankara, he has played a key role in shaping the company’s financial strategy, optimising capital allocation, and fostering strong relationships with stakeholders within and outside the organisation. He has also driven critical initiatives including ERP implementation, investment decisions, and comprehensive financial planning, which delivered operational excellence and growth.\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e","createdAt":"2025-11-15T03:55:42.431Z","updatedAt":"2026-07-04T09:51:03.818Z","publishedAt":"2025-11-15T06:17:29.140Z","position":"Chief Financial Officer","subpos":null,"slug":"neeraj-gautam","leadership_description":"","full_time_positions":null,"Image":{"data":{"id":5275,"attributes":{"name":"dheeraj.webp","alternativeText":null,"caption":null,"width":517,"height":487,"formats":{"small":{"ext":".webp","url":"/uploads/small_dheeraj_31692413a2.webp","hash":"small_dheeraj_31692413a2","mime":"image/webp","name":"small_dheeraj.webp","path":null,"size":11.07,"width":500,"height":471,"sizeInBytes":11070},"thumbnail":{"ext":".webp","url":"/uploads/thumbnail_dheeraj_31692413a2.webp","hash":"thumbnail_dheeraj_31692413a2","mime":"image/webp","name":"thumbnail_dheeraj.webp","path":null,"size":2.51,"width":166,"height":156,"sizeInBytes":2510}},"hash":"dheeraj_31692413a2","ext":".webp","mime":"image/webp","size":14.98,"url":"/uploads/dheeraj_31692413a2.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-11-15T06:16:05.249Z","updatedAt":"2025-11-15T06:16:05.249Z"}}}}},{"id":12,"attributes":{"Name":"Mr. Ravi Kumar","Description":"\u003cp\u003eRavi Kumar serves as President and Group Chief Human Resources Officer at Puravankara Limited. In his current role, Ravi is responsible for driving sustainable people practices, shaping organisational culture and fostering innovative business outcomes. With over 28 years of extensive experience in Human Resources, Ravi brings in a wealth of expertise in HR strategy, talent management, industrial relations, employee engagement, learning and development, business transformation, culture building and leadership coaching. Ravi is best known for his contributions towards building leadership capabilities and coaching colleagues from the industry, in India and overseas.\u003c/p\u003e\u003cp\u003ePrior to joining Puravankara Limited, Ravi held HR leadership positions at Page Industries Limited, Roche Diabetes Care IMEA, Roche Diagnostics Middle East FZCO, Roche Diagnostics India, Saint-Gobain India (Grindwell Norton Limited), and Larsen \u0026amp; Toubro Limited.\u003c/p\u003e\u003cp\u003eHis peers and associates remember him fondly for his mentoring abilities and his focus on developing culture and talent within the organisation. Ravi holds a Post Graduate Diploma in Personnel Management from the reputed Xavier Institute of Social Service.\u003c/p\u003e\u003cp\u003eWhen not at work, Ravi enjoys photography and loves to travel.\u003c/p\u003e","createdAt":"2025-08-11T11:41:34.867Z","updatedAt":"2026-07-04T09:51:44.767Z","publishedAt":"2025-08-11T11:41:36.568Z","position":"Chief Human Resources Officer","subpos":null,"slug":"ravi-kumar","leadership_description":"","full_time_positions":null,"Image":{"data":{"id":2968,"attributes":{"name":"Ravi Kumar, CHRO, Puravakara Limited.jpg","alternativeText":null,"caption":null,"width":520,"height":488,"formats":{"small":{"ext":".jpg","url":"/uploads/small_Ravi_Kumar_CHRO_Puravakara_Limited_1c4804054e.jpg","hash":"small_Ravi_Kumar_CHRO_Puravakara_Limited_1c4804054e","mime":"image/jpeg","name":"small_Ravi Kumar, CHRO, Puravakara Limited.jpg","path":null,"size":34.44,"width":500,"height":469,"sizeInBytes":34437},"thumbnail":{"ext":".jpg","url":"/uploads/thumbnail_Ravi_Kumar_CHRO_Puravakara_Limited_1c4804054e.jpg","hash":"thumbnail_Ravi_Kumar_CHRO_Puravakara_Limited_1c4804054e","mime":"image/jpeg","name":"thumbnail_Ravi Kumar, CHRO, Puravakara Limited.jpg","path":null,"size":6.26,"width":166,"height":156,"sizeInBytes":6263}},"hash":"Ravi_Kumar_CHRO_Puravakara_Limited_1c4804054e","ext":".jpg","mime":"image/jpeg","size":36.79,"url":"/uploads/Ravi_Kumar_CHRO_Puravakara_Limited_1c4804054e.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-08-11T11:40:37.188Z","updatedAt":"2025-08-11T11:40:37.188Z"}}}}},{"id":15,"attributes":{"Name":"Mr. Subrahmanya Gupta Boda","Description":"\u003cp\u003eSubrahmanya Gupta Boda, is the Chief Technology Officer at Puravankara South. A passionate Digital Transformation and Cybersecurity professional.\u0026nbsp;\u003cbr\u003e\u003cbr\u003ePrior roles include Chief Technology Advisor at NABARD, Global CISO at GMR Group, and was with Mercedes-Benz Research and Development India, instrumental in setting up consulting and IT Security in 2002. He began his career with Central Research Laboratory, Ghaziabad (a div. of Bharat Electronics Ltd.,) worked on defense systems.\u003cbr\u003e\u003cbr\u003eHe holds BE Electronics and Comm. from Andhra University, and Masters in Engineering in Software Systems from BITS Pilani. He is a senior member of IEEE and Paul Harris Fellow, Rotary International.\u003cbr\u003e\u003cbr\u003eHe led the Indian Cyber Security team at BRICS Future Skills Challenge 2018, Johannesburg through Skill India Mission, first ever Indian contingent to participate in Future Skills Challenges in lines of the World Skills Council.\u003cbr\u003e\u003cbr\u003eHe contributes to the IT Community through knowledge sharing sessions, mentoring IT leaders, startups faculty, and students on various aspects of Digital and Cyber Security.\u003c/p\u003e","createdAt":"2026-08-12T09:14:07.118Z","updatedAt":"2026-09-25T04:52:08.943Z","publishedAt":"2026-08-12T12:19:02.084Z","position":"Chief Technology Officer","subpos":null,"slug":"mr-subrahmanya-gupta-boda","leadership_description":"","full_time_positions":"","Image":{"data":{"id":10185,"attributes":{"name":"7.webp","alternativeText":null,"caption":null,"width":1293,"height":1217,"formats":{"large":{"ext":".webp","url":"/uploads/large_7_1.webp","hash":"large_7_1","mime":"image/webp","name":"large_7.webp","path":null,"size":38.49,"width":1000,"height":941,"sizeInBytes":38488},"small":{"ext":".webp","url":"/uploads/small_7_1.webp","hash":"small_7_1","mime":"image/webp","name":"small_7.webp","path":null,"size":13.93,"width":500,"height":471,"sizeInBytes":13926},"medium":{"ext":".webp","url":"/uploads/medium_7_1.webp","hash":"medium_7_1","mime":"image/webp","name":"medium_7.webp","path":null,"size":25.85,"width":750,"height":706,"sizeInBytes":25848},"thumbnail":{"ext":".webp","url":"/uploads/thumbnail_7_1.webp","hash":"thumbnail_7_1","mime":"image/webp","name":"thumbnail_7.webp","path":null,"size":2.97,"width":166,"height":156,"sizeInBytes":2974}},"hash":"7_1","ext":".webp","mime":"image/webp","size":72,"url":"/uploads/7_1.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-08-13T08:07:32.592Z","updatedAt":"2026-08-13T08:07:32.592Z"}}}}},{"id":14,"attributes":{"Name":"Mr. Amit Narain Ahuja","Description":"\u003cp\u003eAmit Narain Ahuja is the Chief Risk Officer at Puravankara, where he leads the company’s risk management agenda with a focus on embedding a strong risk culture, enhancing governance standards, and aligning risk practices with business strategy. His approach emphasizes proactive risk identification, robust controls, and informed decision-making to support sustainable growth and protect stakeholder interests.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eWith over 27 years of experience across global financial institutions, multinational organizations and professional advisory practices (Wells Fargo, JP Morgan Chase, Firstsource, EXL Service, KPMG, EY, Deloitte and SNB), Amit has been instrumental in building and transforming risk and control environments. He has played a pivotal role in establishing scalable frameworks, improving control effectiveness, and driving operational efficiency through structured and data-led approaches.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eAmit has worked closely with Boards and Executive Leadership across North America, Europe, UK and APAC, to embed risk awareness into business strategy and foster a strong culture of compliance and accountability. His experience spans enterprise risk management, internal audit, operational risk, fraud risk management and business process transformation across diverse geographies \u0026amp; industries.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eA Chartered Accountant, Certified Governance Risk \u0026amp; Compliance Professional (GRCP), Certified Sarbanes-Oxley expert (CSOE) and Bachelor’s in Commerce (Honors), Amit brings deep domain expertise and strategic perspective to the organization. When not at work, Amit enjoys road cycling, sports, photography and travelling.\u003c/p\u003e","createdAt":"2026-08-12T09:12:26.495Z","updatedAt":"2026-09-25T04:47:39.185Z","publishedAt":"2026-08-12T12:18:39.083Z","position":"Chief Risk Officer","subpos":null,"slug":"amit-narain-ahuja","leadership_description":"","full_time_positions":"","Image":{"data":{"id":10179,"attributes":{"name":"Amit Narain.jpg","alternativeText":null,"caption":null,"width":517,"height":487,"formats":{"small":{"ext":".jpg","url":"/uploads/small_Amit_Narain.jpg","hash":"small_Amit_Narain","mime":"image/jpeg","name":"small_Amit Narain.jpg","path":null,"size":25.61,"width":500,"height":471,"sizeInBytes":25607},"thumbnail":{"ext":".jpg","url":"/uploads/thumbnail_Amit_Narain.jpg","hash":"thumbnail_Amit_Narain","mime":"image/jpeg","name":"thumbnail_Amit Narain.jpg","path":null,"size":4.57,"width":166,"height":156,"sizeInBytes":4569}},"hash":"Amit_Narain","ext":".jpg","mime":"image/jpeg","size":27.3,"url":"/uploads/Amit_Narain.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-08-12T12:18:15.563Z","updatedAt":"2026-08-12T12:18:15.563Z"}}}}}]}}}}},"__N_SSP":true},"page":"/leadership","query":{},"buildId":"y55JGKsP_bLiLytFnaMCK","isFallback":false,"gssp":true,"scriptLoader":[]}</script><script src="/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js" data-cf-settings="7065c1825e6ff69fadb34128-|49" defer></script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092" integrity="sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==" data-cf-beacon='{"version":"2024.11.0","token":"0def3336a86a4d74b2cb3789a0e12f1b","spa":2}' crossorigin="anonymous"></script>
