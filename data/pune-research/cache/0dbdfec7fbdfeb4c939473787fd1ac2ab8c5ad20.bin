                "viralThakker": {
                    name: "Mr. Viral Thakker",
                    image: "assets/pages/about-us/management/ViralThakkar.webp",
                    designation: " Senior Vice President – Commercial, Shapoorji Pallonji Real Estate",
                    description: "Mr. Viral Thakker is the Senior Vice President of Commercial at Shapoorji Pallonji Real Estate (SPRE). He is responsible for managing and monetising commercial assets. Viral has over two decades of diverse work experience across industries, including real estate, telecom, and BFSI.<br><br>He joined the Shapoorji Pallonji Real Estate Company in 2018 as Vice President of Commercial and has been leading the commercial portfolio of asset monetisation. He has been instrumental in unlocking the value of our assets and land bank across the country.<br><br>Before joining SPRE, Viral worked with Tata Housing as Assistant Vice President of Corporate Planning and Business Development. He has vast experience in corporate planning and strategy, private equity funding, new projects, and land acquisitions. He has completed a Post Graduate Management Program from the Xavier Institute of Management, Bhubaneshwar, and is a Chartered Accountant.",
                }
            };

            var popup = document.querySelector("#member__popup");
            var memberName = popup.querySelector(".js-memberModalName");
            var memberImage = popup.querySelector(".js-memberModalImg");
            var memberDesignation = popup.querySelector(".js-memberModalDesignation");
            var memberDescription = popup.querySelector(".js-memberModalDetail");
            var openMemberModal = document.querySelectorAll('.js-openMemberModal');
            var closeMemberModal = document.querySelector('.js-closeMemberModal');
            var scrollY = 0;

            openMemberModal.forEach(ele => {
                ele.addEventListener('click', (e) => {
                    scrollY = window.scrollY;

                    setTimeout(() => {
                        document.documentElement.classList.add("showMemberModal");
                    }, 100);
                    var member = e.currentTarget.dataset.memberId;
                    if (member) {
                        memberName.innerHTML = membersData[member].name;
                        memberImage.src = membersData[member].image;
                        memberImage.alt = membersData[member].name;
                        memberDesignation.innerHTML = membersData[member].designation;
                        memberDescription.innerHTML = membersData[member].description;
                    }
                });
            });
            closeMemberModal.addEventListener('click', () => {
                setTimeout(() => {
                    window.scrollTo(0, scrollY);
                }, 10);
                document.documentElement.classList.remove("showMemberModal");
            });

        }
        memberModalData();
    </script> </body></html>