xt-black-chocolate">+</span></button></div><div><button class="flex cursor-pointer items-center gap-4 justify-between py-6 px-4 md:px-8 border-b  w-4/5 mx-auto transition-colors bg-[#FFFAF7] border-[rgba(255, 255, 255, 0.42)]"><div class="flex items-center gap-6 w-full justify-between"><span class="text-2xl font-display-semi transition-colors text-black-chocolate">04</span><span class="text-2xl md:text-xl font-display-semi transition-colors text-black-chocolate">Retail &amp; F&amp;B</span></div><span class="text-xl  font-light transition-colors text-black-chocolate">+</span></button></div><div><button class="flex cursor-pointer items-center gap-4 justify-between py-6 px-4 md:px-8 border-b  w-4/5 mx-auto transition-colors bg-[#FFFAF7] border-[rgba(255, 255, 255, 0.42)]"><div class="flex items-center gap-6 w-full justify-between"><span class="text-2xl font-display-semi transition-colors text-black-chocolate">05</span><span class="text-2xl md:text-xl font-display-semi transition-colors text-black-chocolate">Data Centres</span></div><span class="text-xl  font-light transition-colors text-black-chocolate">+</span></button></div></div></section><section class="w-full bg-[#FFFAF7] py-20"><div class="mx-auto"><div class="text-center mb-10 opacity-0 px-4 md:px-0"><div class="text-lg tracking-[0.2em] font-medium text-gold-beige mb-2">WE ARE NOW</div><h2 class="text-2xl md:text-[28px] font-display-semi text-black">SHAPING SKYLINES BEYOND BORDERS</h2></div><div class="flex items-center justify-center gap-12 mb-12 opacity-0"><button class="text-lg md:text-[16px] font-medium tracking-wider capitalize transition-colors text-gold-beige border-b-3 border-gold-beige">india</button><button class="text-lg md:text-[16px] font-medium tracking-wider capitalize transition-colors text-gold-beige/60 hover:text-gold-beige">international</button></div><div class="flex flex-wrap items-center justify-center gap-6 md:gap-12 mb-20 opacity-0"><button class="text-lg md:text-[16px] font-medium tracki