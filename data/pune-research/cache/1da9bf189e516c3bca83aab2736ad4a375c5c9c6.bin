                        /***Section Animation***/
                        const scrollElements = document.querySelectorAll(".js-scroll");

                        const elementInView = (el, dividend = 1) => {
                            const elementTop = el.getBoundingClientRect().top;

                            return (
                                elementTop <=
                                (window.innerHeight || document.documentElement.clientHeight) / dividend
                            );
                        };

                        const elementOutofView = (el) => {
                            const elementTop = el.getBoundingClientRect().top;

                            return (
                                elementTop > (window.innerHeight || document.documentElement.clientHeight)
                            );
                        };

                        const displayScrollElement = (element) => {
                            element.classList.add("scrolled");
                        };

                        const hideScrollElement = (element) => {
                            element.classList.remove("scrolled");
                        };

                        const handleScrollAnimation = () => {
                            scrollElements.forEach((el) => {
                                if (elementInView(el, 1.25)) {
                                    displayScrollElement(el);
                                } else if (elementOutofView(el)) {
                                    hideScrollElement(el)
                                }
                            })
                        }

                        window.addEventListener("scroll", () => {
                            handleScrollAnimation();
                        });
                        /***End Section Animation***/

                        $('.select').each(function() {
                            var dropdownParents = $(this).parents('.form-group')
                            $(this).select2({
                                dropdownParent: dropdownParents,
                                minimumResultsForSearch: -1
                            }).on("select2:open", function(e) {
                                $(this).parents('.form-group').addClass('focused');
                            }).on("select2:close", function(e) {
                                if ($(this).find(':selected').val() === '') {
                                    $(this).parents('.form-group').removeClass('focused');
                                }
                            });
                        });

                        // select2 multiple
                        $('.select-multiple').each(function() {
                            var dropdownParents = $(this).parents('.form-group');
                            // var placehldrget = $(this).attr("data-placeholder");
                            $(this).select2({
                                dropdownParent: dropdownParents,
                                // placeholder: placehldrget,
                                // tags: true,
                                // closeOnSelect: false,
                            }).on("select2:open", function(e) {
                                $(this).parents('.form-group').addClass('focused');
                            }).on("select2:close", function(e) {
                                if ($(this).val() != '') {
                                    $(this).parents('.form-group').addClass('focused');
                                } else {
                                    $(this).parents('.form-group').removeClass('focused');
                                }
                            }).on("select2:select", function(e) {
                                $(this).parents('.form-group').addClass('focused');
                            }).on("select2:unselect", function(e) {
                                $(this).parents('.form-group').addClass('focused');
                            })
                        });

                        $(".select-multiple-automatic-tag").select2({
                            tags: true,
                            tokenSeparators: [',', ' ']
                        })

                    }, 2500);

                },
                error: function(xhr) {
                    setTimeout(() => {
                        hideLoader();
                    }, 1000);
                }
            });
        }

    });


    $(document).on("click", ".close-enquire-model", function() {
        $("#project_id-error").html("");
        $("#email-error").html("");
        $("#contact_no-error").html("");
        $("#last_name-error").html("");
        $("#first_name-error").html("");
    });

    let selectedProjectId = null;
    let selectedType = null;
    $(document).on('click', '[data-project_id]', function() {
        selectedProjectId = $(this).data('project_id');
        $("#hideproject").hide();
    });
    let selectedBrochureFile = null;

    $(document).on('click', '[data-brochure_file]', function() {
        selectedBrochureFile = $(this).data('brochure_file');
    });
    $(document).on('click', '[data-type]', function() {
        selectedType = $(this).data('type');
        if (selectedType == "Brochure") {
            $("#formname").text("Download Brochure");
            $("#formdetailsinfo").text("Please Enter Your Details To Know More About Projects");
        } else if (selectedType == "Price") {
            $("#formname").text("Price");
            $("#formdetailsinfo").text("Please Enter Your Details To Know More About Projects");
        } else if (selectedType == "Enquire Now") {
            $("#formname").text("Enquire Now");
        }
    });

    $(document).on("change", ".selectproject", function() {
        $("#project_id-error").html("");
    });

    $.validator.addMethod("lettersOnly", function(value, element) {
        return this.optional(element) || /^[a-zA-Z\s]+$/.test(value);
    }, "Only alphabets are allowed.");

    // Clear the inline OTP error as soon as the user edits the OTP field
    $(document).on("input", ".leads-adds input[name='otp']", function() {
        $(this).closest('form').find('.otp-error-enquire').text('').hide();
    });

    // Handle Send OTP button click for the Enquire Now form
    $(document).on("click", ".leads-adds button[name='send-otp']", function(e) {
        e.preventDefault();
        var $btn = $(this);
        var form = $btn.closest('form');
        var first_name = form.find('input[name="first_name"]').val();
        var email = form.find('input[name="email"]').val();
        var contact_no = form.find('input[name="contact_no"]').val();

        if (!first_name || !email || !contact_no) {
            Swal.fire("Please fill First Name, Email and Mobile Number first", "", "warning");
            return;
        }

        $btn.text('SENDING...').attr('disabled', true);

        // Clear any previous inline OTP error before (re)sending
        form.find('.otp-error-enquire').text('').hide();

        $.ajax({
            type: "POST",
            url: apipath + "/sendotp",
            data: {
                contact_no: contact_no,
                email: email
            },
            headers: {
                'Authorization': 'Bearer ' + API_TOKEN
            },
            success: function(data) {
                if (data.status == 200) {
                    Swal.fire("OTP Sent Successfully to Your Mobile", "", "success");
                    form.find('.otp-field-enquire').removeClass('d-none');
                    $btn.text('RESEND OTP').attr('disabled', false);
                } else {
                    Swal.fire("Failed to send OTP", data.message || "", "error");
                    $btn.text('SEND OTP').attr('disabled', false);
                }
            },
            error: function() {
                Swal.fire("Error sending OTP", "", "error");
                $btn.text('SEND OTP').attr('disabled', false);
            }
        });
    });

    $(".leads-adds").submit(function(e) {
        e.preventDefault();
    }).validate({
        rules: {
            first_name: {
                required: true,
                lettersOnly: true
            },
            last_name: {
                required: true,
                lettersOnly: true
            },
            contact_no: {
                required: true,
                minlength: function() {
                    return $("#country_code").val() === "+91" ? 10 : 8;
                },
                maxlength: function() {
                    return $("#country_code").val() === "+91" ? 10 : 15;
                }
            },
            otp: {
                required: true,
                digits: true,
                minlength: 4,
                maxlength: 4
            }
        },

        messages: {
            first_name: {
                required: "Please enter your first name",
                lettersOnly: "Only alphabets are allowed"
            },
            last_name: {
                required: "Please enter your last name",
                lettersOnly: "Only alphabets are allowed"
            },
            contact_no: {
                minlength: function() {
                    const min = $("#country_code").val() === "+91" ? 10 : 8;
                    return `Please enter at least ${min} digits.`;      
                },
                maxlength: function() {
                    const max = $("#country_code").val() === "+91" ? 10 : 15;
                    return `Please enter no more than ${max} digits.`;
                }
            },
            otp: {
                required: "Please enter the 4-digit OTP",
                digits: "Only numbers are allowed",
                minlength: "OTP must be 4 digits",
                maxlength: "OTP must be 4 digits"
            }
        },
        submitHandler: function(form) {

            $(".leadadds").text('SUBMITING...').attr('disabled', true);
            var formData = new FormData(form);

            if ($(form).find('input[name="consent"]').length > 0) {
                formData.set("consent", $(form).find('input[name="consent"]').is(':checked') ? 'yes' : 'no');
            }

            // Append hidden tracking fields
            const urlParams = new URLSearchParams(window.location.search);
            
            let source = $('input[name="USOURCE"]').val() || urlParams.get('usource') || "";
            let medium = $('input[name="UMEDIUM"]').val() || urlParams.get('umedium') || "";
            let campaign = $('input[name="UCAMPAIGN"]').val() || urlParams.get('ucampaign') || "";
            let content = $('input[name="UCONTENT"]').val() || urlParams.get('ucontent') || "";
            let term = $('input[name="UTERM"]').val() || urlParams.get('uterm') || "";
            let ireferrerVal = $('input[name="IREFERRER"]').val() || urlParams.get('ireferrer') || "";
            let lreferrerVal = $('input[name="LREFERRER"]').val() || urlParams.get('lreferrer') || "";
            let ilandpageVal = $('input[name="ILANDPAGE"]').val() || urlParams.get('ilandpage') || "";
            let visitsVal = $('input[name="VISITS"]').val() || urlParams.get('visits') || "";
             
            formData.set("USOURCE", source);
            formData.set("UMEDIUM", medium);
            formData.set("UCAMPAIGN", campaign);
            formData.set("UCONTENT", content);
            formData.set("UTERM", term);
            formData.set("IREFERRER", ireferrerVal);
            formData.set("LREFERRER", lreferrerVal);
            formData.set("ILANDPAGE", ilandpageVal);
            formData.set("VISITS", visitsVal);

            formData.set("usource", source);
            formData.set("umedium", medium);
            formData.set("ucampaign", campaign);
            formData.set("ucontent", content);
            formData.set("uterm", term);
            formData.set("ireferrer", ireferrerVal);
            formData.set("lreferrer", lreferrerVal);
            formData.set("ilandpage", ilandpageVal);
            formData.set("visits", visitsVal);

            if (selectedProjectId !== "" && selectedProjectId !== undefined && selectedProjectId !== null) {
                formData.append("project_id", selectedProjectId);
            }
            if (selectedType !== "" && selectedType !== undefined && selectedType !== null) {
                formData.append("type_name", selectedType);
            }

            let path = window.location.pathname;
            let segments = path.split('/').filter(Boolean);

            let pageName;

            // Home page detection
            if (
                path === '/' ||
                path === '/kohinoor-group-portal/'
            ) {
                pageName = 'home';
            } else {
                pageName = segments[segments.length - 1];
            }

            formData.append("page_name", pageName);

            console.log(pageName);
            $.ajax({
                type: "POST",
                url: apipath + "/addlead",
                data: formData,
                dataType: 'json',
                cache: false,
                contentType: false,
                processData: false,
                headers: {
                    'Authorization': 'Bearer ' + API_TOKEN
                },
                success: function(data) {
                    if (data.status == 200) {
                        closeModel('enquire-now');
                        $(".form-control").val("");
                        $(".selectproject").trigger("change");
                        // Reset OTP UI for the Enquire Now form
                        $(".leads-adds .otp-field-enquire").addClass("d-none");
                        $(".leads-adds .otp-error-enquire").text('').hide();
                        $(".leads-adds button[name='send-otp']").text('SEND OTP').attr('disabled', false);
                        Swal.fire({
                            title: "Success!",
                            text: data.message || "Thank You!",
                            color: "#aa8a4b",
                            timer: 2000,
                            showConfirmButton: false
                        });

                        if (selectedType == "Brochure" && selectedProjectId) {
                            let brochureUrl = $('[data-project_id="' + selectedProjectId + '"][data-type="Brochure"]').attr('data-brochure_file');
                            if (brochureUrl) {
                                var link = document.createElement('a');
                                link.href = brochureUrl;
                                link.download = '';
                                document.body.appendChild(link);
                                link.click();
                                document.body.removeChild(link);
                            }
                        }
                        if (selectedType == "Floor Plan") {
                            $(".floor-plans-img").addClass("eligibility");
                            const eligibilityData = {
                                status: true,
                                timestamp: new Date().getTime() // current time in ms
                            };
                            localStorage.setItem("floorPlanEligibility", JSON.stringify(eligibilityData));
                        }
                        // location.reload();

                    }
                },
                complete: function() {
                    $(".leadadds").text('SUBMIT').attr('disabled', false);
                    // Keep the modal open when an invalid-OTP error is being shown inline,
                    // otherwise close it as usual.
                    if (!window.__keepEnquireModalOpen) {
                        closeModel('enquire-now');
                    }
                    window.__keepEnquireModalOpen = false;
                },
                error: function(xhr) {
                    $(".leadadds").text('SUBMIT').attr('disabled', false);
                    var response = {};
                    try {
                        response = JSON.parse(xhr.responseText);
                    } catch (e) {
                        response = {};
                    }

                    if (response.status == 400 && response.error) {
                        // If the error is specifically about the OTP, show it inline
                        // under the OTP field and keep the modal open so the user can retry.
                        if (response.error.otp) {
                            window.__keepEnquireModalOpen = true;
                            var otpMsg = Array.isArray(response.error.otp) ? response.error.otp.join(" ") : response.error.otp;
                            $(".leads-adds .otp-error-enquire").text(otpMsg).show();
                            $(".leads-adds input[name='otp']").focus();
                            return;
                        }

                        // Any other 400 validation error: show as before
                        let message = "";
                        for (let key in response.error) {
                            if (response.error.hasOwnProperty(key)) {
                                message += response.error[key] + " ";
                            }
                        }
                        closeModel('enquire-now');
                        Swal.fire(message.trim(), "", "warning");
                    } else {
                        closeModel('enquire-now');
                        Swal.fire("Something went wrong. Please try again.", "", "error");
                    }
                }
            });

            return false;
        }
    });
    document.addEventListener('DOMContentLoaded', function() {
        updateMobileValidation();
    });

    function updateMobileValidation() {
        var $mobile = $("#mobile_number");

        // Bail out on pages that don't have the mobile number field
        if ($mobile.length === 0) {
            return;
        }

        var code = $("#country_code").val();
        var minLen = code === "+91" ? 10 : 8;
        var maxLen = code === "+91" ? 10 : 15;

        $mobile.attr({
            minlength: minLen,
            maxlength: maxLen
        });

        $mobile.rules("add", {
            minlength: minLen,
            maxlength: maxLen,
            messages: {
                minlength: `Please enter a number with at least ${minLen} digits.`,
                maxlength: `Please enter a number more than ${maxLen} digits.`
            }
        });

        // only re-validate if the user has actually typed something
        var mobileVal = $mobile.val() || "";
        if (mobileVal.length > 0) {
            $mobile.valid();
        }
    }

    // search in header 
    $(document).ready(function() {
        getallprojecttype();
        getProjectLocation();
        getallconfiguration();
    });

    function getallprojecttype() {
        $.ajax({
            type: "POST",
            url: apipath + "/getallprojecttype",
            dataType: 'json',
            headers: {
                'Authorization': 'Bearer ' + API_TOKEN
            },
            success: function(result) {
                if (result.status == 200) {
                    let decodedData = JSON.parse(atob(result.data));
                    // Clear and add default option
                    $("#project_type_id").html('<option value="" selected>Select</option>');
                    $("#project_type_id2").html('<option value="" selected>Select</option>');
                    $("#our_project_type").html('<option value="" selected>Select</option>');

                    // Filter only Residential and Commercial
                    $.each(decodedData, function(i, item) {
                        let typeName = item.project_type?.toLowerCase(); // safe check
                        if (typeName === 'residential' || typeName === 'commercial') {
                            let option = "<option value='" + item.project_type_id + "'>" + item.project_type + "</option>";
                            // Populate all filter dropdowns synchronously so header,
                            // home-body and our-projects filters stay in sync.
                            $("#project_type_id").append(option);
                            $("#project_type_id2").append(option);
                            $("#our_project_type").append(option);
                        }
                    });

                    // ✅ Apply stored project_type_id after project types are loaded
                    const storedParams = JSON.parse(localStorage.getItem('searchParams'));
                    if (storedParams?.project_type_id) {
                        $('#project_type_id, #project_type_id2, #our_project_type')
                            .val(storedParams.project_type_id)
                            .trigger('change');
                    }

                }
            }
        });
    }


