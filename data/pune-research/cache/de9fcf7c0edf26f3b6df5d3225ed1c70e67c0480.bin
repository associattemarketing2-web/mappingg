                emailfull: true
            },
            phone: {
                required: true,
                minlength: function () {
                    var country_code = $("#countryCode").val();

                    if (country_code == "+91") {
                        return 10;
                    } else {
                        return 7;
                    }
                },
                maxlength: function () {
                    var country_code = $("#countryCode").val();

                    if (country_code == "+91") {
                        return 10;
                    } else {
                        return 12;
                    }
                }
            },
            region: {
                required: true
            }
        },
        messages: {
            phone: {
                required: "Please enter contact number",
                minlength: "Please put min {0} digit contact number",
                maxlength: "Please put max {0} digit contact number"
            },
            name: {
                required: "Please enter your name"
            },
            email: {
                required: "Please enter your email"
            },
            region: {
                required: "Please select preferred region"
            }
        },
        errorPlacement: function (error, element) {

            if (element.attr("name") == "name") {
                error.insertAfter(element);
            }
            else if (element.attr("name") == "email") {
                error.insertAfter(element);
            }
            else if (element.attr("name") == "phone") {
                error.insertAfter(element.closest(".pkc__contactform__phone"));
            }
            else if (element.attr("name") == "region") {
                error.insertAfter(element);
            }
            else {
                error.insertAfter(element);
            }
        },
          submitHandler: function(form, event) {
            // Hide loader when form submit
            var enquiryuseremail = $("input[name='email']").val();
            var bookusercontactnumber = $("input[name='phone']").val();

            if (typeof Evergage !== 'undefined' && typeof Evergage.sendEvent === 'function') {
                Evergage.sendEvent({
                    action: "Registration",
                    user: {
                        id: bookusercontactnumber,
                        attributes: {
                            emailAddress: enquiryuseremail
                        }
                    }
                });
            }

            $("#preloader").hide();

            var country_code = $("#countryCode").val();
            var book_user_contact_number = $("input[name='phone']").val();
            var firstDigit = book_user_contact_number.toString()[0];

            if (country_code == "+91" && firstDigit == "0") {

                alert("Contact number should not start with 0");
                $("input[name='phone']").focus();
                return false;

            } else {

                $("#preloader").show();

                var book_user_name = $("input[name='name']").val();
                var book_user_email = $("input[name='email']").val();
                var book_user_contact_number = $("input[name='phone']").val();

                var countryCodeField = $("#countryCode").val();
                var preferedregion = $("select[name='region']").val();

                var country = countryName(countryCodeField);

                var book_whatsapp = $("input[name='consent']").is(":checked") ? 1 : 0;

                var url = "https://www.kalpataru.com/";

                var csrf_token = $("#book_csrf_token").val();
                

                var data = {
                    "b_name": book_user_name,
                    "b_email": book_user_email,
                    "b_contactno": book_user_contact_number,
                    "b_whatsapp": book_whatsapp,
                    "url": url,
                    "country": country,
                    "device_type": device_type,
                    "utm_source": utm_source,
                    "utm_campaign": utm_campaign,
                    "utm_medium": utm_medium,
                    "utm_adset": utm_adset,
                    "utm_placement": utm_placement,
                    "utm_term": utm_term,
                    "utm_ad": utm_ad,
                    "utm_site": utm_site,
                    "utm_content": utm_content,
                    "csrf_token": csrf_token,
                    "gclid": gclid,
                    "countryCodeField": countryCodeField,
                    "preferedregion": preferedregion
                };           
             console.log(data);
             $.ajax({
              url: 'https://www.kalpataru.com/website/salesforce',
              type: 'POST',
              data: JSON.stringify(data),
              contentType: 'application/json; charset=utf-8',
              dataType: 'json',
              async: true,
              success: function(data)
              {
                  $("#preloader").hide();
                  console.log(data);

                  // INDIA (+91)
                  if (countryCodeField == '+91')
                  {
                      // Reset the page form
                      $("#enquiryform_immensa")[0].reset();

                      // Open OTP popup
                      $('#otpPage').modal({
                          backdrop: 'static',
                          keyboard: false
                      });

                      $('#otpPage').modal('show');

                      $('#otpPage').on('hidden.bs.modal', function () {
                          $('.modal-backdrop').remove();
                          $('body').removeClass('modal-open');
                      });

                      return;
                  }

                  // NON INDIA
                  
                  // Reset the page form
                  $("#enquiryform_immensa")[0].reset();

                  window.location.href = 'https://www.kalpataru.com/' + data["thankyou_slug"];
              },
            error: function(xhr) {
              $("#preloader").hide();
              var res = xhr.responseJSON;
              console.log(res);
              if (res && res.errors) {
                  // Display error messages next to fields
                  if (res.errors.b_name) {
                      $('#enquiry_error_name').text(res.errors.b_name);
                  }
                  if (res.errors.b_email) {
                      $('#enquiry_error_email').text(res.errors.b_email);
                  }
                  if (res.errors.b_contactno) {
                      $('#enquiry_error_contact').text(res.errors.b_contactno);
                  }
              }
              else{
                // alert(res.message);
                $('#enquiry_popup_error').text(res.message);
              }
            }
          });
           }
         }
       });
// immense page footer form end here
</script>        <script type="text/javascript">
            $(".nav-highlight").removeClass('active');
            $(".nav-leadership").addClass('active');
        </script>
</body>

</html>