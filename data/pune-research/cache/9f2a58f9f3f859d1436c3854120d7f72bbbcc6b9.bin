	color: #2A3B6D;
}

/*** 

====================================================================
						Home-Page-Five
====================================================================

***/

.project-style-two.black-bg .view-btn a:hover {
	color: #2A3B6D;
}


/*** 

====================================================================
						Home-Page-Five
====================================================================

***/


/** slider-style-five **/

.project-block-one .lower-content h4 a:hover {
	color: #2A3B6D;
}

.pricing-table:hover {
	border-top: 5px solid #2A3B6D;
}

.pricing-table .table-header .price {
	color: #2A3B6D;
}

