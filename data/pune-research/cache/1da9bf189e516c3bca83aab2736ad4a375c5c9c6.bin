                                            page_body = page_body.replace("##OUR_INDEX##", sliderHtml);
                                            $("#page-data-append").append(page_body);
                                            // The home-body filter (project_type_id2 / location_id2 /
                                            // configuration_id2) only exists in the DOM after this
                                            // injection, so populate the dropdowns now.
                                            if (typeof getallprojecttype === 'function') getallprojecttype();
                                            if (typeof getProjectLocation === 'function') getProjectLocation();
                                            if (typeof getallconfiguration === 'function') getallconfiguration();
                                            setTimeout((() => {
                                                new Splide("#brand-logo-slider", {
                                                    type: "loop",
