  .mobile-menu {
    position: fixed;
    max-width: 100%;
    padding: 20px;
    right: 0;
    left: -100%;
    top: 0;
    z-index: 9999;
    background: #ffffff;
    height: 100vh;
    transition: all 0.7s;
    overflow: hidden;
  }
  .showmobmenu {
    left: 0% !important;
  }
  .mobmaintablink {
    position: relative;
    font-size: 18px;
    color: #000000;
    border-bottom: 1px solid #E2E5EB;
    display: block;
    width: 100%;
    padding: 10px 0;
    font-weight: 500 !important;
    cursor: pointer;
  }
  .secondlevel-menu {
    margin: 0px 0;
    padding: 0;
    list-style: none;
    visibility: hidden;
    opacity: 0;
    transition: all 0.2s;
    height: 0;
  }
  .secondlevel-menu.activechildmenu {
    margin: 20px 0;
    visibility: visible;
    opacity: 1;
    height: 100%;
  }
  .secondlevel-menu > li a {
    font-size: 18px;
    padding: 5px 0;
    display: block;
  }
  .mobmaintablink:before {
    position: absolute;
    content: '';
    right: 0;
    top: 23px;
    width: 20px;
    height: 2px;
    background: #000000;
  }
  .mobmaintablink:after {
    position: absolute;
    content: '';
    right: 9px;
    top: 14px;
    width: 2px;
    height: 20px;
    background: #000000;
  }
  .nochildmobmenu .mobmaintablink:after, .nochildmobmenu .mobmaintablink:before {
    display: none;
  }
  .mob-menu-title {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .mob-menu-title img {
    height: 60px;
    margin-bottom: 15px;
  }
  .mobsecondlevelparent .bus-catlink {
    position: relative;
    display: block;
    width: 100%;
    padding: 7px 0;
    font-size: 19px;
  }
  .mobsecondlevelparent .bus-catlink:after {
    position: absolute;
    content: '';
    right: 0;
    top: 12px;
    width: 10px;
    height: 16px;
    background: url(https://www.forcemotors.com/wp-content/uploads/2025/02/menu-arrow-black.svg) no-repeat;
    background-size: 8px;
  }
  .bus-catlink {
    cursor: pointer;
  }
  .mob-model-firstlevel {
    margin: 0;
    padding: 0 0 150px;
    list-style: none;
    background:#ffffff;
  }
  .mob-model-secondlevel {
    margin: 30px 20px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .mob-model-secondlevel li {
    width: 49%;
    margin-bottom: 25px;
    border-bottom: 1px solid #ddd;
  }
  .mob-model-secondlevel li a {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0 20px 25px;
  }
  .mob-model-secondlevel li a span {
    display: block;
    width: 100%;
    text-align: center;
    max-width: 191px;
    line-height: 23px;
  }
  .mob-model-secondlevel li a img {
    height: 141px;
    width: auto;
  }
  .mobmcontainer#mobcatname_gurkha .mob-model-secondlevel li:first-child, .mobmcontainer#mobcatname_urbania .mob-model-secondlevel li:first-child {
    display: none !important;
  }
  .mob-model-firstlevel .catlink-disable span {
    display: block !important;
    background: transparent !important;
    padding: 0 !important;
    text-align: center !important;
    font-size: 21px !important;
    color: #000000;
  }
  .mob-model-firstlevel .catlink-disable:after {
    display: none !important;
  }
  .mob-menu-models {
    position: absolute;
    top: 0;
    background: #ffffff;
    width: 100%;
    left: auto;
    right: -150%;
    z-index: 99;
    height: 100%;
    transition: all 1s;
  }
  .mobmcontainer {
    position: absolute;
    top: 0;
    background: #ffffff;
    width: 100%;
    left: auto;
    right: -150%;
    height: 100%;
    transition: all 1s;
  }
  .firstlevel-menu {
    position: relative;
    height: 100vh;
    overflow: hidden;
    overflow-y: scroll;
  }
  .mobmcontainer.activemobmodel {
    right: 150% !important
  }
  .closemobmenu {
    position: absolute;
    right: 0;
    top: 0;
    width: 25px;
    height: 25px;
  }
  .closemobmenu:after {
    position: absolute;
    content: '';
    left: 0;
    top: 10px;
    width: 25px;
    height: 2px;
    background: #000;
    transition: all 0.5s;
    transform: rotate(45deg);
  }
  .closemobmenu:before {
    position: absolute;
    content: '';
    left: 0;
    top: 10px;
    width: 25px;
    height: 2px;
    background: #000;
    transition: all 0.5s;
    transform: rotate(-45deg);
  }
  .mob-model-firstlevel h5 {
    display: block !important;
    padding: 0 !important;
    text-align: center !important;
    font-size: 23px !important;
    color: #0074C3;
    position: relative;
    cursor: pointer;
  }
  .mob-model-firstlevel h5:after {
    background: url(https://www.forcemotors.com/wp-content/uploads/2025/02/menuback-arrow.svg) no-repeat;
    position: absolute;
    content: 'back';
    left: 0;
    top: 6px;
    width: 65px;
    height: 18px;
    background-size: 9px;
    font-size: 15px;
    color: #626262;
  }
  body.unscroll {
    overflow:hidden;
  }
  .activeurl, .activeurl span {
    color: var(--hover) !important;
  }
  @media(max-width:1024px) {
    div#mobcatname_urbania .catlink-disable, div#mobcatname_gurkha .catlink-disable {
      display: none;
    }
    .customugtext {
      margin-top: 20px;
    }
    .menu-secondlevel-post li {
      width: 25% !important;
    }
  } 
  @media(max-width:767px) {
    .customugtext {
      flex-wrap: wrap;
      justify-content: center;
    }
    .mob-model-firstlevel .catlink-disable span {
      padding: 10px 0 20px !important;
    }
    .menu-secondlevel-post li {
      width: 50% !important;
    }
    .mob-model-secondlevel li a span {
      line-height: 20px !important;
      font-size: 14px !important;
      margin-top: 10px !important;
    }
    .mob-model-secondlevel li a {
      padding: 0 5px 25px !important; 
    }
    .mob-model-secondlevel li a img {
      height: 78px !important;
    }
    .mob-model-secondlevel {
        margin: 30px 0px;
    }
  }</style><script type="text/javascript" src="data:text/javascript;base64," defer></script><script type="text/javascript" src="data:text/javascript;base64," defer></script><div class="mega-menu-wrap hidemenu"><div class="ast-container"><div class="mega-menu-row"><div class="mega-menu-tabs"><div class="categorywrap"><h3>Commercial Vehicles</h3><ul><li class="cattabs"><a href="https://www.forcemotors.com/vehicles-category/traveller/" data-tag="catname_traveller">Traveller N</a></li><li class="cattabs"><a href="https://www.forcemotors.com/vehicles-category/urbania/" data-tag="catname_urbania">Urbania DX</a></li><li class="cattabs"><a href="https://www.forcemotors.com/vehicles-category/monobus/" data-tag="catname_monobus">Monobus</a></li><li class="cattabs"><a href="https://www.forcemotors.com/vehicles-category/trax/" data-tag="catname_trax">Trax</a></li><li class="cattabs"><a href="https://www.forcemotors.com/vehicles-category/special-applications/" data-tag="catname_special-applications">Special Applications</a></li></ul></div><div class="categorywrap"><h3>Special Vehicles</h3><ul><li class="cattabs"><a href="https://www.forcemotors.com/vehicles-category/gurkha/" data-tag="catname_gurkha">Gurkha</a></li></ul></div><div class="categorywrap"><h3>Electric Vehicle</h3><ul><li class="cattabs"><a href="https://www.forcemotors.com/vehicles-category/ev/" data-tag="catname_ev">EV</a></li></ul></div></div><div class="mega-menu-links"><div class="mm-container hidediv" id="catname_traveller"><ul class="menu-firstlevel-post"><li><a href="#." class="catlink-disable"><span>Passenger Vehicles</span></a><ul class="menu-secondlevel-post"><li>
