                // NON INDIA
                if (response.status == true) {

                    $("#enquiry_popup_form5")[0].reset();

                    window.location.href = window.location.origin + "/thank-you";
                }
            },

            error: function (xhr) {

                $("#preloader").hide();
                console.log(xhr.responseText);

                alert("Something went wrong. Please try again.");
            }
        });

        return false;
    }
});
