<script>
    function loaderToggle(status) {
        console.log("loaderToggle..." + status);
        console.log(loaderToggle.caller);
        if (status == true) {
            $(".loader").fadeIn(300);
        } else {
            $(".loader").fadeOut(300);
        }
    }
</script>
