    <div id="root"></div>
    <script>
      (function() {
        var path = window.location.pathname;
        var isGreenfinity = path === '/greenfinity' || path.startsWith('/greenfinity/');
        var isAdmin = path.startsWith('/admin');
        var isChatbot = path === '/chatbot';

        if (isGreenfinity) {
          var s = document.createElement('script');
          s.defer = true;
          s.type = 'text/javascript';
          s.setAttribute('data-bot', '24381295');
          s.src = 'https://www.kenyt.ai/botapp/ChatbotUI/dist/js/bot-loader.js';
          document.body.appendChild(s);
        } else if (!isAdmin && !isChatbot) {
          var s = document.createElement('script');
          s.defer = true;
          s.type = 'text/javascript';
          s.setAttribute('data-bot', '23315042');
          s.src = 'https://www.kenyt.ai/botapp/ChatbotUI/dist/js/bot-loader.js';
          document.body.appendChild(s);
        }
      })();
    </script>
