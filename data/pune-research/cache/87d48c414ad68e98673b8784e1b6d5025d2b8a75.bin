oading="eager" width="500" height="800" decoding="async" data-nimg="1" class="d-block d-md-none img-fluid w-100 h-auto bannerimg mobbanner" style="color:transparent" srcSet="/_next/image?url=%2Fuploads%2FMobile_Banner_opt2.jpg&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fuploads%2FMobile_Banner_opt2.jpg&amp;w=1080&amp;q=75 2x" src="/_next/image?url=%2Fuploads%2FMobile_Banner_opt2.jpg&amp;w=1080&amp;q=75"/><div class="banner_slider_box__RdzO8"><div class="container"><div class="row"><div class="col-md-9"><div></div></div></div></div></div></div></div></div><div class="swiper-nav home_nav"><div class="mx-auto container"><div class="navbutton d-flex justify-content-between"><button class="home-swiper-button-prev position-relative" aria-label="Prev"><svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="30" cy="30" r="29.75" stroke="white" stroke-width="0.5"></circle><path d="M17.6464 29.6464C17.4512 29.8417 17.4512 30.1583 17.6464 30.3536L20.8284 33.5355C21.0237 33.7308 21.3403 33.7308 21.5355 33.5355C21.7308 33.3403 21.7308 33.0237 21.5355 32.8284L18.7071 30L21.5355 27.1716C21.7308 26.9763 21.7308 26.6597 21.5355 26.4645C21.3403 26.2692 21.0237 26.2692 20.8284 26.4645L17.6464 29.6464ZM43 29.5L18 29.5V30.5L43 30.5V29.5Z" fill="white"></path></svg></button><button class="home-swiper-button-next position-relative" aria-label="Next"><svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="30" cy="30" r="29.75" transform="matrix(-1 0 0 1 60 0)" stroke="white" stroke-width="0.5"></circle><path d="M42.3536 29.6464C42.5488 29.8417 42.5488 30.1583 42.3536 30.3536L39.1716 33.5355C38.9763 33.7308 38.6597 33.7308 38.4645 33.5355C38.2692 33.3403 38.2692 33.0237 38.4645 32.8284L41.2929 30L38.4645 27.1716C38.2692 26.9763 38.2692 26.6597 38.4645 26.4645C38.6597 26.2692 38.9763 26.2692 39.1716 26.4645L42.3536 29.6464ZM17 29.5L42 29.5V30.5L17 30.5V29.5Z" fill="white"></path></svg></button></div></div></div></div></div><div data-section="Overview"><section class="sec-padd overview position-relative oversection "><div class="rotatebox topleft"></div><div class="container"><div class="g-4 gx-xl-5 row"><div class="col-xl-7 col-lg-6 col-md-12"><div class="head_wrap"><div class="head_wrap"><h3 class="section-title  " data-splitting="">Perfecting the Art of Development. Since 1975.</h3></div></div><div class="contentwrap"><div><p style="margin-left:0px;">Puravankara is one of the leading real estate developers in India, with over five decades of excellence in thoughtfully designed residential and commercial developments.</p><p style="margin-left:0px;">With its presence across 9 cities, the company has built a strong reputation for quality, innovation, and customer-centricity. Its diverse portfolio spans luxury apartments, premium homes, plotted developments, and commercial spaces, consistently setting benchmarks in design, construction quality, and timely delivery.</p><p style="margin-left:0px;">From thoughtfully planned homes to vibrant communities, Puravankara remains committed to creating lasting value, enhancing lifestyles, and delivering spaces that inspire generations across India's growing urban landscapes.</p></div><div class="btnwrap"><a href="/about-us" class="flat_btn">Know More</a></div></div></div><div class="col-xl-5 col-lg-6 col-md-12"><div class="content-wrapper ms-xl-3 mt-md-0"><div class="counter-container"><div class="counter-wrapper position-relative"><div style="opacity:0;transform:translateY(40px)"><div class="rotatebox position-absolute top-0 start-0 end-0 centerbox mb-4 text-center"></div></div><div class="row g-2 g-sm-4 justify-content-center"><div class="col-6 col-lg-6"><div class="counter_item"><div class="icon_wrap"><img alt="real estate developers in India" loading="lazy" width="88" height="88" decoding="async" data-nimg="1" class="img-fluid" style="color:transparent" srcSet="/_next/image?url=%2Fuploads%2Ficon1_53aeebad3d.svg&