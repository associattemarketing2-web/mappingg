<script>
    $(document).ready((function() {
        $(".sidebar-menu-item h5").on("click", (function() {
            const e = $(this).siblings(".sidebar-menu-link");
            var s;
            s = e, $(".sidebar-menu-link.open").not(s).each((function() {
                    const e = $(this),
                        s = e.closest(".sidebar-menu-item");
                    e.css("height", e[0].scrollHeight + "px"), requestAnimationFrame((() => {
                        e.css("height", "0px").removeClass("open"), s.removeClass("menu-active")
                    }))
                })),
                function(e) {
                    const s = e.closest(".sidebar-menu-item"),
                        n = e.hasClass("open"),
                        i = e[0].scrollHeight;
                    n ? (e.css("height", i + "px"), requestAnimationFrame((() => {
                        e.css("height", "0px"), e.removeClass("open"), s.removeClass("menu-active")
                    }))) : (e.addClass("open"), e.css("height", i + "px"), s.addClass("menu-active"))
                }(e)
        })), $(".sidebar-menu-link").on("transitionend", (function() {
            $(this).hasClass("open") && $(this).css("height", "auto")
        }))
    }));
</script>

<script>
    document.addEventListener("DOMContentLoaded", (function() {
        function t(t) {
            const e = document.querySelector(t),
                o = document.getElementById("header"),
                n = o ? o.offsetHeight : 0;
            if (e) {
                const t = e.getBoundingClientRect().top + window.pageYOffset - n;
                window.scrollTo({
                    top: t,
                    behavior: "smooth"
                })
            }
        }
        window.location.hash && setTimeout((() => {
            t(window.location.hash)
        }), 100), document.querySelectorAll(".menu-link").forEach((e => {
            e.addEventListener("click", (function(e) {
                const o = this.getAttribute("href"),
                    [n, i] = o.split("#"),
                    c = window.location.pathname.split("/").pop();
                "" !== n && n !== c || !i || (e.preventDefault(), "function" == typeof menuclose && menuclose(), setTimeout((() => {
                    history.pushState(null, null, "#" + i), t("#" + i)
                }), 300))
            }))
        }))
    }));
</script>



<script>
    $(document).ready(function() {
        // getmenu(page = 1, offset = 0, limit = 200);
        getpage();
        $('.page-loader').addClass('active');

        let pathname = window.location.pathname;
        let url = pathname.split('/').pop();
        if (url == "projects-detail") {
            $("#hideproject").hide();
        }


        function getpage() {

            const fullPath = window.location.pathname.replace(/^\/+|\/+$/g, ''); // Trim slashes
            const pathSegments = fullPath.split('/');
            if (pathSegments.length === 1 && pathSegments[0] === "kohinoor-group-portal") {
                slug_name = "index";
            } else {
                slug_name = pathSegments[pathSegments.length - 1] || "index";
            }
            showLoader();
            var page1 = 'brand-story';

            var slugName = page1;
            var formdata = {
                "limit": 10,
                "offset": 0,
                "status": 1,
                "slug_name": slugName ? slugName : slug_name
            };

            $.ajax({
                type: "POST",
                dataType: 'json',
                url: apipath + "/getcmsallpage",
                data: formdata,
                headers: {
                    'Authorization': 'Bearer ' + API_TOKEN
                },
                success: function(result) {
                    if (result.status == 200 && result.count != 0) {
                        $('span.shimmer').remove();
                        $.each(result.data, function(i, item) {
                            if (item.page_body != null && item.page_body != "") {
                                var appUrl = "https://iamkohinoor.com/";
                                var imagepath = appUrl + "/resources/assets/frontcss";
                                var url = appUrl;
