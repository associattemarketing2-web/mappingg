<!-- NEW DROPDOWN MENU JS START  -->
<script>
    const navToggle = document.getElementById("navToggle");
  const navMenu = document.getElementById("navMenu");

  navToggle?.addEventListener("click", () => {
    navMenu.classList.toggle("navmenu__menu--open");
    navToggle.textContent = navMenu.classList.contains("navmenu__menu--open") ? "✖" : "☰";
  });

   
  document.querySelectorAll(".navmenu__item--has-submenu > .navmenu__link").forEach(link => {
    link.addEventListener("click", e => {
      if (window.innerWidth < 992) {
        e.preventDefault();
        const parent = link.parentElement;
        parent.classList.toggle("isOpen");
      }
    });
  });

   
  document.querySelectorAll(".navmenu__item--has-submenu").forEach(item => {
    item.addEventListener("mouseenter", () => {
      if (window.innerWidth >= 992) {
        item.classList.add("isOpen");
      }
    });
    item.addEventListener("mouseleave", () => {
      if (window.innerWidth >= 992) {
        item.classList.remove("isOpen");
      }
    });
  });
</script>
<!-- NEW DROPDOWN MENU JS END  -->

