                'name1': name1,
                'email1': email1,
                'phone1': phone1,
                'city1': city1,
                'response1': response1,
                'g_recaptcha': g_recaptcha
            },
            success: function(response) {
                console.log(response);
                if (response.status == true) {
                    alert("Your Enquiry has been sent successfully ..!");
                    $("#formfeedback").trigger("reset");
                    $("#error3").html("");
                    $("#send1").html('Send');
                    $('#send1').prop('disabled', false);
                    $('#feedback').modal('hide');
