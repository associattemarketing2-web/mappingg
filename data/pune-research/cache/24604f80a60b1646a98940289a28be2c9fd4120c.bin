<script> 
/*NORMAL-JS-xSNN-KBrr-dRiR-Awzs */
function onLoadxSNNKBrrdRiRAwzs()
{
}
$(document).ready(function(){
try {google.setOnLoadCallback(onLoadxSNNKBrrdRiRAwzs);} catch(e){}
		var timer = setInterval(function(){
            if($('#xSNN-KBrr-dRiR-Awzs').length){
            	//Hide & Show Fixed Menu
				$(window).scroll(function(){
					var pos = $(window).scrollTop();
					if(pos > 300){
						$('#xSNN-KBrr-dRiR-Awzs .fixed').css('top','0px');
					}else{
						$('#xSNN-KBrr-dRiR-Awzs .fixed').css('top','-200px');
					}
				});
				//Hide & Show Mobile Menu
				$('#xSNN-KBrr-dRiR-Awzs .mobile_menu_icon').unbind('click').click(function(){
                 var right = $('#xSNN-KBrr-dRiR-Awzs .mobile_menu').css('right');
					var left = $('#xSNN-KBrr-dRiR-Awzs .mobile_menu').css('left');
                 if(left == '-300px'){
                     $('#xSNN-KBrr-dRiR-Awzs .overlay').fadeIn();
                     $('#xSNN-KBrr-dRiR-Awzs .mobile_menu').css('left','0px');
                 }else{
                     if(left == '0px'){
                         $('#xSNN-KBrr-dRiR-Awzs .mobile_menu').css('left','-300px');
                         $('#xSNN-KBrr-dRiR-Awzs .overlay').fadeOut();
                     }else{
                         if(right == '-300px'){
                             $('#xSNN-KBrr-dRiR-Awzs .overlay').fadeIn();
                             $('#xSNN-KBrr-dRiR-Awzs .mobile_menu').css('right','0px');
                         }else{
                             $('#xSNN-KBrr-dRiR-Awzs .mobile_menu').css('right','-300px');
                             $('#xSNN-KBrr-dRiR-Awzs .overlay').fadeOut();
                         }
                     }
                 }
				});
				//Hide Mobile Menu & Search
				$('#xSNN-KBrr-dRiR-Awzs .mobile_menu .close_icon, #xSNN-KBrr-dRiR-Awzs .overlay, #xSNN-KBrr-dRiR-Awzs .search_icon form i.fa-times').unbind('click').click(function(){
                 if($('#xSNN-KBrr-dRiR-Awzs .mobile_menu').css('right') == '0px'){
                     $('#xSNN-KBrr-dRiR-Awzs .mobile_menu').css('right','-300px');
                     $('#xSNN-KBrr-dRiR-Awzs .search_icon form').css('top','-100px');
                     $('#xSNN-KBrr-dRiR-Awzs .overlay').fadeOut();
                 }else{
                     $('#xSNN-KBrr-dRiR-Awzs .mobile_menu').css('left','-300px');
                     $('#xSNN-KBrr-dRiR-Awzs .search_icon form').css('top','-100px');
                     $('#xSNN-KBrr-dRiR-Awzs .overlay').fadeOut();
                 }
				});
				//Show Search
				$('#xSNN-KBrr-dRiR-Awzs .search_icon2').unbind('click').click(function(){
					$('#xSNN-KBrr-dRiR-Awzs .search_icon form').css('top','0px');
					$('#xSNN-KBrr-dRiR-Awzs .overlay').fadeIn();
					setTimeout(function(){
						$('#xSNN-KBrr-dRiR-Awzs .search_icon input[type="text"]').focus();
					});
				});
            	clearInterval(timer);
	        }
	    },1);	
});
</script>
