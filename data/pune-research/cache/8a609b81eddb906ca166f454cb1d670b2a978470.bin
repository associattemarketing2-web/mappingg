ass="w-full h-full object-cover"><source src="/videos/nyati_banner.mp4" type="video/mp4"/></video></div></div></div></div><div class="slider-nav-wrapper"><span class="slide-btn swiper-button-prev" role="button" aria-label="Previous Slide"></span><span class="slide-btn swiper-button-next" role="button" aria-label="Next Slide"></span></div></div></section><section class="leftRight-imgText-sec left-img"><div class="container-fluid"><div class="row justify-content-between align-items-center page-text-content"><div class="col-lg-7 left-side"><div class="img-wrapper"><img alt="Who we are" width="1920" height="1080" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fwho-we-are.jpg&amp;w=1920&amp;q=80 1x, /_next/image?url=%2Fimages%2Fwho-we-are.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fwho-we-are.jpg&amp;w=3840&amp;q=80"/><span class="img-disc-text">Actual Photo*</span></div></div><div class="col-lg-5 content-box-right"><div class="text-content"><h3 class="title-text"><span class="words line"><span class="word"><span class="char">W</span><span class="char">h</span><span class="char">o</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">w</span><span class="char">e</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">a</span><span class="char">r</span><span class="char">e</span></span></span><span class="whitespace"> </span></h3><div class="content-wrapper"><p>The Nyati Group has been at the forefront of Pune&#x27;s Real Estate Scenario since 1997. The brand stands amongst the most admired real estate brands in Pune. The Nyati Group has been shaping lifestyles with specific focus on design and innovation.</p></div><div class="btn-wrapper"><a data-transition="true" class="standard-btn Button-module__e7WGRa__standard-btn" href="/about-us"><span class="Button-module__e7WGRa__text-label"><span data-text="More about us">More about us</span></span><span class="Button-module__e7WGRa__icon"></span></a></div></div></div></div></div></section><section class="featured-projects-sec"><div class="container-fluid"><div class="row justify-content-center"><div class="col-12"><div class="sec-heading-wrapper"><div class="sec--title-wrapper"><h2 class="sec--main-title"><span class="words line"><span class="word"><span class="char">F</span><span class="char">e</span><span class="char">a</span><span class="char">t</span><span class="char">u</span><span class="char">r</span><span class="char">e</span><span class="char">d</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">P</span><span class="char">r</span><span class="char">o</span><span class="char">j</span><span class="char">e</span><span class="char">c</span><span class="char">t</span><span class="char">s</span></span></span><span class="whitespace"> </span></h2></div><a data-transition="true" class="read-more-btn Button-module__e7WGRa__read-more-btn" href="/projects/residential"><span class="Button-module__e7WGRa__text-label"><span data-text="View All Projects">View All Projects</span></span><span class="Button-module__e7WGRa__icon"></span></a></div></div></div></div><div class="container-fluid"><div class="row justify-content-center"><div class="col-12"><div class="featured-projects-list"><div class="project-card-wrapper"><div class="project-card residential"><a data-transition="true" href="/projects/residential/nyati-emerald"><div class="project-card-visual"><img alt="Nyati Emerald" title="Nyati Emerald" loading="lazy" width="1200" height="800" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fprojects%2FEmerald%2Fbanner-img.jpg&amp;w=1200&amp;q=80 1x, /_next/image?url=%2Fimages%2Fprojects%2FEmerald%2Fbanner-img.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fprojects%2FEmerald%2Fbanner-img.jpg&amp;w=3840&amp;q=80"/><div class="inner-content"><span class="location-text"><i class="fa-solid fa-location-dot"></i> <!-- -->Pune - West<b>Baner</b></span><span class="img-disc-text">Artist Impression*</span><div class="text-wrapper"><h2 class="title-text">Nyati Emerald</h2><div class="desc"><p>2 &amp; 3 Bed Residences</p></div></div></div></div></a></div></div><div class="project-card-wrapper"><div class="project-card residential"><a data-transition="true" href="/projects/residential/nyati-esteban2"><div class="project-card-visual"><img alt="Nyati Esteban II" title="Nyati Esteban II" loading="lazy" width="1200" height="800" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fprojects%2FEsteban2%2Fbanner-img.jpg&amp;w=1200&amp;q=80 1x, /_next/image?url=%2Fimages%2Fprojects%2FEsteban2%2Fbanner-img.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fprojects%2FEsteban2%2Fbanner-img.jpg&amp;w=3840&amp;q=80"/><div class="inner-content"><span class="location-text"><i class="fa-solid fa-location-dot"></i> <!-- -->Pune - South<b>Undri</b></span><span class="img-disc-text">Artist Impression*</span><div class="text-wrapper"><h2 class="title-text">Nyati Esteban II</h2><div class="desc"><p>2 &amp; 3 Bed Residences</p></div></div></div></div></a></div></div><div class="project-card-wrapper"><div class="project-card residential"><a data-transition="true" href="/projects/residential/nyati-equinox"><div class="project-card-visual"><img alt="Nyati Equinox" title="Nyati Equinox" loading="lazy" width="1200" height="800" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fprojects%2FEquinox%2Fbanner-img.jpg&amp;w=1200&amp;q=80 1x, /_next/image?url=%2Fimages%2Fprojects%2FEquinox%2Fbanner-img.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fprojects%2FEquinox%2Fbanner-img.jpg&amp;w=3840&amp;q=80"/><div class="inner-content"><span class="location-text"><i class="fa-solid fa-location-dot"></i> <!-- -->Pune - West<b>Bavdhan</b></span><span class="img-disc-text">Artist Impression*</span><div class="text-wrapper"><h2 class="title-text">Nyati Equinox</h2><div class="desc"><p>2, 3, &amp; 4 Bed Residences</p></div></div></div></div></a></div></div><div class="project-card-wrapper"><div class="project-card residential"><a data-transition="true" href="/projects/residential/nyati-era"><div class="project-card-visual"><img alt="Nyati Era" title="Nyati Era" loading="lazy" width="1200" height="800" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fprojects%2FEra%2Fbanner-img.jpg&amp;w=1200&amp;q=80 1x, /_next/image?url=%2Fimages%2Fprojects%2FEra%2Fbanner-img.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fprojects%2FEra%2Fbanner-img.jpg&amp;w=3840&amp;q=80"/><div class="inner-content"><span class="location-text"><i class="fa-solid fa-location-dot"></i> <!-- -->Pune - East<b>Dhanori</b></span><span class="img-disc-text">Artist Impression*</span><div class="text-wrapper"><h2 class="title-text">Nyati Era</h2><div class="desc"><p>2 &amp; 3 Bed Residences</p></div></div></div></div></a></div></div></div></div></div></div></section><section class="home-luxury-projects-sec"><div class="parallax-container" data-height="100%"><div class="parallax-wrapper" style="height:100%"><img alt="Our core values" width="1920" height="1080" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fluxury-features-bg-hr.jpg&amp;w=1920&amp;q=100 1x, /_next/image?url=%2Fimages%2Fluxury-features-bg-hr.jpg&amp;w=3840&amp;q=100 2x" src="/_next/image?url=%2Fimages%2Fluxury-features-bg-hr.jpg&amp;w=3840&amp;q=100"/></div></div><div class="container inner-container"><div class="row justify-content-center align-items-center"><div class="col-lg-5"><div class="sec--title-wrapper"><h2 class="sec--main-title"><span class="words line"><span class="word"><span class="char">L</span><span class="char">u</span><span class="char">x</span><span class="char">u</span><span class="char">r</span><span class="char">y</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">P</span><span class="char">r</span><span class="char">o</span><span class="char">j</span><span class="char">e</span><span class="char">c</span><span class="char">t</span><span class="char">s</span></span></span><span class="whitespace"> </span></h2></div><div class="text-wrapper"><p>At Nyati Group, a home is more than just a place to live. It is a refined lifestyle that embodies sophistication, comfort, and convenience. Each luxury residence is thoughtfully designed, blending timeless elegance with modern innovation to create living spaces that elevate everyday life to extraordinary heights.</p><a data-transition="true" class="standard-btn Button-module__e7WGRa__standard-btn" href="luxury-projects"><span class="Button-module__e7WGRa__text-label"><span data-text="Explore Now">Explore Now</span></span><span class="Button-module__e7WGRa__icon"></span></a></div></div><div class="col-lg-7"><div class="carousel-wrapper"><div class="swiper projects-carousel"><div class="swiper-wrapper"><div class="swiper-slide"><div class="project-card-wrapper"><div class="project-card luxury"><a data-transition="true" href="/luxury-projects/nyati-evania"><div class="project-card-visual"><img alt="Nyati Evania" title="Nyati Evania" loading="lazy" width="1200" height="800" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fprojects%2FEvania%2Fsignature-hallmark-02.jpg&amp;w=1200&amp;q=80 1x, /_next/image?url=%2Fimages%2Fprojects%2FEvania%2Fsignature-hallmark-02.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fprojects%2FEvania%2Fsignature-hallmark-02.jpg&amp;w=3840&amp;q=80"/><div class="inner-content"><span class="location-text"><i class="fa-solid fa-location-dot"></i> <!-- -->Pune - Central<b>Sadashiv Peth</b></span><span class="img-disc-text">Artist Impression*</span><div class="text-wrapper"><h2 class="title-text">Nyati Evania</h2><div class="desc"><p>2, 3, &amp; 4 Bed Residences</p></div></div></div></div></a></div></div></div><div class="swiper-slide"><div class="project-card-wrapper"><div class="project-card luxury"><a data-transition="true" href="/luxury-projects/nyati-evoque"><div class="project-card-visual"><img alt="Nyati Evoque" title="Nyati Evoque" loading="lazy" width="1200" height="800" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fprojects%2FEvoque%2Foverview-img.jpg&amp;w=1200&amp;q=80 1x, /_next/image?url=%2Fimages%2Fprojects%2FEvoque%2Foverview-img.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fprojects%2FEvoque%2Foverview-img.jpg&amp;w=3840&amp;q=80"/><div class="inner-content"><span class="location-text"><i class="fa-solid fa-location-dot"></i> <!-- -->Pune - East<b>Kalyani Nagar</b></span><span class="img-disc-text">Artist Impression*</span><div class="text-wrapper"><h2 class="title-text">Nyati Evoque</h2><div class="desc"><p>3 &amp; 4 Bespoke Residence</p></div></div></div></div></a></div></div></div><div class="swiper-slide"><div class="project-card-wrapper"><div class="project-card luxury"><a data-transition="true" href="/luxury-projects/nyati-emblem"><div class="project-card-visual"><img alt="Nyati Emblem" title="Nyati Emblem" loading="lazy" width="1200" height="800" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fprojects%2FEmblem%2Fbanner-img.jpg&amp;w=1200&amp;q=80 1x, /_next/image?url=%2Fimages%2Fprojects%2FEmblem%2Fbanner-img.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fprojects%2FEmblem%2Fbanner-img.jpg&amp;w=3840&amp;q=80"/><div class="inner-content"><span class="location-text"><i class="fa-solid fa-location-dot"></i> <!-- -->Pune - Central<b>Sahakar Nagar</b></span><span class="img-disc-text">Artist Impression*</span><div class="text-wrapper"><h2 class="title-text">Nyati Emblem</h2><div class="desc"><p>4 BHK Sanctuary Homes</p></div></div></div></div></a></div></div></div><div class="swiper-slide"><div class="project-card-wrapper"><div class="project-card luxury"><a data-transition="true" href="/luxury-projects/nyati-elenor"><div class="project-card-visual"><img alt="Nyati Elenor" title="Nyati Elenor" loading="lazy" width="1200" height="800" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fprojects%2FElenor%2Foverview-img.jpg&amp;w=1200&amp;q=80 1x, /_next/image?url=%2Fimages%2Fprojects%2FElenor%2Foverview-img.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fprojects%2FElenor%2Foverview-img.jpg&amp;w=3840&amp;q=80"/><div class="inner-content"><span class="location-text"><i class="fa-solid fa-location-dot"></i> <!-- -->Pune - South<b>Lulla Nagar</b></span><span class="img-disc-text">Artist Impression*</span><div class="text-wrapper"><h2 class="title-text">Nyati Elenor</h2><div class="desc"><p>3.5 to 5.5 Sky Bed Residences</p></div></div></div></div></a></div></div></div></div></div><div class="slider-nav-wrapper"><span class="slide-btn swiper-button-prev" role="button" aria-label="Previous Slide"></span><span class="slide-btn swiper-button-next" role="button" aria-label="Next Slide"></span></div></div></div></div></div></section><section class="sec-title-sec"><div class="container-fluid"><div class="row"><div class="col-12 text-center"><div class="sec--title-wrapper"><h2 class="sec--main-title"><span class="words line"><span class="word"><span class="char">G</span><span class="char">r</span><span class="char">o</span><span class="char">u</span><span class="char">p</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">B</span><span class="char">u</span><span class="char">s</span><span class="char">i</span><span class="char">n</span><span class="char">e</span><span class="char">s</span><span class="char">s</span><span class="char">e</span><span class="char">s</span></span></span><span class="whitespace"> </span></h2><div class="sec--desc-wrapper"><p class="sec-desc">Since our inception in 1997, we have created strong benchmarks across <br/> the following verticals through our group businesses.</p></div></div></div></div></div></section><section class="leftRight-imgText-sec right-img has-img-carousel group-business-sec"><div class="container-fluid"><div class="row justify-content-between align-items-center page-text-content"><div class="col-lg-5 left-side content-box-left order-last order-lg-first"><div class="text-content"><div class="inner" data-state="active"><h3 class="title-text"><span class="words line"><span class="word"><span class="char">R</span><span class="char">e</span><span class="char">a</span><span class="char">l</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">E</span><span class="char">s</span><span class="char">t</span><span class="char">a</span><span class="char">t</span><span class="char">e</span></span></span><span class="whitespace"> </span></h3><h4 class="sub-title-text">Over 29 years of shaping Pune&#x27;s skyline and beyond, Nyati Group has earned its place as one of the city&#x27;s most preferred developers. Our residential and commercial projects are known for thoughtful design, quality craftsmanship, and timeless appeal. </h4><div class="para">
                <p>
                    From premium apartments with mountain and city views to state-of-the-art business hubs, every address by Nyati Group is envisioned to offer elevated living and enduring value. With 40 million+ sq. ft. delivered and many more in the pipeline, we continue to set new benchmarks in real estate excellence.
                </p>
            </div><div class="counters-row"><div class="counter-item"><span class="counter-text"><span class="counter"></span><span class="suffix small">+</span></span><span class="counter-label">Projects Delivered</span></div><div class="counter-item"><span class="counter-text"><span class="counter"></span><span class="suffix small">+</span></span><span class="counter-label">Million Sq. Ft. Developed</span></div><div class="counter-item"><span class="counter-text"><span class="counter"></span><span class="suffix small">+</span></span><span class="counter-label">Happy Families</span></div></div><div class="btn-wrapper"><a data-transition="true" class="standard-btn Button-module__e7WGRa__standard-btn" href="/real-estate"><span class="Button-module__e7WGRa__text-label"><span data-text="Read more">Read more</span></span><span class="Button-module__e7WGRa__icon"></span></a></div></div><div class="inner" data-state="inactive"><h3 class="title-text"><span class="words line"><span class="word"><span class="char">E</span><span class="char">n</span><span class="char">g</span><span class="char">i</span><span class="char">n</span><span class="char">e</span><span class="char">e</span><span class="char">r</span><span class="char">i</span><span class="char">n</span><span class="char">g</span><span class="char">,</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">P</span><span class="char">r</span><span class="char">o</span><span class="char">c</span><span class="char">u</span><span class="char">r</span><span class="char">e</span><span class="char">m</span><span class="char">e</span><span class="char">n</span><span class="char">t</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">&amp;</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">C</span><span class="char">o</span><span class="char">n</span><span class="char">t</span><span class="char">r</span><span class="char">a</span><span class="char">c</span><span class="char">t</span><span class="char">i</span><span class="char">n</span><span class="char">g</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">(</span><span class="char">E</span><span class="char">P</span><span class="char">C</span><span class="char">)</span></span></span><span class="whitespace"> </span></h3><h4 class="sub-title-text">Innovation meets precision at Nyati EPC. Our expertise spans across residential and commercial developments, IT and ITES campuses, hospitality projects, educational institutes, and infrastructure works such as roads and bridges.</h4><div class="para">
                <p>
                    With a futuristic approach and collaborations with Grade A developers, Nyati EPC is not just building structures-we're building the backbone of progress across India. Our track record reflects reliability, efficiency, and an uncompromising commitment to quality.
                </p>
            </div><div class="counters-row"><div class="counter-item"><span class="counter-text"><span class="counter"></span><span class="suffix small">+</span></span><span class="counter-label">Ongoing Projects</span></div><div class="counter-item"><span class="counter-text"><span class="counter"></span><span class="suffix small">+</span></span><span class="counter-label">Projects Completed</span></div><div class="counter-item"><span class="counter-text"><span class="counter"></span><span class="suffix small">+</span></span><span class="counter-label">Million Sq. Ft. Developed Across India</span></div></div><div class="btn-wrapper"><a data-transition="true" class="standard-btn Button-module__e7WGRa__standard-btn" href="/engineering-procurement-construction"><span class="Button-module__e7WGRa__text-label"><span data-text="Read more">Read more</span></span><span class="Button-module__e7WGRa__icon"></span></a></div></div><div class="inner" data-state="inactive"><h3 class="title-text"><span class="words line"><span class="word"><span class="char">W</span><span class="char">e</span><span class="char">l</span><span class="char">l</span><span class="char">b</span><span class="char">e</span><span class="char">i</span><span class="char">n</span><span class="char">g</span></span></span><span class="whitespace"> </span></h3><div class="para">
                <p>
                    At Nyati Group, we craft luxurious wellness retreats that blend modern amenities with traditional healing. Heart-crafted experiences, Swastik harmonizes the five dimensions of life-Health, Wealth, Love, Bliss, and Spirituality-to help individuals find balance, joy, and fulfillment. Set in tranquil surroundings, Swastik offers rejuvenating spa treatments, personalised fitness programmes, and nutritious dining for holistic well-being. 
                </p>
            </div><div class="btn-wrapper"><a data-transition="true" class="standard-btn Button-module__e7WGRa__standard-btn" href="/wellbeing"><span class="Button-module__e7WGRa__text-label"><span data-text="Read more">Read more</span></span><span class="Button-module__e7WGRa__icon"></span></a></div></div><div class="inner" data-state="inactive"><h3 class="title-text"><span class="words line"><span class="word"><span class="char">H</span><span class="char">o</span><span class="char">s</span><span class="char">p</span><span class="char">i</span><span class="char">t</span><span class="char">a</span><span class="char">l</span><span class="char">i</span><span class="char">t</span><span class="char">y</span></span></span><span class="whitespace"> </span></h3><h4 class="sub-title-text">The Corinthians Resort &amp; Club</h4><div class="para">
                <p>
                    In the Hospitality sector, we've redefined luxury with The Corinthians Resort and Club-a 5-star haven spread across 25 acres in South Pune. Inspired by ancient Greek and Egyptian architecture, its grandeur blends seamlessly with nature. With world-class amenities, impeccable service, and serene surroundings, The Corinthians offers an unparalleled hospitality experience for discerning travellers. The Corinthians is a favourite among business and leisure travellers alike-earning loyalty from guests across India and abroad for decades.
                </p>
            </div><div class="btn-wrapper"><a data-transition="true" class="standard-btn Button-module__e7WGRa__standard-btn" href="/hospitality"><span class="Button-module__e7WGRa__text-label"><span data-text="Read more">Read more</span></span><span class="Button-module__e7WGRa__icon"></span></a></div></div><div class="inner" data-state="inactive"><h3 class="title-text"><span class="words line"><span class="word"><span class="char">N</span><span class="char">L</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">H</span><span class="char">e</span><span class="char">a</span><span class="char">l</span><span class="char">t</span><span class="char">h</span><span class="char">c</span><span class="char">a</span><span class="char">r</span><span class="char">e</span></span></span><span class="whitespace"> </span></h3><div class="para">
                <p>
                    Through NL Healthcare-a collaboration with the Lahoti Group-we're bringing cutting-edge medical equipment, accessories, and services to homes and hospitals alike. From home healthcare solutions and wheelchairs to surgical tools, ICU units, sports equipment, and physiotherapy products, NL Healthcare empowers medical professionals and families to deliver the highest standards of care.
                </p>
            </div><div class="btn-wrapper"><a data-transition="true" class="standard-btn Button-module__e7WGRa__standard-btn" href="/healthcare"><span class="Button-module__e7WGRa__text-label"><span data-text="Read more">Read more</span></span><span class="Button-module__e7WGRa__icon"></span></a></div></div></div></div><div class="col-lg-7"><div class="img-carousel"><div class="carousel-wrapper"><div class="swiper"><div class="swiper-wrapper"><div class="swiper-slide"><div class="img-wrapper"><img alt="Real Estate" loading="lazy" width="1920" height="1080" decoding="async" data-nimg="1" style="color:transparent;object-fit:cover" srcSet="/_next/image?url=%2Fimages%2Fresidential-projects-banner-new.jpg&amp;w=1920&amp;q=80 1x, /_next/image?url=%2Fimages%2Fresidential-projects-banner-new.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fresidential-projects-banner-new.jpg&amp;w=3840&amp;q=80"/><span class="img-disc-text">Artist Impression*</span></div></div><div class="swiper-slide"><div class="img-wrapper"><img alt="Engineering, Procurement &amp; Contracting (EPC)" loading="lazy" width="1920" height="1080" decoding="async" data-nimg="1" style="color:transparent;object-fit:cover" srcSet="/_next/image?url=%2Fimages%2FSymboisis-International-University.jpg&amp;w=1920&amp;q=80 1x, /_next/image?url=%2Fimages%2FSymboisis-International-University.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2FSymboisis-International-University.jpg&amp;w=3840&amp;q=80"/><span class="img-disc-text">Actual Site Photo*</span></div></div><div class="swiper-slide"><div class="img-wrapper"><img alt="Wellbeing" loading="lazy" width="1920" height="1080" decoding="async" data-nimg="1" style="color:transparent;object-fit:cover" srcSet="/_next/image?url=%2Fimages%2Fwellness.jpg&amp;w=1920&amp;q=80 1x, /_next/image?url=%2Fimages%2Fwellness.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fwellness.jpg&amp;w=3840&amp;q=80"/><span class="img-disc-text">Actual Site Photo*</span></div></div><div class="swiper-slide"><div class="img-wrapper"><img alt="Hospitality" loading="lazy" width="1920" height="1080" decoding="async" data-nimg="1" style="color:transparent;object-fit:cover" srcSet="/_next/image?url=%2Fimages%2Fhospitality.jpg&amp;w=1920&amp;q=80 1x, /_next/image?url=%2Fimages%2Fhospitality.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fhospitality.jpg&amp;w=3840&amp;q=80"/><span class="img-disc-text">Actual Site Photo*</span></div></div><div class="swiper-slide"><div class="img-wrapper"><img alt="NL Healthcare" loading="lazy" width="1920" height="1080" decoding="async" data-nimg="1" style="color:transparent;object-fit:cover" srcSet="/_next/image?url=%2Fimages%2Fhealthcare.jpg&amp;w=1920&amp;q=80 1x, /_next/image?url=%2Fimages%2Fhealthcare.jpg&amp;w=3840&amp;q=80 2x" src="/_next/image?url=%2Fimages%2Fhealthcare.jpg&amp;w=3840&amp;q=80"/><span class="img-disc-text">Image for representation purpose*</span></div></div></div></div><div class="slider-nav-wrapper"><span class="slide-btn swiper-button-prev" role="button" aria-label="Previous Slide"></span><span class="slide-btn swiper-button-next" role="button" aria-label="Next Slide"></span></div></div></div></div></div></div></section><section class="owner-quote-sec"><div class="container-fluid"><div class="row"><div class="quote-box"><div class="inner"><p><span class="words line"><span class="word"><span class="char">A</span><span class="char">t</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">N</span><span class="char">y</span><span class="char">a</span><span class="char">t</span><span class="char">i</span></span></span><span class="whitespace"> </span><span class="words line"><span class="word"><span class="char">G</span><span class="char">r</span><span class="char">o</span><span class="char">u</span><span class="char">p</span><span class="char">,</span></span></span><span class="whitespace"> </span><