            <section class="projInnerSec17 paddingTopBottom">
            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <div class="d-inline-block text-center">
                            <div data-aos="fade-up" class="subtitle">Let's Connect</div>
                            <h2 data-aos="fade-up" class="title">Guidance You Can Trust</h2>
                        </div>
                        <div data-aos="fade-up" class="secDesc mt-3"><p>We prioritize strong relationships and clear communication to drive success for everyone. Connect with us today. Together, we will take the next step in your journey at Supreme.</p></div>
                    </div>
                </div>
                <div class="row gx-5">
                    <div class="col-md-6 offset-md-6">
                        <form data-aos="fade-up" action="javascript:;" method="POST" id="contact_form_submit" name="contact_form_submit" data-parsley-validate>
                            <input type="hidden" name="_token" value="dsVkvJv14Kh1p71rkP35W7g4NxVv3q9ZZyeewJFR" autocomplete="off">                            <div class="row">
                                <div class="col-md-6 mt-5 pt-sm-2">
                                    <input 
                                        class="form-control" 
                                        type="text" 
                                        placeholder="First Name*"
                                        data-parsley-trigger="keyup"
                                        name="first_name"
                                        required
                                        data-parsley-errors-container="#first_name_error"
                                    />
                                    <div id="first_name_error" class="text-danger error mt-1"></div>
                                </div>
                                <div class="col-md-6 mt-5 pt-sm-2">
                                    <input 
                                        class="form-control" 
                                        type="text" 
                                        placeholder="Last Name*"
                                        data-parsley-trigger="keyup"
                                        name="last_name"
                                        required
                                        data-parsley-errors-container="#last_name_error"
                                    />
                                    <div id="last_name_error" class="text-danger error mt-1"></div>
                                </div>
                                <div class="col-md-6 mt-5 pt-sm-2">
                                    <input 
                                        class="form-control" 
                                        type="phone" 
                                        placeholder="Mobile Number*"
                                        data-parsley-trigger="keyup"
                                        name="mobile_number"
                                        id="contact_mobile_number"
                                        required
                                        data-parsley-cphone=""
                                        data-parsley-errors-container="#contact_mobile_number_error"
                                    />
                                    <div id="contact_mobile_number_error" class="text-danger error mt-1"></div>
                                </div>
                                <div class="col-md-6 mt-5 pt-sm-2">
                                    <input 
                                        class="form-control" 
                                        type="email" 
                                        placeholder="Enter Email*"
                                        data-parsley-trigger="keyup"
                                        name="email"
                                        required
                                        data-parsley-errors-container="#email_error"
                                    />
                                    <div id="email_error" class="text-danger error mt-1"></div>
                                </div>
                                <div class="col-md-12 mt-5 pt-sm-2">
                                    <input 
                                        class="form-control" 
                                        type="text" 
                                        placeholder="Subject*"
                                        data-parsley-trigger="keyup"
                                        name="c_subject"
                                        required
                                        data-parsley-errors-container="#c_subject_error"
                                    />
                                    <div id="c_subject_error" class="text-danger error mt-1"></div>
                                </div>
                                <div class="col-md-12 mt-5 pt-sm-2">
                                    <textarea
                                        class="form-control" 
                                        type="text" 
                                        placeholder="Message*"
                                        data-parsley-trigger="keyup"
                                        name="c_message"
                                        required
                                        data-parsley-errors-container="#c_message_error"
                                        rows="1"
                                    ></textarea>
                                    <div id="c_message_error" class="text-danger error mt-1"></div>
                                </div>
                                <div class="col-md-12 mt-3" style="font-size: 8px;">By clicking Submit, you consent to your information being shared with Supreme Universal in accordance with our privacy policy. The information shall be maintained in full confidentiality and shall not be shared with any third party. We may use this information to contact you regarding your enquiry via Email, SMS, or WhatsApp.</div>
                                <div class="col-md-12 mt-3" style="font-size: 8px;">I agree and authorize Supreme Universal to contact me via call and other communication channels. This consent will override any registration with the DNC/NDNC.</div>
