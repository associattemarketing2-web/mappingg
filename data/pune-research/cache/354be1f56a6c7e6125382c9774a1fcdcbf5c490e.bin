<style>
  @keyframes popIn {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  @media (max-width: 768px) {
    #exit-popup {
      padding: 30px 20px !important;
      border-radius: 12px !important;
    }
    #exit-popup .exit-title {
      font-size: 20px !important;
    }
    #exit-popup p {
      font-size: 13px !important;
    }
  }
</style>

<script>
  var exitShown = false;

  function showExitPopup() {
    exitShown = true;
    document.getElementById('exit-overlay').style.display = 'flex';
    localStorage.setItem('exitShown', Date.now());
  }

  function closeExitPopup() {
    document.getElementById('exit-overlay').style.display = 'none';
  }

  window.addEventListener('load', function() {

    document.getElementById('exit-overlay').addEventListener('click', function(e) {
      if (e.target === this) closeExitPopup();
    });

    var lastShown = localStorage.getItem('exitShown');
    if (lastShown && (Date.now() - lastShown) < 3 * 24 * 60 * 60 * 1000) {
      exitShown = true;
      return;
    }

    if (window.innerWidth <= 768) {
      setTimeout(function() {
        if (!exitShown) showExitPopup();
      }, 60000);
    }

    if (window.innerWidth > 768) {
      setTimeout(function() {
        document.addEventListener('mouseleave', function(e) {
          if (e.clientY < 50 && !exitShown) {
            showExitPopup();
          }
        });
      }, 5000);
    }

  });
</script>
