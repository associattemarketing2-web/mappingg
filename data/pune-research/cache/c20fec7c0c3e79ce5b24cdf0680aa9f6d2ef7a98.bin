								<p class="paragraph">A market leader in the wholesale supply of dry fruits</p>
							</div>
						</div>
					</a>
				</div>
				
				<div class="col-12 col-mg-6 col-lg-6 mb-5">
					<a class="businesses__inner-block">
						<div class="image">
							<img loading="lazy" src="https://www.mantraproperties.in/assets/images/business/mantra-supply-solution-77890178.webp" alt="Mantra Supply Solutions" class="img-fluid">
						</div>
						<div class="caption">
							<div class="caption__left">
								<h3 class="secondary-heading mb-3">Mantra Supply Solution</h3>
								<p class="paragraph">A renowned grocery and associated products supplier to hotels, restaurants and caterers</p>
							</div>
						</div>
					</a>
				</div>
				
				<div class="col-12 col-mg-6 col-lg-6 mb-5">
