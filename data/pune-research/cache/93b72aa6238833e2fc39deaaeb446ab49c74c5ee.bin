<section class="pt-md-3" >
<div class="container">
 <div class="row ">
  	<div class="col-md-5 float-left">
 		<h1><span class="text-uppercase text text-brown">Enquiry<br> Form</span></h1>
 		<p class="mb-2">For project enquiries, e-mail us at <a href="/cdn-cgi/l/email-protection#bacac8dfc9dbd6dfc9fad4dbd3d1d4dbccdbc8df94d9d5d7" class="text-brown"><span class="__cf_email__" data-cfemail="2b5b594e584a474e586b454a4240454a5d4a594e05484446">[email&#160;protected]</span></a> or<br> call us on pre-sales no. <a href="tel:+91 8956005544" class="text-brown">+91 8956005544</a> (all business days, 9 a.m. to 6 p.m.)</p>
 	</div>
 	<div class="col-md-7 float-left" >
 		<form  id="contactform" method="post" onsubmit="return false;"> 
        <div class="form-group col-md-6 float-left">
        	<input type="text" class="form-control rounded-0" placeholder="YOUR NAME" name="name3" id="name3">
        </div>
        <div class="form-group col-md-6 float-left">
        	<input type="email" class="form-control rounded-0" placeholder="YOUR EMAIL" name="email3" id="email3">
        </div>
        <div class="form-group col-md-6 float-left">
        	<input type="text" class="form-control rounded-0" maxlength="10" placeholder="YOUR PHONE NO." name="phone3" id="phone3">
        </div>
        <div class="form-group selectdiv position-relative col-md-6 float-left">
        	<select name="project3" id="project3" class="form-control  rounded-0" required >
