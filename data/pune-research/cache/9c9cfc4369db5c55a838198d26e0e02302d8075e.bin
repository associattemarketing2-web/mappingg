        #coming-soon-popup-box .popup-gradient {
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 35%;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 100%);
            pointer-events: none;
        }

        #coming-soon-popup-box .popup-enquire-btn {
            position: absolute;
            left: 25px;
            bottom: 25px;
            z-index: 2;
        }

        @media (max-width: 575px) {
            #coming-soon-popup-box {
