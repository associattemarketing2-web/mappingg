<div class="code-embed">
  <script>
MktoForms2.whenReady(function (mktoform) {
      var blockedDomains = new Set(getDomainBlocklist());    
      var errorEmailMessage = "Please use a business email address.";
      var mktoformEl = mktoform.getFormElem()[0];
      var emailInput = mktoformEl.querySelector("#Email");

      if (emailInput) {
          emailInput.addEventListener("blur", function() {
              validateEmailDomain();
          });
          
          emailInput.addEventListener("input", function() {
             mktoform.submittable(true);
          });
      }
      
      mktoform.onValidate(function(builtInValidation) {
          if (!builtInValidation) return;
          validateEmailDomain();
      });

      function validateEmailDomain() {
          var currentEmailVal = emailInput.value.trim();
          if (currentEmailVal && currentEmailVal.indexOf("@") !== -1) {
              var emailDomain = currentEmailVal.split("@")[1].toLowerCase();
              if (blockedDomains.has(emailDomain)) {
                  mktoform.showErrorMessage(errorEmailMessage, MktoForms2.$(emailInput));
                  mktoform.submittable(false);
              } else {
                  mktoform.submittable(true);
              }
          }
      }
  });
</script>

</div>

        
    </div>

</div>

  <div class="column-2 container responsivegrid cmp-container--padding-left-large">

    
    
    
