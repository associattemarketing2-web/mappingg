                                                <picture>
                                                    <source srcset="" type="image/webp" />
                                                    <source srcset="https://cdn.bajajauto.com/-/media/assets/bajajauto/about-us/bajaj-team/committees-and-management-team/samardeep-subandh.jpg" type="image/jpeg" />
