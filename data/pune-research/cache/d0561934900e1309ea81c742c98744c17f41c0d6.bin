ages/favicon-16x16.png\",\"sizes\":\"16x16\",\"type\":\"image/png\"}],[\"$\",\"link\",\"20\",{\"rel\":\"apple-touch-icon\",\"href\":\"/assets/images/apple-touch-icon.png\"}],[\"$\",\"$L19\",\"21\",{}]]\n"])</script><script>self.__next_f.push([1,"8:null\n"])</script></body></html>