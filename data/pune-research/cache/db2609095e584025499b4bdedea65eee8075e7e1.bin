                <style>
                    .search-modal .sobha-project-search {
                        max-width: 1200px;
                        margin: 0px auto 0;
                        background: #fff;
                        padding: 20px;
                        border-radius: 0 0 10px 10px;
                        text-align: center;
                        position: absolute;
                        top: 70px;
                        left: 50%;
                        transform: translateX(-50%);
                    }

                    .search-modal .sobha-project-search h3 {
                        color: #0A0A0A;
                        font-size: 16px;
                        font-weight: 600;
                        line-height: 24px;
                        margin: 0 0 24px;
                        text-transform: none;
                        letter-spacing: 0;
                    }

                    .search-modal .sobha-project-search form {
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        gap: 20px;
                        flex-wrap: nowrap;
                    }

                    .search-modal {
                        background: rgba(89, 93, 95, 0) !important;
                    }

                    .search-modal .sobha-project-search .custom-multiselect {
                        position: relative;
                        width: 240px;
                        flex: 0 0 240px;
                    }

                    .search-active header.header,
                    .search-modal .sobha-project-search {
                        box-shadow: 0px 4px 4px 0px #00000040;
                    }

                    .search-modal .sobha-project-search .custom-multiselect::before {
                        position: absolute;
                        top: -8px;
                        left: 14px;
                        z-index: 3;
                        padding: 0 6px;
                        background: #fff;
                        color: #111;
                        font-size: 12px;
                        line-height: 16px;
                        pointer-events: none;
                    }

                    .header-sticky {
                        display: block !important;
                    }

                    .search-modal .sobha-project-search form>.custom-multiselect:nth-of-type(1)::before {
                        content: "City";
                    }

                    .search-modal .sobha-project-search form>.custom-multiselect:nth-of-type(2)::before {
                        content: "Project Name";
                    }

                    .search-modal .sobha-project-search form>.custom-multiselect:nth-of-type(3)::before {
                        content: "Configuration";
                    }

                    .search-modal .sobha-project-search form>.custom-multiselect:nth-of-type(4)::before {
                        content: "Property Type";
                    }

                    .search-modal .sobha-project-search .select-box {
                        position: relative;
                        height: 60px;
                        display: flex;
                        align-items: center;
                        border: 1.4px solid #151515;
                        border-radius: 9px;
                        padding: 0 42px 0 12px;
                        background: #fff;
                        cursor: pointer;
                        font-size: 14px;
                        line-height: 24px;
                        font-weight: 400;
                        text-align: left;
                        color: #888;
                        overflow: hidden;
                        white-space: nowrap;
                        text-overflow: ellipsis;
                    }

                    /* .search-modal .sobha-project-search .select-box::after {
    content: "";
    position: absolute;
    right: 18px;
    top: 22px;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid #555;
    border-bottom: 1.5px solid #555;
    transform: rotate(45deg);
}

.search-modal .sobha-project-search .custom-multiselect.active .select-box::after {
    top: 27px;
    transform: rotate(225deg);
} */
                    .search-modal .sobha-project-search .select-box {
                        justify-content: space-between;
                    }

                    .search-modal .sobha-project-search .select-text {
                        display: block;
                        overflow: hidden;
                        white-space: nowrap;
                        text-overflow: ellipsis;
                    }

                    .search-modal .sobha-project-search .select-arrow {
                        position: absolute;
                        right: 18px;
                        top: 22px;
                        width: 8px;
                        height: 8px;
                        border-right: 1.5px solid #555;
                        border-bottom: 1.5px solid #555;
                        transform: rotate(45deg);
                        cursor: pointer;
                    }

                    .search-modal .sobha-project-search .custom-multiselect.active .select-arrow {
                        top: 27px;
                        transform: rotate(225deg);
                    }

                    .search-modal .sobha-project-search .checkbox-list {
                        display: none;
                        position: absolute;
                        top: 64px;
                        left: 0;
                        width: 100%;
                        min-width: 220px;
                        background: #fff;
                        border: 0;
                        border-radius: 0 0 6px 6px;
                        z-index: 999999;
                        max-height: 250px;
                        overflow-y: auto;
                        text-align: left;
                        padding: 12px 0;
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.28);
                    }

                    .search-modal .sobha-project-search .custom-multiselect.active .checkbox-list {
                        display: block;
                    }

                    .search-modal .sobha-project-search .checkbox-list label {
                        display: flex;
                        align-items: center;
                        padding: 8px;
                        margin: 0;
                        font-size: 14px;
                        line-height: 24px;
                        color: #000;
                        cursor: pointer;
                        background: #fff;
                    }

                    .search-modal .sobha-project-search .checkbox-list label:hover {
                        background: #f7f7f7;
                    }

                    .search-modal .sobha-project-search .checkbox-list input[type="checkbox"] {
                        appearance: none;
                        -webkit-appearance: none;
                        width: 20px;
                        height: 20px;
                        min-width: 20px;
                        margin: 0 10px 0 0;
                        padding: 0;
                        border: 1.4px solid #222;
                        border-radius: 2px;
                        background: #fff;
                        box-shadow: none !important;
                        cursor: pointer;
                        position: relative;
                    }

                    .search-modal .sobha-project-search .checkbox-list input[type="checkbox"]:checked::after {
                        content: "";
                        position: absolute;
                        left: 6px;
                        top: 2px;
                        width: 6px;
                        height: 11px;
                        border-right: 2px solid #222;
                        border-bottom: 2px solid #222;
                        transform: rotate(45deg);
                    }

                    .search-modal .sobha-project-search button {
                        height: 50px;
                        min-width: 100px;
                        padding: 0 22px;
                        background: #b79a4d;
                        color: #fff;
                        border: 0;
                        border-radius: 9px;
                        font-size: 18px;
                        font-weight: 500;
                        cursor: pointer;
                    }

                    .search-modal .sobha-project-search .checkbox-list label:has(input[type="checkbox"]:checked) {
                        background: #a98d43;
                        color: #000;
                    }

                    .search-modal .sobha-project-search .checkbox-list label:has(input[type="checkbox"]:checked):hover {
                        background: #a98d43;
                    }

                    .search-modal .sobha-project-search button:hover {
                        background: #a98d43;
                    }

                    @media (max-width: 991px) {
                        .search-modal .sobha-project-search {
                            width: calc(100% - 30px);
                            padding: 34px 22px 30px;
                        }

                        .search-modal .sobha-project-search form {
                            flex-wrap: wrap;
                            gap: 18px;
                        }

                        .search-modal .sobha-project-search .custom-multiselect {
                            width: calc(50% - 9px);
                            flex: 0 0 calc(50% - 9px);
                        }

                        .search-modal .sobha-project-search button {
                            width: 100%;
                        }
                    }

                    @media (max-width: 575px) {
                        .search-modal .sobha-project-search {
                            margin-top: 0px;
                            padding: 30px 16px 26px;
                        }

                        .search-modal .close-btn,
                        #iframe-modal .close-btn {
                            right: 6px !important;
                        }

                        .search-modal .sobha-project-search h3 {
                            font-size: 18px;
                            margin-bottom: 24px;
                        }

                        .search-modal .sobha-project-search .custom-multiselect {
                            width: 100%;
                            flex: 0 0 100%;
                        }

                        .search-modal .sobha-project-search .select-box {
                            height: 56px;
                            font-size: 16px;
                        }

                        .search-modal .sobha-project-search .checkbox-list {
                            top: 60px;
                            width: 100%;
                        }
                    }
                </style>

