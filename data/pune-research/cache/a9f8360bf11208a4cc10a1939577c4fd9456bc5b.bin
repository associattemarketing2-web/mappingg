ndefined\",\"nonce\":\"SPtqp+endBOrmKwlkM8EqA==\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2bn4ht82l5-44.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"SPtqp+endBOrmKwlkM8EqA==\"}],[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1__rc2-bfjwpr.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"SPtqp+endBOrmKwlkM8EqA==\"}],[\"$\",\"link\",\"3\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0fomunoovfcq_.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"SPtqp+endBOrmKwlkM8EqA==\"}]]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}],[\"$\",\"$L2a\",null,{\"children\":[\"$\",\"$L2b\",null,{}]}]]}]\n24:[\"$\",\"$L2c\",null,{}]\n1c:[\"$\",\"$L2d\",null,{\"sectionName\":\"Cookie Consent - We respect your privacy - PopUp\",\"header\":{\"title\":\"Cookie Consent - We respect your privacy\",\"color\":\"white\",\"level\":\"h2\"},\"description\":\"We use cookies and similar technologies to operate our website. With your permission, we also use cookies for analytics, advertising, social media features, and embedded content. Where required by law, we will only use non‑essential cookies with your consent. Where applicable, you may opt out of the sale or sharing of personal information, and we honor Global Privacy Control (GPC) signals.\",\"manageCookiesButton\":{\"buttonName\":\"Primary - Manage cookies\",\"label\":\"Manage cookies\",\"type\":\"primary\",\"color\":\"white\",\"bgColor\":\"black\",\"borderColor\":\"white\"},\"manageCookieSection\":[{\"sectionName\":\"Cookie Consent - Customize Cookies\",\"header\":{\"title\":\"Your Privacy\",\"color\":\"white\",\"level\":\"h2\"},\"description\":\"When you browse the internet, your personal information is often stored as cookies. These cookies can reveal your preferences, device information, and more. While they enhance your browsing experience, they can also compromise your privacy. We understand the importance of protecting your personal data, so we offer the option to control the types of cookies stored on your browser. However, please note that disabling certain cookies may limit your access to certain features and services on the website.\",\"sectionItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies\",\"header\":{\"title\":\"Strictly necessary cookies\",\"color\":\"white\",\"level\":\"h4\"},\"description\":\"Without these cookies, our website cannot function. They are vital for enabling you to access the services you have requested, such as logging in, filling out forms, and setting your privacy preferences. These cookies cannot be disabled as they are integral to the site's smooth operation. While you can adjust your browser settings to block or receive alerts about these cookies, please be aware that doing so may prevent you from accessing certain parts of the website and receiving the services you require. Rest assured, these cookies do not store personally identifiable information, so your privacy remains protected.\",\"sectionItemsTitle\":\"Cookie List\",\"sectionItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Cookie name\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"cookiesession1\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Cookie type\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"First-party cookie\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Category\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Strictly necessary cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Expiration/Duration\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"Session\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Platform name\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Next JS\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Strictly necessary cookies - Description\",\"cookieTitle\":\"Description\",\"cookieValue\":\"This is a default cookie that gets triggered when the page loads\"}]}],\"isEnabled\":true},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies\",\"header\":{\"title\":\"Performance cookies\",\"color\":\"white\",\"level\":\"h4\"},\"description\":\"These cookies are important for us to measure and improve the performance of our website. By counting visits and traffic sources, we can gain valuable insights into how our site is being used and identify areas for improvement. Additionally, these cookies allow us to remember your preferences, such as your language or region, and provide you with a more personalized browsing experience. They help us understand which pages are popular, which ones need improvement, and how visitors navigate our site. If you choose to disable these cookies, we will not be able to monitor the performance of our site or provide you with the enhanced features that make your experience more enjoyable. Please note that refusing to enable these cookies may impact your overall experience on our website.\",\"sectionItemsTitle\":\"Cookie List\",\"sectionItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie name\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"_gid\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third-party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Category\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"24 months\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"Google Analytics\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description\",\"cookieTitle\":\"Description\",\"cookieValue\":\"This cookie is used to store and count page views. To know more, please visit www.cookiedatabase.org/cookiefunctions/count-and-track-pageviews/\"}]},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie List\",\"title\":\"Cookie List\",\"cookieListItems\":[{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie name\",\"cookieTitle\":\"Cookie name\",\"cookieValue\":\"_clck\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Cookie type\",\"cookieTitle\":\"Cookie type\",\"cookieValue\":\"Third-party\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Category\",\"cookieTitle\":\"Category\",\"cookieValue\":\"Performance cookies\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Expiration/Duration\",\"cookieTitle\":\"Expiration/Duration\",\"cookieValue\":\"1 year\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Platform name\",\"cookieTitle\":\"Platform name\",\"cookieValue\":\"MS Clarity\"},{\"sectionName\":\"Cookie Consent - Customize Cookies - Performance cookies - Description\",\"cookieTitle\":\"Description\",\"cookieValue\":\"Ensures the Clarity user ID and preferences, unique to that site, on the browser; this guarantees that behavior in subsequent visits to the same site will be attributed to the same user ID\"}]},{\"sectionName\":\"Cookie Consent - Customize Cookies - Pe