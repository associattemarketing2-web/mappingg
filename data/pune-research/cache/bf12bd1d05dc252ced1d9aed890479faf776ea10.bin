    <div class="form-check">
        <label for="termsCheck" class="form-check-label">
            <!-- Hidden input to send "0" when checkbox is not checked -->
            <input type="hidden" name="dealerconsentHidden" id="dealerconsentHidden" value="0">
            <!-- Checkbox input to send "1" when checked -->
            <input 
                name="consent" 
                required 
                type="checkbox" 
                class="form-check-input" 
                id="consent" 
                value="1" 
                
            >
            By clicking on the submit button, I agree to receive a call and/or email from Finolex or its
            authorised representative(s) as per the calling guidelines avail & also agree to the
            website’s <a href="https://www.finolexpipes.com/tnc" target="_blank">Terms and Conditions</a> & 
