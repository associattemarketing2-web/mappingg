<!-- HOME PAGE POPUP -->
<!-- Popup Modal -->
<div class="modal fade"
     id="homePopupModal"
     tabindex="-1"
     role="dialog"
     aria-modal="true"
     aria-label="Cosmos Bank notices"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content border-0 shadow">

            <!-- Close -->
            <!-- Close Button -->
            <button type="button"
                    class="btn-close popup-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">X</button>

            <!-- Carousel -->
            <div id="popupCarousel"
                 class="carousel slide"
                 data-bs-ride="carousel"
                 data-bs-interval="4000">

                <!-- Indicators -->
                <div class="carousel-indicators">

                    <button type="button"
                            data-bs-target="#popupCarousel"
                            data-bs-slide-to="0"
                            class="active"
                            aria-label="Go to notice 1"></button>

                    <button type="button"
                            data-bs-target="#popupCarousel"
                            data-bs-slide-to="1"
                            aria-label="Go to notice 2"></button>

                    <button type="button"
                            data-bs-target="#popupCarousel"
                            data-bs-slide-to="2"
                            aria-label="Go to notice 3"></button>

                </div>

                <!-- Slides -->
                <div class="carousel-inner">

                    <div class="carousel-item active">

                        <img loading="lazy" src="https://www.cosmos.bank.in/images/popup/rbipop1.jpg"
                             class="d-block w-100"
                             alt="Cosmos Bank important notice (1 of 2)">

                    </div>


                    <div class="carousel-item">

                        <img loading="lazy" src="https://www.cosmos.bank.in/images/popup/rbipop2.jpg"
                             class="d-block w-100"
                             alt="Cosmos Bank important notice (2 of 2)">

                    </div>

                </div>

                <!-- Previous -->
                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#popupCarousel"
                        data-bs-slide="prev"
                        aria-label="Go to Previous Slide">

                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>

                </button>

                <!-- Next -->
                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#popupCarousel"
                        data-bs-slide="next"
                        aria-label="Go to Next Slide">

                    <span class="carousel-control-next-icon" aria-hidden="true"></span>

                </button>

            </div>

        </div>

    </div>

</div>
<style>
    #homePopupModal .modal-dialog {
        max-width: 700px;
        margin-top: 250px;
    }

    #homePopupModal .modal-content {
        border-radius: 10px;
        overflow: hidden;
        position: relative;
    }

    #homePopupModal img {
        width: 100%;
        display: block;
    }

    .popup-close {
        position: absolute;
        top: 0px;
        right: 0px;
        z-index: 9999;
        background: #fff;
        border-radius: 50%;
        opacity: 1;
    }

    .carousel-control-prev,
    .carousel-control-next {
        width: 55px;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0,0,0,.6);
        border-radius: 50%;
        padding: 20px;
    }

    .carousel-indicators {
        bottom: 15px;
    }

        .carousel-indicators button {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

    .popup-close {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        z-index: 999999 !important;
        padding: 10px;
        background-color: black;
        color: white;
    }

    .fa-chevron-left:before {
        padding-left: 12px;
        color: white;
    }

    .fa-chevron-right:before {
        padding-left: 12px;
        color: white;
    }
</style>


<script>
          $(function () {

        const modal = new bootstrap.Modal(
            document.getElementById("homePopupModal")
        );

        setTimeout(function () {

            modal.show();

        },1000);

    });
</script>
