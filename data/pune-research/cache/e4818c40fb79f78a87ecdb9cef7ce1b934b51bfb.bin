<span><span><a href="https://www.forcemotors.com/">Home</a></span> <span class="seprator"> + </span> <span><a href="https://www.forcemotors.com/about-force/">About Force</a></span> <span class="seprator"> + </span> <span class="breadcrumb_last" aria-current="page"><strong>Leadership Team</strong></span></span></div></div><div class="page-title"><h1>Leadership Team</h1></div></div></section><main id="content" class="site-main post-144 page type-page status-publish hentry"><div class="page-content"><div data-elementor-type="wp-page" data-elementor-id="144" class="elementor elementor-144"><div class="elementor-element elementor-element-7ea0f32 our-experties-sec pageoverview e-flex e-con-boxed e-con e-parent" data-id="7ea0f32" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}"><div class="e-con-inner"><div class="elementor-element elementor-element-26fb591 elementor-widget elementor-widget-text-editor" data-id="26fb591" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default"><div class="elementor-widget-container"><p>Our team at Force Motors brings together seasoned leaders with diverse expertise and thoughtful judgment, to the company. We promote a culture of transparency, accountability and steady professional development.</p></div></div></div></div><div class="elementor-element elementor-element-169e193 board-directors-sec topleftshape  e-flex e-con-boxed e-con e-parent" data-id="169e193" data-element_type="container" data-e-type="container"><div class="e-con-inner"><div class="elementor-element elementor-element-9bbf7bd elementor-widget elementor-widget-heading" data-id="9bbf7bd" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default"><div class="elementor-widget-container"><h2 class="elementor-heading-title elementor-size-default">Board Of Directors</h2></div></div><div class="elementor-element elementor-element-6d8bf0d elementor-widget elementor-widget-shortcode" data-id="6d8bf0d" data-element_type="widget" data-e-type="widget" data-widget_type="shortcode.default"><div class="elementor-widget-container"><div class="elementor-shortcode"><style type="text/css">.team-popup-wrap li {
		width: 100% !important;
		padding: 0 !important;
		margin: 0 !important;
	}
	.team-popup-wrap ul {
		margin: 0 0 20px !important;
		padding: 0 0 0 20px !important;
	}
	.hidden {
		display: none !important;
	}
	.leadership-team-section {
		position: relative;
	}
	.team-list {
		margin: 0 -5px;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
	}
	.team-list li {
		width: 33%;
		padding: 0 15px;
		margin-bottom: 40px;
	}
	.team-item {
		display: block;
	}
	.team-item img {
		width: 100%;
	}
	.team-item h2 {
		color: #0074C3;
		font-size: 22px;
		font-weight: 500;
		line-height: 30px;
		display: block;
		margin: 20px 0 3px 0;
	}
	.team-item span, .teampop-content span {
		color: #000000;
		font-size: 18px;
		font-weight: 400;
		line-height: 32px;
	}
	.show-team-pop {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		justify-content: center;
		align-items: center;
		background: #000000d4;
		z-index: 9999999;
		display: flex	;
		height: 100%;
	}
	.team-close-pop {
		position: absolute;
		right: 0;
		top: 0;
		cursor: pointer;
		z-index: 9;
	}
	.team-popup-wrap {
		padding: 40px 10px 40px 40px;
		background: #ffffff;
		width: 100%;
		max-width: 1000px;
		position: relative;
	}
	.team-meta {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0;
	}
	.team-popimg {
		width: 30%;
	}
	.teampop-content {
		width: 65%;
		height: 450px;
		overflow: hidden;
		overflow-y: scroll;
		padding-right: 30px;
	}
	.team-popimg img {
		display: block;
	}
	.teampop-content h3 {
		margin: 0 0 5px;
		color: #0074C3;
		font-size: 42px;
		font-weight: 500;
		line-height: 50px;
		display: block;
	}
	.teampop-content p {
		margin-bottom: 15px !important;
		font-size: 15px;
		line-height: 25px;
	}
/* 	.team-item.prasan-firodia {
		pointer-events: none;
		cursor: default;
	} */
	.teampop-content span {
		margin-bottom: 20px;
		display: block;
	}
	@media(max-width:1024px) {
		.show-team-pop {
			padding: 0 20px;
		}
		.team-popup-wrap {
			padding: 20px;
		}
		.teampop-content h3 {
			font-size: 30px;
			line-height: 40px;
		}
		.team-item h2 {
			font-size: 22px;
			line-height: 25px;
			margin-top: 5px;
		}
		.team-item span, .teampop-content span {
			font-size: 18px;
			line-height: 25px;
			display: block;
		}
	}
	@media(max-width:767px) {
		.teampop-content h3 {
			font-size: 26px;
			line-height: 34px;
		}
		.team-popimg {
			display: none;
		}
		.teampop-content {
			width: 100%;
			padding-right: 10px;
		}
		.team-close-pop {
			right: -15px;
			top: -5px;
		}
		.team-close-pop img {
			width: 70px;
		}
		.team-list li {
			width: 50%;
			margin-bottom: 20px;
		}
		.team-item h2 {
			font-size: 19px;
			line-height: 22px;
		}
		.team-item span, .teampop-content span {
			font-size: 16px;
			line-height: 23px;
		}
	}</style><section class="leadership-team-section"><div class="leadership-team-wrap"><ul class="team-list"><li>
