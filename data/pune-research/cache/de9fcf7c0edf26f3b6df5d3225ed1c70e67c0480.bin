                {
                  return 7;
                }
              },
              maxlength :function(){
                var country_code = $(".selected-enquiry").html();
                if (country_code=="+91") {
                  return 10;
                }
                else
                {
                  return 12;
                }
              },               
            },
            enquiry_terms_conditions: {
              required: function() {
                var path = window.location.pathname.replace(/\/$/, '');
