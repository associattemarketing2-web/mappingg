<div id="shopify-block-AT2plNGNVWC90bDk5e__13492175517568419881" class="shopify-block shopify-app-block">







<script>
(function() {
  /* ==========================================================
     BOOLEANMATHS PASSIVE BRIDGE v4.0 (ZERO INTERFERENCE)
     Strategy: Update cart attributes PROACTIVELY, never block anything
     - Monitors page for any cart/checkout activity
     - Ensures attributes are ALWAYS in cart before user acts
     - 100% passive - no blocking, no interception
     ========================================================== */

  const DEBUG = false;
  const ENDPOINT_IDENTITY = "https://api.booleanmaths.com/identity";

  // --- UTILITIES ---
  function log(msg, data) {
    if (DEBUG) console.log("BooleanMaths:", msg, data || "");
  }

function setDeviceData() {
  log("Requesting ultimate device specs...");

  // --- Helper to guess form factor if API fails ---
  const getFormFactorFallback = () => {
    const width = window.screen.width;
    if (width <= 480) return 'phone';
    if (width <= 1024) return 'tablet';
    return 'desktop';
  };

  let dev = {
    os: 'Unknown',
    model: 'Unknown',
    os_ver: 'Unknown',
    arch: 'Unknown',
    bit: 'Unknown',
    form: getFormFactorFallback(), // Default to screen-based guess
    ram: navigator.deviceMemory || 'Unknown',
    cpu: navigator.hardwareConcurrency || 'Unknown',
    conn_type: navigator.connection ? navigator.connection.effectiveType : 'Unknown',
    conn_speed: navigator.connection ? navigator.connection.downlink : 'Unknown'
  };

  // 1. Basic OS Detection
  if (/iPhone|iPad/.test(navigator.userAgent)) {
      dev.os = 'iOS';
      dev.form = /iPad/.test(navigator.userAgent) ? 'tablet' : 'phone';
  }
  else if (/Android/.test(navigator.userAgent)) dev.os = 'Android';
  else if (/Macintosh/.test(navigator.userAgent)) dev.os = 'macOS';
  else if (/Windows/.test(navigator.userAgent)) dev.os = 'Windows';

  const save = (data) => {
    const val = [
      data.os, data.model, data.os_ver, data.arch, 
      data.bit, data.form, data.ram, data.cpu, 
      data.conn_type, data.conn_speed
    ].join('|');

    const expiry = new Date();
    expiry.setTime(expiry.getTime() + (30 * 24 * 60 * 60 * 1000));
    document.cookie = "_bm_device_hint=" + encodeURIComponent(val) + 
                      ";expires=" + expiry.toUTCString() + ";path=/;SameSite=Lax";
  };

  save(dev);

  // 2. High Entropy Request (Refined for Form Factor)
  if (navigator.userAgentData && navigator.userAgentData.getHighEntropyValues) {
    navigator.userAgentData.getHighEntropyValues([
      "model", "platform", "platformVersion", 
      "architecture", "bitness", "formFactor"
    ]).then(ua => {
        dev.os = ua.platform || dev.os;
        dev.model = ua.model || 'Unknown'; 
        dev.os_ver = ua.platformVersion || 'Unknown';
        dev.arch = ua.architecture || 'Unknown';
        dev.bit = ua.bitness || 'Unknown';
        
        // If the API gives us a specific form factor, use it (it returns an array)
        if (ua.formFactor && ua.formFactor.length > 0) {
            dev.form = ua.formFactor[0];
        }
        
        save(dev);
    }).catch(err => log("High entropy blocked", err));
  }
}

setDeviceData();

  // Returns EVERY value the cookie header carries for `name`, in header order.
  //
  // One name legitimately appears twice. Meta's fbevents.js writes _fbp on the registrable
  // domain (.brand.com) while our setCookie below writes host-only (www.brand.com), and the
  // browser sends both. Shopify's _shopify_y behaves the same way across a custom domain
  // and myshopify.com.
  function getAllCookieValues(name) {
    const target = name + '=';
    const out = [];
    const all = String(document.cookie || '').split(';');
    for (let i = 0; i < all.length; i++) {
      const c = all[i].trim();
      if (c.indexOf(target) === 0) out.push(c.substring(target.length));
    }
    return out;
  }

  // First value for `name`, or null.
  //
  // This used to read `const parts = value.split('; ' + name + '='); if (parts.length === 2)`
  // and return null whenever the name appeared MORE than once — the duplicate case above.
  // For _fbp that was catastrophic: getCookie said "no cookie", resolveFbp minted a fresh
  // id and wrote yet another duplicate, on every single page load. Measured before the fix:
  // 265,905 visitors churning a generated _fbp in three days, the worst holding 537 of them
  // across 1,098 events, while Meta's own _fbp churned for only 8,906. _bm_uuid churned the
  // same way for 14% of visitors through the _shopify_y lookup.
  function getCookie(name) {
    const all = getAllCookieValues(name);
    return all.length ? all[0] : null;
  }

  // Deletes the HOST-ONLY cookie named `name`, leaving any domain-scoped one intact.
  //
  // This asymmetry is the whole point. A write with no `domain` attribute can only ever
  // address the host-only cookie, so expiring it here removes ours (www.brand.com) and
  // cannot touch Meta's (.brand.com). Once the duplicate is gone the browser sends one
  // value, which is what lets the web pixel agree with us — see resolveFbp.
  function deleteHostOnlyCookie(name) {
    document.cookie = name + "=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;SameSite=Lax";
  }

  async function hashValue(val) {
    try {
      const msgBuffer = new TextEncoder().encode(val);
      const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
      return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
    } catch (e) { return null; }
  }

  // --- DEVICE FINGERPRINTING ---
  async function captureDeviceFingerprint() {
    let fingerprint = {
      screen: window.screen.width + "x" + window.screen.height,
      pixel_ratio: window.devicePixelRatio || 1,
      timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
      language: navigator.language,
      os: 'Unknown', model: 'Unknown'
    };
    if (navigator.userAgentData) {
      try {
        const ua = await navigator.userAgentData.getHighEntropyValues(["model", "platform"]);
        fingerprint.os = ua.platform; fingerprint.model = ua.model;
      } catch (e) {}
    } else {
        if (/iPhone|iPad/.test(navigator.userAgent)) fingerprint.os = 'iOS';
        else if (/Android/.test(navigator.userAgent)) fingerprint.os = 'Android';
    }
    return fingerprint;
  }

  // --- IDENTITY LISTENER ---
  const REGEX = { phone_in: /^(?:\+91|0)?([6-9]\d{9})$/, email: /@/ };
  async function identifyUser(val) {
    if (!val || val.length < 5) return;
    let type = null; let clean = val.trim().toLowerCase();
    
    if (REGEX.email.test(clean)) type = 'email';
    else {
        let p = clean.replace(/\D/g, '');
        if (REGEX.phone_in.test(p)) { type = 'phone'; clean = '+91' + p.slice(-10); }
    }

    if (type) {
      const hash = await hashValue(clean);
      const fp = await captureDeviceFingerprint(); 
      const bmuuid = getCookie('_bm_uuid') || getCookie('_shopify_y'); 

      fetch(ENDPOINT_IDENTITY, {
        method: 'POST', 
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ bm_uuid: bmuuid, type, hash, device: fp }),
        keepalive: true
      }).catch(()=>{});
    }
  }

  // --- GET TRACKING DATA ---
  function newUUID() {
    if (window.crypto && window.crypto.randomUUID) return window.crypto.randomUUID();
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
      const r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }

  function setCookie(name, value, days) {
    const expiry = new Date();
    expiry.setTime(expiry.getTime() + (days * 24 * 60 * 60 * 1000));
    document.cookie = name + "=" + value +
                      ";expires=" + expiry.toUTCString() + ";path=/;SameSite=Lax";
  }

  // Meta's Browser ID. Format is fixed and documented:
  //   fb.<subdomainIndex>.<creationTimeMs>.<random>
  // subdomainIndex is 1 for a normal shop domain.
  //
  // ONLY ever created when the cookie is absent. If the merchant has Meta's pixel on the
  // theme, fbevents.js reads an existing _fbp and only mints its own when there is none —
  // so writing first means their pixel adopts OUR value and browser + server events share
  // one Browser ID. Overwriting a value their pixel has already reported would give Meta
  // two ids for one person, which is worse than sending nothing.
  function resolveFbp() {
    // With duplicates possible, pick deliberately rather than taking whichever the browser
    // happened to send first. Meta's current pixel writes a 5-part _fbp
    // (fb.1.<ts>.<random>.<extra>); ours is 4-part. If Meta's is present it is the value
    // Meta already knows, so it wins — sending our own alongside it would give Meta two
    // Browser IDs for one person.
    const existing = getAllCookieValues('_fbp').filter(Boolean);
    if (existing.length) {
      const metas = existing.filter((v) => v.split('.').length >= 5);
      if (!metas.length) return existing[0];

      // Both kinds present. Picking Meta's here is not enough on its own: the web pixel
      // extension (extensions/boolean) reads cookies through Shopify's sandboxed
      // `browser.cookie.get('_fbp')`, which returns ONE value and offers no way to see or
      // choose between duplicates. It was returning our host-only id while cart
      // note_attributes carried Meta's, so trackevents and the order webhook described the
      // same person with two different Browser IDs.
      //
      // Removing our duplicate leaves exactly one _fbp in the header, so the sandboxed
      // lookup has nothing to get wrong. Safe to drop: a 4-part id we minted ourselves is
      // one Meta has never been told about, whereas theirs is already attached to their
      // browser-side events.
      if (existing.length > metas.length) {
        deleteHostOnlyCookie('_fbp');
        log("Removed duplicate host-only _fbp in favour of Meta's", metas[0]);
      }
      return metas[0];
    }

    let fbp = 'fb.1.' + Date.now() + '.' + Math.floor(Math.random() * 1e10);
    // 90 days, matching the lifetime Meta's own pixel uses.
    setCookie('_fbp', fbp, 90);
    log("Generated _fbp", fbp);
    return fbp;
  }

  function getTrackingData() {
    // Shopify's visitor ID (_shopify_y) is the preferred uuid - the web pixel
    // resolves the same value, so events and cart attributes stay joined.
    let bmuuid = getCookie('_shopify_y') || getCookie('_bm_uuid');

    if (!bmuuid) {
      // No visitor ID available - create one and persist it for the pixel
      bmuuid = newUUID();
      const expiry = new Date();
      expiry.setTime(expiry.getTime() + (365 * 24 * 60 * 60 * 1000));
      document.cookie = "_bm_uuid=" + bmuuid +
                        ";expires=" + expiry.toUTCString() + ";path=/;SameSite=Lax";
      log("Generated fallback _bm_uuid", bmuuid);
    }

    // Browser identifiers ride along into note_attributes so SERVER-side order events can
    // carry them. An order webhook never sees a cookie, so without this fbp coverage on
    // Purchase/*_Purchase_BM events is 0% — Meta's "low fbp coverage" warning.
    const data = { '_bm_uuid': bmuuid, '_fbp': resolveFbp() };

    // _fbc is only present when the visitor arrived from a Facebook ad (fbclid). Never
    // fabricated: a made-up click id would be wrong, and the server already rebuilds fbc
    // from a stored clickId when it can.
    const fbc = getCookie('_fbc');
    if (fbc) data['_fbc'] = fbc;

    // OpenAI (ChatGPT Ads) equivalents of _fbp / _fbc. Same reason they ride along here:
    // an order webhook never sees a cookie, so without these the Conversions API cannot
    // attribute a server-side purchase back to a ChatGPT ad click.
    //   __obref  — written by OpenAI's own pixel; we only read it
    //   __oppref — the click identifier, captured from the landing URL below
    const obref = getCookie('__obref');
    if (obref) data['__obref'] = obref;

    const oppref = resolveOppref();
    if (oppref) data['__oppref'] = oppref;

    return data;
  }

  // OpenAI passes the click identifier as `oppref` on the landing URL, the way Meta passes
  // fbclid. Persist it so it survives the rest of the session and reaches server-side
  // events long after the landing page is gone.
  //
  // Never overwrites an existing cookie: if OpenAI's own pixel already wrote __oppref,
  // theirs wins — a value we re-derived from a stale URL would be the wrong click.
  function resolveOppref() {
    const existing = getCookie('__oppref');
    if (existing) return existing;

    let fromUrl = null;
    try {
      fromUrl = new URLSearchParams(window.location.search).get('oppref');
    } catch (e) {
      return null;
    }
    if (!fromUrl) return null;

    // 90 days, matching how _fbp is persisted above.
    setCookie('__oppref', fromUrl, 90);
    log("Captured __oppref from landing URL", fromUrl);
    return fromUrl;
  }

  // --- STATE MANAGEMENT ---
  let attributesInCart = false;
  let updateInProgress = false;

  // --- ENSURE ATTRIBUTES ARE IN CART ---
  async function ensureAttributesInCart() {
    if (attributesInCart || updateInProgress) return;
    
    const data = getTrackingData();
    if (!data) return;
    
    updateInProgress = true;
    
    try {
      // First, check if attributes are already in cart
      const cartResponse = await fetch(window.Shopify.routes.root + 'cart.js');
      const cart = await cartResponse.json();
      
      // Already-in-cart check must cover EVERY attribute we send, not just _bm_uuid.
      // Comparing only the uuid would short-circuit for any existing cart that predates a
      // newly added attribute (e.g. _fbp), so the new one would never be written and the
      // gap would look like the frontend change had not shipped.
      const upToDate = cart.attributes && Object.keys(data).every(
        (k) => cart.attributes[k] === data[k]
      );
      if (upToDate) {
        log("✓ Attributes already in cart");
        attributesInCart = true;
        updateInProgress = false;
        return;
      }
      
      // Attributes not in cart, update them
      log("⟳ Updating cart attributes proactively");
      const updateResponse = await fetch(window.Shopify.routes.root + 'cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attributes: data }),
        keepalive: true
      });
      
      const updatedCart = await updateResponse.json();
      attributesInCart = true;
      log("✓ Cart attributes updated:", updatedCart.attributes);
      
    } catch (err) {
      log("⚠ Cart update failed:", err);
    } finally {
      updateInProgress = false;
    }
  }

  // --- PROACTIVE MONITORING ---
  function startProactiveMonitoring() {
    // Strategy 1: Update attributes on page load if we have tracking data
    ensureAttributesInCart();
    
    // Strategy 2: Monitor for ANY interaction with checkout/cart buttons
    document.addEventListener('mouseover', (e) => {
      const target = e.target.closest('button, a, input[type="submit"]');
      if (!target) return;
      
      // Check if it's ANY button that might trigger checkout/cart
      const isCheckoutButton = 
        target.name === 'checkout' ||
        target.name === 'add' ||
        target.classList.contains('shopify-payment-button__button') ||
        target.classList.contains('checkout-btn') ||
        target.classList.contains('product-form__submit') ||
        target.href?.includes('/checkout') ||
        target.getAttribute('onclick')?.includes('checkout');
      
      if (isCheckoutButton) {
        log("👆 Hovering checkout/cart button - ensuring attributes ready");
        ensureAttributesInCart();
      }
    }, { passive: true });
    
    // Strategy 3: Monitor for focus on checkout/cart buttons (keyboard users)
    document.addEventListener('focusin', (e) => {
      const target = e.target.closest('button, a, input[type="submit"]');
      if (!target) return;
      
      const isCheckoutButton = 
        target.name === 'checkout' ||
        target.name === 'add' ||
        target.classList.contains('shopify-payment-button__button') ||
        target.classList.contains('checkout-btn') ||
        target.classList.contains('product-form__submit');
      
      if (isCheckoutButton) {
        log("⌨ Focusing checkout/cart button - ensuring attributes ready");
        ensureAttributesInCart();
      }
    }, { passive: true });
    
    // Strategy 4: Re-ensure attributes before ANY click (just in case)
    document.addEventListener('click', (e) => {
      const target = e.target.closest('button, a, input[type="submit"]');
      if (!target) return;
      
      const isCheckoutButton = 
        target.name === 'checkout' ||
        target.name === 'add' ||
        target.classList.contains('shopify-payment-button__button') ||
        target.classList.contains('checkout-btn') ||
        target.classList.contains('product-form__submit') ||
        target.href?.includes('/checkout');
      
      if (isCheckoutButton) {
        log("🖱 Clicked checkout/cart button - attributes should already be ready");
        // Don't block - attributes should already be there from hover/focus
        // But fire one more update just to be safe (fire and forget)
        if (!attributesInCart && !updateInProgress) {
          const data = getTrackingData();
          if (data) {
            fetch(window.Shopify.routes.root + 'cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ attributes: data }),
              keepalive: true
            }).catch(() => {});
          }
        }
      }
    }, { passive: true, capture: true });
    
    // Strategy 5: Periodic check (every 2 seconds) to ensure attributes stay in cart
    setInterval(() => {
      ensureAttributesInCart();
    }, 2000);
  }

  // --- INITIALIZATION ---
  function init() {
    // 1. Identity Listener
    document.addEventListener('blur', (e) => {
      if(e.target.tagName === 'INPUT') identifyUser(e.target.value);
    }, true);

    // 2. Start Proactive Monitoring
    startProactiveMonitoring();

    log("BooleanMaths Passive Bridge v4.0 Loaded ✓");
    log("100% passive - no blocking, no interference");
    log("Attributes will be ready before any button click");
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>

</div><div id="shopify-block-AeWtjZE1LT2Irb3pva__7079518687644006178" class="shopify-block shopify-app-block"><script>
  (function () {
    const cartAttributes = {};

    // Helper function to retrieve the UTM from Url
    function getUTMFromUrl() {
      const url_string = window.location.href;
      const url = new URL(url_string);

      const utm_id = url.searchParams.get("utm_id");
      const utm_source = url.searchParams.get("utm_source");
      const utm_medium = url.searchParams.get("utm_medium");
      const utm_campaign = url.searchParams.get("utm_campaign");
      const utm_term = url.searchParams.get("utm_term");
      const ref = url.searchParams.get("ref");

      if (!utm_id && !utm_source && !utm_medium && !utm_campaign && !ref) {
        return null;
      }

      let utmParameters = {};
      
        if (utm_id) {
          utmParameters.utm_id = utm_id;
        }
        if (utm_source) {
          utmParameters.utm_source = utm_source;
        }
        if (utm_medium) {
          utmParameters.utm_medium = utm_medium;
        }
        if (utm_campaign) {
          utmParameters.utm_campaign = utm_campaign;
        }
        if (utm_term) {
          utmParameters.utm_term = utm_term;
        }
        if (ref) {
          utmParameters.ref = ref;
        }
      

      return Object.keys(utmParameters).length === 0
        ? null
        : utmParameters;
    }

    // Helper function to retrieve the UTM from Cookie
    function getUTMAttributes() {
      const urlUtmParams = getUTMFromUrl();

      if (urlUtmParams) {
          return urlUtmParams;
      }

      // No longer reading from deprecated Shopify cookies
      return undefined;
    }

    function saveUtmParameters() {
      const utmParams = getUTMAttributes();
      if (utmParams) {
        const cartHasUtmAttributes = Object.keys(cartAttributes).find(attributeKey => attributeKey.startsWith("utm_") || attributeKey === "ref");
        if (cartHasUtmAttributes) {
          // Don't call API if it already contains our UTM parameters
          return;
        }

        // Handle both Shopify.routes.root and routes.root_url for better compatibility
        var rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) 
          || (window.routes && window.routes.root_url) 
          || '/';
        
        var updateCart = fetch(rootUrl + 'cart/update.js',
        {
          headers: {
            'Content-Type': 'application/json',
          },
          method: "POST",
          body: JSON.stringify({
            attributes: {
              ...utmParams
            },
          })
        })
        .then(response => response.json())
        .then(data => {
          return data
        });
      }
    }

    saveUtmParameters();
  })();
</script>




