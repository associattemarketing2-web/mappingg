size":6.9,"width":166,"height":156,"sizeInBytes":6902}},"hash":"shailja_6e50a506bc","ext":".jpg","mime":"image/jpeg","size":104.12,"url":"/uploads/shailja_6e50a506bc.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-07-04T11:51:36.412Z","updatedAt":"2025-07-04T11:51:36.412Z"}}}}}]}},"directorsec":{"id":1,"sectiontitle":"About Founder","subtitle":"Chairman’s Message","description":"\u003cp\u003eIf there is one reason why Puravankara has evolved consistently across the last five decades to emerge as one of India’s fastest growing real estate development companies, it is because we have invested in our core values with passion to the point that they have become a part of our culture. And this culture is putting ‘People at the heart of everything we do’, be it customers, employees, community, government, shareholders or business partners.\u003cbr\u003eWhile appraising the performance of real estate development companies, it would be simplistic to believe that success is derived from the ability to mobilize financial resources, buy land parcels, appoint dependable contractors and market apartments. At Puravankara Projects, we feel that success is derived from the ability to lead, motivate, inspire, delegate and empower.\u003c/p\u003e","name":"Mr. Ravi Puravankara","position":"Founder \u0026 Chairman - Executive Director","image":{"data":{"id":2756,"attributes":{"name":"DSC_5076-copy-1.png","alternativeText":null,"caption":null,"width":1200,"height":1023,"formats":{"large":{"ext":".png","url":"/uploads/large_DSC_5076_copy_1_a6e2c1968e.png","hash":"large_DSC_5076_copy_1_a6e2c1968e","mime":"image/png","name":"large_DSC_5076-copy-1.png","path":null,"size":1257.98,"width":1000,"height":853,"sizeInBytes":1257979},"small":{"ext":".png","url":"/uploads/small_DSC_5076_copy_1_a6e2c1968e.png","hash":"small_DSC_5076_copy_1_a6e2c1968e","mime":"image/png","name":"small_DSC_5076-copy-1.png","path":null,"size":363.17,"width":500,"height":426,"sizeInByt