    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #Footer-sections--22552458854649__footer .footer__grid {
      /* Brand and the link/contact columns are two separate flex groups so
         they can use DIFFERENT gaps — the wide gap that looks right between
         brand and the rest would be much too wide if also applied between
         the short Contact/Jewellery/Services columns themselves. */
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      text-align: left;
    }
    #Footer-sections--22552458854649__footer .footer__link-columns {
      flex-direction: row;
      /* flex-wrap lets columns overflow onto a new row once there isn't
         room for all of them at their natural width — without it, a fixed
         row would instead SHRINK each column below its content's width,
         which is what was wrapping the text inside them (adding more
         blocks, or narrowing the screen, left less room per column). Each
         column gets flex: 0 0 auto so it keeps its natural content width
         instead of shrinking to fit; the row wraps instead. */
      flex-wrap: wrap;
      row-gap: 2.4rem;
      /* Fixed rem/px gaps don't shrink with the viewport — clamp() with a vw
         term scales it fluidly instead: 2rem at the 750px breakpoint,
         growing linearly up to 12rem by 1600px, capped at 12rem beyond
         that. Solved from (min, minViewport) and (max, maxViewport) via
         slope = (max-min)/(maxVw-minVw), intercept = min - slope*minVw. */
      column-gap: clamp(2rem, -6.8rem + 19vw, 12rem);
    }
    #Footer-sections--22552458854649__footer .footer__link-columns .footer-block {
      flex: 0 0 auto;
    }
    #Footer-sections--22552458854649__footer .footer-block--contact {
      order: initial;
    }
    #Footer-sections--22552458854649__footer .footer-block--brand .footer-block__tagline svg {
      height:100%;
      width:100%;
    }
    #Footer-sections--22552458854649__footer .list-social {
      justify-content: center;
      margin-top:4rem;
    }
    #Footer-sections--22552458854649__footer .footer-block__contact-line {
      justify-content: flex-start;
    }
    #Footer-sections--22552458854649__footer .footer__badges {
      justify-content: flex-end;
    }
    #Footer-sections--22552458854649__footer .footer__content-bottom-wrapper {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
    #Footer-sections--22552458854649__footer .footer__localization,
    #Footer-sections--22552458854649__footer .footer__payment {
      justify-content: flex-start;
    }
  }
  @media screen and (max-width:749px) {
    #Footer-sections--22552458854649__footer .footer__diamond {
      display:none;
    }
    #Footer-sections--22552458854649__footer .footer-block--brand .footer-block__tagline {
      font-size: 1.2rem;
    }
    #Footer-sections--22552458854649__footer .footer-block__details-content .link {
      display:inline-block;
      margin:0 auto;
    }
    #Footer-sections--22552458854649__footer .footer__grid {
      gap:4.8rem;
    }
    #Footer-sections--22552458854649__footer .footer__badge {
      padding:0.8rem;
    }
    #Footer-sections--22552458854649__footer .footer__divider .footer__diamond {
      display:block;
    }
  }

  
