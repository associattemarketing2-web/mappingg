<style>
    .mbl-mediaShow .mbl-projBack {
        display: flex !important;
        gap: 10px;
        margin-top: 15px;
    }

    .mbl-mediaShow .mbl-projBack svg path {
        fill: hsla(0, 0%, 100%, .5);
    }

    /* Newsletter button SVG states */
    .c-footer__subscribe .c-submittingState,
    .c-footer__subscribe .c-footer__inputTick,
    .c-footer__subscribe .c-footer__inputCross1,
    .c-footer__subscribe .c-footer__inputCross2 {
        display: none !important;
    }

    .c-footer__subscribe .c-footer__inputArrow {
        display: block !important;
    }

    /* Submitting state: show loader, hide others */
    .c-footer__subscribe.is-submitted .c-submittingState {
        display: inline-block !important;
    }

    .c-footer__subscribe.is-submitted .c-footer__inputArrow,
    .c-footer__subscribe.is-submitted .c-footer__inputTick,
    .c-footer__subscribe.is-submitted .c-footer__inputCross1,
    .c-footer__subscribe.is-submitted .c-footer__inputCross2 {
        display: none !important;
    }

    /* Success state: show tick icon, hide others */
    .c-footer__subscribe.is-success .c-footer__inputTick {
        display: block !important;
    }

    .c-footer__subscribe.is-success .c-footer__inputArrow,
    .c-footer__subscribe.is-success .c-submittingState,
    .c-footer__subscribe.is-success .c-footer__inputCross1,
    .c-footer__subscribe.is-success .c-footer__inputCross2 {
        display: none !important;
    }

    /* Failed state: show cross icons, hide others */
    .c-footer__subscribe.is-failed .c-footer__inputCross1,
    .c-footer__subscribe.is-failed .c-footer__inputCross2 {
        display: block !important;
    }

    .c-footer__subscribe.is-failed .c-footer__inputArrow,
    .c-footer__subscribe.is-failed .c-submittingState,
    .c-footer__subscribe.is-failed .c-footer__inputTick {
        display: none !important;
    }
</style> </main> </div> <div class="c-transitionCurtain"></div> <script src="bundle/bundle.js"></script> </body></html>