                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="wcag-form-label" for="FullName">Full Name <span class="wcag-req" aria-hidden="true">*</span></label>
                        <input class="form-control" placeholder="Full Name" aria-required="true" type="text" data-val="true" data-val-length="The field FullName must be a string with a maximum length of 100." data-val-length-max="100" data-val-regex="Invalid Name." data-val-regex-pattern="^[a-zA-Z\s\.]&#x2B;$" data-val-required="Full Name is required." id="FullName" maxlength="100" name="FullName" value="" />
                        <span class="text-danger field-validation-valid" data-valmsg-for="FullName" data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="wcag-form-label" for="MobileNumber">Mobile Number <span class="wcag-req" aria-hidden="true">*</span></label>
                        <input class="form-control" placeholder="Mobile Number" aria-required="true" aria-describedby="mobileHint" type="text" data-val="true" data-val-regex="Invalid Mobile Number." data-val-regex-pattern="^[6-9][0-9]{9}$" data-val-required="Mobile Number is required." id="MobileNumber" name="MobileNumber" value="" />
                        <small id="mobileHint" class="wcag-form-hint">Enter a 10-digit mobile number, e.g. 9876543210.</small>
                        <span class="text-danger field-validation-valid" data-valmsg-for="MobileNumber" data-valmsg-replace="true"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="wcag-form-label" for="Email">Email Address <span class="wcag-req" aria-hidden="true">*</span></label>
                    <input class="form-control" placeholder="Email Address" aria-required="true" aria-describedby="emailHint" type="email" data-val="true" data-val-email="Invalid Email." data-val-length="The field Email must be a string with a maximum length of 100." data-val-length-max="100" data-val-required="Email is required." id="Email" maxlength="100" name="Email" value="" />
                    <small id="emailHint" class="wcag-form-hint">Enter a valid email address, e.g. name@example.com.</small>
                    <span class="text-danger field-validation-valid" data-valmsg-for="Email" data-valmsg-replace="true"></span>
                </div>

                <div class="form-group">
                    <label class="wcag-form-label" for="Comments">Your Comments <span class="wcag-req" aria-hidden="true">*</span></label>
                    <textarea class="form-control" placeholder="Your Comments" minlength="5" maxlength="500" aria-required="true" aria-describedby="commentsHint" data-val="true" data-val-length="Comments length invalid." data-val-length-max="500" data-val-length-min="5" data-val-required="Comments are required." id="Comments" name="Comments">
</textarea>
                    <small id="commentsHint" class="wcag-form-hint">Comments must contain between 5 and 500 characters.</small>
                    <span class="text-danger field-validation-valid" data-valmsg-for="Comments" data-valmsg-replace="true"></span>
                </div>
                <div class="form-group get-in-touch-pg-submit-button-div">
                    <button type="submit" id="btnGItSubmit" class="submit-button orange-button">Submit</button>
                </div>

            </form>


    </div>
    <!--get-in-touch-form-wrap end-->
</div>


                    <!--col end-->
                </div>
                <!--row end-->
            </div>
            <!--get-in-touch-right-col-wrap end-->
