# ---------------------------------------------------------------------------
# Mappingg environment variables. Copy to .env.local and fill in real values.
# NEVER commit .env.local. All of these are SERVER-ONLY except NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Pooled Prisma Postgres connection string. TLS is required by the provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# --- Auth / sessions (required) --------------------------------------------
# Secret used to sign the mg_session JWT (HS256). Generate a long random value,
# e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Public site URL (required in production) ------------------------------
# Absolute origin, used for canonical URLs, sitemap, OpenGraph, OAuth callbacks.
NEXT_PUBLIC_SITE_URL="https://www.mappingg.com"

# --- Google Maps JS API key (admin team-editor / 3D map only) --------------
# The PUBLIC map is Leaflet and needs no key. This key is only used by the
# admin editor. Restrict it by HTTP referrer in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# --- Google OAuth (optional — only if/when Google Login is enabled) --------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
# These are read SERVER-SIDE only. Do NOT prefix the secret with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Object storage / CDN for project images (optional until migration) ----
# Used by the image-CDN migration (migration/migrate-project-images.mjs) and
# future admin uploads. Until these are set, project images keep being served
# from the database via /api/media (legacy fallback) and nothing breaks.
# Provider: "s3" covers AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, etc.
IMAGE_STORAGE_PROVIDER=""        # "s3" | "vercel-blob" (leave empty = disabled)
IMAGE_STORAGE_BUCKET=""          # bucket name (s3)
IMAGE_STORAGE_REGION=""          # e.g. "auto" (R2) or "ap-south-1" (S3)
IMAGE_STORAGE_ENDPOINT=""        # S3-compatible endpoint, e.g. https://<acct>.r2.cloudflarestorage.com
IMAGE_STORAGE_ACCESS_KEY=""      # server-only — never NEXT_PUBLIC_
IMAGE_STORAGE_SECRET_KEY=""      # server-only — never NEXT_PUBLIC_
IMAGE_CDN_BASE_URL=""            # public base URL images are served from, e.g. https://cdn.mappingg.com
# For Vercel Blob instead of S3, set IMAGE_STORAGE_PROVIDER="vercel-blob" and:
# BLOB_READ_WRITE_TOKEN=""
