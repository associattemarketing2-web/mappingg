<script>
  function checkMobileView() {
  var isDesktop = window.innerWidth >= 768;
 

  $('.ax-hero-banner-slider .banner-wrapper').each(function () {
    var $wrapper = $(this);
    var $desktop = $wrapper.find('.desktop-img img, .desktop-img video, .desktop-img iframe');
    var $mobile = $wrapper.find('.mobile-img img, .mobile-img video, .mobile-img iframe');

    var desktopImageUrl = $desktop.attr('src') || $desktop.find('source').attr('src');
    var mobileImageUrl = $mobile.attr('src') || $mobile.find('source').attr('src');

    var finalUrl = isDesktop ? desktopImageUrl : (mobileImageUrl || desktopImageUrl);

    $wrapper.find('img').attr('src', finalUrl);
  });
}

  $(document).ready(function() {
	checkMobileView();
    $(window).on('resize orientationchange', function () {
    checkMobileView();
  });
    var slideCount = $('.ax-hero-banner-slider .banner-wrapper').length;
    $('.ax-hero-banner-slider').slick({
      dots: false,
      slidesToShow: 1,
      slidesToScroll: 1,
      adaptiveHeight: true
    });
  });
