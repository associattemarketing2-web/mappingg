<!-- -----CAPTCHA SCRIPT START-------- -->
<script>
(function() {
    $('.btnEnquiry').on('click',function(){
         $('#e_type').val($(this).data('e-type'));
    });

    const fonts = ["sans-serif"];
    let captchaValue = "";

    function gencaptcha() {
        let value = btoa(Math.random() * 1000000000);
        value = value.substr(0, 5 + Math.random() * 5);
        captchaValue = value;
    }

    function setcaptcha() {
        let html = captchaValue.split("").map((char) => {
            const rotate = -20 + Math.trunc(Math.random() * 10);
            const font = Math.trunc(Math.random() * fonts.length);
            return `<span
            style="
            transform:rotate(${rotate}deg);
            font-family:${font[font]};
            "
           >${char} </span>`;
        }).join("");
        document.querySelector(".contact_form #captcha .preview").innerHTML = html;
    }

    function initCaptcha() {
        document.querySelector(".contact_form #captcha .captcha_refersh").addEventListener("click", function() {
            gencaptcha();
            setcaptcha();
        });

        gencaptcha();
        setcaptcha();
    }
    initCaptcha();

    // document.querySelector(".contact_form .submit_btn").addEventListener("click", function() {
    //     let inputcaptchavalue = document.querySelector(".contact_form #captcha input").value;

    //     if (inputcaptchavalue === captchaValue) {
    //         // swal("","Log in","success");
    //         // alert("Log in success");
            
    //         var form = $('#contactUsForm')[0];
    //         var data = new FormData(form);
    //         $.ajax({
    //             headers: {
    //                 'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
    //             },
    //             type: "POST",
    //             url: "https://www.bharatforge.com/contact-us/submit",
    //             data: data,
    //             processData: false,
    //             contentType: false,
    //             cache: false,
    //             success: function (response) {
    //                 $('#validation-errors').html('<div class="alert alert-success">'+response.message+'</div');
    //             },error: function (xhr) {
    //                 $('#validation-errors').html('');
    //                 var message = '';
    //                 $.each(xhr.responseJSON.errors, function(key,value) {
    //                     message += "<div>"+value+"</div>";
    //                 }); 
    //                 $('#validation-errors').append('<div class="alert alert-danger">'+message+'</div');
    //             },
    //         });
    //     } else {
    //         if(inputcaptchavalue == ''){
    //             $('#validation-errors').html('<div class="alert alert-danger">Please enter captcha</div');
    //         }else{
    //             $('#validation-errors').html('<div class="alert alert-danger">Invalid Captcha</div');
    //         }
    //     }
    // });

    $.validator.methods.email = function( value, element ) {
        return this.optional( element ) || /[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$/.test( value );
    }

    jQuery.validator.addMethod("lettersonly", function(value, element) {
        return this.optional(element) || /^[a-z\s]+$/i.test(value);
    }, "Only alphabetical characters"); 

    
    $('#contactUsForm').validate({
        rules: {
            e_first_name: {
                required: true,
                lettersonly: true,
                maxlength: 100
            },
            e_last_name: {
                required: true,
                lettersonly: true,
                maxlength: 100
            },
            e_desig: {
                required: true,
                maxlength: 100
            },
            e_org: {
                required: true,
                maxlength: 100
            },
            e_country: {
                required: true
            },
            e_email: {
                required: true,
                maxlength: 100
            },
            e_comment: {
                required: true,
                maxlength: 1000
            },
            captcha_text: "required",
        },
        messages: {
            e_first_name: {
                required: "Enter your First Name",
                lettersonly: "Only characters and space is allowed in first name",
                maxlength: jQuery.validator.format("First Name should not exceed {0} characters")
            },
            e_last_name: {
                required: "Enter your Last Name",
                lettersonly: "Only characters and space is allowed in last name",
                maxlength: jQuery.validator.format("Last Name should not exceed {0} characters")
            },
            e_desig: {
                required: "Enter your Designation",
                maxlength: jQuery.validator.format("Designation should not exceed {0} characters")
            },
            e_org: {
                required: "Enter your Organization",
                maxlength: jQuery.validator.format("Organization should not exceed {0} characters")
            },
            e_country: {
                required: "Select your Country"
            },
            e_email: {
                required: "Enter your Email",
                email: "Enter a valid Email",
                maxlength: jQuery.validator.format("Email should not exceed {0} characters")
            },
            e_comment: {
                required: "Enter your Comments",
                maxlength: jQuery.validator.format("Comments should not exceed {0} characters")
            },
            captcha_text: "Enter valid captcha text",
        },
        submitHandler: function() { 
            let inputcaptchavalue = document.querySelector(".contact_form #captcha input").value;

            if (inputcaptchavalue === captchaValue) {
                // swal("","Log in","success");
                // alert("Log in success");
                
                var form = $('#contactUsForm')[0];
                var data = new FormData(form);
                $.ajax({
                    headers: {
                        'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                    },
                    type: "POST",
                    url: "https://www.bharatforge.com/contact-us/submit",
                    data: data,
                    processData: false,
                    contentType: false,
                    cache: false,
                    success: function (response) {
                        $('#validation-errors').html('<div class="alert alert-success">'+response.message+'</div');
                        $('input[type=text]').val('');
                        $('input[type=email]').val('');
                        $('textarea').val('');
                        $("[name='e_country']").val('').attr('selected', true);
                        window.location.reload();
                    },error: function (xhr) {
                        $('#validation-errors').html('');
                        var message = '';
                        $.each(xhr.responseJSON.errors, function(key,value) {
                            message += "<div>"+value+"</div>";
                        }); 
                        $('#validation-errors').append('<div class="alert alert-danger">'+message+'</div');
                    },
                });
            } else {
                if(inputcaptchavalue == ''){
                    $('#validation-errors').html('<div class="alert alert-danger">Please enter captcha</div');
                }else{
                    $('#validation-errors').html('<div class="alert alert-danger">Invalid Captcha</div');
                }
            }
        }
    });
})();
</script>
<!-- ----CAPTCHA SCRIPT END----------- -->
<!-- FACILITIES-TAB-START -->
<script>
function openCity(evt, cityName) {
    var i, tabcontent, tablinks;
    tabcontent = document.getElementsByClassName("tabcontent");
    for (i = 0; i < tabcontent.length; i++) {
        tabcontent[i].style.display = "none";
    }
    tablinks = document.getElementsByClassName("tablinks");
    for (i = 0; i < tablinks.length; i++) {
        tablinks[i].className = tablinks[i].className.replace(" active", "");
    }
    document.getElementById(cityName).style.display = "block";
    evt.currentTarget.className += " active";
}
</script>
<style>
.tabcontent {
    display: none;
}
</style>
<!-- FACILITIES-TAB-END -->

<!-- active menus script start -->
<script>
$(document).ready(function() {
    var metaTags = {}; // Object to hold the meta tag data from the config file
    var currentSectionId = null; // Track the currently active section

    function loadMetaConfig() {
        $.getJSON('../assets/js/meta-config.json', function(data) {
            metaTags = data;
            // Initialize the meta tags based on the current section (if any)
            setActiveMenuItems();
        }).fail(function(jqXHR, textStatus, errorThrown) {
            console.error('Failed to load meta tag configuration:', textStatus, errorThrown);
        });
    }

    function setActiveMenuItems() {
        var scrollY = $(window).scrollTop() + 100; // Adjusting the scroll position check
        var newSectionId = null; // Track the currently active section

        $(".sectionBox").each(function() {
            var sectionTop = $(this).offset().top;
            var sectionBottom = sectionTop + $(this).outerHeight();
            var targetId = $(this).attr("id");

            if (scrollY >= sectionTop && scrollY < sectionBottom) {
                $("nav a[href='#" + targetId + "']").parent('li').addClass("active");
                newSectionId = targetId;
            } else {
                $("nav a[href='#" + targetId + "']").parent('li').removeClass("active");
            }
        });

        if (newSectionId && newSectionId !== currentSectionId) {
            currentSectionId = newSectionId;
            history.replaceState(null, null, '#' + currentSectionId); // Update the URL with the new section ID
            updateMetaTags(currentSectionId);
        }
    }

    function updateMetaTags(sectionId) {
        var metaTag = metaTags[sectionId] || {
            title: 'Bharat Forge',
            description: '',
            keywords: '',
            canonical: ''
        };

        // Update the title tag
        document.title = metaTag.title;

        // Update meta description
        var metaDescription = $('meta[name="description"]');
        if (metaDescription.length) {
            metaDescription.attr('content', metaTag.description);
        } else {
            $('head').append('<meta name="description" content="' + metaTag.description + '">');
        }

        // Update meta keywords
        var metaKeywords = $('meta[name="keywords"]');
        if (metaKeywords.length) {
            metaKeywords.attr('content', metaTag.keywords);
        } else {
            $('head').append('<meta name="keywords" content="' + metaTag.keywords + '">');
        }

        // Update canonical link
        var canonicalLink = $('link[rel="canonical"]');
        if (canonicalLink.length) {
            canonicalLink.attr('href', metaTag.canonical);
        } else {
            $('head').append('<link rel="canonical" href="' + metaTag.canonical + '">');
        }
    }

    // Load meta configuration file
    loadMetaConfig();

    // Highlight active menu item and update URL on scroll
    $(window).on("scroll", setActiveMenuItems);

    // Handle navigation clicks
    $('nav a').on('click', function(e) {
        e.preventDefault();
        var targetId = $(this).attr('href');
        var targetSection = $(targetId);
        if (targetSection.length) {
            $('html, body').animate({
                scrollTop: targetSection.offset().top -
                    50 // Adjust scrolling to account for 50px offset
            }, 100, function() {
                // Ensure highlight after scroll animation
                setActiveMenuItems();
            });

            // Update the browser's URL after clicking a link
            history.pushState(null, null, targetId);
        }
        return false;
    });
});
</script>
<!-- active menus script end -->
<!-- SCRIPT END -->
