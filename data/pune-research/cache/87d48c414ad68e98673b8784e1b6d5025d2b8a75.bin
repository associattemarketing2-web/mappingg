tyles, and delivering spaces that inspire generations across India's growing urban landscapes.\u003c/p\u003e","stat":[{"id":1,"Title":"Completed Projects","number":"98","suffix":"+","icon":{"data":{"id":339,"attributes":{"name":"icon1.svg","alternativeText":"real estate developers in India","caption":null,"width":92,"height":92,"formats":null,"hash":"icon1_53aeebad3d","ext":".svg","mime":"image/svg+xml","size":21.37,"url":"/uploads/icon1_53aeebad3d.svg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-03-12T04:38:48.605Z","updatedAt":"2026-06-26T10:43:47.460Z"}}}},{"id":2,"Title":"Cities","number":"9","suffix":null,"icon":{"data":{"id":337,"attributes":{"name":"icon2.svg","alternativeText":"Real Estate Developers Bangalore","caption":null,"width":72,"height":72,"formats":null,"hash":"icon2_b7c40051f5","ext":".svg","mime":"image/svg+xml","size":10.45,"url":"/uploads/icon2_b7c40051f5.svg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-03-12T04:38:48.552Z","updatedAt":"2026-06-26T10:44:03.934Z"}}}},{"id":3,"Title":"Awards","number":"200","suffix":"+","icon":{"data":{"id":340,"attributes":{"name":"icon3.svg","alternativeText":"Top Builders in Bangalore","caption":null,"width":84,"height":84,"formats":null,"hash":"icon3_c47bba5f6c","ext":".svg","mime":"image/svg+xml","size":15.03,"url":"/uploads/icon3_c47bba5f6c.svg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-03-12T04:38:48.607Z","updatedAt":"2026-06-26T10:44:13.455Z"}}}},{"id":4,"Title":"Happy Customers","number":"200000","suffix":"+","icon":{"data":{"id":338,"attributes":{"name":"icon4.svg","alternativeText":"Real Estate Developers","caption":null,"width":88,"height":88,"formats":null,"hash":"icon4_2ba969df5a","ext":".svg","mime":"image/svg+xml","size":12.69,"url":"/uploads/icon4_2ba969df5a.svg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-03-12T04:38:48.554Z","updatedAt":"2026-06-26T1