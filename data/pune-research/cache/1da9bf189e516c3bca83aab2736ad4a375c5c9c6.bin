    function toggleSearchFields() {
        let selectedProjectType = $('#our_project_type').val();
        let selectedConfigText = $(".our_project_new option:selected").text().toLowerCase();
        if (selectedProjectType == "3" ||
            selectedConfigText.includes("lease") ||
            selectedConfigText.includes("sale")) {
            $(".ourhidesearch").hide();
        } else {
            $(".ourhidesearch").show();
        }
    }

    function toggleSearchFieldsHome() {
        let selectedProjectType = $('#project_type_id2').val();
        let selectedConfigText = $("#configuration_id2 option:selected").text().toLowerCase();

        if (selectedProjectType == "3" ||
            selectedConfigText.includes("lease") ||
            selectedConfigText.includes("sale")) {
            $(".hidesearchhome").hide();
        } else {
            $(".hidesearchhome").show();
        }
    }

    function toggleSearchFieldshead() {
        let selectedProjectType = $('#project_type_id').val();
        let selectedConfigText = $("#configuration_id option:selected").text().toLowerCase();

        if (selectedProjectType == "3" ||
            selectedConfigText.includes("lease") ||
            selectedConfigText.includes("sale")) {
            $(".hidesearch").hide();
        } else {
            $(".hidesearch").show();
        }
    }


