<style>
    #balic-gps-card{position:fixed;bottom:110px;left:18px;z-index:98;display:none;animation:balic-gps-slide .3s ease;background:#ffffff;border:1.5px solid #dadce0;border-radius:12px;padding:14px 18px;box-shadow:0 2px 12px rgba(0,0,0,.15);cursor:pointer;transition:box-shadow .2s;width:fit-content}
