<style id="wp-custom-css">
.section-heading-top span{
    font-size: 30px;
    line-height: 0;
    display: inline-block;
    padding-top: 2px;
    position: absolute;
    left: -1px;
    top: 15px;
}
#contact .elementor-field-type-submit{
		width:auto;
}
.section-heading span{
	color:#D4A017;
}
.section-heading-black span{
	color:#111827;
}
.elementor-widget-button svg,
.elementor-field-type-submit svg{
	transform:rotate(-45deg);
	font-size:26px;
	transition: all .2s linear;
	position:absolute;
	right:10px
}
.elementor-field-type-submit svg{
	right:15px;
}
.elementor-widget-button:hover svg,.elementor-field-type-submit:hover svg{
	transform:rotate(0deg);
}

.elementor-widget-button.default-button svg{
	transform:rotate(0deg);
}
/* Set offset/inactive slides to less opacity */
#slider-crafted-for-you .swiper-slide, #recognition-carousel .swiper-slide, #creative-projects-carousel  .swiper-slide{
    opacity: 0.3;
    transition: opacity 0.4s ease-in-out;
}

/* Step 2: Make the 1st visible slide bright */
#slider-crafted-for-you  .swiper-slide.swiper-slide-active,#recognition-carousel  .swiper-slide.swiper-slide-active, #creative-projects-carousel .swiper-slide.swiper-slide-active,
/* Step 3: Make the 2nd visible slide bright */
#slider-crafted-for-you  .swiper-slide.swiper-slide-next, #recognition-carousel  .swiper-slide.swiper-slide-next, #creative-projects-carousel .swiper-slide.swiper-slide-next,
/* Step 4: Make the 3rd visible slide bright */
#slider-crafted-for-you  .swiper-slide.swiper-slide-next + .swiper-slide, #creative-projects-carousel .swiper-slide.swiper-slide-next + .swiper-slide, #recognition-carousel  .swiper-slide.swiper-slide-next + .swiper-slide, #recognition-carousel  .swiper-slide.swiper-slide-next + .swiper-slide + .swiper-slide,  #creative-projects-carousel .swiper-slide.swiper-slide-next + .swiper-slide + .swiper-slide,  #creative-projects-carousel .swiper-slide.swiper-slide-next + .swiper-slide + .swiper-slide + .swiper-slide, #recognition-carousel  .swiper-slide.swiper-slide-next + .swiper-slide + .swiper-slide + .swiper-slide   {
    opacity: 1;
}

/*BLOG CUSTOMIZATION*/
 .elementor-kit-9 .blog-content h2{
	font-size:30px;
	 margin-top:0;
	 margin-bottom:10px;
}
 .elementor-kit-9 .blog-content h3{
	font-size:28px;
}
 .elementor-kit-9 .blog-content h2{
	font-size:30px;
}
/*MEGA MENU*/
.mega-menu-list .elementor-icon-list-item .elementor-icon-list-text span{
	font-size:smaller;
	color:#888;
}
.mega-menu-list .elementor-icon-list-item .elementor-icon-list-text sup.luxe{
	color:#D4A017;
}

/*MEGA MENU FIRST POST*/
.mega-menu-post .elementor-posts-container.elementor-has-item-ratio .elementor-post__thumbnail img{
	height:100%;
}

/*PULSATING ANIMATION*/

.testimonial-video .elementor-custom-embed-play svg{
    animation-name: customPulseLoop !important;
    animation-duration: 2s !important;
    animation-iteration-count: infinite !important;
    animation-timing-function: ease-in-out !important;
    animation-fill-mode: both !important;
    
    /* Crucial: Prevents Elementor's parent containers from clipping the pulse scaling */
    transform-style: preserve-3d !important;
    backface-visibility: hidden !important;
    display: inline-block !important;
}

/* 2. Renamed unique timeline to avoid conflicts with Elementor's internal engine */
@keyframes customPulseLoop {
    0% {
        transform: scale(1);
    }
    50% {
        transform: scale(.8); /* Adjust thickness of pulse here */
    }
    100% {
        transform: scale(1);
    }
}
	#global-header.elementor-sticky--effects .e-n-menu-title-container span{
		color:#111827;
	}


#global-header.elementor-sticky--effects .e-n-menu-dropdown-icon.e-focus svg{
	fill:#D4A017;
}

.price-range span{
	font-size:smaller;
}
.project-navigation .elementor-icon-list-item.active-nav-item .elementor-icon-list-text, .project-navigation .elementor-icon-list-item.active-nav-item a svg {
  color: #D4A017 !important;
  fill: #D4A017 !important;
}

/*PROPERTY LISTING */
.property-listing{
	
}

/* Make the card content overlay the image */
.property-listing .elementor-post {
    position: relative;
    overflow: hidden;
}

.property-listing .elementor-post__thumbnail {
    position: relative;
}

.property-listing .elementor-post__text {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    padding: 20px;
    color: #fff;
    background: linear-gradient(
        to top,
        rgba(0,0,0,0.8),
        rgba(0,0,0,0)
    );
    box-sizing: border-box;
}
.property-listing.elementor-posts--thumbnail-top .elementor-post__thumbnail__link{
	margin-bottom:0;
}

/* Ensure title and excerpt look good over the image */
.property-listing .elementor-post__title {
    padding-bottom: 5px;
}

.property-listing .elementor-post__excerpt {
    margin: 0;
}
a.no-underline-container, .no-underline-container a{
    text-decoration: none !important;
}
/*STICKY LOGO SWITCH*/
.logo-regular {
	display:none;
}
#global-header.elementor-sticky--effects .logo-regular, #global-header-mobile.elementor-sticky--effects .logo-regular{
	display:block;
}
#global-header.elementor-sticky--effects .logo-sticky, #global-header-mobile.elementor-sticky--effects .logo-sticky{
	display:none;
}
.project-content{
	padding:0!important;
}

.contact-forms .elementor-field-type-submit{
	width:auto;
}
.badge-project-listing .elementor-post-info__terms-list{
	font-size:0 !important;
}
.badge-project-listing .elementor-post-info__terms-list span.elementor-post-info__terms-list-item{
	font-size:8px !important;
	padding: 8px 15px;
  border: 1px solid #D4A017;
  border-radius: 25px;
  display: block !important;
	background:#D4A017;
}
.badge-project-listing .elementor-post-info__terms-list span.elementor-post-info__terms-list-item + span{
	margin-top:-10px;
