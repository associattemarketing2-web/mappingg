<div class="main-screen-enquire-btn">
  <a href="javascript:void(0)" class="theme-btn sticky-btn-enquire" data-type="Enquire Now" onclick="openModel('enquire-now');">Enquire Now</a>
</div>

<div id="header-search-menu-detail" class="header-search-menu-detail bg-light-golden">
  <div class="header-search-menu-close" onclick="closeModel('header-search-menu-detail');"></div>
  <div class="properties-filter theme-padding">
    <div class="columns is-mobile is-multiline is-variable is-6 is-justify-content-center is-align-items-end">
      <div class="column">
        <div class="form-group custom-select">
          <label class="form-label">Project Type</label>
          <select class="form-control select" id="project_type_id" name="project_type_id" required>
          </select>
        </div>
      </div>
      <div class="column">
        <div class="form-group custom-select">
          <label class="form-label">Location</label>
          <select class="form-control select" id="location_id" name="location_id">
            <!-- <option value="">Select</option> -->
          </select>
        </div>
      </div>
      <div class="column">
        <div class="form-group custom-select">
          <label class="form-label">Configuration</label>
          <select class="form-control select" id="configuration_id" name="configuration_id" multiple>
            <!-- <option value="">Select</option> -->
          </select>
        </div>
      </div>
      
      <div class="column hidesearch">
        <div class="form-group custom-range-slider">
          <label class="form-label">Carpet Size (in Sq. Ft.)</label>
          <ul>
            <li>
              <!-- <label>447 Sq.Ft</label> -->
              <input type="number" maxlength="650" value="650" class="from custom-range-title" id="searchminrang" />
            </li>
            <li>
              <input type="number" maxlength="2500" value="2500" class="to custom-range-title" id="searchmaxrang" />
            </li>
          </ul>
          <input type="text" class="properties-range-slider" value="" data-skin="round" data-type="double" data-min="650" data-max="2500" data-grid="false" />
        </div>
      </div>
      

      
      <div class="column search-btn">
         <div class="form-group is-flex is-gap-1">
          
          <button type="submit" class="btn rounded-pill btn-outline-primary searchproject"><span>Search</span></button>
          <button type="submit" class="btn rounded-pill btn-outline-primary searchclearfilters"><span>Reset</span></button>
        </div>
      </div>
    </div>
  </div>
</div>

