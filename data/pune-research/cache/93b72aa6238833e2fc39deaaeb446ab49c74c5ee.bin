            $("#error3").html("Please enter email");
            return false;
        }
        var emailReg = /^(("[\w-\s]+")|([\w-]+(?:\.[\w-]+)*)|("[\w-\s]+")([\w-]+(?:\.[\w-]+)*))(@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$)|(@\[?((25[0-5]\.|2[0-4][0-9]\.|1[0-9]{2}\.|[0-9]{1,2}\.))((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\.){2}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\]?$)/i;
        if (emailReg.test(email1) == false) {
            $("#error3").html("Please enter valid email address");
            return false;
        }
        if (!phone1) {
            $("#error3").html("Please enter phone");
            return false;
        }
        var mob = /^[0-9]{10}$/;
        if (mob.test(phone1) == false) {
            $("#error3").html("Please enter 10 digit number");
            return false;
        }
        if (!city1) {
            $("#error3").html("Please enter city");
            return false;
        }
        if (!response1) {
            $("#error3").html("Please enter feedback");
            return false;
        }
        $("#send1").html('<i class="fa fa-spinner fa-pulse fa-fw"></i> Loading..');
        $('#send1').prop('disabled', true);


        $.ajax({
            type: "POST",
            url: "https://naiknavare.com/send_feedback",
